ISO-10303-21;
HEADER;
/* A 1000 mm cube, hand-written for step_core's tests (VUGSTEP, LEDGER SR482): ISO 10303-21 clear text, the AP214
   automotive_design schema, the public example shape: eight CARTESIAN_POINTs, six PLANEs, twelve EDGE_CURVEs over
   LINEs. The bottom PLANE's axis is +Z with ADVANCED_FACE same_sense .F., and E12 runs against its LINE
   (EDGE_CURVE same_sense .F.), so both sense flags are exercised. */
FILE_DESCRIPTION(('step_core test cube'),'2;1');
FILE_NAME('cube.step','2026-11-01T00:00:00',('Vug'),('UnaOS'),'hand-written','hand-written','');
FILE_SCHEMA(('AUTOMOTIVE_DESIGN { 1 0 10303 214 1 1 1 1 }'));
ENDSEC;
DATA;
#1=APPLICATION_CONTEXT('core data for automotive mechanical design processes');
#2=APPLICATION_PROTOCOL_DEFINITION('international standard','automotive_design',2000,#1);
#3=PRODUCT_CONTEXT('',#1,'mechanical');
#4=PRODUCT('cube','cube','',(#3));
#5=PRODUCT_DEFINITION_FORMATION('','',#4);
#6=PRODUCT_DEFINITION_CONTEXT('part definition',#1,'design');
#7=PRODUCT_DEFINITION('design','',#5,#6);
#8=PRODUCT_DEFINITION_SHAPE('','',#7);
#9=SHAPE_DEFINITION_REPRESENTATION(#8,#10);
#10=ADVANCED_BREP_SHAPE_REPRESENTATION('cube',(#20,#11),#15);
#11=AXIS2_PLACEMENT_3D('origin',#30,$,$);
#12=( LENGTH_UNIT() NAMED_UNIT(*) SI_UNIT(.MILLI.,.METRE.) );
#13=( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#14=( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#15=( GEOMETRIC_REPRESENTATION_CONTEXT(3) GLOBAL_UNCERTAINTY_ASSIGNED_CONTEXT((#16))
  GLOBAL_UNIT_ASSIGNED_CONTEXT((#12,#13,#14)) REPRESENTATION_CONTEXT('cube','3D') );
#16=UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.E-06),#12,'distance_accuracy_value','confusion accuracy');
#20=MANIFOLD_SOLID_BREP('cube',#21);
#21=CLOSED_SHELL('',(#100,#110,#120,#130,#140,#150));
/* points P1..P8 and vertices V1..V8 */
#30=CARTESIAN_POINT('P1',(0.,0.,0.));
#31=CARTESIAN_POINT('P2',(1000.,0.,0.));
#32=CARTESIAN_POINT('P3',(1000.,1000.,0.));
#33=CARTESIAN_POINT('P4',(0.,1000.,0.));
#34=CARTESIAN_POINT('P5',(0.,0.,1000.));
#35=CARTESIAN_POINT('P6',(1000.,0.,1000.));
#36=CARTESIAN_POINT('P7',(1000.,1000.,1000.));
#37=CARTESIAN_POINT('P8',(0.,1000.,1000.));
#40=VERTEX_POINT('V1',#30);
#41=VERTEX_POINT('V2',#31);
#42=VERTEX_POINT('V3',#32);
#43=VERTEX_POINT('V4',#33);
#44=VERTEX_POINT('V5',#34);
#45=VERTEX_POINT('V6',#35);
#46=VERTEX_POINT('V7',#36);
#47=VERTEX_POINT('V8',#37);
/* directions */
#50=DIRECTION('+X',(1.,0.,0.));
#51=DIRECTION('+Y',(0.,1.,0.));
#52=DIRECTION('+Z',(0.,0.,1.));
#53=DIRECTION('-X',(-1.,0.,0.));
#54=DIRECTION('-Y',(0.,-1.,0.));
#55=DIRECTION('-Z',(0.,0.,-1.));
/* edges: VECTOR, LINE, EDGE_CURVE */
#60=VECTOR('',#50,1000.);
#61=LINE('',#30,#60);
#62=EDGE_CURVE('E1',#40,#41,#61,.T.);
#63=VECTOR('',#51,1000.);
#64=LINE('',#31,#63);
#65=EDGE_CURVE('E2',#41,#42,#64,.T.);
#66=VECTOR('',#53,1000.);
#67=LINE('',#32,#66);
#68=EDGE_CURVE('E3',#42,#43,#67,.T.);
#69=VECTOR('',#54,1000.);
#70=LINE('',#33,#69);
#71=EDGE_CURVE('E4',#43,#40,#70,.T.);
#72=VECTOR('',#50,1000.);
#73=LINE('',#34,#72);
#74=EDGE_CURVE('E5',#44,#45,#73,.T.);
#75=VECTOR('',#51,1000.);
#76=LINE('',#35,#75);
#77=EDGE_CURVE('E6',#45,#46,#76,.T.);
#78=VECTOR('',#53,1000.);
#79=LINE('',#36,#78);
#80=EDGE_CURVE('E7',#46,#47,#79,.T.);
#81=VECTOR('',#54,1000.);
#82=LINE('',#37,#81);
#83=EDGE_CURVE('E8',#47,#44,#82,.T.);
#84=VECTOR('',#52,1000.);
#85=LINE('',#30,#84);
#86=EDGE_CURVE('E9',#40,#44,#85,.T.);
#87=VECTOR('',#52,1000.);
#88=LINE('',#31,#87);
#89=EDGE_CURVE('E10',#41,#45,#88,.T.);
#90=VECTOR('',#52,1000.);
#91=LINE('',#32,#90);
#92=EDGE_CURVE('E11',#42,#46,#91,.T.);
#93=VECTOR('',#55,1000.);
#94=LINE('',#37,#93);
#95=EDGE_CURVE('E12',#43,#47,#94,.F.);
/* bottom, z = 0: the plane's axis +Z, the face against it (same_sense .F.); the loop runs about -Z */
#100=ADVANCED_FACE('bottom',(#101),#107,.F.);
#101=FACE_OUTER_BOUND('',#102,.T.);
#102=EDGE_LOOP('',(#103,#104,#105,#106));
#103=ORIENTED_EDGE('',*,*,#71,.F.);
#104=ORIENTED_EDGE('',*,*,#68,.F.);
#105=ORIENTED_EDGE('',*,*,#65,.F.);
#106=ORIENTED_EDGE('',*,*,#62,.F.);
#107=PLANE('',#108);
#108=AXIS2_PLACEMENT_3D('',#30,#52,#50);
/* top, z = 1000 */
#110=ADVANCED_FACE('top',(#111),#117,.T.);
#111=FACE_OUTER_BOUND('',#112,.T.);
#112=EDGE_LOOP('',(#113,#114,#115,#116));
#113=ORIENTED_EDGE('',*,*,#74,.T.);
#114=ORIENTED_EDGE('',*,*,#77,.T.);
#115=ORIENTED_EDGE('',*,*,#80,.T.);
#116=ORIENTED_EDGE('',*,*,#83,.T.);
#117=PLANE('',#118);
#118=AXIS2_PLACEMENT_3D('',#34,#52,#50);
/* front, y = 0 */
#120=ADVANCED_FACE('front',(#121),#127,.T.);
#121=FACE_OUTER_BOUND('',#122,.T.);
#122=EDGE_LOOP('',(#123,#124,#125,#126));
#123=ORIENTED_EDGE('',*,*,#62,.T.);
#124=ORIENTED_EDGE('',*,*,#89,.T.);
#125=ORIENTED_EDGE('',*,*,#74,.F.);
#126=ORIENTED_EDGE('',*,*,#86,.F.);
#127=PLANE('',#128);
#128=AXIS2_PLACEMENT_3D('',#30,#54,#50);
/* right, x = 1000 */
#130=ADVANCED_FACE('right',(#131),#137,.T.);
#131=FACE_OUTER_BOUND('',#132,.T.);
#132=EDGE_LOOP('',(#133,#134,#135,#136));
#133=ORIENTED_EDGE('',*,*,#65,.T.);
#134=ORIENTED_EDGE('',*,*,#92,.T.);
#135=ORIENTED_EDGE('',*,*,#77,.F.);
#136=ORIENTED_EDGE('',*,*,#89,.F.);
#137=PLANE('',#138);
#138=AXIS2_PLACEMENT_3D('',#31,#50,#51);
/* back, y = 1000 */
#140=ADVANCED_FACE('back',(#141),#147,.T.);
#141=FACE_OUTER_BOUND('',#142,.T.);
#142=EDGE_LOOP('',(#143,#144,#145,#146));
#143=ORIENTED_EDGE('',*,*,#68,.T.);
#144=ORIENTED_EDGE('',*,*,#95,.T.);
#145=ORIENTED_EDGE('',*,*,#80,.F.);
#146=ORIENTED_EDGE('',*,*,#92,.F.);
#147=PLANE('',#148);
#148=AXIS2_PLACEMENT_3D('',#32,#51,#53);
/* left, x = 0 */
#150=ADVANCED_FACE('left',(#151),#157,.T.);
#151=FACE_OUTER_BOUND('',#152,.T.);
#152=EDGE_LOOP('',(#153,#154,#155,#156));
#153=ORIENTED_EDGE('',*,*,#71,.T.);
#154=ORIENTED_EDGE('',*,*,#86,.T.);
#155=ORIENTED_EDGE('',*,*,#83,.F.);
#156=ORIENTED_EDGE('',*,*,#95,.F.);
#157=PLANE('',#158);
#158=AXIS2_PLACEMENT_3D('',#33,#53,#54);
ENDSEC;
END-ISO-10303-21;
