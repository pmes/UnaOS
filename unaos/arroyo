# JETSON-EL0IMG: carry the EL0 programs onto the Orin boot volume, beside kernel.elf. Runs AFTER
# `prepare_aarch64` — that function `rm -rf`s and re-creates `$ESP_DIR_ARM`, so anything staged before
# it is wiped.
#
# WHY THE JETSON VOLUME IS THE PROGRAM VOLUME. On x86 there are two volumes (the ESP the firmware reads
# once, and a separate DATA volume the kernel mounts after ExitBootServices — see `esp_x86`). The Orin
# has ONE: the same FAT32 stick the on-board UEFI launched BOOTAA64.EFI from is re-enumerated by the
# kernel's own xHCI stack as USB mass storage (JD3: "mass storage ready (slot 2)"), and that is the
# volume `fs::fat::mount()` binds and the panel `ls`/`cat` read. So a program staged here is a program
# the running Orin can see.
#
# ALWAYS, NOT KNOB-GATED — three reasons:
#
#   1. It cannot move kernel.elf. The five crates are their own cargo workspaces with their own target
#      dirs and nothing in the kernel reads their output (only `user_blob.bin` is `include_bytes!`d, and
#      that build stays behind the `tegra_el0` gate above). The knob-off byte-identity invariant the
#      `tegra_el0` Cargo note states is about the KERNEL IMAGE, and it still holds exactly: verified by
#      building `esp-jetson` before and after this change and comparing sha256 of kernel.elf.
#   2. The cost is nil. ~54 KiB of images against the ~11.8 MB this volume already carries (kernel.elf
#      ~2.0 MB + SRC.TGZ ~9.8 MB) — under half a percent of a FAT32 stick that has gigabytes spare. Bytes
#      that are never exec'd are inert.
#   3. A conditional `ls` is an unreadable instrument. If the programs appeared only when a kernel-side
#      development knob happened to be armed, an operator staring at an empty `ls` on the panel could not
#      tell "this build did not stage them" from "the FAT mount is not reading". Staging unconditionally
#      makes the listing mean one thing.
#
# HELLO.BIN is the one exception, and only because its source (`target/user_blob.bin`) is built by
# `build_user_blob`, which IS knob-gated for the mtime-churn reason documented there. When the knob is
# armed the file already exists at zero marginal cost, so it rides along; when it is not, it is absent
# rather than stale — a stale flat blob from some earlier Pi build is worse than no file at all.
#
# NOT STAGED, deliberately: K2OWN.BIN / K2IMP.BIN / MIDDEN.BIN. Those are Pi *fixture* pairs driven by
# the `witness` cascade (K2 ownership enforcement, BANDY bus round-trip), not standalone programs — on
# the Orin nothing drives them and they would only add noise to `ls`. They cost nothing to add later if
# a jetson witness ever wants them.
stage_jetson_el0_images() {
    local staged=0
    echo -e "${COLOR_CYAN}⚡ Staging EL0 programs onto the Jetson boot volume...${COLOR_RESET}"
    # The five static-ELF64 images `build_user_el0_elf_images` just produced. Each already passed its
    # ELF-magic + 16 KiB slot-window assertions there; re-assert PRESENCE here, because the failure this
    # guards against is a staging step that silently copied nothing.
    for img in ELFHELLO.ELF VUG.ELF VUGK.ELF STAT.ELF PULSE.ELF; do
        local src="${WORKSPACE_DIR}/target/${img}"
        [ -s "$src" ] || { echo -e "${COLOR_RED}ERROR: ${img} missing/empty — cannot stage the jetson boot volume${COLOR_RESET}"; exit 1; }
        cp "$src" "${ESP_DIR_ARM}/${img}"
        staged=$((staged + 1))
    done
    # HELLO.BIN: only when `tegra_el0` armed `build_user_blob` above (see the block header).
    if [ -s "${WORKSPACE_DIR}/target/user_blob.bin" ]; then
        case ",${_feats}" in
            *",tegra_el0,"*)
                cp "${WORKSPACE_DIR}/target/user_blob.bin" "${ESP_DIR_ARM}/HELLO.BIN"
                staged=$((staged + 1))
                ;;
        esac
    fi
    # THE VALIDITY CHECK (this track's rule): an instrument that is not in the image proves nothing. Print
    # what actually landed, with sizes, so the build's own output is the evidence — not a claim about it.
    echo -e "${COLOR_GREEN}✅ EL0 programs on the boot volume (${staged}):${COLOR_RESET}"
    local f
    for f in "${ESP_DIR_ARM}"/*.ELF "${ESP_DIR_ARM}"/*.BIN; do
        [ -f "$f" ] || continue
        printf '     %-14s %8s B\n' "$(basename "$f")" "$(wc -c < "$f" | tr -d ' ')"
    done
    # PULSE.ELF's honest note, printed where the operator will read it. ABIFREEZE divergence D2:
    # SYS_CPUPULSE (49) is dispatched ONLY by the x86 kernel; the aarch64 dispatcher has no arm for it and
    # answers -ENOSYS. `user-pulse` handles that refusal by design — its baseline `sample()` returns None,
    # it prints `:: PULSE-A: SYS_CPUPULSE refused - no honest sample, exiting ::` and exits 2 rather than
    # drawing a fabricated bar. So the image is honest to stage: its failure is a stated verdict, not a
    # fault. Every other image here uses only syscalls the aarch64 dispatcher implements.
    echo -e "${COLOR_YELLOW}   note: PULSE.ELF exits 2 with 'SYS_CPUPULSE refused' on aarch64 (ABIFREEZE D2) — by design.${COLOR_RESET}"
}

# Jetson Orin Nano boot media: the aarch64 UEFI ESP (BOOTAA64.EFI + kernel.elf + the EL0 programs
# `stage_jetson_el0_images` carries) built with the `tegra` UART feature forced on (= UNAOS_TEGRA=1),
# so the kernel drives the Tegra 16550 at UARTC (0x0C28_0000) rather than the QEMU-virt PL011. Boots
# from NVIDIA's on-board UEFI (JetPack 6 / L4T r36) off a single-partition FAT32 USB stick.
# See docs/dev/OS/01_BOOT_HAL/arch_arm64.md (Orin).
esp_jetson() {
    # Force `tegra` on top of whatever features were already selected (idempotent).
    case ",${_feats}" in
        *",tegra,"*) ;;
        *) _feats="${_feats}tegra,"; KERNEL_FEATURES="--features ${_feats%,}" ;;
    esac
    # ORIN-SMP-DEFAULT: the 6-core SMP kick-off is default-on for the jetson image (opt out with
    # UNAOS_NOTEGRASMP=1 => boot-core-only, byte-identical to the pre-flip baseline). Idempotent.
    if [ -z "${UNAOS_NOTEGRASMP:-}" ]; then
        case ",${_feats}" in
            *",tegrasmp,"*) ;;
            *) _feats="${_feats}tegrasmp,"; KERNEL_FEATURES="--features ${_feats%,}" ;;
        esac
    fi
    echo -e "${COLOR_YELLOW}⚡ kernel features (jetson): ${_feats%,}${COLOR_RESET}"
    local TOOLBIN; TOOLBIN="$(rustc +nightly --print sysroot)/lib/rustlib/$(rustc +nightly -vV | awk '/host/{print $2}')/bin"
    # JETSON-EL0 (M1b): an ARMED jetson image compiles `arch/aarch64/syscall.rs`, which
    # `include_bytes!`es `target/user_blob.bin` (the el0-hello payload). That file is produced by
    # `build_user_blob`, which until this arc ran ONLY from the Pi `kernel8` path — so a first
    # `UNAOS_TEGRA_EL0=1 ./arroyo esp-jetson` in a tree that had never built a Pi image failed with
    # `couldn't read .../target/user_blob.bin`. Build it here, and ONLY when armed: the disarmed jetson
    # path does not compile `syscall.rs` at all, so adding an unconditional blob build would slow every
    # ordinary jetson build and (by refreshing the blob's mtime) churn the kernel's rebuild for nothing.
    case ",${_feats}" in
        *",tegra_el0,"*)
            build_user_blob
            ;;
    esac
    # JETSON-EL0IMG: build the five static-ELF64 EL0 programs BEFORE the kernel, so a size-cliff or
    # magic assertion fails in seconds rather than after a full kernel link. UNCONDITIONAL, unlike the
    # blob above — see the three reasons in the staging block below.
    build_user_el0_elf_images
    prepare_aarch64
    stage_jetson_el0_images
    pack_source_along "$ESP_DIR_ARM"
    echo -e "${COLOR_GREEN}✅ Jetson ESP (tegra): ${ESP_DIR_ARM}${COLOR_RESET}"
    [ -f "${ESP_DIR_ARM}/SRC.TGZ" ] && echo -e "   SRC.TGZ sha256: $(sha256_of "${ESP_DIR_ARM}/SRC.TGZ")"
    cat <<EOF

  Make Orin boot media (macOS), then boot it:
    1. Format a USB stick as ONE FAT32 partition — ERASES it, pick the right diskN:
         diskutil list                                      # find your USB (external, physical)
         diskutil eraseDisk "MS-DOS FAT32" UNAOS MBRFormat /dev/diskN
    2. Copy the ESP on (no macOS AppleDouble junk), then eject. The trailing "/." copies the WHOLE
       staged tree — EFI/, kernel.elf, SRC.*, and the EL0 programs (VUG.ELF / VUGK.ELF / STAT.ELF /
       PULSE.ELF / ELFHELLO.ELF, + HELLO.BIN on a tegra_el0 build). Enumerating them by hand is how
       a stick ends up booting fine with an empty \`ls\`:
         COPYFILE_DISABLE=1 cp -R "${ESP_DIR_ARM}"/. /Volumes/UNAOS/
         sync && diskutil eject /dev/diskN
    3. Plug into an Orin USB-A port, attach a DisplayPort monitor at power-on, then power on.
    4. In the UEFI Shell (tap ESC during boot if it does not drop there):
         connect -r                      # bind FAT drivers — card readers need this
         map -r                           # find the stick's FSx:  (HD(1,MBR,...) on USB/Unit)
         FSx:\\EFI\\BOOT\\BOOTAA64.EFI     # launch UnaOS  (x = the number map showed)
  Serial console: Raspberry Pi Debug Probe on the board TTL header (pin 3 = RX, pin 4 = TX), 115200.
EOF
}

# ORIN-SELFUP payload builder — the SCAFFOLDING-SIDE half of the self-update transport seam.
# Packs a staged ESP tree (default: the esp-jetson output at $ESP_DIR_ARM) into the UPK1 container
# the kernel's `arch/aarch64/selfup_tegra.rs` parses, plus its detached digest:
#     UPDATE.PAK   magic "UNAOSUP1" | u32 LE count | u32 LE header_len |
#                  per entry: u16 LE path_len, path, u32 LE size, 32-byte sha256 | data packed in order
#     UPDATE.SHA   sha256 hex of UPDATE.PAK (sha256sum line shape — hash first)
# MATCHED-PAIR RULE (BOOTABI) enforced at BUILD time too: refuses a tree missing EFI/BOOT/BOOTAA64.EFI
# or kernel.elf, so a bad payload is caught on the host, not on the bench. Dotfiles/AppleDouble junk
# are skipped with a warning (the kernel would refuse their non-8.3 names anyway). Usage:
#     ./arroyo selfup-pak [src_esp_dir] [out_dir]     # defaults: $ESP_DIR_ARM, its parent (target/)
# Stage the two outputs into the BOOT VOLUME ROOT of a running Orin (bench card loop today; a network
# transport later delivers the same two names) and boot a `UNAOS_SELFUP=1` image to apply.
#
# PAYLOAD COMPOSITION (2026-08-26, boot7i): THE PAYLOAD IS THE MATCHED PAIR, NOT THE WHOLE TREE.
# boot7i staged a whole-tree pak — 10 entries, 14282148 bytes, of which SRC.TGZ alone was 11523546
# (80.7%) — and the flight LOOPED: `orinwdt`'s 300 s POR watchdog (wdt_tegra.rs TIMEOUT_SECS, armed
# in `tegra_early_stop` and disarmed only at the EL1 terminus, which is AFTER `selfup_service`) fired
# mid-SRC.TGZ on every attempt, so the board POR-reset back into the same S0..S3 prefix forever
# (capture/line-acm0/orin.log:16302/17014-17032 then 17967/18677-18695, each followed by a fresh
# `Boot-mode : Coldboot`). Only the LOADER + KERNEL are the boot ABI; SRC.TGZ and the demo ELFs are
# media furniture that the media build (`esp-jetson`) already puts on a card, and re-shipping them
# through a self-update buys nothing and costs the watchdog window. The kernel side needs no change:
# `parse_header` requires exactly `count in 1..=MAX_ENTRIES` plus the pair — every other member is
# optional by construction (selfup_tegra.rs:392-402), so a 2-entry pak parses, stages and flips on an
# UNCHANGED receiver. Reversible: `UNAOS_SELFUP_WHOLE=1 ./arroyo selfup-pak` restores the whole-tree
# walk for a bench run that deliberately wants it.
selfup_pak() {
    local src="${1:-$ESP_DIR_ARM}"
    local out="${2:-$(dirname "$ESP_DIR_ARM")}"
    [ -d "$src" ] || { echo -e "${COLOR_RED}selfup-pak: source ESP dir not found: $src (run ./arroyo esp-jetson first)${COLOR_RESET}" >&2; return 1; }
    mkdir -p "$out"
    SELFUP_SRC="$src" SELFUP_OUT="$out" SELFUP_WHOLE="${UNAOS_SELFUP_WHOLE:-}" python3 - <<'PYPAK' || return 1
import hashlib, os, struct, sys

src = os.environ["SELFUP_SRC"]
out = os.environ["SELFUP_OUT"]
MAGIC = b"UNAOSUP1"
MAX_ENTRIES, MAX_PATH = 64, 128

def ok83(comp):
    base, dot, ext = comp.rpartition(".")
    if not dot:
        base, ext = comp, ""
    if not base or len(base) > 8 or len(ext) > 3 or "." in base:
        return False
    return all(c.isalnum() or c in "_-~" for c in base + ext)

entries = []
skipped = []
for root, dirs, files in os.walk(src):
    dirs.sort(); files.sort()
    for f in files:
        rel = os.path.relpath(os.path.join(root, f), src).replace(os.sep, "/")
        if rel.upper() in ("UPDATE.PAK", "UPDATE.SHA"):
            continue
        comps = rel.split("/")
        if any(c.startswith(".") or not ok83(c) for c in comps) or len(rel) > MAX_PATH:
            skipped.append(rel)
            continue
        entries.append(rel)
if skipped:
    print("selfup-pak: SKIPPED (non-8.3 / dotfile):", ", ".join(skipped), file=sys.stderr)
if not entries:
    sys.exit("selfup-pak: no packable files under " + src)
upper = {e.upper() for e in entries}
if "EFI/BOOT/BOOTAA64.EFI" not in upper or "KERNEL.ELF" not in upper:
    sys.exit("selfup-pak: MATCHED-PAIR RULE — the tree must carry BOTH EFI/BOOT/BOOTAA64.EFI and "
             "kernel.elf (whole ESP or nothing); refusing to build a partial payload")

# PAYLOAD COMPOSITION: the pair alone, unless UNAOS_SELFUP_WHOLE=1 asks for the whole tree. The
# gate above ran on the FULL walk on purpose — a source tree that never had a loader/kernel is
# still refused here, before the narrowing, so the build-time half of the matched-pair rule is
# unchanged. What the narrowing drops (SRC.TGZ, the demo ELFs, SRC.SHA) is media furniture that
# `esp-jetson` writes when the card is built; it is not boot ABI and must not ride the watchdog
# window. See the comment above the function for the boot7i evidence.
PAIR = ("EFI/BOOT/BOOTAA64.EFI", "KERNEL.ELF")
if os.environ.get("SELFUP_WHOLE"):
    print("selfup-pak: WHOLE-TREE payload (UNAOS_SELFUP_WHOLE=1) — every packable file rides along",
          file=sys.stderr)
else:
    dropped = [e for e in entries if e.upper() not in PAIR]
    entries = [e for e in entries if e.upper() in PAIR]
    if dropped:
        drop_bytes = sum(os.path.getsize(os.path.join(src, d.replace("/", os.sep))) for d in dropped)
        print("selfup-pak: MATCHED PAIR ONLY — dropped %d non-pair file(s), %d bytes (%s). "
              "UNAOS_SELFUP_WHOLE=1 packs the whole tree."
              % (len(dropped), drop_bytes, ", ".join(dropped)), file=sys.stderr)
# The entry-count bound is a bound on the CONTAINER, so it is checked on what actually gets packed
# (it used to run on the raw walk, which would have refused a >64-file staging tree even when the
# pair-only payload it produces is two entries).
if len(entries) > MAX_ENTRIES:
    sys.exit(f"selfup-pak: {len(entries)} files exceeds the kernel's {MAX_ENTRIES}-entry bound")

table = b""
blobs = []
for rel in entries:
    data = open(os.path.join(src, rel.replace("/", os.sep)), "rb").read()
    if len(data) >= 2**32:
        sys.exit("selfup-pak: " + rel + " exceeds the u32 size field")
    pb = rel.encode()
    table += struct.pack("<H", len(pb)) + pb + struct.pack("<I", len(data)) + hashlib.sha256(data).digest()
    blobs.append(data)
header = MAGIC + struct.pack("<II", len(entries), 16 + len(table)) + table
pak = header + b"".join(blobs)
pak_path = os.path.join(out, "UPDATE.PAK")
open(pak_path, "wb").write(pak)
digest = hashlib.sha256(pak).hexdigest()
open(os.path.join(out, "UPDATE.SHA"), "w").write(digest + "  UPDATE.PAK\n")
print(f"selfup-pak: {len(entries)} files, {len(pak)} bytes -> {pak_path}")
print(f"selfup-pak: sha256 {digest} -> UPDATE.SHA")
PYPAK
    echo -e "${COLOR_GREEN}✅ self-update payload: ${out}/UPDATE.PAK + UPDATE.SHA — stage BOTH into the boot volume root, then boot a UNAOS_SELFUP=1 image${COLOR_RESET}"
}

# Bare-metal Raspberry Pi 4: build a flat kernel8.img the GPU ROM loads directly from the microSD
# SLOT (no UEFI/EDK2 — the native Pi boot path), stage the Pi firmware blobs + config.txt around it,
# and build a flashable .img for Raspberry Pi Imager. Links non-PIE at 0x80000 (aarch64-base.json,
# relocation-model=static) with pi-baremetal.ld, then objcopy to a raw binary.
KERNEL8_DIR="${WORKSPACE_DIR}/target/pi_baremetal"
# SOURCE-ALONG: every pi4 image carries the exact source tree that built it. make-pi-img.sh writes
# SRC.TGZ (deterministic gzip'd tar of the repo — no target/, no .git/, nothing .gitignore'd) and
# SRC.SHA (one `sha256sum -c`-checkable line) into the FAT32 root next to kernel8.img, so a running
# system — and the ledger — can always answer "what code is this". Same tree in => same bytes out
# (tree-object based, pinned mtime, gzip -n); see make-pi-img.sh's SOURCE-ALONG block for the
# determinism argument and docs/dev/OS/01_BOOT_HAL/arch_arm64.md §SOURCE-ALONG for the contract.
#
# DEFAULT ON, for `kernel8` AND `kernel8-test` alike — the self-hosting intent is that there is no
# such thing as a UnaOS pi4 image without its source, and a test image that differs from a flashed
# image in its FAT contents is exactly the kind of drift this arc exists to remove. Measured cost on
# this tree: +1.3 s wall (1.83 s vs 0.49 s, readback included) and 5.24 MiB from a 19 MiB working
# tree, i.e. well under the 5 s/cycle bar that
# would have justified making it opt-in for tests. UNAOS_NOSRC=1 skips it if a cycle ever needs to.
# The 56 MiB FAT (64 MiB image less the 8 MiB unafs tail) holds the ~6 MiB boot set + SRC.TGZ with
# room to spare, so the 64 MiB size_mb below is UNCHANGED by this arc; make-pi-img.sh hard-fails
# with a "GROW the size_mb argument" message rather than letting mcopy/ditto truncate, so that
# headroom is checked at every build, not assumed.
# PIUSB-16: the Pi GPU firmware blobs we stage (start4.elf/fixup4.dat), the base DTB, and the
# miniuart-bt overlay come from the OFFICIAL raspberrypi/firmware repo at a pinned stable tag — NOT
# scavenged from a stale third-party UEFI bundle. The prior source (pftf/RPi4 UEFI v1.52, ~2023) is a
# UEFI-oriented bundle whose old start4.elf did not run the stock power-on VL805/PCIe init this board's
# updated bootloader (2026-05-17) expects — the VideoCore handed our kernel a PCIe RC left in reset
# (RGR1_SW_INIT_1=0x3, PCIE_STATUS=0x0). FW_TAG matches the bootloader era so the VC does its normal
# init + VL805 firmware push before handoff. Blobs are redistributable in binary form under
# boot/LICENCE.broadcom (the same terms under which RPi OS ships them). "latest stable, always."
FW_TAG="1.20260521"
FW_CACHE="${WORKSPACE_DIR}/target/pi-firmware-${FW_TAG}"
FW_RAW="https://raw.githubusercontent.com/raspberrypi/firmware/${FW_TAG}/boot"

# BUILD-2 (concurrency safety): the whole kernel8() build stages into SHARED trees —
# crates/user-blob/target, ${WORKSPACE_DIR}/target/*.bin, KERNEL8_DIR (wiped at entry) — and then
# calls make-pi-img.sh on the ONE shared UnaOS-pi4-baremetal.img. Two concurrent `arroyo kernel8`
# (or kernel8-test) runs in the same worktree race there: one run wipes/relinks a file the other's
# objcopy is reading ("llvm-objcopy: No such file or directory") and both hit the make-pi-img
# hdiutil/partitionDisk race. So the build critical section is serialized on a coarse lock, released
# the moment the build finishes (BEFORE any QEMU phase — QEMU runs already use per-run ports/logs and
# may overlap). make-pi-img.sh keeps its own finer lock too (defense in depth; instant when we hold
# this one). Mechanism mirrors make-pi-img: mkdir-atomic lock, PID file, stale-break on dead holder
# or age > K8_LOCK_STALE_SECS, bounded wait with dots. Env: UNAOS_K8_LOCK_WAIT_SECS / _STALE_SECS.
K8_LOCKDIR="${WORKSPACE_DIR}/target/kernel8-build.lock"
K8_LOCK_HELD=""
k8_lock_release() {
    [ -n "$K8_LOCK_HELD" ] && rm -rf "$K8_LOCKDIR" 2>/dev/null || true
    K8_LOCK_HELD=""
}
k8_lock_acquire() {
    local wait_secs="${UNAOS_K8_LOCK_WAIT_SECS:-1800}"
    local stale_secs="${UNAOS_K8_LOCK_STALE_SECS:-1200}"
    local waited=0 dotted=0 holder mtime now age
    mkdir -p "${WORKSPACE_DIR}/target"
    while ! mkdir "$K8_LOCKDIR" 2>/dev/null; do
        holder=$(cat "$K8_LOCKDIR/pid" 2>/dev/null || echo "")
        # BSD stat first, GNU stat second — the `|| echo 0` fallback alone would make every
        # contended wait on Linux read age=huge and false-reclaim a live holder's lock
        mtime=$(stat -f %m "$K8_LOCKDIR" 2>/dev/null || stat -c %Y "$K8_LOCKDIR" 2>/dev/null || echo 0)
        now=$(date +%s); age=$(( now - mtime ))
        if [ -n "$holder" ] && ! kill -0 "$holder" 2>/dev/null; then
            echo -e "${COLOR_YELLOW}kernel8: stale build lock reclaimed — holder PID $holder dead (age ${age}s)${COLOR_RESET}" >&2
            rm -rf "$K8_LOCKDIR" 2>/dev/null || true; continue
        fi
        if [ "$age" -gt "$stale_secs" ]; then
            echo -e "${COLOR_YELLOW}kernel8: stale build lock reclaimed — age ${age}s > ${stale_secs}s (holder PID ${holder:-unknown})${COLOR_RESET}" >&2
            rm -rf "$K8_LOCKDIR" 2>/dev/null || true; continue
        fi
        if [ "$waited" -ge "$wait_secs" ]; then
            echo "" >&2
            echo -e "${COLOR_RED}kernel8: timed out after ${waited}s waiting for build lock held by PID ${holder:-unknown} ($K8_LOCKDIR)${COLOR_RESET}" >&2
            exit 1
        fi
        [ "$dotted" -eq 0 ] && { printf 'kernel8: waiting for concurrent build lock (PID %s) ' "${holder:-unknown}" >&2; dotted=1; }
        printf '.' >&2
        sleep 3; waited=$(( waited + 3 ))
    done
    [ "$dotted" -eq 1 ] && echo "" >&2
    echo $$ > "$K8_LOCKDIR/pid"
    K8_LOCK_HELD=1
    trap 'k8_lock_release' EXIT INT TERM
}

# VUGSTAGE (PARITY §6.6b): one aarch64 image of crates/user-vug, named by $1 (the target/ basename) and
# built with the cargo features in $2 — the exact twin of build_one_vug_x86 (~line 1068), which has emitted
# three images since VUGSCENE while this arch emitted one. Same crate, same app logic, same linker-script
# SHAPE; only the per-arch syscall stubs and the target differ.
#
# UVUG-1's original prose, kept because it is still what the program DOES: it maps an off-screen surface
# (SYS_FB_MAP), spawns 2 EL0 worker threads (SYS_THREAD_SPAWN) that render halves of the scene under a FUTEX
# frame barrier, presents each frame (SYS_FB_PRESENT), then joins both (SYS_THREAD_JOIN) and prints its
# `:: UVUG: … ::` witness before exiting 0. Kept AS AN ELF (strip-all preserves the ELF header + program
# headers + the two PT_LOAD segments) for the kernel's aarch64 loader to validate and map with per-segment
# permissions. Linker script user-vug.ld (PHDRS: a R+X text segment + a R+W data segment);
# `-z max-page-size=0x1000` packs the segments on 4 KiB boundaries so the image fits the 16 KiB slot window.
#
# `--target-dir` keeps the three cargo builds apart, for the reason build_one_vug_x86 states: the feature set
# is part of the fingerprint, so a shared directory would rebuild (and relink) the whole crate on every call,
# and a stale artifact could be picked up by the objcopy of the NEXT image if a build ever failed after the
# first. The bare-aarch64 target comes from the crate's own .cargo/config.toml (build.target =
# aarch64-base.json), so — unlike the x86 twin, which must override it — no `--target` is passed here; the
# artifact lands under `<target-dir>/aarch64-base/release/`.
build_one_vug_aarch64() {
    local out="$1" feats="$2"
    local TOOLBIN; TOOLBIN="$(rustc +nightly --print sysroot)/lib/rustlib/$(rustc +nightly -vV | awk '/host/{print $2}')/bin"
    echo -e "${COLOR_YELLOW}⚡ Building EL0 mini-vug static-ELF program (crates/user-vug${feats:+ [$feats]} → target/${out})...${COLOR_RESET}"
    mkdir -p "${WORKSPACE_DIR}/target"
    cd "$WORKSPACE_DIR/crates/user-vug"
    local tdir="${WORKSPACE_DIR}/crates/user-vug/target/arm${feats:+-$feats}"
    RUSTFLAGS="-C link-arg=-T${WORKSPACE_DIR}/crates/user-vug/user-vug.ld -C link-arg=-z -C link-arg=max-page-size=0x1000" \
      cargo +nightly build --release -Z json-target-spec --target-dir "$tdir" ${feats:+--features "$feats"}
    cd "$WORKSPACE_DIR"
    "$TOOLBIN/llvm-objcopy" --strip-all \
      "${tdir}/aarch64-base/release/user-vug" \
      "${WORKSPACE_DIR}/target/${out}"
    # It must exist, begin with the ELF magic (\x7fELF), and fit the slot window (USER_REGION_SIZE = 16 KiB;
    # a larger image is BadSize at load). A wrong magic or oversize image is a build failure caught here.
    [ -s "${WORKSPACE_DIR}/target/${out}" ] || { echo -e "${COLOR_RED}ERROR: ${out} missing/empty — UVUG build failed${COLOR_RESET}"; exit 1; }
    local umag; umag="$(head -c 4 "${WORKSPACE_DIR}/target/${out}" | od -An -tx1 | tr -d ' \n')"
    [ "$umag" = "7f454c46" ] || { echo -e "${COLOR_RED}ERROR: ${out} does not start with the ELF magic; first 4 bytes = ${umag}${COLOR_RESET}"; exit 1; }
    # The e_machine check the x86 twin carries, in its aarch64 form: EM_AARCH64 = 183 = 0x00b7, little-endian
    # b7 00 at offset 18. Staging an x86 image on Pi media would otherwise be a confusing bench failure
    # (loader refusal at spawn) rather than an obvious build failure here — and with two arches' images
    # sharing one target/ directory, a mixed-up basename is exactly the mistake that can happen.
    local umach; umach="$(od -An -tx1 -j18 -N2 "${WORKSPACE_DIR}/target/${out}" | tr -d ' \n')"
    [ "$umach" = "b700" ] || { echo -e "${COLOR_RED}ERROR: ${out} e_machine is ${umach}, want b700 (EM_AARCH64=183 LE)${COLOR_RESET}"; exit 1; }
    local usz; usz="$(wc -c < "${WORKSPACE_DIR}/target/${out}" | tr -d ' ')"
    [ "$usz" -le 16384 ] || { echo -e "${COLOR_RED}ERROR: ${out} ${usz} bytes > USER_REGION_SIZE (16384)${COLOR_RESET}"; exit 1; }
    echo -e "${COLOR_GREEN}✅ static-ELF EL0 mini-vug program: ${out} (${usz} B)${COLOR_RESET}"
}

# VUGSTAGE: the aarch64 pin table, identical to build_user_vug_x86's — three images out of one source, per
# the LOD_PIN note in crates/user-vug/Cargo.toml:
#
#   VUG.ELF   (no features)  the ADAPTIVE detail ladder. The default; what `vug`/Quarry launch.
#   VUGC.ELF  (pinlo)        level 0 forever — the CLASSIC wireframe, the A/B baseline that keeps old fps
#                            numbers comparable across the renderer change.
#   VUGX.ELF  (pinhi)        LOD_MAX forever — the full per-pixel shard, for measuring the heaviest frame
#                            this draws on the BCM2711 rather than inferring it from the ladder's choice.
#
# `bg`/`run` take a path and no argv on either arch (shell.rs: `match args.first()`), so a build feature is
# the only channel a pin can travel down — hence three link products rather than one flag. All three names
# are 8.3-clean and land in the FAT root beside STAT.ELF/PULSE.ELF, so each gets its own IMAGE_SHA256
# principal and both reach paths work on them unchanged: Quarry's double-click (`.ELF` is launchable — see
# video/quarry/live.rs) and `bg /fat/VUGX.ELF` at the shell.
#
# The aarch64 names carry no `-ARM` suffix (the x86 ones carry `-X86`) because the aarch64 build IS the
# staged name: the x86 side stages target/VUG*-X86.ELF *as* VUG*.ELF via builder/make-fat-img, while kernel8
# copies target/VUG*.ELF into the Pi staging dir verbatim.
build_user_vug_aarch64() {
    build_one_vug_aarch64 VUG.ELF  ""
    build_one_vug_aarch64 VUGC.ELF "pinlo"
    build_one_vug_aarch64 VUGX.ELF "pinhi"
}

# JETSON-EL0 (M1b): this function was LIFTED VERBATIM out of `kernel8()` so a second caller can reach it.
# It had exactly one caller (the Pi `kernel8` path), and the `tegra_el0` jetson image needs the same
# artifact for the same reason: `syscall.rs` `include_bytes!`es `target/user_blob.bin`, so the file must
# exist BEFORE the kernel build or the armed build fails outright (`couldn't read .../user_blob.bin`) —
# which is precisely what a first armed `esp-jetson` did in a tree that had never run `kernel8`. An
# in-tree build that happens to have a stale blob lying around from an earlier Pi build masks this, so the
# dependency is wired here rather than left to luck. (`TOOLBIN` used to be the caller's to set; the merged
# form declares its own `local TOOLBIN` below, so both callers — and `check_both` — are covered.)
#
# M6c: build the EL0 user program as a SEPARATE link product (out of the kernel's .text) and
# objcopy it to a flat binary the kernel include_bytes!s (crates/kernel/src/arch/aarch64/
# syscall.rs). Built for the SAME bare aarch64 target as the kernel, with its own tiny linker
# script (crates/user-blob/user-blob.ld); the routine is position-independent (byte-granular `adr`
# + an inline message), so it runs wherever the kernel copies it. This MUST run BEFORE the kernel
# build: include_bytes! needs target/user_blob.bin to exist, and its (always-fresh) mtime is what
# drives the kernel's rebuild when the routine changes. (build-std/target come from the crate's
# own .cargo/config.toml; it is its own workspace, so no cargo invocation in this script builds the
# crate as a side effect — it is built only where this function is called.)
#
# TOOLFIX/BLOB — WHY THIS IS A FUNCTION AND NOT AN INLINE BLOCK OF kernel8(). The comment that used
# to sit here said "`./arroyo check`/`build` never touch it — the blob is validated only here at
# kernel8-build time, not at `check`", and crates/kernel/src/arch/aarch64/syscall.rs says the same
# ("`./arroyo check`/`build` — which do not build the blob — never need the file to exist"). BOTH
# ARE FALSE, and the falsifier is in this script: `arch/aarch64/syscall.rs` is
# `#[cfg(feature = "baremetal")]`, and KERNEL_CFG_MATRIX's `arm-pi` leg enables `baremetal`. So
# `./arroyo check` compiles the module — and therefore its `include_bytes!` — while nothing on the
# check path produces the file. On a tree whose `unaos/target/` is empty (a fresh clone, a fresh
# worktree, or anything after `./arroyo clean`, which runs `cargo clean` and wipes it) the gate goes
# red on a MISSING BUILD ARTIFACT rather than on any source defect:
#     error: couldn't read `.../crates/kernel/../../target/user_blob.bin`: No such file or directory
#     ❌ arm-pi — unaos-kernel FAILED to compile
# `check_both` now calls this function when the artifact is absent, so `check` produces its own
# input and is self-contained again. It stays a no-op on a warm tree (the guard is existence-only,
# never a rebuild), so the artifact's mtime — which IS the kernel's rebuild trigger — is untouched
# by `check` and only ever moved by the kernel8 path that genuinely rebuilds the routine.
build_user_blob() {
    # M6c: build the EL0 user program as a SEPARATE link product (out of the kernel's .text) and
    # objcopy it to a flat binary the kernel include_bytes!s (crates/kernel/src/arch/aarch64/
    # syscall.rs). Built for the SAME bare aarch64 target as the kernel, with its own tiny linker
    # script (crates/user-blob/user-blob.ld); the routine is position-independent (byte-granular `adr`
    # + an inline message), so it runs wherever the kernel copies it. This MUST run BEFORE the kernel
    # build: include_bytes! needs target/user_blob.bin to exist, and its (always-fresh) mtime is what
    # drives the kernel's rebuild when the routine changes. (build-std/target come from the crate's
    # own .cargo/config.toml; it is its own workspace. Since TEGRAEL0LEG, `./arroyo check` DOES
    # build the blob once per fresh tree (`ensure_user_blob`) and armed aarch64 runnable images
    # rebuild it unconditionally (BLOBATOMIC); validation runs here, on every build, pre-landing.)
    local TOOLBIN; TOOLBIN="$(rustc +nightly --print sysroot)/lib/rustlib/$(rustc +nightly -vV | awk '/host/{print $2}')/bin"
    echo -e "${COLOR_YELLOW}⚡ Building EL0 user blob (crates/user-blob → target/user_blob.bin)...${COLOR_RESET}"
    mkdir -p "${WORKSPACE_DIR}/target"
    cd "$WORKSPACE_DIR/crates/user-blob"
    RUSTFLAGS="-C link-arg=-T${WORKSPACE_DIR}/crates/user-blob/user-blob.ld" \
      cargo +nightly build --release -Z json-target-spec
    cd "$WORKSPACE_DIR"
    # BLOBATOMIC (2026-08-21, peer-ruled): objcopy to a temp name and validate BEFORE the artifact
    # lands, then mv (atomic on one filesystem) — an interrupted build can no longer leave a
    # truncated-but-nonempty user_blob.bin that `ensure_user_blob`'s -s test would accept forever.
    "$TOOLBIN/llvm-objcopy" -O binary --only-section=.text \
      "${WORKSPACE_DIR}/crates/user-blob/target/aarch64-base/release/user-blob" \
      "${WORKSPACE_DIR}/target/user_blob.bin.tmp"
    # The flat blob must exist and begin EXACTLY at _start's first instruction — the kernel enters the
    # copy at offset 0, so a stray byte ahead of _start (a future toolchain reordering objcopy output)
    # would be a metal-only wrong-entry fault QEMU wouldn't reliably catch. _start = `mov x8, #1` =
    # 0xD2800028 = little-endian bytes 28 00 80 d2. Assert both — on the temp, before it can land.
    [ -s "${WORKSPACE_DIR}/target/user_blob.bin.tmp" ] || { echo -e "${COLOR_RED}ERROR: user_blob.bin missing/empty — blob build failed${COLOR_RESET}"; exit 1; }
    local head4; head4="$(head -c 4 "${WORKSPACE_DIR}/target/user_blob.bin.tmp" | od -An -tx1 | tr -d ' \n')"
    if [ "$head4" != "280080d2" ]; then
        echo -e "${COLOR_RED}ERROR: user_blob.bin does not start with _start (mov x8,#1); first 4 bytes = ${head4}${COLOR_RESET}"
        exit 1
    fi
    mv -f "${WORKSPACE_DIR}/target/user_blob.bin.tmp" "${WORKSPACE_DIR}/target/user_blob.bin"
    echo -e "${COLOR_GREEN}✅ EL0 user blob: $(wc -c < "${WORKSPACE_DIR}/target/user_blob.bin" | tr -d ' ') bytes${COLOR_RESET}"
}

# JETSON-EL0IMG: the FIVE static-ELF64 EL0 programs, LIFTED VERBATIM out of `kernel8()` so a second
# caller can reach them — the same move (and the same reason) as `build_user_blob` above. They had
# exactly one caller, the Pi `kernel8` path, and the jetson boot volume needs the identical artifacts:
# `esp-jetson` staged only BOOTAA64.EFI + kernel.elf, so an Orin that boots to the panel shell had a
# readable FAT volume with NO programs on it to `ls` or exec, while the Pi card carried all five.
#
# WHAT IS AND IS NOT LIFTED. Only the static-ELF family moves (ELFHELLO / VUG / VUGK / STAT / PULSE).
# The FLAT blobs (`user_blob.bin` -> HELLO.BIN, plus K2OWN/K2IMP/MIDDEN) stay inline in `kernel8()`
# because they are produced by the ONE cargo build in `crates/user-blob`, whose `user_blob.bin` output
# the kernel `include_bytes!`es — see `build_user_blob`'s note on why refreshing that file's mtime is a
# cost the disarmed jetson path must not pay. The five crates here are the opposite case: each is its
# OWN cargo workspace with its own target dir, nothing in the kernel reads their output, and therefore
# building them CANNOT change kernel.elf. That asymmetry is exactly why this function is safe to call
# unconditionally from `esp_jetson` while `build_user_blob` stays behind the `tegra_el0` gate.
#
# Requires `TOOLBIN` to be set by the caller (both callers compute it the same way).
build_user_el0_elf_images() {
    # ELF-1: build the minimal static ELF64 EL0 program (crates/user-elf) and — UNLIKE the flat blobs above
    # — KEEP it as an ELF (strip-all removes section headers/symbols but preserves the ELF header + program
    # headers + the two PT_LOAD segments). Its own workspace + linker script (user-elf.ld's PHDRS clause
    # declares a R+X text segment and a R+W data segment); `-z max-page-size=0x1000` packs the segments on
    # 4 KiB boundaries so the whole image fits the kernel's 16 KiB slot-window read cap. The kernel's aarch64
    # loader (load_program_into_slot -> validate_elf) reads this back off the SD as ELFHELLO.ELF, validates
    # the ident/type/machine, walks the PT_LOAD headers, and maps each segment with per-segment permissions.
    echo -e "${COLOR_YELLOW}⚡ Building EL0 static-ELF program (crates/user-elf → target/ELFHELLO.ELF)...${COLOR_RESET}"
    cd "$WORKSPACE_DIR/crates/user-elf"
    RUSTFLAGS="-C link-arg=-T${WORKSPACE_DIR}/crates/user-elf/user-elf.ld -C link-arg=-z -C link-arg=max-page-size=0x1000" \
      cargo +nightly build --release -Z json-target-spec
    cd "$WORKSPACE_DIR"
    mkdir -p "${WORKSPACE_DIR}/target"   # a fresh worktree has no target/ yet — two executors hit this 2026-08-25
    "$TOOLBIN/llvm-objcopy" --strip-all \
      "${WORKSPACE_DIR}/crates/user-elf/target/aarch64-base/release/user-elf" \
      "${WORKSPACE_DIR}/target/ELFHELLO.ELF"
    # It must exist, begin with the ELF magic (\x7fELF), and fit the slot window (USER_REGION_SIZE = 16 KiB;
    # a larger image is BadSize at load). A wrong magic or oversize image is a build failure caught here.
    [ -s "${WORKSPACE_DIR}/target/ELFHELLO.ELF" ] || { echo -e "${COLOR_RED}ERROR: ELFHELLO.ELF missing/empty — ELF build failed${COLOR_RESET}"; exit 1; }
    emag="$(head -c 4 "${WORKSPACE_DIR}/target/ELFHELLO.ELF" | od -An -tx1 | tr -d ' \n')"
    [ "$emag" = "7f454c46" ] || { echo -e "${COLOR_RED}ERROR: ELFHELLO.ELF does not start with the ELF magic; first 4 bytes = ${emag}${COLOR_RESET}"; exit 1; }
    esz="$(wc -c < "${WORKSPACE_DIR}/target/ELFHELLO.ELF" | tr -d ' ')"
    [ "$esz" -le 16384 ] || { echo -e "${COLOR_RED}ERROR: ELFHELLO.ELF ${esz} bytes > USER_REGION_SIZE (16384)${COLOR_RESET}"; exit 1; }
    echo -e "${COLOR_GREEN}✅ static-ELF EL0 program: ELFHELLO.ELF (${esz} B)${COLOR_RESET}"

    # UVUG-1 / VUGSTAGE: build the THREE static-ELF64 EL0 mini-vug images (crates/user-vug). See
    # build_one_vug_aarch64 above for the per-image shape and build_user_vug_aarch64 for the pin table.
    build_user_vug_aarch64

    # KVUG: the SAME source, linked a second time with the `kvug` cargo feature, as target/VUGK.ELF — the
    # aarch64 twin of build_one_vug_x86's VUGK-X86.ELF. Peter's ruling: the in-kernel vug
    # (crates/kernel/src/vug.rs) lives on this branch only and its CONTENT belongs in VUG.ELF — "for those
    # with super extremely slow machines / for history". VUGK.ELF is that content: `m` cycles the kernel's
    # three screens — the classic wireframe (`Mode::Wire`), the painter's-algorithm faceted crystal
    # (`Mode::Solid`), and the BeBox tribute (`run_bebox_mode`).
    #
    # WHY A FOURTH IMAGE RATHER THAN A FOURTH MODE OF VUG.ELF. `.text` is capped at 0x2000 by a page cliff
    # (the SIZE note in crates/user-vug/src/main.rs): one byte past it and `.bss` moves a page, the file
    # jumps 4096 bytes in one step, and the 16 KiB check below rejects it — AND `.bss` would land on
    # base+0x3000, which is worker A's stack. The kernel renderer costs 2143 bytes and the shipped images
    # have 461 (aarch64) / 169 (x86) free, so `kvug` also compiles OUT the shard raytracer it replaces.
    # That is what makes VUGK.ELF fit, and it is the right product besides: the shard is the expensive
    # renderer, the kernel's is the cheap one, and "slow machine" is the whole brief.
    #
    # The default images are untouched by construction — every hunk of this arc is `#[cfg(feature =
    # "kvug")]` — and `.text` was measured byte-identical (0x1e33 aarch64 / 0x1f57 x86) after the port.
    echo -e "${COLOR_YELLOW}⚡ Building EL0 KERNEL-VUG static-ELF program (crates/user-vug [kvug] → target/VUGK.ELF)...${COLOR_RESET}"
    cd "$WORKSPACE_DIR/crates/user-vug"
    RUSTFLAGS="-C link-arg=-T${WORKSPACE_DIR}/crates/user-vug/user-vug.ld -C link-arg=-z -C link-arg=max-page-size=0x1000" \
      cargo +nightly build --release -Z json-target-spec --features kvug \
      --target-dir "${WORKSPACE_DIR}/crates/user-vug/target/a64-kvug"
    cd "$WORKSPACE_DIR"
    "$TOOLBIN/llvm-objcopy" --strip-all \
      "${WORKSPACE_DIR}/crates/user-vug/target/a64-kvug/aarch64-base/release/user-vug" \
      "${WORKSPACE_DIR}/target/VUGK.ELF"
    # The same three checks VUG.ELF takes, on the image the loader will actually read.
    [ -s "${WORKSPACE_DIR}/target/VUGK.ELF" ] || { echo -e "${COLOR_RED}ERROR: VUGK.ELF missing/empty — KVUG build failed${COLOR_RESET}"; exit 1; }
    kmag="$(head -c 4 "${WORKSPACE_DIR}/target/VUGK.ELF" | od -An -tx1 | tr -d ' \n')"
    [ "$kmag" = "7f454c46" ] || { echo -e "${COLOR_RED}ERROR: VUGK.ELF does not start with the ELF magic; first 4 bytes = ${kmag}${COLOR_RESET}"; exit 1; }
    ksz="$(wc -c < "${WORKSPACE_DIR}/target/VUGK.ELF" | tr -d ' ')"
    [ "$ksz" -le 16384 ] || { echo -e "${COLOR_RED}ERROR: VUGK.ELF ${ksz} bytes > USER_REGION_SIZE (16384)${COLOR_RESET}"; exit 1; }
    echo -e "${COLOR_GREEN}✅ static-ELF EL0 kernel-vug program: VUGK.ELF (${ksz} B)${COLOR_RESET}"

    # BGRUN-2: build the static ELF64 EL0 PERSISTENCE program (crates/user-stat) exactly like UVUG/ELFHELLO
    # — keep it AS AN ELF (strip-all preserves the ELF header + program headers + the two PT_LOAD segments).
    # It creates one 128x128 compositor window (SYS_WIN_CREATE), repaints its own pid + a frame counter + a
    # sweep block, and NEVER exits on its own — `kill <pid>` is the whole remedy. That is what makes the
    # WC-TAB window ring operator-verifiable: a backgrounded UVUG is unfocused, stays on its deterministic
    # auto path and is gone in 300 frames, so two windows never coexisted long enough to TAB between them.
    # Same linker script shape as UVUG (crates/user-stat/user-stat.ld — two PT_LOAD segments via a PHDRS
    # clause); `-z max-page-size=0x1000` packs the segments on 4 KiB boundaries so the image fits the
    # kernel's 16 KiB slot window.
    echo -e "${COLOR_YELLOW}⚡ Building EL0 persistence static-ELF program (crates/user-stat → target/STAT.ELF)...${COLOR_RESET}"
    cd "$WORKSPACE_DIR/crates/user-stat"
    RUSTFLAGS="-C link-arg=-T${WORKSPACE_DIR}/crates/user-stat/user-stat.ld -C link-arg=-z -C link-arg=max-page-size=0x1000" \
      cargo +nightly build --release -Z json-target-spec
    cd "$WORKSPACE_DIR"
    "$TOOLBIN/llvm-objcopy" --strip-all \
      "${WORKSPACE_DIR}/crates/user-stat/target/aarch64-base/release/user-stat" \
      "${WORKSPACE_DIR}/target/STAT.ELF"
    # Same three checks as VUG: it must exist, begin with the ELF magic (\x7fELF), and fit the slot window
    # (USER_REGION_SIZE = 16 KiB; a larger image is BadSize at load).
    [ -s "${WORKSPACE_DIR}/target/STAT.ELF" ] || { echo -e "${COLOR_RED}ERROR: STAT.ELF missing/empty — STAT build failed${COLOR_RESET}"; exit 1; }
    smag="$(head -c 4 "${WORKSPACE_DIR}/target/STAT.ELF" | od -An -tx1 | tr -d ' \n')"
    [ "$smag" = "7f454c46" ] || { echo -e "${COLOR_RED}ERROR: STAT.ELF does not start with the ELF magic; first 4 bytes = ${smag}${COLOR_RESET}"; exit 1; }
    ssz="$(wc -c < "${WORKSPACE_DIR}/target/STAT.ELF" | tr -d ' ')"
    [ "$ssz" -le 16384 ] || { echo -e "${COLOR_RED}ERROR: STAT.ELF ${ssz} bytes > USER_REGION_SIZE (16384)${COLOR_RESET}"; exit 1; }
    echo -e "${COLOR_GREEN}✅ static-ELF EL0 persistence program: STAT.ELF (${ssz} B)${COLOR_RESET}"

    # PULSE-1: build the static ELF64 EL0 CPU-PULSE MONITOR (crates/user-pulse) exactly like STAT/UVUG. It
    # creates one 128x128 compositor window and draws one segmented pulse bar per core — the kernel `pulse`
    # verb's instrument as a ring-3 window — reading the per-core counters through SYS_CPUPULSE(49) and doing
    # its own windowed delta math. Same linker script shape (crates/user-pulse/user-pulse.ld — two PT_LOAD
    # segments via a PHDRS clause) and the same three assertions as STAT.
    #
    # It is built on aarch64 as well as x86 even though the x86 desktop is where it ships first: the crate is
    # arch-neutral above its two syscall stubs, and a build that links here is the standing proof that the
    # aarch64 half of the shared syscall number stays in agreement with the x86 half.
    echo -e "${COLOR_YELLOW}⚡ Building EL0 cpu-pulse static-ELF program (crates/user-pulse → target/PULSE.ELF)...${COLOR_RESET}"
    cd "$WORKSPACE_DIR/crates/user-pulse"
    RUSTFLAGS="-C link-arg=-T${WORKSPACE_DIR}/crates/user-pulse/user-pulse.ld -C link-arg=-z -C link-arg=max-page-size=0x1000" \
      cargo +nightly build --release -Z json-target-spec
    cd "$WORKSPACE_DIR"
    "$TOOLBIN/llvm-objcopy" --strip-all \
      "${WORKSPACE_DIR}/crates/user-pulse/target/aarch64-base/release/user-pulse" \
      "${WORKSPACE_DIR}/target/PULSE.ELF"
    [ -s "${WORKSPACE_DIR}/target/PULSE.ELF" ] || { echo -e "${COLOR_RED}ERROR: PULSE.ELF missing/empty — PULSE build failed${COLOR_RESET}"; exit 1; }
    pmag="$(head -c 4 "${WORKSPACE_DIR}/target/PULSE.ELF" | od -An -tx1 | tr -d ' \n')"
    [ "$pmag" = "7f454c46" ] || { echo -e "${COLOR_RED}ERROR: PULSE.ELF does not start with the ELF magic; first 4 bytes = ${pmag}${COLOR_RESET}"; exit 1; }
    psz="$(wc -c < "${WORKSPACE_DIR}/target/PULSE.ELF" | tr -d ' ')"
    [ "$psz" -le 16384 ] || { echo -e "${COLOR_RED}ERROR: PULSE.ELF ${psz} bytes > USER_REGION_SIZE (16384)${COLOR_RESET}"; exit 1; }
    echo -e "${COLOR_GREEN}✅ static-ELF EL0 cpu-pulse program: PULSE.ELF (${psz} B)${COLOR_RESET}"
}

kernel8() {
    k8_lock_acquire
    local TOOLBIN; TOOLBIN="$(rustc +nightly --print sysroot)/lib/rustlib/$(rustc +nightly -vV | awk '/host/{print $2}')/bin"

    # The hello blob, unconditionally (a kernel8 image must never carry a stale routine). The same
    # `cargo build --release` this runs also links the other [[bin]]s of the crate, which the K2 and
    # midden objcopies below consume — so it must stay ahead of them.
    build_user_blob

    # K2 (make-enforcement-LIVE): the SAME `cargo build --release` above builds every [[bin]] in the
    # user-blob crate, so `owner-blob` + `imp-blob` are already linked (with user-blob.ld) alongside
    # `user-blob`. objcopy each to a flat binary the kernel8 staging carries onto the card as K2OWN.BIN /
    # K2IMP.BIN — two more distinct 8.3 names => two more distinct prog:<NAME> principals, the honest
    # precondition for by_name_spawn_multivalued(). Position-independent like the hello blob (entry first).
    for b in owner-blob imp-blob; do
        out="${WORKSPACE_DIR}/target/$(echo "$b" | tr - _).bin"
        "$TOOLBIN/llvm-objcopy" -O binary --only-section=.text \
          "${WORKSPACE_DIR}/crates/user-blob/target/aarch64-base/release/${b}" "$out"
        # A flat EL0 program must be non-empty and fit one code page (USER_CODE_SIZE = 0x1000); an empty
        # or oversize blob is a build failure the loader would reject at spawn (BadSize) — catch it here.
        [ -s "$out" ] || { echo -e "${COLOR_RED}ERROR: ${b}.bin missing/empty — K2 blob build failed${COLOR_RESET}"; exit 1; }
        sz="$(wc -c < "$out" | tr -d ' ')"
        [ "$sz" -le 4096 ] || { echo -e "${COLOR_RED}ERROR: ${b}.bin ${sz} bytes > USER_CODE_SIZE (4096)${COLOR_RESET}"; exit 1; }
        # Entry-first assertion (the hello-blob discipline): the kernel enters the flat image at offset 0, so a
        # toolchain reorder putting a non-entry byte first is a metal-only wrong-entry fault QEMU won't catch.
        # Both K2 blobs' _start begins `mov x23, xzr` = 0xAA1F03F7 = little-endian bytes f7 03 1f aa. Assert it.
        head4="$(head -c 4 "$out" | od -An -tx1 | tr -d ' \n')"
        [ "$head4" = "f7031faa" ] || { echo -e "${COLOR_RED}ERROR: ${b}.bin does not start with _start (mov x23,xzr); first 4 bytes = ${head4}${COLOR_RESET}"; exit 1; }
    done
    echo -e "${COLOR_GREEN}✅ K2 EL0 programs: owner_blob.bin ($(wc -c < "${WORKSPACE_DIR}/target/owner_blob.bin" | tr -d ' ') B) + imp_blob.bin ($(wc -c < "${WORKSPACE_DIR}/target/imp_blob.bin" | tr -d ' ') B)${COLOR_RESET}"

    # BANDY-1 M4 (midden — program #3): same build lane as the K2 blobs; objcopy the `midden-blob`
    # [[bin]] to a flat binary staged as MIDDEN.BIN. Its _start is a single `b midden_main` hop
    # (byte 3 of a small-forward `b` is 0x14) — assert entry-first like the other blobs.
    "$TOOLBIN/llvm-objcopy" -O binary --only-section=.text \
      "${WORKSPACE_DIR}/crates/user-blob/target/aarch64-base/release/midden-blob" \
      "${WORKSPACE_DIR}/target/midden_blob.bin"
    [ -s "${WORKSPACE_DIR}/target/midden_blob.bin" ] || { echo -e "${COLOR_RED}ERROR: midden_blob.bin missing/empty — midden build failed${COLOR_RESET}"; exit 1; }
    msz="$(wc -c < "${WORKSPACE_DIR}/target/midden_blob.bin" | tr -d ' ')"
    [ "$msz" -le 4096 ] || { echo -e "${COLOR_RED}ERROR: midden_blob.bin ${msz} bytes > USER_CODE_SIZE (4096)${COLOR_RESET}"; exit 1; }
    mb4="$(head -c 4 "${WORKSPACE_DIR}/target/midden_blob.bin" | od -An -tx1 | tr -d ' \n')"
    case "$mb4" in
        ??????14) : ;;
        *) echo -e "${COLOR_RED}ERROR: midden_blob.bin does not start with _start's 'b' hop; first 4 bytes = ${mb4}${COLOR_RESET}"; exit 1 ;;
    esac
    echo -e "${COLOR_GREEN}✅ midden EL0 program: midden_blob.bin (${msz} B)${COLOR_RESET}"

    # JETSON-EL0IMG: the five static-ELF64 EL0 programs (ELFHELLO / VUG / VUGK / STAT / PULSE) used to
    # be built inline right here; they are now `build_user_el0_elf_images` (defined above `kernel8`), so
    # `esp_jetson` can build the identical artifacts for the Orin boot volume. Verbatim lift — same
    # order, same linker scripts, same magic/size assertions, same target/ output names.
    build_user_el0_elf_images

    # K2 metal money-shot: UNAOS_K2_LEAVE=1 adds the `k2_leave` feature — k2_liveenf becomes a two-boot
    # cross-reboot power-cycle proof (boot-1 leaves a persisted owned file; boot-2 verifies the live boot
    # rebuild). OFF => the normal same-boot battery (byte-identical). For the ATTENDED Pi bench only.
    local K8_FEATS="baremetal,skip_xhci"
    # DEFAULT-QUIET: `kernel8-test` (the battery) arms UNAOS_WITNESS so the Pi bare-metal image carries the
    # M6b..U7 fixture cascade (CAPSTONE + all -> PASS lines). The plain `kernel8` media build leaves it unset,
    # so the flashed image is quiet — reaches the shell with CAPSTONE + device honesty lines only.
    if [ -n "${UNAOS_WITNESS:-}" ]; then
        K8_FEATS="${K8_FEATS},witness"
        echo -e "${COLOR_YELLOW}  • UNAOS_WITNESS: kernel8 carries the M6b..U7 fixture battery (CAPSTONE + PASS lines)${COLOR_RESET}"
    fi
    # CLOCK-2: UNAOS_LOGTS=1 adds the `logts` feature — a compact timestamp prefix on each serial LINE
    # (monotonic ms → UTC after a civil anchor). K8_FEATS is CURATED (does not draw from the general
    # `_feats`), so the arm must be added here too or logts never reaches the Pi image. OFF => the
    # prefix path is not compiled and serial is byte-identical.
    if [ -n "${UNAOS_LOGTS:-}" ]; then
        K8_FEATS="${K8_FEATS},logts"
        echo -e "${COLOR_YELLOW}  • UNAOS_LOGTS: kernel8 serial lines carry a timestamp prefix (monotonic ms → UTC after sync)${COLOR_RESET}"
    fi
    if [ -n "${UNAOS_K2_LEAVE:-}" ]; then
        K8_FEATS="${K8_FEATS},k2_leave"
        echo -e "${COLOR_YELLOW}  • UNAOS_K2_LEAVE: k2_liveenf → two-boot money-shot mode (boot-1 leaves K2PRIV.BIN; power-cycle; boot-2 verifies)${COLOR_RESET}"
    fi
    # CORE3-PROBE: UNAOS_CORE3PROBE=1 adds the `core3probe` feature — the aarch64 secondary entry
    # stub raw-dumps each core's MPIDR/EL/x0 to the PL011 MMU-off before any Rust, to resolve the
    # CORE3-SMP >1 MiB core-3 regression on an attended bench. OFF => the stub is byte-identical.
    if [ -n "${UNAOS_CORE3PROBE:-}" ]; then
        K8_FEATS="${K8_FEATS},core3probe"
        echo -e "${COLOR_YELLOW}  • UNAOS_CORE3PROBE: secondary stub raw-dumps MPIDR/EL/x0 to PL011 (see scripts/core3-probe-bench.md)${COLOR_RESET}"
    fi
    # SMP-7: UNAOS_SMP7=1 adds the `smp7` feature — per-core secondary bring-up evidence (release-write
    # timestamp, check-in time + the MPIDR the AP derived for ITSELF, the bring-up stage it reached, any
    # re-release count) and one `[smp7] cores online=<mask> missed=<mask> …` verdict after bring-up
    # settles. Answers the P53 metal report ("only procs 2 & 4 running regularly") by separating "never
    # left the spin-table" from "arrived and died in its own bring-up". UNAOS_SMP7_RETRY=1 additionally
    # re-releases a NEVER-ARRIVED AP up to 3x (implies smp7). Both OFF => no [smp7] line and no retry;
    # note the arc's ALWAYS-ON part (pre-release DC CIVAC over SECONDARY_STACKS) ships either way, so
    # knob-off is byte-identical to the rest of SMP-7, not to the pre-arc image.
