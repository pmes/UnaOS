# --- Full battery: the one-command merge-window suite (seat runs this before every merge) ---
# Runs every gate serially, prints one ✅/❌ verdict line per step, exits nonzero on any failure.
# Verdicts come from the serial logs (read with awk — control bytes break plain grep).

# The ledgered test-fat one-line console drop (unaos-hazards; 4 battery re-run cycles on
# 2026-07-11 alone): under battery load the best-effort console intermittently drops ONE
# verdict line — always with ZERO explicit FAIL lines. On exactly that signature, re-run the
# FAT chain once in isolation and let the appended re-run's verdicts stand; a log carrying any
# real "-> FAIL"/"FAIL ::" line keeps its red (no retry). All output flows through _step's
# capture, so the pattern + FAIL scans below see the COMBINED log (the PASS-line tally in the
# summary inflates on a retry day — informational only, the retry announcement line explains).
test_fat_drop_retry() { # $1 = the logfile _step is capturing (READ here, written via stdout)
    if "$0" test-fat sf 300; then return 0; fi
    if ! awk 'BEGIN{f=0} /-> FAIL|FAIL ::/{f=1} END{exit f}' "$1"; then return 1; fi
    echo "battery: test-fat missed its verdict with ZERO FAIL lines — the ledgered console drop; ONE isolated re-run"
    UNAOS_FATIMG=sf "$0" test 200
}

battery() {
    local t0=$SECONDS rc=0 results=""
    local blog_dir="target/battery"; mkdir -p "$blog_dir"

    _step() { # name, expected-pattern (empty = rc only), logfile[:verdictfile], cmd...
        # kernel8-test doesn't echo its serial log to stdout, so a step may name a separate
        # verdict file (logfile:verdictfile) — patterns are checked there instead.
        local name="$1" pattern="$2" logf="${3%%:*}" vf="${3#*:}"; shift 3
        echo -e "${COLOR_CYAN}⚡ battery: ${name}${COLOR_RESET}"
        if "$@" > "$logf" 2>&1; then local crc=0; else local crc=$?; fi
        local ok=1
        [ "$crc" -ne 0 ] && ok=0
        if [ -n "$pattern" ]; then
            awk -v p="$pattern" 'BEGIN{f=1} $0 ~ p {f=0} END{exit f}' "$vf" || ok=0
        fi
        # Any explicit FAIL verdict line in a serial-backed step is a failure.
        awk 'BEGIN{f=0} /-> FAIL|FAIL ::/{f=1} END{exit f}' "$vf" || ok=0
        if [ "$ok" -eq 1 ]; then
            results="${results}  ✅ ${name}\n"
        else
            results="${results}  ❌ ${name}  (log: ${logf})\n"; rc=1
        fi
    }

    _step "check (both arches)"        ""                    "$blog_dir/check.log"        "$0" check
    _step "check (tegra)"              ""                    "$blog_dir/check-tegra.log"  env UNAOS_TEGRA=1 "$0" check
    _step "x86 test 25 (MISSION)"      "MISSION SUCCESS"     "$blog_dir/test-x86.log"     "$0" test 25
    _step "x86 test-fat sf 300"        "U11m2.*-> PASS"      "$blog_dir/test-fat.log"     test_fat_drop_retry "$blog_dir/test-fat.log"
    _step "arm virt v2 (MISSION)"      "MISSION SUCCESS"     "$blog_dir/test-arm-v2.log"  "$0" test-arm 22
    _step "arm virt v3 (CAPSTONE 6/6)" "CAPSTONE COMPLETE"   "$blog_dir/test-arm-v3.log"  env UNAOS_GICV3=1 "$0" test-arm 40
    _step "pi4 kernel8-test 35"        "CAPSTONE COMPLETE"   "$blog_dir/kernel8.log:target/serial-pi.log" "$0" kernel8-test 35
    _step "esp-jetson (links)"         ""                    "$blog_dir/esp-jetson.log"   env UNAOS_TEGRA=1 "$0" esp-jetson

    local passes; passes=$(awk '/-> PASS|: PASS/{n++} END{print n+0}' "$blog_dir/test-fat.log" target/serial-pi.log 2>/dev/null || echo '?')
    echo -e "\n${COLOR_PURPLE}════════════ BATTERY SUMMARY ($(( SECONDS - t0 ))s) ════════════${COLOR_RESET}"
    echo -e "$results"
    echo "  PASS lines (fat+pi): $passes   step logs: $blog_dir/"
    echo -e "  ${COLOR_CYAN}⚠ this run clobbered any x86 esp media — rebuild UNAOS_USBDEBUG=1 esp-x86 LAST before flashing${COLOR_RESET}"
    if [ "$rc" -eq 0 ]; then
        echo -e "${COLOR_GREEN}✅ FULL BATTERY GREEN${COLOR_RESET}"
    else
        echo -e "${COLOR_RED}❌ BATTERY FAILED — see step logs${COLOR_RESET}"
    fi
    return $rc
}

# --- Entry Point ---

case "${1:-}" in
    x86|x86_64)
        show_expectations_x86
        launch_x86_64
        ;;
    arm|aarch64)
        launch_aarch64
        ;;
    test|test-x86|test_x86)
        test_x86_64 "${2:-20}"
        ;;
    test-arm|test-aarch64)
        test_aarch64 "${2:-20}"
        ;;
    check)
        check_both
        ;;
    build)
        build_both
        ;;
    esp-x86|esp_x86)
        esp_x86
        ;;
    esp-arm|esp_arm)
        esp_arm
        ;;
    esp-jetson|esp_jetson|jetson)
        esp_jetson
        ;;
    fat-img|fat_img|fatimg)
        fat_img
        ;;
    test-fat|test_fat)
        test_fat "${2:-part}" "${3:-30}"
        ;;
    kernel8|baremetal)
        kernel8
        ;;
    kernel8-run|run-pi)
        run_kernel8
        ;;
    kernel8-test|test-pi)
        test_kernel8 "${2:-8}"
        ;;
    battery)
        battery
        ;;
    mbench)
        # Metal-bench harness passthrough: assert a serial capture (bridge log or
        # QEMU target/serial*.log) against a witness spec in scripts/specs/.
        # See scripts/mbench.py --help (replay / follow / self-test / inject).
        shift
        exec python3 "${WORKSPACE_DIR}/scripts/mbench.py" "$@"
        ;;
    clean)
        clean_all
        ;;
    "")
        while true; do
            show_menu
        done
        ;;
    *)
        echo -e "${COLOR_RED}Unknown command: $1${COLOR_RESET}"
        echo "Usage: ./arroyo [x86|arm|test [secs]|test-arm [secs]|check|build|esp-x86|esp-arm|esp-jetson|fat-img|test-fat [part|gpt|p16|sf] [secs]|kernel8|kernel8-run|kernel8-test [secs]|battery|clean]"
        exit 1
        ;;
esac
