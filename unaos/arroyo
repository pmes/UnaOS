#!/bin/bash
# ARROYO: The Stream that Feeds the River
# "Ad Astra Per Aspera"
#
# Usage:
#   ./arroyo              Interactive menu
#   ./arroyo x86           Build & boot x86_64 (GUI window + serial on stdio)
#   ./arroyo arm           Build & boot aarch64
#   ./arroyo test [secs]   Headless x86_64 run; serial captured to target/serial.log
#   ./arroyo test-arm [s]  Headless aarch64 run; serial -> target/serial-arm.log
#   ./arroyo check         Quick syntax check (both targets)
#   ./arroyo build         Build both targets (no QEMU)
#   ./arroyo clean         Purge all build artifacts

set -e

# --- Configuration ---
COLOR_RESET="\033[0m"
COLOR_PURPLE="\033[0;35m"
COLOR_CYAN="\033[0;36m"
COLOR_GREEN="\033[0;32m"
COLOR_YELLOW="\033[0;33m"
COLOR_RED="\033[0;31m"

WORKSPACE_DIR="$(cd "$(dirname "$0")" && pwd)"

# Build flags shared by both targets
NIGHTLY_FLAGS="-Z build-std=core,compiler_builtins,alloc -Z build-std-features=compiler-builtins-mem -Z json-target-spec"

# Optional kernel cargo features (composable). UNAOS_SKIP_XHCI=1 disables xHCI/USB bring-up
# (video-only boot for real HW where firmware may still own the controller and stall its reset);
# UNAOS_BOOTLOG=1 holds the boot log on screen instead of handing off to the GUI;
# UNAOS_PI=1 (Raspberry Pi 4) and UNAOS_TEGRA=1 (Jetson Orin Nano / Tegra234) select the aarch64
# UART — `pi` touches no UART (fbcon only), `tegra` points serial at the Tegra 16550. Empty by default.
# UNAOS_USBSERIAL=1 is a BUILDER/QEMU knob (not a kernel feature): the builder attaches an FTDI FT232
# usb-serial device (VID 0403 PID 6001) whose chardev is target/ftdi.log, so the x86 kernel's U2.5
# FTDI console driver enumerates it and replays the boot log out the (emulated) cable. `is_ok()`
# semantics — an EMPTY value counts as SET.
KERNEL_FEATURES=""
_feats=""
[ -n "${UNAOS_SKIP_XHCI:-}" ] && _feats="${_feats}skip_xhci,"
[ -n "${UNAOS_BOOTLOG:-}" ] && _feats="${_feats}bootlog,"
[ -n "${UNAOS_PI:-}" ] && _feats="${_feats}pi,"
[ -n "${UNAOS_USBDEBUG:-}" ] && _feats="${_feats}usbdebug,"
[ -n "${UNAOS_SCHED_DEMO:-}" ] && _feats="${_feats}sched_demo,"
[ -n "${UNAOS_TEGRA:-}" ] && _feats="${_feats}tegra,"
if [ -n "$_feats" ]; then
    KERNEL_FEATURES="--features ${_feats%,}"
    echo -e "${COLOR_YELLOW}⚡ kernel features: ${_feats%,}${COLOR_RESET}"
fi

# UNAOS_BOOTDIAG=1 turns on the BOOTLOADER's `bootdiag` feature — an additive UEFI boot-time
# diagnostics block (firmware vendor/rev, GOP handle count, ConOut device path, DTB stdout-path +
# serial aliases: the Jetson Orin UART/GOP truth). It gates the bootloader build only (the kernel is
# untouched); OFF by default => byte-identical boot logs. Only the aarch64 bootloader build reads it
# (esp-jetson / the Orin); the x86 bootloader is built by the `builder` crate and is unaffected.
BOOTLOADER_FEATURES=""
_bfeats=""
[ -n "${UNAOS_BOOTDIAG:-}" ] && _bfeats="${_bfeats}bootdiag,"
# UNAOS_JB8_LEVER=1 turns on the bootloader's `jb8lever` feature — the JB8 pre-EBS Usb2Hc
# disconnect+reconnect (forced XhciControllerDxe.Start re-run) on the Jetson Orin. Bench-only risk
# media; OFF by default. aarch64/tegra234-gated at runtime; x86 bootloader unaffected.
[ -n "${UNAOS_JB8_LEVER:-}" ] && _bfeats="${_bfeats}jb8lever,"
if [ -n "$_bfeats" ]; then
    BOOTLOADER_FEATURES="--features ${_bfeats%,}"
    echo -e "${COLOR_YELLOW}⚡ bootloader features: ${_bfeats%,}${COLOR_RESET}"
fi

# UNAOS_GICV3=1 selects the GICv3 model on the aarch64 `virt` board. A trailing `-machine
# gic-version=3` overrides the default gic-version=2 (QEMU keeps the last value of a repeated machine
# property). Only affects the `arm`/`test-arm` (virt) runs; the Pi paths (raspi4b) are always GICv2.
# Default (unset) stays GICv2. This is a build-time nop — it changes only the QEMU invocation, not
# the kernel binary (the driver runtime-detects the version at boot).
GICV3_ARG=""
if [ -n "${UNAOS_GICV3:-}" ]; then
    GICV3_ARG="-machine gic-version=3"
    echo -e "${COLOR_YELLOW}⚡ aarch64 virt: GICv3 (gic-version=3)${COLOR_RESET}"
fi

# UNAOS_SDIMG (kernel8-run / kernel8-test): the microSD image QEMU raspi4b attaches via `if=sd`.
# Unset -> target/UnaOS-pi4-baremetal.img (the freshly-built flashable image, HELLO.BIN in its FAT32
# root — so QEMU's card IS the boot image). UNAOS_SDIMG=0 omits the drive (the M6g no-SD control);
# any other value is a path override. QEMU attaches the card to the LEGACY SDHCI (the driver's fallback
# base); real Pi 4 silicon routes the slot to EMMC2 (the driver's first-tried base).
#
# UNAOS_FATIMG swaps the usb-storage backing to a FAT image (scripts/make-fat-img.sh) so the
# kernel's read-only FAT reader can be exercised on aarch64 QEMU too. Mirrors the x86 builder knob
# (builder/src/main.rs). Unset -> usb.img (the raw UNA-OS pattern image). Build with `./arroyo fat-img`.
STICK_IMG="${WORKSPACE_DIR}/builder/usb.img"
case "${UNAOS_FATIMG:-}" in
    "") ;;
    1|part) STICK_IMG="${WORKSPACE_DIR}/builder/fat.img";;
    gpt) STICK_IMG="${WORKSPACE_DIR}/builder/fat-gpt.img";;
    p16) STICK_IMG="${WORKSPACE_DIR}/builder/fat16.img";;
    sf) STICK_IMG="${WORKSPACE_DIR}/builder/fat-sf.img";;
    *) STICK_IMG="${UNAOS_FATIMG}";;
esac

# --- Build Functions ---

build_kernel_x86_64() {
    echo -e "${COLOR_YELLOW}⚡ Building x86_64 Kernel...${COLOR_RESET}"
    cd "$WORKSPACE_DIR/crates/kernel"
    cargo +nightly build --release \
      --target ../../x86_64-unaos.json \
      $NIGHTLY_FLAGS $KERNEL_FEATURES
    cd "$WORKSPACE_DIR"
    echo -e "${COLOR_GREEN}✅ x86_64 Kernel Built.${COLOR_RESET}"
}

# U2: build the x86 ring-3 "hello from disk" user program as a SEPARATE flat link product (out of the
# kernel's .text) and objcopy it to target/hello.bin — the artifact the builder copies onto the ESP
# and make-fat-img.sh copies onto the FAT images as HELLO.BIN; the kernel's U2 FAT loader reads it
# off the volume and runs it in ring 3. Mirrors the aarch64 M6c user-blob objcopy step (see kernel8).
# Its own workspace + bare x86_64 target + tiny linker script; the routine is position-independent
# (RIP-relative + inline message), so it runs wherever the kernel copies it. Fast/incremental — safe
# to call at the start of every x86 build path.
build_user_hello_x86() {
    local TOOLBIN; TOOLBIN="$(rustc +nightly --print sysroot)/lib/rustlib/$(rustc +nightly -vV | awk '/host/{print $2}')/bin"
    echo -e "${COLOR_YELLOW}⚡ Building x86 ring-3 user blob (crates/user-blob-x86 → target/hello.bin)...${COLOR_RESET}"
    mkdir -p "${WORKSPACE_DIR}/target"
    cd "$WORKSPACE_DIR/crates/user-blob-x86"
    RUSTFLAGS="-C link-arg=-T${WORKSPACE_DIR}/crates/user-blob-x86/user-blob-x86.ld" \
      cargo +nightly build --release -Z json-target-spec
    cd "$WORKSPACE_DIR"
    "$TOOLBIN/llvm-objcopy" -O binary --only-section=.text \
      "${WORKSPACE_DIR}/crates/user-blob-x86/target/x86_64-unknown-none/release/user-blob-x86" \
      "${WORKSPACE_DIR}/target/hello.bin"
    # The flat blob must exist and begin EXACTLY at _start's first instruction — the kernel enters the
    # copy at offset 0, so a stray byte ahead of _start (a future toolchain reordering objcopy output)
    # would be a metal-only wrong-entry fault QEMU wouldn't reliably catch. _start = `mov rax, 1` =
    # 48 c7 c0 01 00 00 00; assert the leading 4 bytes.
    [ -f "${WORKSPACE_DIR}/target/hello.bin" ] || { echo -e "${COLOR_RED}ERROR: hello.bin missing — blob build failed${COLOR_RESET}"; exit 1; }
    local head4; head4="$(head -c 4 "${WORKSPACE_DIR}/target/hello.bin" | od -An -tx1 | tr -d ' \n')"
    if [ "$head4" != "48c7c001" ]; then
        echo -e "${COLOR_RED}ERROR: hello.bin does not start with _start (mov rax,#1); first 4 bytes = ${head4}${COLOR_RESET}"
        exit 1
    fi
    echo -e "${COLOR_GREEN}✅ x86 user blob: $(wc -c < "${WORKSPACE_DIR}/target/hello.bin" | tr -d ' ') bytes${COLOR_RESET}"
}

build_kernel_aarch64() {
    echo -e "${COLOR_YELLOW}⚡ Building aarch64 Kernel...${COLOR_RESET}"
    cd "$WORKSPACE_DIR/crates/kernel"
    cargo +nightly build --release \
      --target ../../aarch64-unaos.json \
      $NIGHTLY_FLAGS $KERNEL_FEATURES
    cd "$WORKSPACE_DIR"
    echo -e "${COLOR_GREEN}✅ aarch64 Kernel Built.${COLOR_RESET}"
}

# --- Launch Functions ---

launch_x86_64() {
    build_user_hello_x86   # U2: target/hello.bin — the builder copies it onto the ESP
    build_kernel_x86_64

    echo -e "${COLOR_CYAN}⚡ Launching x86_64 via Builder (kernel + bootloader + QEMU)...${COLOR_RESET}"
    cd "$WORKSPACE_DIR/builder"
    cargo +nightly run --release
    cd "$WORKSPACE_DIR"
}

ESP_DIR_ARM="${WORKSPACE_DIR}/target/aarch64_esp"
AAVMF_PATH=""

# Build the aarch64 kernel + bootloader, pack the ESP, and resolve AAVMF firmware
# (sets the global AAVMF_PATH). Shared by launch_aarch64 and test_aarch64.
prepare_aarch64() {
    build_kernel_aarch64

    local KERNEL_BIN="${WORKSPACE_DIR}/target/aarch64-unaos/release/unaos-kernel"
    local BOOTLOADER_BIN="${WORKSPACE_DIR}/target/aarch64-unknown-uefi/release/bootloader.efi"

    echo -e "${COLOR_YELLOW}⚡ Building aarch64 UEFI Bootloader...${COLOR_RESET}"
    cd "$WORKSPACE_DIR/crates/bootloader"
    cargo +nightly build --release --target aarch64-unknown-uefi \
      $BOOTLOADER_FEATURES \
      -Z build-std=core,compiler_builtins,alloc \
      -Z build-std-features=compiler-builtins-mem
    cd "$WORKSPACE_DIR"

    echo -e "${COLOR_CYAN}⚡ Packaging ESP (EFI System Partition)...${COLOR_RESET}"
    rm -rf "$ESP_DIR_ARM"
    mkdir -p "$ESP_DIR_ARM/EFI/BOOT"
    cp "$BOOTLOADER_BIN" "$ESP_DIR_ARM/EFI/BOOT/BOOTAA64.EFI"
    cp "$KERNEL_BIN" "$ESP_DIR_ARM/kernel.elf"

    # Locate AAVMF firmware (macOS/Homebrew + Linux locations)
    local AAVMF_PATHS=(
        "/usr/local/share/qemu/edk2-aarch64-code.fd"
        "/opt/homebrew/share/qemu/edk2-aarch64-code.fd"
        "/usr/share/AAVMF/AAVMF_CODE.fd"
        "/usr/share/edk2/aarch64/QEMU_EFI.fd"
        "/usr/share/qemu-efi-aarch64/QEMU_EFI.fd"
    )
    AAVMF_PATH=""
    for path in "${AAVMF_PATHS[@]}"; do
        if [ -f "$path" ]; then AAVMF_PATH="$path"; break; fi
    done
    if [ -z "$AAVMF_PATH" ]; then
        echo -e "${COLOR_RED}CRITICAL: AAVMF Firmware not found.${COLOR_RESET}"
        exit 1
    fi

    # Ensure the USB mass-storage backing image exists (64 MiB, signed) — mirrors the x86
    # builder (builder/src/main.rs) so `usb-storage` has something to enumerate on aarch64 too.
    local USB_IMG="${WORKSPACE_DIR}/builder/usb.img"
    if [ ! -f "$USB_IMG" ]; then
        echo -e "${COLOR_YELLOW}⚡ Creating usb.img (64 MiB, signed)...${COLOR_RESET}"
        dd if=/dev/zero of="$USB_IMG" bs=1m count=0 seek=64 2>/dev/null
        printf 'UNA-OS-DISK-001-ALPHA' | dd of="$USB_IMG" conv=notrunc 2>/dev/null
    fi
}

launch_aarch64() {
    prepare_aarch64

    echo -e "${COLOR_GREEN}⚡ Launching QEMU (aarch64)...${COLOR_RESET}"
    echo -e "${COLOR_PURPLE}--- EXPECTED BEHAVIOR ---${COLOR_RESET}"
    echo -e "  • Serial: PCI scan ('XHCI CONTROLLER NOT FOUND' is normal — no USB on virt)"
    echo -e "  • Framebuffer shows UnaOS boot screen / shell"
    echo -e "${COLOR_PURPLE}-------------------------${COLOR_RESET}"

    qemu-system-aarch64 \
        -machine virt,virtualization=on,gic-version=2 ${GICV3_ARG} \
        -cpu cortex-a72 \
        -smp 4 \
        -m 1G \
        -drive if=pflash,format=raw,readonly=on,file="$AAVMF_PATH" \
        -drive format=raw,file=fat:rw:"$ESP_DIR_ARM" \
        -serial stdio \
        -device ramfb \
        -device qemu-xhci,id=xhci \
        -drive if=none,id=stick,format=raw,file="${STICK_IMG}" \
        -device usb-storage,bus=xhci.0,drive=stick \
        -device usb-kbd,bus=xhci.0 \
        -device usb-tablet,bus=xhci.0 \
        -no-reboot \
        -no-shutdown \
        -d guest_errors \
        ${UNAOS_QEMU_EXTRA:-}
}

# Headless aarch64 run: serial -> target/serial-arm.log, self-terminates after N secs.
test_aarch64() {
    local secs="${1:-20}"
    prepare_aarch64

    local logf="${WORKSPACE_DIR}/target/serial-arm.log"
    rm -f "$logf"
    echo -e "${COLOR_CYAN}⚡ Headless aarch64 test (${secs}s). Serial -> ${logf}${COLOR_RESET}"
    qemu-system-aarch64 \
        -machine virt,virtualization=on,gic-version=2 ${GICV3_ARG} -cpu cortex-a72 -smp 4 -m 1G \
        -drive if=pflash,format=raw,readonly=on,file="$AAVMF_PATH" \
        -drive format=raw,file=fat:rw:"$ESP_DIR_ARM" \
        -serial "file:${logf}" -device ramfb -display none \
        -device qemu-xhci,id=xhci \
        -drive if=none,id=stick,format=raw,file="${STICK_IMG}" \
        -device usb-storage,bus=xhci.0,drive=stick \
        -device usb-kbd,bus=xhci.0 -device usb-tablet,bus=xhci.0 \
        -no-reboot -no-shutdown \
        ${UNAOS_QEMU_EXTRA:-} &
    local qpid=$!
    sleep "$secs"
    kill "$qpid" 2>/dev/null || true
    wait "$qpid" 2>/dev/null || true

    echo ""
    echo -e "${COLOR_PURPLE}════════════ SERIAL LOG (${logf}) ════════════${COLOR_RESET}"
    cat "$logf" 2>/dev/null || echo -e "${COLOR_RED}(no serial log produced)${COLOR_RESET}"
    echo -e "${COLOR_PURPLE}═══════════════════════════════════════════════════${COLOR_RESET}"
    echo -e "${COLOR_GREEN}✅ aarch64 test complete. Log at ${logf}${COLOR_RESET}"
}

# --- Headless Test (capture serial to a file) ---
# Boots x86_64 in QEMU with no display, redirects the serial console to
# target/serial.log, and auto-terminates after N seconds (default 20). Use this for
# fast iteration / sharing boot logs — the log lands at a fixed path every time.
#   ./arroyo test          # 20s headless run, then prints the serial log
#   ./arroyo test 30       # 30s run
SERIAL_LOG="${WORKSPACE_DIR}/target/serial.log"

test_x86_64() {
    local secs="${1:-20}"
    build_user_hello_x86   # U2: target/hello.bin — the builder copies it onto the ESP
    build_kernel_x86_64

    echo -e "${COLOR_CYAN}⚡ Headless x86_64 test (${secs}s). Serial -> ${SERIAL_LOG}${COLOR_RESET}"
    rm -f "$SERIAL_LOG"
    cd "$WORKSPACE_DIR/builder"
    UNAOS_SERIAL_LOG="$SERIAL_LOG" UNAOS_TEST_SECS="$secs" cargo +nightly run --release
    cd "$WORKSPACE_DIR"

    echo ""
    echo -e "${COLOR_PURPLE}════════════ SERIAL LOG (${SERIAL_LOG}) ════════════${COLOR_RESET}"
    cat "$SERIAL_LOG" 2>/dev/null || echo -e "${COLOR_RED}(no serial log produced)${COLOR_RESET}"
    echo -e "${COLOR_PURPLE}═══════════════════════════════════════════════════${COLOR_RESET}"
    echo -e "${COLOR_GREEN}✅ Test run complete. Full log saved at ${SERIAL_LOG}${COLOR_RESET}"
}

# --- Utility Functions ---

check_both() {
    echo -e "${COLOR_YELLOW}⚡ Syntax Check: x86_64...${COLOR_RESET}"
    cd "$WORKSPACE_DIR/crates/kernel"
    cargo +nightly check --release \
      --target ../../x86_64-unaos.json \
      $NIGHTLY_FLAGS $KERNEL_FEATURES
    echo -e "${COLOR_GREEN}✅ x86_64 OK${COLOR_RESET}"

    echo -e "${COLOR_YELLOW}⚡ Syntax Check: aarch64...${COLOR_RESET}"
    cargo +nightly check --release \
      --target ../../aarch64-unaos.json \
      $NIGHTLY_FLAGS $KERNEL_FEATURES
    cd "$WORKSPACE_DIR"
    echo -e "${COLOR_GREEN}✅ aarch64 OK${COLOR_RESET}"
}

build_both() {
    build_kernel_x86_64
    build_kernel_aarch64
}

# --- Real-hardware boot media (build + package an ESP, no QEMU) ---

# x86_64 ESP for the MacBook (UEFI). Copy the packaged directory's contents onto a FAT32 USB
# stick (so it has /EFI/BOOT/BOOTX64.EFI and /kernel.elf), then boot the Mac holding Option.
esp_x86() {
    echo -e "${COLOR_CYAN}⚡ Building x86_64 kernel + bootloader and packaging the ESP (no QEMU)...${COLOR_RESET}"
    build_user_hello_x86   # U2: target/hello.bin — the builder copies it onto the ESP as HELLO.BIN
    cd "$WORKSPACE_DIR/builder"
    UNAOS_PACKAGE_ONLY=1 cargo +nightly run --release
    cd "$WORKSPACE_DIR"
    echo -e "${COLOR_GREEN}✅ x86 ESP: ${WORKSPACE_DIR}/target/x86_64_esp/ (incl. HELLO.BIN for the U2 loader)${COLOR_RESET}"
    echo -e "   Copy its contents to a FAT32 USB root, then boot the Mac holding ⌥ Option → 'EFI Boot'."
}

# Build the FAT32 test image(s) the kernel's read-only FAT reader parses (ls/cat). Ensures the x86
# ESP is packaged first (so EFI/ + kernel.elf populate the volume), then builds a partitioned image
# (MBR@LBA0 -> BPB) and a superfloppy (BPB@LBA0). Test with `UNAOS_FATIMG=1 ./arroyo test`.
fat_img() {
    build_user_hello_x86   # U2: ensure target/hello.bin is fresh even if the ESP is reused below
    if [ ! -d "${WORKSPACE_DIR}/target/x86_64_esp" ]; then
        echo -e "${COLOR_YELLOW}⚡ Packaging the x86 ESP first (payload for the FAT image)...${COLOR_RESET}"
        esp_x86
    fi
    echo -e "${COLOR_CYAN}⚡ Building FAT test images (MBR/GPT FAT32 + FAT16 + superfloppy)...${COLOR_RESET}"
    bash "${WORKSPACE_DIR}/scripts/make-fat-img.sh" part
    bash "${WORKSPACE_DIR}/scripts/make-fat-img.sh" gpt
    bash "${WORKSPACE_DIR}/scripts/make-fat-img.sh" p16
    bash "${WORKSPACE_DIR}/scripts/make-fat-img.sh" sf
    echo -e "${COLOR_GREEN}✅ FAT images: fat.img (MBR32), fat-gpt.img (GPT32), fat16.img (MBR16), fat-sf.img (superfloppy)${COLOR_RESET}"
    echo -e "   Test:  ./arroyo test-fat [part|gpt|p16|sf] 30"
}

# Headless FAT test the right way: package a FRESH ESP, rebuild the FAT image from it (so the
# usb-storage backing -- which OVMF may boot, since it carries EFI/BOOT/BOOTX64.EFI -- runs the
# SAME kernel under test, not a stale one), then boot with that FAT image as the block device.
# `./arroyo test-fat [part|sf] [secs]`. Mirrors a single-stick metal boot (boot + block are one FAT).
test_fat() {
    local layout="${1:-part}"
    local secs="${2:-30}"
    case "$layout" in part|gpt|p16|sf) ;; *) echo "usage: ./arroyo test-fat [part|gpt|p16|sf] [secs]"; exit 1;; esac
    esp_x86
    bash "${WORKSPACE_DIR}/scripts/make-fat-img.sh" "$layout"
    export UNAOS_FATIMG="$layout"
    test_x86_64 "$secs"
}

# aarch64 ESP for the Raspberry Pi 4 (UEFI / Path A). Copy onto a FAT32 SD card alongside the
# Tianocore RPi4 EDK2 firmware (RPI_EFI.fd + the Pi firmware blobs).
esp_arm() {
    prepare_aarch64
    echo -e "${COLOR_GREEN}✅ aarch64 ESP: ${ESP_DIR_ARM}${COLOR_RESET}"
    echo -e "   Copy its contents to a FAT32 SD card together with the RPi4 EDK2 UEFI firmware."
}

# Jetson Orin Nano boot media: the aarch64 UEFI ESP (BOOTAA64.EFI + kernel.elf) built with the
# `tegra` UART feature forced on (= UNAOS_TEGRA=1), so the kernel drives the Tegra 16550 at UARTC
# (0x0C28_0000) rather than the QEMU-virt PL011. Boots from NVIDIA's on-board UEFI (JetPack 6 / L4T
# r36) off a single-partition FAT32 USB stick. See docs/dev/OS/01_BOOT_HAL/arch_arm64.md (Orin).
esp_jetson() {
    # Force `tegra` on top of whatever features were already selected (idempotent).
    case ",${_feats}" in
        *",tegra,"*) ;;
        *) _feats="${_feats}tegra,"; KERNEL_FEATURES="--features ${_feats%,}" ;;
    esac
    echo -e "${COLOR_YELLOW}⚡ kernel features (jetson): ${_feats%,}${COLOR_RESET}"
    prepare_aarch64
    echo -e "${COLOR_GREEN}✅ Jetson ESP (tegra): ${ESP_DIR_ARM}${COLOR_RESET}"
    cat <<EOF

  Make Orin boot media (macOS), then boot it:
    1. Format a USB stick as ONE FAT32 partition — ERASES it, pick the right diskN:
         diskutil list                                      # find your USB (external, physical)
         diskutil eraseDisk "MS-DOS FAT32" UNAOS MBRFormat /dev/diskN
    2. Copy the ESP on (no macOS AppleDouble junk), then eject:
         COPYFILE_DISABLE=1 cp -R "${ESP_DIR_ARM}/EFI" "${ESP_DIR_ARM}/kernel.elf" /Volumes/UNAOS/
         sync && diskutil eject /dev/diskN
    3. Plug into an Orin USB-A port, attach a DisplayPort monitor at power-on, then power on.
    4. In the UEFI Shell (tap ESC during boot if it does not drop there):
         connect -r                      # bind FAT drivers — card readers need this
         map -r                           # find the stick's FSx:  (HD(1,MBR,...) on USB/Unit)
         FSx:\\EFI\\BOOT\\BOOTAA64.EFI     # launch UnaOS  (x = the number map showed)
  Serial console: Raspberry Pi Debug Probe on the board TTL header (pin 3 = RX, pin 4 = TX), 115200.
EOF
}

# Bare-metal Raspberry Pi 4: build a flat kernel8.img the GPU ROM loads directly from the microSD
# SLOT (no UEFI/EDK2 — the native Pi boot path), stage the Pi firmware blobs + config.txt around it,
# and build a flashable .img for Raspberry Pi Imager. Links non-PIE at 0x80000 (aarch64-base.json,
# relocation-model=static) with pi-baremetal.ld, then objcopy to a raw binary.
KERNEL8_DIR="${WORKSPACE_DIR}/target/pi_baremetal"
FW_ZIP="${WORKSPACE_DIR}/target/RPi4_UEFI_Firmware_v1.52.zip"
kernel8() {
    local TOOLBIN; TOOLBIN="$(rustc +nightly --print sysroot)/lib/rustlib/$(rustc +nightly -vV | awk '/host/{print $2}')/bin"

    # M6c: build the EL0 user program as a SEPARATE link product (out of the kernel's .text) and
    # objcopy it to a flat binary the kernel include_bytes!s (crates/kernel/src/arch/aarch64/
    # syscall.rs). Built for the SAME bare aarch64 target as the kernel, with its own tiny linker
    # script (crates/user-blob/user-blob.ld); the routine is position-independent (byte-granular `adr`
    # + an inline message), so it runs wherever the kernel copies it. This MUST run BEFORE the kernel
    # build: include_bytes! needs target/user_blob.bin to exist, and its (always-fresh) mtime is what
    # drives the kernel's rebuild when the routine changes. (build-std/target come from the crate's
    # own .cargo/config.toml; it is its own workspace, so `./arroyo check`/`build` never touch it —
    # the blob is validated only here at kernel8-build time, not at `check`.)
    echo -e "${COLOR_YELLOW}⚡ Building EL0 user blob (crates/user-blob → target/user_blob.bin)...${COLOR_RESET}"
    mkdir -p "${WORKSPACE_DIR}/target"
    cd "$WORKSPACE_DIR/crates/user-blob"
    RUSTFLAGS="-C link-arg=-T${WORKSPACE_DIR}/crates/user-blob/user-blob.ld" \
      cargo +nightly build --release -Z json-target-spec
    cd "$WORKSPACE_DIR"
    "$TOOLBIN/llvm-objcopy" -O binary --only-section=.text \
      "${WORKSPACE_DIR}/crates/user-blob/target/aarch64-base/release/user-blob" \
      "${WORKSPACE_DIR}/target/user_blob.bin"
    # The flat blob must exist and begin EXACTLY at _start's first instruction — the kernel enters the
    # copy at offset 0, so a stray byte ahead of _start (a future toolchain reordering objcopy output)
    # would be a metal-only wrong-entry fault QEMU wouldn't reliably catch. _start = `mov x8, #1` =
    # 0xD2800028 = little-endian bytes 28 00 80 d2. Assert both.
    [ -f "${WORKSPACE_DIR}/target/user_blob.bin" ] || { echo -e "${COLOR_RED}ERROR: user_blob.bin missing — blob build failed${COLOR_RESET}"; exit 1; }
    local head4; head4="$(head -c 4 "${WORKSPACE_DIR}/target/user_blob.bin" | od -An -tx1 | tr -d ' \n')"
    if [ "$head4" != "280080d2" ]; then
        echo -e "${COLOR_RED}ERROR: user_blob.bin does not start with _start (mov x8,#1); first 4 bytes = ${head4}${COLOR_RESET}"
        exit 1
    fi
    echo -e "${COLOR_GREEN}✅ EL0 user blob: $(wc -c < "${WORKSPACE_DIR}/target/user_blob.bin" | tr -d ' ') bytes${COLOR_RESET}"

    echo -e "${COLOR_YELLOW}⚡ Building bare-metal kernel8.img (Pi 4, microSD-slot boot)...${COLOR_RESET}"
    cd "$WORKSPACE_DIR/crates/kernel"
    RUSTFLAGS="-C link-arg=-T${WORKSPACE_DIR}/crates/kernel/pi-baremetal.ld" \
      cargo +nightly build --release --target ../../aarch64-base.json \
      $NIGHTLY_FLAGS --features baremetal,skip_xhci
    cd "$WORKSPACE_DIR"

    rm -rf "$KERNEL8_DIR"; mkdir -p "$KERNEL8_DIR/overlays"
    "$TOOLBIN/llvm-objcopy" -O binary \
      "${WORKSPACE_DIR}/target/aarch64-base/release/unaos-kernel" "$KERNEL8_DIR/kernel8.img"
    cp "${WORKSPACE_DIR}/scripts/pi-baremetal-config.txt" "$KERNEL8_DIR/config.txt"

    # Standard Pi GPU firmware blobs (start4.elf/fixup4.dat) + base DTB + the miniuart-bt overlay,
    # pulled from the cached pftf release zip (we use only its stock firmware files here).
    if [ ! -f "$FW_ZIP" ]; then
        echo -e "${COLOR_CYAN}⚡ Fetching Pi firmware (pftf v1.52)...${COLOR_RESET}"
        curl -sL -o "$FW_ZIP" https://github.com/pftf/RPi4/releases/download/v1.52/RPi4_UEFI_Firmware_v1.52.zip
    fi
    unzip -o -j "$FW_ZIP" start4.elf fixup4.dat bcm2711-rpi-4-b.dtb -d "$KERNEL8_DIR" >/dev/null
    unzip -o -j "$FW_ZIP" "overlays/miniuart-bt.dtbo" -d "$KERNEL8_DIR/overlays" >/dev/null
    echo -e "${COLOR_GREEN}✅ Boot files: ${KERNEL8_DIR}${COLOR_RESET}"

    # M6g: carry the EL0 user blob onto the boot media as HELLO.BIN, next to kernel8.img in the FAT32
    # root (make-pi-img.sh ditto's the whole staging dir). On metal the kernel's M6g loader reads this
    # very file back off the microSD it booted from; in QEMU it rides the same image attached via if=sd.
    # Mirror of the x86 carry (make-fat-img.sh's HELLO_BIN block).
    cp "${WORKSPACE_DIR}/target/user_blob.bin" "$KERNEL8_DIR/HELLO.BIN"

    # U9: plant a DEDICATED writable scratch file (NEVER HELLO.BIN — other fixtures load that as EL0 code).
    # 1 KiB (> 512 so fat::probe_once never cats it) of a known 0xEE filler; the u9 File-write demo opens it
    # RW, seeks in, overwrites a 16-byte sentinel IN PLACE, reads it back, and the launcher re-reads the raw
    # sector to prove it changed while the file size did not. Re-created every kernel8 build (KERNEL8_DIR is
    # wiped above + the .img is rebuilt), so each kernel8-test run gets a pristine scratch file.
    head -c 1024 /dev/zero | tr '\000' '\356' > "$KERNEL8_DIR/SCRATCH.BIN"

    bash "${WORKSPACE_DIR}/scripts/make-pi-img.sh" "$KERNEL8_DIR" "${WORKSPACE_DIR}/target/UnaOS-pi4-baremetal.img" 64
    echo -e "${COLOR_GREEN}✅ Flashable image: target/UnaOS-pi4-baremetal.img — Imager → Use custom → microSD → SD slot.${COLOR_RESET}"
}

# Boot the bare-metal kernel8.img on QEMU's `raspi4b` (emulated BCM2711) — the same flat binary the
# real Pi GPU ROM loads from the microSD slot. raspi4b loads `-kernel` to 0x80000 and enters at EL2,
# and faithfully models the VideoCore mailbox + framebuffer (the buffer is scanned out to the
# display), so this exercises the Phase-2 mailbox framebuffer end to end. Our PL011 (UART0) is the
# FIRST `-serial`; the mini-UART is second. (No EDID in QEMU → the firmware's default 640×480.)
run_kernel8() {
    kernel8 # always rebuild from current source (incremental; ~seconds) so we never run a stale image
    echo -e "${COLOR_GREEN}⚡ Launching QEMU raspi4b (bare-metal kernel8.img)...${COLOR_RESET}"
    echo -e "  • PL011 serial (UART0) on stdio; mailbox framebuffer on the display"
    # M6g: attach the freshly-built flashable image as the SD card (the same bytes that get flashed, so
    # QEMU's card IS the boot image, HELLO.BIN in its FAT32 root). UNAOS_SDIMG=0 omits it (regression
    # control); any other value overrides the path. The `if=sd` card lands on QEMU's LEGACY SDHCI.
    local SDIMG="${UNAOS_SDIMG:-${WORKSPACE_DIR}/target/UnaOS-pi4-baremetal.img}"
    local SD_DRIVE=""
    [ "$SDIMG" != "0" ] && SD_DRIVE="-drive if=sd,format=raw,file=${SDIMG}"
    qemu-system-aarch64 \
        -machine raspi4b \
        -kernel "$KERNEL8_DIR/kernel8.img" \
        -serial mon:stdio -serial null \
        ${SD_DRIVE} \
        ${UNAOS_QEMU_EXTRA:-}
}

# Headless raspi4b test: boot kernel8.img, capture PL011 -> target/serial-pi.log and a QMP
# screendump of the mailbox framebuffer -> target/pi-screen.png, then self-terminate.
test_kernel8() {
    local secs="${1:-8}"
    kernel8 # always rebuild from current source (incremental; ~seconds) so we never test a stale image
    local logf="${WORKSPACE_DIR}/target/serial-pi.log"
    local png="${WORKSPACE_DIR}/target/pi-screen.png"
    rm -f "$logf"
    echo -e "${COLOR_CYAN}⚡ Headless raspi4b test (${secs}s). Serial -> ${logf}, screen -> ${png}${COLOR_RESET}"
    # M6g: attach the flashable image as the SD card (UNAOS_SDIMG=0 omits it for the no-SD control; any
    # other value overrides the path). Same bytes as the flash image, so HELLO.BIN is in its FAT32 root.
    local SDIMG="${UNAOS_SDIMG:-${WORKSPACE_DIR}/target/UnaOS-pi4-baremetal.img}"
    local SD_DRIVE=""
    [ "$SDIMG" != "0" ] && SD_DRIVE="-drive if=sd,format=raw,file=${SDIMG}"
    qemu-system-aarch64 \
        -machine raspi4b \
        -kernel "$KERNEL8_DIR/kernel8.img" \
        -serial "file:${logf}" -serial null -display none \
        ${SD_DRIVE} \
        -qmp tcp:127.0.0.1:4463,server,nowait \
        ${UNAOS_QEMU_EXTRA:-} &
    local qpid=$!
    python3 "${WORKSPACE_DIR}/scripts/qmp_shoot.py" --port 4463 --wait "$((secs - 1))" --out "$png" 2>/dev/null || sleep "$secs"
    kill "$qpid" 2>/dev/null || true
    wait "$qpid" 2>/dev/null || true
    echo -e "${COLOR_GREEN}✅ Serial:${COLOR_RESET} ${logf}    ${COLOR_GREEN}Screen:${COLOR_RESET} ${png}"
}

clean_all() {
    echo -e "${COLOR_YELLOW}⚡ Purging build artifacts...${COLOR_RESET}"
    cd "$WORKSPACE_DIR"
    cargo clean
    echo -e "${COLOR_GREEN}✅ Clean.${COLOR_RESET}"
}

