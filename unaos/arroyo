[ -n "${UNAOS_NETTEST:-}" ] && _feats="${_feats}nettest,genet,"
# ── BANNER-DEDUP (orin 3, 2026-08-22) — the banner must not misreport its own composition ─────────
#
# THE SYMPTOM. An armed jetson build printed `tegra` THREE times:
#   ⚡ kernel features (jetson): rast,ehcihid,kbdwit,sdhcblk,smolnet,tegra,tegra_el0,tegra,tegrasmp,tegra
#
# THE CAUSE, and it is NOT the `case ",${_feats}" in *",tegra,"*` guards in `esp_jetson`. Those are
# CORRECT: they prepend the comma to the SUBJECT (`",${_feats}"`) precisely so a feature sitting in
# first position still presents a leading comma, and `_feats` is comma-TERMINATED by construction, so
# both sides are bracketed and the test matches. Replayed against the exact banner above, both jetson
# guards MATCH and append NOTHING. The duplication is produced entirely UPSTREAM, by the knob mapping
# in this block: several knobs append an implied feature alongside their own, unguarded —
#   UNAOS_TEGRA      -> `tegra,`
#   UNAOS_TEGRA_EL0  -> `tegra_el0,tegra,`
#   UNAOS_TEGRASMP   -> `tegrasmp,tegra,`   (and the NOTEGRASMP default-on line appends the same pair)
#   UNAOS_NETTEST    -> `nettest,genet,`    (duplicates `genet` if UNAOS_GENET=1 is also set)
# — so any two of them naming the same implied feature print it twice. It is a CLASS, not a tegra
# quirk, and it is NOT contained to `esp_jetson`: `UNAOS_TEGRA=1 ./arroyo check`, which never calls
# `esp_jetson` at all, prints `...,tegra,tegrasmp,tegra` from this very line.
#
# WHY IT IS WORTH FIXING even though the build was always correct. Cargo takes `--features` as a SET,
# so a repeated name changes nothing about the image. But this track CERTIFIES THAT A FEATURE IS ARMED
# BY READING THIS BANNER (CLAUDE.md's full-knob rule, and the TOOLFIX/BANNER note immediately below,
# which exists for the same reason one arch over). A banner that misreports its own composition is the
# instrument lying about the instrument.
#
# THE FIX. Collapse repeats at the single choke point where `_feats` is finalised, keeping
# first-occurrence order, using this file's own idiom (`case ",$acc" in *",$f,"*`) rather than a new
# one. Every consumer downstream reads `$_feats` or `$KERNEL_FEATURES` from here, so one pass fixes
# every path's banner — check, x86, arm, esp-*, esp-jetson — and `esp_jetson`'s guards keep working
# unchanged (they still correctly append `tegra`/`tegrasmp` on a bare `./arroyo esp-jetson`).
#
# IT CANNOT CHANGE THE IMAGE, and this was MEASURED, not argued: the armed jetson kernel built from
# the duplicated string and from the deduplicated string is BYTE-IDENTICAL (same .elf sha256 — not
# merely the same loadable image). Removing an exact repeat leaves the resolved feature SET, and hence
# cargo's `-Cmetadata` fingerprint, untouched. Contrast `arm_features` below, which strips a feature
# that IS in the set and therefore DOES have to justify itself.
_dedup_acc=""
for _dedup_f in ${_feats//,/ }; do
    case ",${_dedup_acc}" in
        *",${_dedup_f},"*) ;;
        *) _dedup_acc="${_dedup_acc}${_dedup_f}," ;;
    esac
done
_feats="$_dedup_acc"
unset _dedup_acc _dedup_f

if [ -n "$_feats" ]; then
    KERNEL_FEATURES="--features ${_feats%,}"
    # TOOLFIX/BANNER: this map drives the x86/virt cargo invocations ONLY. The Pi bare-metal builds
    # compile from `kernel8()`'s CURATED $K8_FEATS — a SEPARATE list that deliberately does not draw
    # from `$_feats` — so printing this line on a kernel8-family command stated the wrong build twice
    # over: it OMITTED every armed Pi feature (`UNAOS_PIDESK=1 UNAOS_QUARRY=1 ./arroyo kernel8`
    # printed a banner with neither name on it, and a run with no other knob set printed the default
    # x86 list `ehcihid,kbdwit,sdhcblk,smolnet` — none of which is in the image), and it ADVERTISED
    # features the image does not contain (`UNAOS_WC=1 ./arroyo kernel8` printed `...,wc`, but `wc`
    # is not in K8_FEATS and no `wc` byte reaches kernel8.img).
    #
    # That is not cosmetic. CLAUDE.md's full-knob rule reads this exact string to decide whether a gate
    # really armed the knob it claims, and on the Pi path the banner could be satisfied FALSELY — a run
    # could show `wc` while building an image without one `wc` byte in it — and could equally fail to
    # show a feature that WAS armed (`desktop_firmware`, `quarry`, the whole v3d ladder). So the banner is
    # suppressed for the kernel8 family here and `kernel8()` emits the real one, with the identical
    # prefix, from the list it actually hands cargo. Every other command's banner is unchanged, and
    # $KERNEL_FEATURES itself is set exactly as before on every path, so no build changes.
    case "${1:-}" in
        kernel8|baremetal|kernel8-run|run-pi|kernel8-test|test-pi|kernel8-install|install-pi) ;;
        *) echo -e "${COLOR_YELLOW}⚡ kernel features: ${_feats%,}${COLOR_RESET}" ;;
    esac
fi

# SMOLNET-DEFAULT: `smolnet` is an x86-only feature — its optional smoltcp dep is x86-gated
# (`[target.'cfg(target_arch="x86_64")'.dependencies]`) and its module + EVERY call site are
# `#[cfg(all(feature="smolnet", target_arch="x86_64"))]`, so the aarch64 compiler never sees one byte
# of it. Feeding it to an aarch64 cargo invocation is a no-op for the emitted CODE, but it shifts the
# crate's cargo `-Cmetadata` fingerprint (the enabled-feature set is hashed into symbol manglings),
# which would perturb the jetson media hash for zero observable change. `arm_features` echoes
# $KERNEL_FEATURES with `smolnet` stripped, so every aarch64 kernel compile gets media BYTE-IDENTICAL
# whether smolnet is default-on or opted out (the aarch64 byte-identity contract, enforced at build,
# not merely claimed). x86 builds keep the full $KERNEL_FEATURES. (Pi `kernel8` builds from its own
# curated K8_FEATS, which never carries smolnet, so it needs no strip.) Always exits 0.
arm_features() {
    case "$KERNEL_FEATURES" in
        --features\ *) ;;
        *) printf '%s' "$KERNEL_FEATURES"; return 0 ;;
    esac
    local f=",${KERNEL_FEATURES#--features },"
    f="${f//,smolnet,/,}"
    # KBDWIT rides the same strip, for the same reason: the `ehci` module it instruments is
    # `target_arch = "x86_64"`-gated, so `kbdwit` emits not one byte of aarch64 CODE — but an
    # enabled feature is hashed into cargo's `-Cmetadata` fingerprint, so leaving it in would shift
    # every aarch64 media hash between a default build and a `UNAOS_NOKBDWIT=1` one for zero
    # observable change. Stripped => aarch64 media are byte-identical either way.
    f="${f//,kbdwit,/,}"
    # DEADMAN rides the same strip, for the same reason: the real instrument is
    # `all(feature = "deadman", target_arch = "x86_64")`-gated and every counter, the emit and both
    # `wm` samplers live inside it, so `deadman` emits not one byte of aarch64 CODE — the aarch64
    # half is the empty `#[inline(always)]` shim, which compiles to nothing. But an enabled feature
    # is hashed into cargo's `-Cmetadata` fingerprint, so leaving it in would shift every aarch64
    # media hash between a default build and a `UNAOS_DEADMAN=1` one for zero observable change.
    # Stripped => the x86 track can arm a timer-ISR witness without touching Pi or Jetson media.
    # ⚠ This strip governs MEDIA only. `deadman` IS named on the `arm-pi` type-check leg above, and
    # must stay there: the hooks in `video/wm.rs` (`note_attach`, `note_composite_done`) are
    # ARCH-NEUTRAL call sites, so the shim half has to compile armed on aarch64 or the seam is
    # covered on neither arch.
    f="${f//,deadman,/,}"
    # WCG-PAYGO is deliberately NOT in this strip, and must not join it by analogy with the
    # entries above: since the 2026-08-27 parity port (WCGPAR) the feature emits REAL aarch64
    # code — the glass-witness paygo half including the occlusion attribution — so stripping it
    # would change behaviour, not just the fingerprint. It is also named on the `arm-pi`
    # type-check leg above so that half compiles armed. (Whether Pi MEDIA ships it armed is the
    # pi track's call; this function only strips what is provably codeless on aarch64.)
    # WEDGEINJ rides the same strip, and more strictly than the others: its whole implementation is
    # `all(target_arch = "x86_64", feature = "wedgeinj")`-gated (the aarch64 half is the empty
    # `#[inline(always)]` shim), so it emits not one byte of aarch64 code — and it is a DELIBERATE
    # FAULT INJECTOR, which has no business anywhere near a media path it cannot fire on. Stripped =>
    # aarch64 media stay byte-identical whether or not the x86 track is reproducing its wedge.
    f="${f//,wedgeinj,/,}"
    # SDHC-4a rides the same strip, for the same reason: `drivers/sdhc.rs` is reached only from
    # `arch/x86_64/pci.rs`, so `sdw` emits not one byte of aarch64 CODE — but leaving it enabled would
    # shift every aarch64 media hash between a default build and a `UNAOS_SDW=1` one for zero
    # observable change. Stripped => aarch64 media are byte-identical whichever way the x86 write arm
    # points, which is the property that lets the x86 track arm a card-write knob without touching the
    # Pi or Jetson media at all.
    f="${f//,sdw,/,}"
    # WCD-VALVE rides the same strip, for the same reason: every valve item is x86_64-gated, so
    # `wcdvalve` emits not one byte of aarch64 CODE — but an enabled feature is hashed into cargo's
    # `-Cmetadata` fingerprint, and leaving it in would shift the aarch64 media hash between a
    # default build and a `UNAOS_WCDVALVE=1` one for zero observable change.
    f="${f//,wcdvalve,/,}"
    # SDHC-4b rides the same strip: the registration call site is inside `drivers/sdhc.rs` (reached only
    # from `arch/x86_64/pci.rs`) and every block/FAT arm the knob adds is gated
    # `all(target_arch = "x86_64", feature = "sdhcblk")`, so `sdhcblk` emits not one byte of aarch64
    # CODE — but an enabled feature is hashed into cargo's `-Cmetadata` fingerprint, so leaving it in
    # would shift every aarch64 media hash between a default build and a `UNAOS_SDHCBLK=1` one for zero
    # observable change. Stripped => the x86 track can arm an internal-card block backend without
    # touching the Pi or Jetson media at all.
    f="${f//,sdhcblk,/,}"
    # PCI-CENSUS (GR20) rides the same strip, for the same reason: `full_census` lives in
    # `arch/x86_64/pci.rs`, so `pcicensus` emits not one byte of aarch64 CODE — but an enabled
    # feature is hashed into cargo's `-Cmetadata` fingerprint, so leaving it in would shift every
    # aarch64 media hash between a default build and a `UNAOS_PCICENSUS=1` one for zero observable
    # change. Stripped => the x86 track can arm a bus census without touching Pi or Jetson media.
    f="${f//,pcicensus,/,}"
    # BCMA-RECON (GR20) rides the same strip, for the same reason: `drivers/bcma.rs` is declared
    # `#[cfg(all(target_arch = "x86_64", feature = "bcmarecon"))]` and is reached only from
    # `arch/x86_64/pci.rs`, so `bcmarecon` emits not one byte of aarch64 CODE — but an enabled
    # feature is hashed into cargo's `-Cmetadata` fingerprint, so leaving it in would shift every
    # aarch64 media hash between a default build and a `UNAOS_BCMARECON=1` one for zero observable
    # change. Stripped => the x86 track can recon a radio without touching Pi or Jetson media.
    f="${f//,bcmarecon,/,}"
    # BCMA-S1 (GR20) rides the same strip, for the same reason and as a consequence of the same fact:
    # `bcmaS1` implies `bcmarecon`, whose only code is the x86-gated `drivers/bcma.rs`, so `bcmaS1`
    # emits not one byte of aarch64 CODE — but an enabled feature is hashed into cargo's `-Cmetadata`
    # fingerprint, so leaving it in (or its implied `bcmarecon`, already stripped above) would shift
    # every aarch64 media hash for zero observable change.
    f="${f//,bcmaS1,/,}"
    # WIFI-1 (GR25) rides the same strip, for the same reason and by the same mechanism as
    # `bcmarecon` above: `src/wifi/` is declared `#[cfg(all(feature = "wifi", target_arch =
    # "x86_64"))]` and all three main-loop call sites carry the same pair, so `wifi` emits not one
    # byte of aarch64 CODE — but an enabled feature is hashed into cargo's `-Cmetadata` fingerprint,
    # so leaving it in would shift every aarch64 media hash between a default build and a
    # `UNAOS_WIFI=1` one for zero observable change. Stripped => the x86 track can arm the radio's
    # firmware loader without touching Pi or Jetson media at all.
    f="${f//,wifi,/,}"
    # WIFI-2 (GR25) rides the same strip, for the same reason and as a consequence of the same fact:
    # `wifi2` implies `wifi`, whose only code is the x86-gated `src/wifi/`, and `bringup.rs` is a
    # sibling inside that same gate — so `wifi2` emits not one byte of aarch64 CODE. An enabled feature
    # is still hashed into cargo's `-Cmetadata` fingerprint, so leaving it in would shift every
    # Pi/Jetson media hash between a default build and a `UNAOS_WIFI2=1` one for zero observable
    # change. Stripped BEFORE `wifi` would matter if the order were the other way round: `,wifi2,`
    # does not contain `,wifi,` as a substring (the trailing comma is part of the pattern), so the
    # `wifi` strip above cannot half-rewrite it and the two lines are order-independent.
    f="${f//,wifi2,/,}"
    # WVAL-REPLAY rides the same strip, for the same reason and as a consequence of the same fact:
    # `wifival` implies `wifi2`, whose only code is the x86-gated `src/wifi/`, and `validate_replay`
    # is a sibling function inside `bringup.rs` under that same gate — so `wifival` emits not one
    # byte of aarch64 CODE. An enabled feature is still hashed into cargo's `-Cmetadata` fingerprint,
    # so leaving it in (or its implied `wifi2`/`wifi`, both stripped above) would shift every
    # Pi/Jetson media hash between a default build and a `UNAOS_WIFIVAL=1` one for zero observable
    # change. Order-independent with the two strips above by the same argument they make about each
    # other: `,wifival,` does not contain `,wifi,` or `,wifi2,` as a substring, because the trailing
    # comma is part of every pattern.
    f="${f//,wifival,/,}"
    # WIFI-3 rides the same strip, for the same reason and as a consequence of the same fact:
    # `wifi3` implies `wifi2`, whose only code is the x86-gated `src/wifi/`, and `upload_ucode`
    # is a sibling function inside `bringup.rs` under that same gate — so `wifi3` emits not one
    # byte of aarch64 CODE. An enabled feature is still hashed into cargo's `-Cmetadata`
    # fingerprint, so leaving it in (or its implied `wifi2`/`wifi`, both stripped above) would
    # shift every Pi/Jetson media hash between a default build and a `UNAOS_WIFI3=1` one for
    # zero observable change. Order-independent with the strips above by their own argument:
    # `,wifi3,` does not contain `,wifi,` or `,wifi2,` as a substring, because the trailing
    # comma is part of every pattern.
    f="${f//,wifi3,/,}"
    # BT-L0 (GR21) rides the same strip, for the same reason and by the same mechanism as `kbdwit`
    # above: every line `bt` gates lives in `drivers/ehci/mod.rs`, which is declared
    # `#[cfg(all(target_arch = "x86_64", feature = "ehcihid"))]`, so `bt` emits not one byte of
    # aarch64 CODE — but an enabled feature is hashed into cargo's `-Cmetadata` fingerprint, so
    # leaving it in would shift every aarch64 media hash between a default build and a `UNAOS_BT=1`
    # one for zero observable change. Note `bt` IMPLIES `ehcihid`, which is default-ON and is NOT
    # stripped (it predates this policy and the Pi/Jetson media hashes are already computed with it
    # present), so stripping `bt` alone is the whole delta.
    f="${f//,bt,/,}"
    # BT-C1 (GR24) rides the same strip, for the same reason and as a consequence of the same fact:
    # `btc` implies `bt`, whose only code is inside the x86-gated `drivers/ehci/mod.rs`, so `btc`
    # emits not one byte of aarch64 CODE — but an enabled feature is hashed into cargo's
    # `-Cmetadata` fingerprint, so leaving it in (or its implied `bt`, stripped just above) would
    # shift every aarch64 media hash between a default build and a `UNAOS_BTC=1` one for zero
    # observable change. Stripped => the x86 track can page a speaker without touching Pi or Jetson
    # media at all.
    f="${f//,btc,/,}"
    # BT-DIR rides the same strip, for the same reason and as a consequence of the same fact:
    # `btdir` implies `btc` implies `bt`, whose only code is inside the x86-gated
    # `drivers/ehci/mod.rs`, so `btdir` emits not one byte of aarch64 CODE — but an enabled feature
    # is hashed into cargo's `-Cmetadata` fingerprint, so leaving it in (or either of the two
    # implied features stripped just above) would shift every aarch64 media hash between a default
    # build and a `UNAOS_BTDIR=1` one for zero observable change. Stripped => the x86 track can run
    # the direction test without touching Pi or Jetson media at all.
    f="${f//,btdir,/,}"
    # VSYNC-PACE (GR22, polarity inverted GR25) rides the same strip, for the same reason: every line
    # `vsyncpace` gates lives in `arch/x86_64/syscall.rs` and is additionally `wc`-gated (an x86-only
    # feature), so `vsyncpace` emits not one byte of aarch64 CODE — but an enabled feature is hashed into
    # cargo's `-Cmetadata` fingerprint, so leaving it in would shift every aarch64 media hash between a
    # default build and a `UNAOS_VSYNCPACE=1` one for zero observable change. Stripped => the x86 track
    # can arm (or disarm) the present pacer without touching Pi or Jetson media at all.
    f="${f//,vsyncpace,/,}"
    # GEN7-3D R1 (GR25) rides the same strip, for the same reason and by the same mechanism as
    # `bcmarecon` above: `drivers/gpu/gen7.rs` carries a file-level `#![cfg(target_arch =
    # "x86_64")]` and its single call site is gated `all(target_arch = "x86_64", feature = "gen7")`,
    # so `gen7` emits not one byte of aarch64 CODE — but an enabled feature is hashed into cargo's
    # `-Cmetadata` fingerprint, so leaving it in would shift every aarch64 media hash between a
    # default build and a `UNAOS_IVB3D=1` one for zero observable change. Note `gen7` IMPLIES
    # `intel-ivb`, which predates this policy and is NOT stripped, so stripping `gen7` alone is the
    # whole delta.
    #
    # ⚠ Review of 055c0e58 caught this comment being load-bearing and FALSE: the call site was
    # gated on the FEATURE only, so an aarch64 build with `gen7` enabled would have tried to call
    # into a file whose `#![cfg]` had deleted it — the strip was a BUILD REQUIREMENT masquerading as
    # a hash-stability nicety, and the comment said the opposite. The call site is now arch-gated
    # too, which makes this paragraph true as written and demotes the strip back to what every other
    # entry here is: fingerprint hygiene, not a load-bearing dependency.
    f="${f//,gen7,/,}"
    # PCIH / NOASPM rides the same strip, for the same reason: every noaspm-gated byte lives in
    # the x86_64-only half of drivers/gpu/pcihealth.rs, so the feature emits not one byte of
    # aarch64 CODE — but an enabled feature is hashed into cargo's -Cmetadata fingerprint, so
    # leaving it in would shift every aarch64 media hash for zero observable change. Stripped =>
    # the x86 track can run the ASPM experiment without touching Pi or Jetson media.
    f="${f//,noaspm,/,}"
    f="${f#,}"; f="${f%,}"
    if [ -n "$f" ]; then printf -- '--features %s' "$f"; fi
    return 0
}

# UNAOS_BOOTDIAG=1 turns on the BOOTLOADER's `bootdiag` feature — an additive UEFI boot-time
# diagnostics block (firmware vendor/rev, GOP handle count, ConOut device path, DTB stdout-path +
# serial aliases: the Jetson Orin UART/GOP truth). It gates the bootloader build only (the kernel is
# untouched); OFF by default => byte-identical boot logs. Only the aarch64 bootloader build reads it
# (esp-jetson / the Orin); the x86 bootloader is built by the `builder` crate and is unaffected.
BOOTLOADER_FEATURES=""
_bfeats=""
[ -n "${UNAOS_BOOTDIAG:-}" ] && _bfeats="${_bfeats}bootdiag,"
# UNAOS_JB8_LEVER=1 turns on the bootloader's `jb8lever` feature — the JB8 pre-EBS Usb2Hc
# disconnect+reconnect (forced XhciControllerDxe.Start re-run) on the Jetson Orin. Bench-only risk
# media; OFF by default. aarch64/tegra234-gated at runtime; x86 bootloader unaffected.
[ -n "${UNAOS_JB8_LEVER:-}" ] && _bfeats="${_bfeats}jb8lever,"
if [ -n "$_bfeats" ]; then
    BOOTLOADER_FEATURES="--features ${_bfeats%,}"
    echo -e "${COLOR_YELLOW}⚡ bootloader features: ${_bfeats%,}${COLOR_RESET}"
fi

# UNAOS_GICV3=1 selects the GICv3 model on the aarch64 `virt` board. A trailing `-machine
# gic-version=3` overrides the default gic-version=2 (QEMU keeps the last value of a repeated machine
# property). Only affects the `arm`/`test-arm` (virt) runs; the Pi paths (raspi4b) are always GICv2.
# Default (unset) stays GICv2. This is a build-time nop — it changes only the QEMU invocation, not
# the kernel binary (the driver runtime-detects the version at boot).
GICV3_ARG=""
if [ -n "${UNAOS_GICV3:-}" ]; then
    GICV3_ARG="-machine gic-version=3"
    echo -e "${COLOR_YELLOW}⚡ aarch64 virt: GICv3 (gic-version=3)${COLOR_RESET}"
fi

# AARCH64-VNET: UNAOS_VNET=1 attaches a `virtio-net-device` on the QEMU `virt` virtio-mmio bus with a
# user-mode (slirp) backend, so the `vnet` kernel driver has a real NIC to claim and slirp's gateway
# (10.0.2.2) to ICMP-ping. Legacy transport is QEMU's virtio-mmio default (the driver reads the Version
# register and drives legacy). Only affects the `arm`/`test-arm` (virt) runs. Default (unset) => empty =>
# the QEMU invocation is BYTE-IDENTICAL to baseline (no netdev, no device). This is a build-time nop for
# the kernel binary beyond the `vnet` feature wired above.
VNET_ARG=""
if [ -n "${UNAOS_VNET:-}" ]; then
    VNET_ARG="-netdev user,id=unet -device virtio-net-device,netdev=unet"
    echo -e "${COLOR_YELLOW}⚡ aarch64 virt: virtio-net-device + slirp user net (UNAOS_VNET)${COLOR_RESET}"
fi

# UNAOS_SDIMG (kernel8-run / kernel8-test): the microSD image QEMU raspi4b attaches via `if=sd`.
# Unset -> target/UnaOS-pi4-baremetal.img (the freshly-built flashable image, HELLO.BIN in its FAT32
# root — so QEMU's card IS the boot image). UNAOS_SDIMG=0 omits the drive (the M6g no-SD control);
# any other value is a path override. QEMU attaches the card to the LEGACY SDHCI (the driver's fallback
# base); real Pi 4 silicon routes the slot to EMMC2 (the driver's first-tried base).
#
# UNAOS_K8_SCRIPT (kernel8-test only): arms TYPED INPUT — UART0 becomes a bidirectional socket
# chardev (still logging to the same target/serial-pi.log) and scripts/k8_type.py types the named
# script at the shell. DEFAULT OFF; unset, the QEMU argv is byte-for-byte what it has always been.
# UNAOS_K8_SPEC / UNAOS_K8_PORT tune the extra spec and the socket port. See test_kernel8().
#
# UNAOS_FATIMG swaps the usb-storage backing to a FAT image (scripts/make-fat-img.sh) so the
