#!/bin/bash
# ARROYO: The Stream that Feeds the River
# "Ad Astra Per Aspera"
#
# Usage:
#   ./arroyo              Interactive menu
#   ./arroyo x86           Build & boot x86_64 (GUI window + serial on stdio)
#   ./arroyo arm           Build & boot aarch64
#   ./arroyo test [secs]   Headless x86_64 run; serial captured to target/serial.log
#   ./arroyo test-arm [s]  Headless aarch64 run; serial -> target/serial-arm.log
#   ./arroyo check         Quick syntax check (both targets)
#   ./arroyo build         Build both targets (no QEMU)
#   ./arroyo clean         Purge all build artifacts

set -e

# --- Configuration ---
COLOR_RESET="\033[0m"
COLOR_PURPLE="\033[0;35m"
COLOR_CYAN="\033[0;36m"
COLOR_GREEN="\033[0;32m"
COLOR_YELLOW="\033[0;33m"
COLOR_RED="\033[0;31m"

WORKSPACE_DIR="$(cd "$(dirname "$0")" && pwd)"

# DEFAULT-QUIET (witness): the regression BATTERIES re-prove the full fixture set, so arm the kernel's
# `witness` cargo feature for exactly the battery commands — `test`/`test-fat` (x86, via the builder),
# `test-arm` (aarch64 virt), `kernel8-test` (Pi bare-metal). The boot/media commands (`x86`/`arm`/
# `esp-x86`/`esp-arm`/`esp-jetson`/`kernel8`/`vm-image`) leave it OFF so a default boot reaches the shell
# with the boot-honesty lines only. EXPORTED so the `builder` subprocess (which rebuilds the x86 kernel
# from its OWN env-driven feature list) also pushes it. `battery` is deliberately NOT armed here: each of
# its sub-invocations (`"$0" test`, `"$0" test-arm`, `"$0" kernel8-test`) re-enters this case and self-arms,
# while its `"$0" esp-jetson` sub-invocation does NOT — keeping the jetson media witness-free (byte-identity).
case "${1:-}" in
    test|test-x86|test_x86|test-fat|test_fat|test-arm|test-aarch64|kernel8-test|test-pi)
        export UNAOS_WITNESS="${UNAOS_WITNESS:-1}" ;;
esac

# Build flags shared by both targets
NIGHTLY_FLAGS="-Z build-std=core,compiler_builtins,alloc -Z build-std-features=compiler-builtins-mem -Z json-target-spec"

# Optional kernel cargo features (composable). UNAOS_SKIP_XHCI=1 disables xHCI/USB bring-up
# (video-only boot for real HW where firmware may still own the controller and stall its reset);
# UNAOS_BOOTLOG=1 holds the boot log on screen instead of handing off to the GUI;
# UNAOS_PI=1 (Raspberry Pi 4) and UNAOS_TEGRA=1 (Jetson Orin Nano / Tegra234) select the aarch64
# UART — `pi` touches no UART (fbcon only), `tegra` points serial at the Tegra 16550. Empty by default.
# UNAOS_USBSERIAL=1 is a BUILDER/QEMU knob (not a kernel feature): the builder attaches an FTDI FT232
# usb-serial device (VID 0403 PID 6001) whose chardev is target/ftdi.log, so the x86 kernel's U2.5
# FTDI console driver enumerates it and replays the boot log out the (emulated) cable. `is_ok()`
# semantics — an EMPTY value counts as SET.
KERNEL_FEATURES=""
_feats=""
# DEFAULT-QUIET: UNAOS_WITNESS=1 arms the `witness` fixture-battery feature (auto-set above for the battery
# commands; default OFF for boot/media builds). On x86 the builder re-derives features from env, so this
# also flows through UNAOS_WITNESS there; on aarch64 virt/tegra `witness` gates nothing (all its call sites
# are x86- or baremetal-scoped), so arming it for test-arm is a functional no-op that only reflects intent.
[ -n "${UNAOS_WITNESS:-}" ] && _feats="${_feats}witness,"
[ -n "${UNAOS_SKIP_XHCI:-}" ] && _feats="${_feats}skip_xhci,"
[ -n "${UNAOS_BOOTLOG:-}" ] && _feats="${_feats}bootlog,"
[ -n "${UNAOS_PI:-}" ] && _feats="${_feats}pi,"
[ -n "${UNAOS_USBDEBUG:-}" ] && _feats="${_feats}usbdebug,"
[ -n "${UNAOS_SCHED_DEMO:-}" ] && _feats="${_feats}sched_demo,"
# STOR-1: route x86 storage syscalls through the interrupt-driven storage service task (opt-in;
# metal-pending). x86_64 only — a no-op on the aarch64 media below.
[ -n "${UNAOS_IRQSTORAGE:-}" ] && _feats="${_feats}irqstorage,"
# VPERF: x86 video-path bench instrumentation (scroll/VRAM-read counters, fbmem memory-type
# readout, display-BAR probe, scripted scroll scenario). x86_64-only module — aarch64 media are
# byte-identical with this on or off.
[ -n "${UNAOS_VIDEOBENCH:-}" ] && _feats="${_feats}videobench,"
# RAST-1/RAST-TEGRA: software-rasterizer spinning-cube demo through the panel path (UNAOS_RAST=1).
# Cross-arch knob now: x86/virt + aarch64/virt (QEMU ramfb witness) + aarch64/tegra (the Orin panel).
# Knob-off is byte-identical on BOTH arches (module + `rast` dep unlinked).
[ -n "${UNAOS_RAST:-}" ] && _feats="${_feats}rast,"
# PORTSW-1: DEFAULT-ON Panther Point EHCI->xHCI port switchover (route the shared USB2 ports + enable
# SuperSpeed) so the 2012 rMBP internal keyboard/trackpad re-enumerate on the xHCI+HID stack. Applied
# BEFORE enumeration with mask-read-before-write discipline (writes only advertised bits). Metal-gated
# policy (2026-07-16): the no-routing boot dropped ALL external USB on the 2012 rMBP, so routing runs
# by default. UNAOS_NOPORTSW=1 OPTS OUT (never-run no-routing experiment) => zero config-space writes
# => byte-identical no-routing media. Inert on QEMU (non-Intel xHCI). x86_64 only; aarch64 identical.
[ -n "${UNAOS_NOPORTSW:-}" ] && _feats="${_feats}noportsw,"
# EHCI-1 scout: read-only EHCI reconnaissance probe (x86_64). UNAOS_EHCISCOUT=1 fires the read-only
# census probe (call site gated `ehciscout_run`); the scout MODULE itself is compiled by default now
# (the EHCI-3 driver, default-ON below, is built from it). Kept in sync with builder/src/main.rs.
[ -n "${UNAOS_EHCISCOUT:-}" ] && _feats="${_feats}ehciscout_run,"
# EHCI-2 configure-and-relook: knob-gated minimal EHCI wake + two PORTSC censuses (x86_64). The
# evidence PROBE call site is gated `ehciconfig_run` (implies ehciconfig for the wake it shares with
# the driver). Pair with UNAOS_NOEHCIHID=1 for pure evidence (no driver). Kept in sync with builder.
[ -n "${UNAOS_EHCICONFIG:-}" ] && _feats="${_feats}ehciconfig_run,"
# EHCI-4 M1: the EHCI-3 minimal HID driver is now DEFAULT-ON on x86 (metal-gated 2026-07-17: the
# internal keyboard TYPES on the 2012 rMBP). The driver + its shared wake + ACPI-root retention are
# compiled by default via `ehcihid` (implies ehciconfig->ehciscout). UNAOS_NOEHCIHID=1 OPTS OUT =>
# feature not pushed => module + all call sites unlinked => byte-identical to the pre-fold no-EHCI
# default. Mirrors the PORTSW-1 default-ON/negative-knob policy. x86_64 only; aarch64 identical.
[ -z "${UNAOS_NOEHCIHID:-}" ] && _feats="${_feats}ehcihid,"
# BATMON-1: the Apple SMC battery monitor (x86_64). UNAOS_SMC=1 arms the polled SMC key/value driver
# (boot key-inventory scout + battery snapshot for the on-screen meter). Port I/O confined to
# 0x300/0x304; no value-mutating writes. The builder attaches QEMU's isa-applesmc under this knob so
# the protocol machinery is gated by a known-key read; battery keys are metal-first. Default OFF =>
# module + call sites unlinked, media byte-identical. Kept in sync with builder/src/main.rs.
[ -n "${UNAOS_SMC:-}" ] && _feats="${_feats}smc,"
# INSTALL-CORE: UNAOS_INSTALLDEMO=1 arms the installer engine + its x86 boot witness (GPT writer +
# FAT32 formatter + extent content-verify). The builder attaches a dedicated BLANK scratch disk over
# the usb-storage slot under this knob (see builder/src/main.rs), against which the engine writes a
# GPT + FAT32 ESP + a payload file and content-verifies it (incl. a 1-byte-corruption negative test),
# emitting `:: INSTALL: gpt+fat32+copy verify => PASS ::`. The engine refuses any target whose leading
# sectors are not blank. Arch-neutral engine (compiles both arches under the feature); witness is
# x86-only. Default OFF => module + call site vanish, media byte-identical. Kept in sync with
# builder/src/main.rs.
[ -n "${UNAOS_INSTALLDEMO:-}" ] && _feats="${_feats}installdemo,"
# SMOLNET-DEFAULT: smoltcp is the DEFAULT x86 net stack (2026-07-17, Peter's ruling). The mature
# smoltcp TCP/IP stack (ROADMAP §1b) carries the shell's ping/arp/netinfo + the socket syscalls + the
# boot witnesses; the hand-rolled `net` crate is RETIRED as the default (kept in tree, live, resumable
# — it still backs connect/fetch/udpsend, the TCP echo listener, and driver DHCP). UNAOS_NOSMOLNET=1
# OPTS OUT => `smolnet` not pushed => the hand-rolled stack is the whole net path, byte-identical to
# the pre-flip default. Mirrors the PORTSW-1/EHCI-4 default-ON/negative-knob policy. x86-only optional
# dep + x86-gated module; the aarch64 kernel compiles STRIP it via `arm_features` (below) so aarch64
# media is byte-identical to the pre-flip default whichever way this knob points. Kept in sync with
# builder/src/main.rs (which produces only x86 media, so it pushes `smolnet` unconditionally-by-default).
[ -z "${UNAOS_NOSMOLNET:-}" ] && _feats="${_feats}smolnet,"
# VPERF M2: the fbcon viewport-cap bench lever (implies videobench). x86_64 only.
[ -n "${UNAOS_VIDEOCAP:-}" ] && _feats="${_feats}videocap,"

# GPU drivers
[ -n "${UNAOS_KEPLER:-}" ] && _feats="${_feats}nvidia-kepler,"
[ -n "${UNAOS_IVB:-}" ] && _feats="${_feats}intel-ivb,"

[ -n "${UNAOS_TEGRA:-}" ] && _feats="${_feats}tegra,"
# ORIN-SMP-2: UNAOS_SMPPROBE=<n> arms the JM5 CPU_ON firmware-wall investigation probe (tegra-only;
# arch/aarch64/smpprobe.rs). The numeric value selects the experiment at compile time via
# option_env!("UNAOS_SMPPROBE") (cargo passes the env to rustc), so each armed value is a distinct
# image — the record echoes the live SEL so the operator can verify which experiment ran. Default
# OFF; when unset the feature vanishes and the tegra image is byte-identical to baseline.
[ -n "${UNAOS_SMPPROBE:-}" ] && _feats="${_feats}smpprobe,"
# ORIN-SMP-DEFAULT: the real 6-core Orin SMP kick-off (arch/aarch64/smp_virt.rs::start_secondaries_tegra
# + the fdt_tegra `/cpus` presence enumerator) is DEFAULT-ON for tegra builds — metal-proven across
# SMP-1..8 (entry shape, concurrency, position, image layout, idle/busy heartbeats, count-based
# determinism). Any tegra build (UNAOS_TEGRA=1, or the `esp-jetson` target which forces tegra) arms
# `tegrasmp` UNLESS opted out with UNAOS_NOTEGRASMP=1, which drops the kick-off => the tegra image runs
# workers on the boot core only, byte-identical to the pre-flip baseline. UNAOS_TEGRASMP=1 still arms it
# explicitly (back-compat, byte-identical to the new default). The `tegrasmp` feature implies `tegra`.
# Mirrors the PORTSW-1/SMOLNET default-ON/negative-knob policy. See arch_arm64.md §ORIN-SMP.
[ -n "${UNAOS_TEGRASMP:-}" ] && _feats="${_feats}tegrasmp,tegra,"
[ -n "${UNAOS_TEGRA:-}" ] && [ -z "${UNAOS_NOTEGRASMP:-}" ] && _feats="${_feats}tegrasmp,tegra,"
# JETSON-XCARVE M2: UNAOS_XCARVE=1 arms the inherited-xHCI-pointer instrumentation
# (arch/aarch64/xusb_tegra.rs::jbxc_inherited_dump), fired at the top of jb2b_attach BEFORE the
# no-HCRST takeover overwrites the inherited DCBAAP/CRCR/ERST. The `xcarve` feature implies `tegra`.
# Default OFF; when unset the probe + call site vanish and the tegra image is byte-identical to
# baseline (zero `JBXC` strings knob-off). See arch_arm64.md §JETSON-XCARVE.
[ -n "${UNAOS_XCARVE:-}" ] && _feats="${_feats}xcarve,tegra,"
# JETSON-XCARVE FIX M2: UNAOS_XCARVE_SCRUB=1 arms the aimed neutralization
# (arch/aarch64/xusb_tegra.rs::jbxc_scrub_inherited), fired pre-takeover/pre-JB9i: it rewrites ONLY
# the inherited DRAM pointers that fail the plausibility test (bit-63 / out-of-DRAM-window), never a
# sane pointer, never the Falcon. The `xcarve_scrub` feature implies `tegra`. Default OFF; when
# unset the scrub + call site vanish, byte-identical to baseline (zero `JBXC-SCRUB` strings).
# Combine with UNAOS_XCARVE=1 to emit the census + scrub together. See arch_arm64.md §JETSON-XCARVE.
[ -n "${UNAOS_XCARVE_SCRUB:-}" ] && _feats="${_feats}xcarve_scrub,tegra,"
# JETSON-XCARVE-CRCR M1: UNAOS_XCARVE_CRCRQ=1 arms the command-ring quiesce + re-seat
# (arch/aarch64/xusb_tegra.rs::jbxc_crcrq_quiesce), fired after the no-HCRST takeover start()s the
# controller but BEFORE JB9i's first command doorbell: if CRCR.CRR=1 (inherited running ring) it
# issues a spec-clean Command Abort (CRCR.CA) and polls CRR->0, then re-seats CRCR at OUR ring so no
# command executes on the firmware's inherited internal fetch pointer (the carveout target, by
# elimination). CA only — never HCRST/CSB, the Falcon service loop is untouched. The `xcarve_crcrq`
# feature implies `tegra`. Default OFF; when unset the quiesce + call site vanish, byte-identical to
# baseline (zero `JBXC-CRCRQ` strings). Combine with UNAOS_XCARVE=1 for census + quiesce together.
# See arch_arm64.md §JETSON-XCARVE.
[ -n "${UNAOS_XCARVE_CRCRQ:-}" ] && _feats="${_feats}xcarve_crcrq,tegra,"
# JETSON-XCARVE M1: UNAOS_XCARVE_RELINK=1 arms the relink-experiment pad (a `#[used]` inert
# read-only pad static that perturbs image layout with ZERO semantic change). Rebuilds the
# layout-correlated leg-23 image with a different layout to test the carveout's layout correlation.
# The `xcarve_relink` feature implies `tegra`. Default OFF => the pad vanishes, byte-identical to
# baseline.
[ -n "${UNAOS_XCARVE_RELINK:-}" ] && _feats="${_feats}xcarve_relink,tegra,"
# ORIN-NET-1: UNAOS_PCIEPROBE=1 arms the read-only PCIe root-complex + NIC recon census
# (arch/aarch64/pcie_probe.rs). Standalone feature (does NOT imply tegra, mirroring smpprobe) so the
# census runs on BOTH the metal tegra path (combine with UNAOS_TEGRA=1) and the QEMU virt GICv3 path
# (UNAOS_GICV3=1 test-arm — witnesses the graceful skip: virt has a generic ecam, no Tegra234 RC).
# Read-only: DTB census + a poison-rejecting, already-mapped-only config-space liveness read; no
# fabric/config/BAR/power write, no new mapping. Default OFF => module + call sites vanish, every
# image byte-identical to baseline. See arch_arm64.md §ORIN-NET-1.
[ -n "${UNAOS_PCIEPROBE:-}" ] && _feats="${_feats}pcieprobe,"
# ORIN-NET-2: UNAOS_PCIE2=1 arms the controller-0 link + device-enumeration recon
# (arch/aarch64/pcie_probe.rs, census2). Reads link state from the root port's DBI config space (the
# PCIe-capability Link Status, read-only) and reaches controller-0's config/ECAM aperture for a
# bus-0/bus-1 walk via the existing kernel MMIO-mapping path (mmu_tegra::map_mmio_window, kernel page
# tables only). Standalone (does NOT imply tegra, mirroring pcieprobe): runs on the metal tegra path
# (combine with UNAOS_TEGRA=1) and the QEMU virt GICv3 path (graceful skip — no Tegra234 RC). Read-only
# beyond kernel page tables: no fabric/config/BAR write, no link retrain. Default OFF => module + call
# sites vanish, byte-identical to baseline. See arch_arm64.md §ORIN-NET-2.
[ -n "${UNAOS_PCIE2:-}" ] && _feats="${_feats}pcie2,"
# ORIN-NET-3: UNAOS_PCIE3=1 arms the PS-widen + controller-0 link bring-up + device-enumeration recon
# (arch/aarch64/pcie_probe.rs census2 pcie3 blocks + mmu_tegra PS widen). The lane's FIRST DELIBERATE
# FABRIC WRITES, in three classes only: (M1) widen the tegra TCR PS/IPS 36->40-bit so map_mmio_window
# reaches controller-0's ECAM (~184 GiB, above the NET-2 64-GiB ceiling); (M2) the appl LTSSM enable
# sequence on controller 0 (Linux pcie-tegra194 = documentation of record), polling DLL-active; (M3)
# the all-ones/readback BAR-sizing ritual on the enumerated device, restoring each original. Every
# fabric write logged loudly before issue. Builds on pcie2 (implies it); the metal M2/M3 writes are
# additionally tegra-gated, so a pcie3-standalone virt build only witnesses the PS-widen mapping
# decision + graceful skip (UNAOS_GICV3=1 test-arm). Default OFF => module blocks + call sites vanish,
# byte-identical to baseline modulo the ratified 1-byte Location class. See arch_arm64.md §ORIN-NET-3.
[ -n "${UNAOS_PCIE3:-}" ] && _feats="${_feats}pcie3,pcie2,"
# ORIN-NET-4: UNAOS_NET4=1 arms the Realtek RTL8168/8111 GbE driver + smoltcp bind — the Orin's FIRST
# network path (arch/aarch64/rtl8168_tegra.rs). Builds on NET-3 (implies pcie3,pcie2): claims
# controller-0's downstream device (bus1:dev0:fn0 = 0x10ec:0x8168), maps its register BAR via the
# PS-widened map_mmio_window, resets the MAC, brings up the C+ RX/TX descriptor rings, reads the MAC,
# and binds a smoltcp phy::Device over the rings. Pulls the smoltcp dep on aarch64 (dep:smoltcp). The
# driver MMIO/DMA + the smoltcp adapter are additionally tegra-gated (QEMU models no Tegra234 RC), so a
# net4-standalone virt build only prints one honest witness line; the metal build combines
# UNAOS_TEGRA=1. Default OFF => module + call sites vanish, smoltcp not pulled, byte-identical to
# baseline. See arch_arm64.md §ORIN-NET-4 and scripts/orin-net4-bench.md.
[ -n "${UNAOS_NET4:-}" ] && _feats="${_feats}net4,pcie3,pcie2,"
# ORIN-SDMMC-1: UNAOS_SDMMC=1 arms the Tegra234 microSD-slot SDMMC controller READ-ONLY recon — the
# installer line's first rung (arch/aarch64/sdmmc_tegra.rs). Resolves the controller from the live DTB
# (compatible/name match, no hardcoded base; the enabled removable instance = the microSD slot), maps
# its register window, does a poison-honest CAPS/version probe (NET-4b law: read before any write), runs
# the SDHCI identification ladder to CID/CSD/capacity, and reads sector 0 (CMD17) to classify MBR/GPT/FAT.
# READ-ONLY to the card by construction (no CMD24/write path). Standalone (does NOT imply tegra, mirroring
# pcieprobe): the recon runs on BOTH the metal tegra path (combine with UNAOS_TEGRA=1) and the QEMU virt
# GICv3 path, where — QEMU modelling no Tegra234 SDMMC — the tegra-gated MMIO is compiled out and it prints
# one honest compiled-present witness line (zero MMIO). Default OFF => module + call sites vanish,
# byte-identical to baseline. See arch_arm64.md §ORIN-SDMMC and scripts/orin-sdmmc1-bench.md.
[ -n "${UNAOS_SDMMC:-}" ] && _feats="${_feats}sdmmc,"
# ORIN-SDMMC-2: UNAOS_SDMMC_ARM=1 is the SEPARATE explicit write ARM on top of UNAOS_SDMMC (double-gating —
# writes require BOTH the sdmmc feature AND this arm; the recon knob alone never writes the card). It pulls
# the `sdmmc_arm` feature (which requires `sdmmc`, added here for a lone UNAOS_SDMMC_ARM=1) that compiles in
# the CMD24 write helper + the paranoia ladder (re-census -> GPT-safe scratch region -> stash -> write
# stamped pattern -> verify -> restore -> verify), announced-before-issue and bounded. On virt it prints a
# metal-only ARMED witness line (zero MMIO); on metal (combine with UNAOS_TEGRA=1) it runs the ladder after
# the read census. UNAOS_SDMMC=1 WITHOUT this is byte-identical to the ORIN-SDMMC-1 recon. See
# arch_arm64.md §ORIN-SDMMC and scripts/orin-sdmmc1-bench.md.
[ -n "${UNAOS_SDMMC_ARM:-}" ] && _feats="${_feats}sdmmc_arm,sdmmc,"
# ORIN-INSTALL-1: UNAOS_INSTALL_TARGET_SD=1 is the THIRD (destructive-confirmation) gate on top of the
# double-arm above — it compiles in the first real installer flow (an InstallTarget over the rung-2 armed
# SD write path driving the install:: engine's GPT + FAT32 + sha extent-verify onto the SEATED microSD;
# arch/aarch64/sdmmc_tegra.rs::install_to_sd). Pulls `install_target` (⇒ sdmmc_arm ⇒ sdmmc, all added here
# for a lone knob). The flow announces the sector-0 classification + card CID it is about to destroy before
# the first write and zeroes the ESP metadata region to handle a non-blank card. On virt it prints one
# honest compiled-present-metal-only line (zero MMIO); on metal (combine with UNAOS_TEGRA=1) it runs the
# full install after the read census + rung-2 ladder. UNAOS_SDMMC_ARM=1 WITHOUT this is byte-identical to
# the merged rung-2 ladder. See arch_arm64.md §ORIN-INSTALL-1 and scripts/orin-sdmmc1-bench.md.
[ -n "${UNAOS_INSTALL_TARGET_SD:-}" ] && _feats="${_feats}install_target,sdmmc_arm,sdmmc,"
# AARCH64-VNET: UNAOS_VNET=1 arms the virtio-net-mmio driver + smoltcp bind on the QEMU `virt` machine
# (arch/aarch64/virtio_net.rs) — the QEMU-testable proof of the aarch64 smoltcp seam NET-4 built. Scans
# the fixed virtio-mmio window, drives the LEGACY transport, and runs an ICMP-ping witness against the
# slirp gateway (10.0.2.2). Standalone (does NOT imply tegra/net4): it targets a device QEMU models, so
# it runs on the plain virt GICv3 path (UNAOS_VNET=1 UNAOS_GICV3=1 test-arm). The knob ALSO adds the
# `-netdev user -device virtio-net-device` QEMU args below (VNET_ARG); knob-off leaves BOTH the feature
# and the QEMU invocation byte-identical to baseline. See arch_arm64.md §AARCH64-VNET.
[ -n "${UNAOS_VNET:-}" ] && _feats="${_feats}vnet,"
# PI-GENET: UNAOS_GENET=1 arms the BCM2711 on-board Gigabit Ethernet (Broadcom GENET v5) driver +
# smoltcp bind — the Pi's FIRST network path (arch/aarch64/genet.rs). DTB-resolves the GENET register
# base, poison-honest probes SYS_REV_CTRL to classify whether the build models GENET, brings up UMAC +
# external RGMII PHY + TDMA/RDMA rings, reads the station MAC (DTB local-mac-address, else UMAC regs),
# and binds a smoltcp phy::Device + DHCP/ping over the rings (the shared net_phy seam vnet/net4 ride).
# Standalone (does NOT imply baremetal, mirroring net4/tegra): the MMIO/DMA metal half is
# all(baremetal, aarch64)-gated, so this `check`-path arm compiles only the honest witness half (no
# MMIO); the actual bring-up is the kernel8() build below (which sets baremetal). Pulls dep:smoltcp on
# aarch64. Default OFF => module + call site vanish, smoltcp not pulled, byte-identical. See
# arch_arm64.md §PI-GENET and scripts/pi-genet-bench.md.
[ -n "${UNAOS_GENET:-}" ] && _feats="${_feats}genet,"
if [ -n "$_feats" ]; then
    KERNEL_FEATURES="--features ${_feats%,}"
    echo -e "${COLOR_YELLOW}⚡ kernel features: ${_feats%,}${COLOR_RESET}"
fi

# SMOLNET-DEFAULT: `smolnet` is an x86-only feature — its optional smoltcp dep is x86-gated
# (`[target.'cfg(target_arch="x86_64")'.dependencies]`) and its module + EVERY call site are
# `#[cfg(all(feature="smolnet", target_arch="x86_64"))]`, so the aarch64 compiler never sees one byte
# of it. Feeding it to an aarch64 cargo invocation is a no-op for the emitted CODE, but it shifts the
# crate's cargo `-Cmetadata` fingerprint (the enabled-feature set is hashed into symbol manglings),
# which would perturb the jetson media hash for zero observable change. `arm_features` echoes
# $KERNEL_FEATURES with `smolnet` stripped, so every aarch64 kernel compile gets media BYTE-IDENTICAL
# whether smolnet is default-on or opted out (the aarch64 byte-identity contract, enforced at build,
# not merely claimed). x86 builds keep the full $KERNEL_FEATURES. (Pi `kernel8` builds from its own
# curated K8_FEATS, which never carries smolnet, so it needs no strip.) Always exits 0.
arm_features() {
    case "$KERNEL_FEATURES" in
        --features\ *) ;;
        *) printf '%s' "$KERNEL_FEATURES"; return 0 ;;
    esac
    local f=",${KERNEL_FEATURES#--features },"
    f="${f//,smolnet,/,}"
    f="${f#,}"; f="${f%,}"
    if [ -n "$f" ]; then printf -- '--features %s' "$f"; fi
    return 0
}

# UNAOS_BOOTDIAG=1 turns on the BOOTLOADER's `bootdiag` feature — an additive UEFI boot-time
# diagnostics block (firmware vendor/rev, GOP handle count, ConOut device path, DTB stdout-path +
# serial aliases: the Jetson Orin UART/GOP truth). It gates the bootloader build only (the kernel is
# untouched); OFF by default => byte-identical boot logs. Only the aarch64 bootloader build reads it
# (esp-jetson / the Orin); the x86 bootloader is built by the `builder` crate and is unaffected.
BOOTLOADER_FEATURES=""
_bfeats=""
[ -n "${UNAOS_BOOTDIAG:-}" ] && _bfeats="${_bfeats}bootdiag,"
# UNAOS_JB8_LEVER=1 turns on the bootloader's `jb8lever` feature — the JB8 pre-EBS Usb2Hc
# disconnect+reconnect (forced XhciControllerDxe.Start re-run) on the Jetson Orin. Bench-only risk
# media; OFF by default. aarch64/tegra234-gated at runtime; x86 bootloader unaffected.
[ -n "${UNAOS_JB8_LEVER:-}" ] && _bfeats="${_bfeats}jb8lever,"
if [ -n "$_bfeats" ]; then
    BOOTLOADER_FEATURES="--features ${_bfeats%,}"
    echo -e "${COLOR_YELLOW}⚡ bootloader features: ${_bfeats%,}${COLOR_RESET}"
fi

# UNAOS_GICV3=1 selects the GICv3 model on the aarch64 `virt` board. A trailing `-machine
# gic-version=3` overrides the default gic-version=2 (QEMU keeps the last value of a repeated machine
# property). Only affects the `arm`/`test-arm` (virt) runs; the Pi paths (raspi4b) are always GICv2.
# Default (unset) stays GICv2. This is a build-time nop — it changes only the QEMU invocation, not
# the kernel binary (the driver runtime-detects the version at boot).
GICV3_ARG=""
if [ -n "${UNAOS_GICV3:-}" ]; then
    GICV3_ARG="-machine gic-version=3"
    echo -e "${COLOR_YELLOW}⚡ aarch64 virt: GICv3 (gic-version=3)${COLOR_RESET}"
fi

# AARCH64-VNET: UNAOS_VNET=1 attaches a `virtio-net-device` on the QEMU `virt` virtio-mmio bus with a
# user-mode (slirp) backend, so the `vnet` kernel driver has a real NIC to claim and slirp's gateway
# (10.0.2.2) to ICMP-ping. Legacy transport is QEMU's virtio-mmio default (the driver reads the Version
# register and drives legacy). Only affects the `arm`/`test-arm` (virt) runs. Default (unset) => empty =>
# the QEMU invocation is BYTE-IDENTICAL to baseline (no netdev, no device). This is a build-time nop for
# the kernel binary beyond the `vnet` feature wired above.
VNET_ARG=""
if [ -n "${UNAOS_VNET:-}" ]; then
    VNET_ARG="-netdev user,id=unet -device virtio-net-device,netdev=unet"
    echo -e "${COLOR_YELLOW}⚡ aarch64 virt: virtio-net-device + slirp user net (UNAOS_VNET)${COLOR_RESET}"
fi

# UNAOS_SDIMG (kernel8-run / kernel8-test): the microSD image QEMU raspi4b attaches via `if=sd`.
# Unset -> target/UnaOS-pi4-baremetal.img (the freshly-built flashable image, HELLO.BIN in its FAT32
# root — so QEMU's card IS the boot image). UNAOS_SDIMG=0 omits the drive (the M6g no-SD control);
# any other value is a path override. QEMU attaches the card to the LEGACY SDHCI (the driver's fallback
# base); real Pi 4 silicon routes the slot to EMMC2 (the driver's first-tried base).
#
# UNAOS_FATIMG swaps the usb-storage backing to a FAT image (scripts/make-fat-img.sh) so the
# kernel's read-only FAT reader can be exercised on aarch64 QEMU too. Mirrors the x86 builder knob
# (builder/src/main.rs). Unset -> usb.img (the raw UNA-OS pattern image). Build with `./arroyo fat-img`.
STICK_IMG="${WORKSPACE_DIR}/builder/usb.img"
case "${UNAOS_FATIMG:-}" in
    "") ;;
    1|part) STICK_IMG="${WORKSPACE_DIR}/builder/fat.img";;
    gpt) STICK_IMG="${WORKSPACE_DIR}/builder/fat-gpt.img";;
    p16) STICK_IMG="${WORKSPACE_DIR}/builder/fat16.img";;
    sf) STICK_IMG="${WORKSPACE_DIR}/builder/fat-sf.img";;
    *) STICK_IMG="${UNAOS_FATIMG}";;
esac

# --- Build Functions ---

build_kernel_x86_64() {
    echo -e "${COLOR_YELLOW}⚡ Building x86_64 Kernel...${COLOR_RESET}"
    cd "$WORKSPACE_DIR/crates/kernel"
    cargo +nightly build --release \
      --target ../../x86_64-unaos.json \
      $NIGHTLY_FLAGS $KERNEL_FEATURES
    cd "$WORKSPACE_DIR"
    echo -e "${COLOR_GREEN}✅ x86_64 Kernel Built.${COLOR_RESET}"
}

# U2: build the x86 ring-3 "hello from disk" user program as a SEPARATE flat link product (out of the
# kernel's .text) and objcopy it to target/hello.bin — the artifact the builder copies onto the ESP
# and make-fat-img.sh copies onto the FAT images as HELLO.BIN; the kernel's U2 FAT loader reads it
# off the volume and runs it in ring 3. Mirrors the aarch64 M6c user-blob objcopy step (see kernel8).
# Its own workspace + bare x86_64 target + tiny linker script; the routine is position-independent
# (RIP-relative + inline message), so it runs wherever the kernel copies it. Fast/incremental — safe
# to call at the start of every x86 build path.
build_user_hello_x86() {
    local TOOLBIN; TOOLBIN="$(rustc +nightly --print sysroot)/lib/rustlib/$(rustc +nightly -vV | awk '/host/{print $2}')/bin"
    echo -e "${COLOR_YELLOW}⚡ Building x86 ring-3 user blob (crates/user-blob-x86 → target/hello.bin)...${COLOR_RESET}"
    mkdir -p "${WORKSPACE_DIR}/target"
    cd "$WORKSPACE_DIR/crates/user-blob-x86"
    RUSTFLAGS="-C link-arg=-T${WORKSPACE_DIR}/crates/user-blob-x86/user-blob-x86.ld" \
      cargo +nightly build --release -Z json-target-spec
    cd "$WORKSPACE_DIR"
    "$TOOLBIN/llvm-objcopy" -O binary --only-section=.text \
      "${WORKSPACE_DIR}/crates/user-blob-x86/target/x86_64-unknown-none/release/user-blob-x86" \
      "${WORKSPACE_DIR}/target/hello.bin"
    # The flat blob must exist and begin EXACTLY at _start's first instruction — the kernel enters the
    # copy at offset 0, so a stray byte ahead of _start (a future toolchain reordering objcopy output)
    # would be a metal-only wrong-entry fault QEMU wouldn't reliably catch. _start = `mov rax, 1` =
    # 48 c7 c0 01 00 00 00; assert the leading 4 bytes.
    [ -f "${WORKSPACE_DIR}/target/hello.bin" ] || { echo -e "${COLOR_RED}ERROR: hello.bin missing — blob build failed${COLOR_RESET}"; exit 1; }
    local head4; head4="$(head -c 4 "${WORKSPACE_DIR}/target/hello.bin" | od -An -tx1 | tr -d ' \n')"
    if [ "$head4" != "48c7c001" ]; then
        echo -e "${COLOR_RED}ERROR: hello.bin does not start with _start (mov rax,#1); first 4 bytes = ${head4}${COLOR_RESET}"
        exit 1
    fi
    echo -e "${COLOR_GREEN}✅ x86 user blob: $(wc -c < "${WORKSPACE_DIR}/target/hello.bin" | tr -d ' ') bytes${COLOR_RESET}"
}

build_kernel_aarch64() {
    echo -e "${COLOR_YELLOW}⚡ Building aarch64 Kernel...${COLOR_RESET}"
    cd "$WORKSPACE_DIR/crates/kernel"
    local _af; _af="$(arm_features)"
    # Surface the effective aarch64 feature set when it differs from the (x86) banner — makes the
    # SMOLNET-DEFAULT strip visible so an operator doesn't read `smolnet` off the banner for aarch64.
    [ "$_af" != "$KERNEL_FEATURES" ] && echo -e "${COLOR_YELLOW}⚡ aarch64 effective features: ${_af#--features }${COLOR_RESET}"
    cargo +nightly build --release \
      --target ../../aarch64-unaos.json \
      $NIGHTLY_FLAGS $_af
    cd "$WORKSPACE_DIR"
    echo -e "${COLOR_GREEN}✅ aarch64 Kernel Built.${COLOR_RESET}"
}

# --- Launch Functions ---

launch_x86_64() {
    build_user_hello_x86   # U2: target/hello.bin — the builder copies it onto the ESP
    build_kernel_x86_64

    echo -e "${COLOR_CYAN}⚡ Launching x86_64 via Builder (kernel + bootloader + QEMU)...${COLOR_RESET}"
    cd "$WORKSPACE_DIR/builder"
    cargo +nightly run --release
    cd "$WORKSPACE_DIR"
}

ESP_DIR_ARM="${WORKSPACE_DIR}/target/aarch64_esp"
AAVMF_PATH=""

# Build the aarch64 kernel + bootloader, pack the ESP, and resolve AAVMF firmware
# (sets the global AAVMF_PATH). Shared by launch_aarch64 and test_aarch64.
prepare_aarch64() {
    build_kernel_aarch64

    local KERNEL_BIN="${WORKSPACE_DIR}/target/aarch64-unaos/release/unaos-kernel"
    local BOOTLOADER_BIN="${WORKSPACE_DIR}/target/aarch64-unknown-uefi/release/bootloader.efi"

    echo -e "${COLOR_YELLOW}⚡ Building aarch64 UEFI Bootloader...${COLOR_RESET}"
    cd "$WORKSPACE_DIR/crates/bootloader"
    cargo +nightly build --release --target aarch64-unknown-uefi \
      $BOOTLOADER_FEATURES \
      -Z build-std=core,compiler_builtins,alloc \
      -Z build-std-features=compiler-builtins-mem
    cd "$WORKSPACE_DIR"

    echo -e "${COLOR_CYAN}⚡ Packaging ESP (EFI System Partition)...${COLOR_RESET}"
    rm -rf "$ESP_DIR_ARM"
    mkdir -p "$ESP_DIR_ARM/EFI/BOOT"
    cp "$BOOTLOADER_BIN" "$ESP_DIR_ARM/EFI/BOOT/BOOTAA64.EFI"
    cp "$KERNEL_BIN" "$ESP_DIR_ARM/kernel.elf"

    # Locate AAVMF firmware (macOS/Homebrew + Linux locations)
    local AAVMF_PATHS=(
        "/usr/local/share/qemu/edk2-aarch64-code.fd"
        "/opt/homebrew/share/qemu/edk2-aarch64-code.fd"
        "/usr/share/AAVMF/AAVMF_CODE.fd"
        "/usr/share/edk2/aarch64/QEMU_EFI.fd"
        "/usr/share/qemu-efi-aarch64/QEMU_EFI.fd"
    )
    AAVMF_PATH=""
    for path in "${AAVMF_PATHS[@]}"; do
        if [ -f "$path" ]; then AAVMF_PATH="$path"; break; fi
    done
    if [ -z "$AAVMF_PATH" ]; then
        echo -e "${COLOR_RED}CRITICAL: AAVMF Firmware not found.${COLOR_RESET}"
        exit 1
    fi

    # Ensure the USB mass-storage backing image exists (64 MiB, signed) — mirrors the x86
    # builder (builder/src/main.rs) so `usb-storage` has something to enumerate on aarch64 too.
    local USB_IMG="${WORKSPACE_DIR}/builder/usb.img"
    if [ ! -f "$USB_IMG" ]; then
        echo -e "${COLOR_YELLOW}⚡ Creating usb.img (64 MiB, signed)...${COLOR_RESET}"
        dd if=/dev/zero of="$USB_IMG" bs=1m count=0 seek=64 2>/dev/null
        printf 'UNA-OS-DISK-001-ALPHA' | dd of="$USB_IMG" conv=notrunc 2>/dev/null
    fi
}

launch_aarch64() {
    prepare_aarch64

    echo -e "${COLOR_GREEN}⚡ Launching QEMU (aarch64)...${COLOR_RESET}"
    echo -e "${COLOR_PURPLE}--- EXPECTED BEHAVIOR ---${COLOR_RESET}"
    echo -e "  • Serial: PCI scan ('XHCI CONTROLLER NOT FOUND' is normal — no USB on virt)"
    echo -e "  • Framebuffer shows UnaOS boot screen / shell"
    echo -e "${COLOR_PURPLE}-------------------------${COLOR_RESET}"

    qemu-system-aarch64 \
        -machine virt,virtualization=on,gic-version=2 ${GICV3_ARG} \
        -cpu cortex-a72 \
        -smp 4 \
        -m 1G \
        -drive if=pflash,format=raw,readonly=on,file="$AAVMF_PATH" \
        -drive format=raw,file=fat:rw:"$ESP_DIR_ARM" \
        -serial stdio \
        -device ramfb \
        -device qemu-xhci,id=xhci \
        -drive if=none,id=stick,format=raw,file="${STICK_IMG}" \
        -device usb-storage,bus=xhci.0,drive=stick \
        -device usb-kbd,bus=xhci.0 \
        -device usb-tablet,bus=xhci.0 \
        ${VNET_ARG} \
        -no-reboot \
        -no-shutdown \
        -d guest_errors \
        ${UNAOS_QEMU_EXTRA:-}
}

# Headless aarch64 run: serial -> target/serial-arm.log, self-terminates after N secs.
test_aarch64() {
    local secs="${1:-20}"
    prepare_aarch64

    local logf="${WORKSPACE_DIR}/target/serial-arm.log"
    rm -f "$logf"
    echo -e "${COLOR_CYAN}⚡ Headless aarch64 test (${secs}s). Serial -> ${logf}${COLOR_RESET}"
    qemu-system-aarch64 \
        -machine virt,virtualization=on,gic-version=2 ${GICV3_ARG} -cpu cortex-a72 -smp 4 -m 1G \
        -drive if=pflash,format=raw,readonly=on,file="$AAVMF_PATH" \
        -drive format=raw,file=fat:rw:"$ESP_DIR_ARM" \
        -serial "file:${logf}" -device ramfb -display none \
        -device qemu-xhci,id=xhci \
        -drive if=none,id=stick,format=raw,file="${STICK_IMG}" \
        -device usb-storage,bus=xhci.0,drive=stick \
        -device usb-kbd,bus=xhci.0 -device usb-tablet,bus=xhci.0 \
        ${VNET_ARG} \
        -no-reboot -no-shutdown \
        ${UNAOS_QEMU_EXTRA:-} &
    local qpid=$!
    sleep "$secs"
    kill "$qpid" 2>/dev/null || true
    wait "$qpid" 2>/dev/null || true

    echo ""
    echo -e "${COLOR_PURPLE}════════════ SERIAL LOG (${logf}) ════════════${COLOR_RESET}"
    cat "$logf" 2>/dev/null || echo -e "${COLOR_RED}(no serial log produced)${COLOR_RESET}"
    echo -e "${COLOR_PURPLE}═══════════════════════════════════════════════════${COLOR_RESET}"
    echo -e "${COLOR_GREEN}✅ aarch64 test complete. Log at ${logf}${COLOR_RESET}"
}

# --- Headless Test (capture serial to a file) ---
# Boots x86_64 in QEMU with no display, redirects the serial console to
# target/serial.log, and auto-terminates after N seconds (default 20). Use this for
# fast iteration / sharing boot logs — the log lands at a fixed path every time.
#   ./arroyo test          # 20s headless run, then prints the serial log
#   ./arroyo test 30       # 30s run
SERIAL_LOG="${WORKSPACE_DIR}/target/serial.log"

test_x86_64() {
    local secs="${1:-20}"
    build_user_hello_x86   # U2: target/hello.bin — the builder copies it onto the ESP
    build_kernel_x86_64

    # VPERF: UNAOS_QMP_SHOT=<png path> arms a QMP framebuffer screendump of the headless x86 run
    # (the same qmp_shoot.py technique kernel8-test uses). The port default (4464) auto-bumps past
    # busy listeners so parallel worktree sessions never collide (UNAOS_QMP_PORT overrides the
    # start). The shooter runs in the background: it retries the QMP connect while the builder
    # compiles, waits UNAOS_QMP_WAIT (default secs-3) after QEMU appears, then dumps — inside the
    # builder's kill window. `|| true` guards keep this additive under `set -e`.
    local qmp_pid=""
    if [ -n "${UNAOS_QMP_SHOT:-}" ]; then
        local qmp_port="${UNAOS_QMP_PORT:-4464}"
        while lsof -iTCP:"$qmp_port" -sTCP:LISTEN >/dev/null 2>&1; do qmp_port=$((qmp_port + 1)); done
        export UNAOS_QEMU_EXTRA="${UNAOS_QEMU_EXTRA:-} -qmp tcp:127.0.0.1:${qmp_port},server,nowait"
        python3 "${WORKSPACE_DIR}/scripts/qmp_shoot.py" --port "$qmp_port" --connect-timeout 600 \
            --wait "${UNAOS_QMP_WAIT:-$((secs - 3))}" --out "${UNAOS_QMP_SHOT}" 2>/dev/null &
        qmp_pid=$!
        echo -e "${COLOR_YELLOW}⚡ QMP screendump armed: port ${qmp_port} -> ${UNAOS_QMP_SHOT}${COLOR_RESET}"
    fi

    echo -e "${COLOR_CYAN}⚡ Headless x86_64 test (${secs}s). Serial -> ${SERIAL_LOG}${COLOR_RESET}"
    rm -f "$SERIAL_LOG"
    cd "$WORKSPACE_DIR/builder"
    UNAOS_SERIAL_LOG="$SERIAL_LOG" UNAOS_TEST_SECS="$secs" cargo +nightly run --release
    cd "$WORKSPACE_DIR"
    if [ -n "$qmp_pid" ]; then wait "$qmp_pid" 2>/dev/null || true; fi

    echo ""
    echo -e "${COLOR_PURPLE}════════════ SERIAL LOG (${SERIAL_LOG}) ════════════${COLOR_RESET}"
    cat "$SERIAL_LOG" 2>/dev/null || echo -e "${COLOR_RED}(no serial log produced)${COLOR_RESET}"
    echo -e "${COLOR_PURPLE}═══════════════════════════════════════════════════${COLOR_RESET}"
    echo -e "${COLOR_GREEN}✅ Test run complete. Full log saved at ${SERIAL_LOG}${COLOR_RESET}"
}

