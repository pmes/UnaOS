# --- Entry Point ---

case "${1:-}" in
    x86|x86_64)
        show_expectations_x86
        launch_x86_64
        ;;
    arm|aarch64)
        launch_aarch64
        ;;
    test|test-x86|test_x86)
        test_x86_64 "${2:-20}"
        ;;
    test-arm|test-aarch64)
        test_aarch64 "${2:-20}"
        ;;
    check)
        check_both
        ;;
    build)
        build_both
        ;;
    esp-x86|esp_x86)
        esp_x86
        ;;
    esp-arm|esp_arm)
        esp_arm
        ;;
    esp-jetson|esp_jetson|jetson)
        esp_jetson
        ;;
    fat-img|fat_img|fatimg)
        fat_img
        ;;
    test-fat|test_fat)
        test_fat "${2:-part}" "${3:-30}"
        ;;
    kernel8|baremetal)
        kernel8
        ;;
    kernel8-run|run-pi)
        run_kernel8
        ;;
    kernel8-test|test-pi)
        test_kernel8 "${2:-8}"
        ;;
    clean)
        clean_all
        ;;
    "")
        while true; do
            show_menu
        done
        ;;
    *)
        echo -e "${COLOR_RED}Unknown command: $1${COLOR_RESET}"
        echo "Usage: ./arroyo [x86|arm|test [secs]|test-arm [secs]|check|build|esp-x86|esp-arm|esp-jetson|fat-img|test-fat [part|gpt|p16|sf] [secs]|kernel8|kernel8-run|kernel8-test [secs]|clean]"
        exit 1
        ;;
esac
