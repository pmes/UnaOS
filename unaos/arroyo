show_menu() {
    echo ""
    echo -e "${COLOR_PURPLE}═══════════════════════════════${COLOR_RESET}"
    echo -e "${COLOR_PURPLE}     A R R O Y O   v2.0${COLOR_RESET}"
    echo -e "${COLOR_PURPLE}═══════════════════════════════${COLOR_RESET}"
    echo -e "  ${COLOR_CYAN}1)${COLOR_RESET} Boot x86_64    (Build + QEMU GUI)"
    echo -e "  ${COLOR_CYAN}2)${COLOR_RESET} Boot aarch64   (Build + QEMU)"
    echo -e "  ${COLOR_CYAN}3)${COLOR_RESET} Test x86_64    (Headless, capture serial -> target/serial.log)"
    echo -e "  ${COLOR_CYAN}4)${COLOR_RESET} Check          (Both targets)"
    echo -e "  ${COLOR_CYAN}5)${COLOR_RESET} Build          (Both targets)"
