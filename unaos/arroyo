# Jetson Orin Nano boot media: the aarch64 UEFI ESP (BOOTAA64.EFI + kernel.elf) built with the
# `tegra` UART feature forced on (= UNAOS_TEGRA=1), so the kernel drives the Tegra 16550 at UARTC
# (0x0C28_0000) rather than the QEMU-virt PL011. Boots from NVIDIA's on-board UEFI (JetPack 6 / L4T
# r36) off a single-partition FAT32 USB stick. See docs/dev/OS/01_BOOT_HAL/arch_arm64.md (Orin).
esp_jetson() {
    # Force `tegra` on top of whatever features were already selected (idempotent).
    case ",${_feats}" in
        *",tegra,"*) ;;
        *) _feats="${_feats}tegra,"; KERNEL_FEATURES="--features ${_feats%,}" ;;
    esac
    echo -e "${COLOR_YELLOW}⚡ kernel features (jetson): ${_feats%,}${COLOR_RESET}"
    prepare_aarch64
    echo -e "${COLOR_GREEN}✅ Jetson ESP (tegra): ${ESP_DIR_ARM}${COLOR_RESET}"
    cat <<EOF

  Make Orin boot media (macOS), then boot it:
    1. Format a USB stick as ONE FAT32 partition — ERASES it, pick the right diskN:
         diskutil list                                      # find your USB (external, physical)
         diskutil eraseDisk "MS-DOS FAT32" UNAOS MBRFormat /dev/diskN
    2. Copy the ESP on (no macOS AppleDouble junk), then eject:
         COPYFILE_DISABLE=1 cp -R "${ESP_DIR_ARM}/EFI" "${ESP_DIR_ARM}/kernel.elf" /Volumes/UNAOS/
         sync && diskutil eject /dev/diskN
    3. Plug into an Orin USB-A port, attach a DisplayPort monitor at power-on, then power on.
    4. In the UEFI Shell (tap ESC during boot if it does not drop there):
         connect -r                      # bind FAT drivers — card readers need this
         map -r                           # find the stick's FSx:  (HD(1,MBR,...) on USB/Unit)
         FSx:\\EFI\\BOOT\\BOOTAA64.EFI     # launch UnaOS  (x = the number map showed)
  Serial console: Raspberry Pi Debug Probe on the board TTL header (pin 3 = RX, pin 4 = TX), 115200.
EOF
}

# Bare-metal Raspberry Pi 4: build a flat kernel8.img the GPU ROM loads directly from the microSD
# SLOT (no UEFI/EDK2 — the native Pi boot path), stage the Pi firmware blobs + config.txt around it,
# and build a flashable .img for Raspberry Pi Imager. Links non-PIE at 0x80000 (aarch64-base.json,
# relocation-model=static) with pi-baremetal.ld, then objcopy to a raw binary.
KERNEL8_DIR="${WORKSPACE_DIR}/target/pi_baremetal"
FW_ZIP="${WORKSPACE_DIR}/target/RPi4_UEFI_Firmware_v1.52.zip"
kernel8() {
    local TOOLBIN; TOOLBIN="$(rustc +nightly --print sysroot)/lib/rustlib/$(rustc +nightly -vV | awk '/host/{print $2}')/bin"

    # M6c: build the EL0 user program as a SEPARATE link product (out of the kernel's .text) and
    # objcopy it to a flat binary the kernel include_bytes!s (crates/kernel/src/arch/aarch64/
    # syscall.rs). Built for the SAME bare aarch64 target as the kernel, with its own tiny linker
    # script (crates/user-blob/user-blob.ld); the routine is position-independent (byte-granular `adr`
    # + an inline message), so it runs wherever the kernel copies it. This MUST run BEFORE the kernel
    # build: include_bytes! needs target/user_blob.bin to exist, and its (always-fresh) mtime is what
    # drives the kernel's rebuild when the routine changes. (build-std/target come from the crate's
    # own .cargo/config.toml; it is its own workspace, so `./arroyo check`/`build` never touch it —
    # the blob is validated only here at kernel8-build time, not at `check`.)
    echo -e "${COLOR_YELLOW}⚡ Building EL0 user blob (crates/user-blob → target/user_blob.bin)...${COLOR_RESET}"
    mkdir -p "${WORKSPACE_DIR}/target"
    cd "$WORKSPACE_DIR/crates/user-blob"
    RUSTFLAGS="-C link-arg=-T${WORKSPACE_DIR}/crates/user-blob/user-blob.ld" \
      cargo +nightly build --release -Z json-target-spec
    cd "$WORKSPACE_DIR"
    "$TOOLBIN/llvm-objcopy" -O binary --only-section=.text \
      "${WORKSPACE_DIR}/crates/user-blob/target/aarch64-base/release/user-blob" \
      "${WORKSPACE_DIR}/target/user_blob.bin"
    # The flat blob must exist and begin EXACTLY at _start's first instruction — the kernel enters the
    # copy at offset 0, so a stray byte ahead of _start (a future toolchain reordering objcopy output)
    # would be a metal-only wrong-entry fault QEMU wouldn't reliably catch. _start = `mov x8, #1` =
    # 0xD2800028 = little-endian bytes 28 00 80 d2. Assert both.
    [ -f "${WORKSPACE_DIR}/target/user_blob.bin" ] || { echo -e "${COLOR_RED}ERROR: user_blob.bin missing — blob build failed${COLOR_RESET}"; exit 1; }
    local head4; head4="$(head -c 4 "${WORKSPACE_DIR}/target/user_blob.bin" | od -An -tx1 | tr -d ' \n')"
    if [ "$head4" != "280080d2" ]; then
        echo -e "${COLOR_RED}ERROR: user_blob.bin does not start with _start (mov x8,#1); first 4 bytes = ${head4}${COLOR_RESET}"
        exit 1
    fi
    echo -e "${COLOR_GREEN}✅ EL0 user blob: $(wc -c < "${WORKSPACE_DIR}/target/user_blob.bin" | tr -d ' ') bytes${COLOR_RESET}"

    # K2 (make-enforcement-LIVE): the SAME `cargo build --release` above builds every [[bin]] in the
    # user-blob crate, so `owner-blob` + `imp-blob` are already linked (with user-blob.ld) alongside
    # `user-blob`. objcopy each to a flat binary the kernel8 staging carries onto the card as K2OWN.BIN /
    # K2IMP.BIN — two more distinct 8.3 names => two more distinct prog:<NAME> principals, the honest
    # precondition for by_name_spawn_multivalued(). Position-independent like the hello blob (entry first).
    for b in owner-blob imp-blob; do
        out="${WORKSPACE_DIR}/target/$(echo "$b" | tr - _).bin"
        "$TOOLBIN/llvm-objcopy" -O binary --only-section=.text \
          "${WORKSPACE_DIR}/crates/user-blob/target/aarch64-base/release/${b}" "$out"
        # A flat EL0 program must be non-empty and fit one code page (USER_CODE_SIZE = 0x1000); an empty
        # or oversize blob is a build failure the loader would reject at spawn (BadSize) — catch it here.
        [ -s "$out" ] || { echo -e "${COLOR_RED}ERROR: ${b}.bin missing/empty — K2 blob build failed${COLOR_RESET}"; exit 1; }
        sz="$(wc -c < "$out" | tr -d ' ')"
        [ "$sz" -le 4096 ] || { echo -e "${COLOR_RED}ERROR: ${b}.bin ${sz} bytes > USER_CODE_SIZE (4096)${COLOR_RESET}"; exit 1; }
        # Entry-first assertion (the hello-blob discipline): the kernel enters the flat image at offset 0, so a
        # toolchain reorder putting a non-entry byte first is a metal-only wrong-entry fault QEMU won't catch.
        # Both K2 blobs' _start begins `mov x23, xzr` = 0xAA1F03F7 = little-endian bytes f7 03 1f aa. Assert it.
        head4="$(head -c 4 "$out" | od -An -tx1 | tr -d ' \n')"
        [ "$head4" = "f7031faa" ] || { echo -e "${COLOR_RED}ERROR: ${b}.bin does not start with _start (mov x23,xzr); first 4 bytes = ${head4}${COLOR_RESET}"; exit 1; }
    done
    echo -e "${COLOR_GREEN}✅ K2 EL0 programs: owner_blob.bin ($(wc -c < "${WORKSPACE_DIR}/target/owner_blob.bin" | tr -d ' ') B) + imp_blob.bin ($(wc -c < "${WORKSPACE_DIR}/target/imp_blob.bin" | tr -d ' ') B)${COLOR_RESET}"

    # K2 metal money-shot: UNAOS_K2_LEAVE=1 adds the `k2_leave` feature — k2_liveenf becomes a two-boot
    # cross-reboot power-cycle proof (boot-1 leaves a persisted owned file; boot-2 verifies the live boot
    # rebuild). OFF => the normal same-boot battery (byte-identical). For the ATTENDED Pi bench only.
    local K8_FEATS="baremetal,skip_xhci"
    if [ -n "${UNAOS_K2_LEAVE:-}" ]; then
        K8_FEATS="${K8_FEATS},k2_leave"
        echo -e "${COLOR_YELLOW}  • UNAOS_K2_LEAVE: k2_liveenf → two-boot money-shot mode (boot-1 leaves K2PRIV.BIN; power-cycle; boot-2 verifies)${COLOR_RESET}"
    fi
    # CORE3-PROBE: UNAOS_CORE3PROBE=1 adds the `core3probe` feature — the aarch64 secondary entry
    # stub raw-dumps each core's MPIDR/EL/x0 to the PL011 MMU-off before any Rust, to resolve the
    # CORE3-SMP >1 MiB core-3 regression on an attended bench. OFF => the stub is byte-identical.
    if [ -n "${UNAOS_CORE3PROBE:-}" ]; then
        K8_FEATS="${K8_FEATS},core3probe"
        echo -e "${COLOR_YELLOW}  • UNAOS_CORE3PROBE: secondary stub raw-dumps MPIDR/EL/x0 to PL011 (see scripts/core3-probe-bench.md)${COLOR_RESET}"
    fi
    # NS-SPAN (K7 WATCH rider): UNAOS_NSSPAN=1 adds the `nsspan` feature — instrument the IRQ-masked
    # namespace-lock hold at the three fused persist sites (revoke/grants/grow), tracking the per-site
    # worst-case CNTPCT delta and emitting a `:: NS-SPAN: … ::` line after the K3/K5 fixtures. Closes the
    # Option-A deeper-masked-span bench WATCH. OFF => byte-identical (the whole rider is cfg-gated).
    if [ -n "${UNAOS_NSSPAN:-}" ]; then
        K8_FEATS="${K8_FEATS},nsspan"
        echo -e "${COLOR_YELLOW}  • UNAOS_NSSPAN: instrument the ns-lock hold at revoke/grants/grow, emit :: NS-SPAN: … ::${COLOR_RESET}"
    fi
    echo -e "${COLOR_YELLOW}⚡ Building bare-metal kernel8.img (Pi 4, microSD-slot boot)...${COLOR_RESET}"
    cd "$WORKSPACE_DIR/crates/kernel"
    RUSTFLAGS="-C link-arg=-T${WORKSPACE_DIR}/crates/kernel/pi-baremetal.ld" \
      cargo +nightly build --release --target ../../aarch64-base.json \
      $NIGHTLY_FLAGS --features "$K8_FEATS"
    cd "$WORKSPACE_DIR"

    rm -rf "$KERNEL8_DIR"; mkdir -p "$KERNEL8_DIR/overlays"
    "$TOOLBIN/llvm-objcopy" -O binary \
      "${WORKSPACE_DIR}/target/aarch64-base/release/unaos-kernel" "$KERNEL8_DIR/kernel8.img"
    cp "${WORKSPACE_DIR}/scripts/pi-baremetal-config.txt" "$KERNEL8_DIR/config.txt"

    # Standard Pi GPU firmware blobs (start4.elf/fixup4.dat) + base DTB + the miniuart-bt overlay,
    # pulled from the cached pftf release zip (we use only its stock firmware files here).
    if [ ! -f "$FW_ZIP" ]; then
        echo -e "${COLOR_CYAN}⚡ Fetching Pi firmware (pftf v1.52)...${COLOR_RESET}"
        curl -sL -o "$FW_ZIP" https://github.com/pftf/RPi4/releases/download/v1.52/RPi4_UEFI_Firmware_v1.52.zip
    fi
    unzip -o -j "$FW_ZIP" start4.elf fixup4.dat bcm2711-rpi-4-b.dtb -d "$KERNEL8_DIR" >/dev/null
    unzip -o -j "$FW_ZIP" "overlays/miniuart-bt.dtbo" -d "$KERNEL8_DIR/overlays" >/dev/null
    echo -e "${COLOR_GREEN}✅ Boot files: ${KERNEL8_DIR}${COLOR_RESET}"

    # M6g: carry the EL0 user blob onto the boot media as HELLO.BIN, next to kernel8.img in the FAT32
    # root (make-pi-img.sh ditto's the whole staging dir). On metal the kernel's M6g loader reads this
    # very file back off the microSD it booted from; in QEMU it rides the same image attached via if=sd.
    # Mirror of the x86 carry (make-fat-img.sh's HELLO_BIN block).
    cp "${WORKSPACE_DIR}/target/user_blob.bin" "$KERNEL8_DIR/HELLO.BIN"

    # K2: carry the two additional EL0 programs onto the boot media (make-pi-img.sh ditto's the whole
    # staging dir). K2OWN.BIN = the private-create owner; K2IMP.BIN = the non-owner impostor. Re-created
    # every kernel8 build (KERNEL8_DIR is wiped above), present in every kernel8-test image AND on metal.
    # NEVER collide with HELLO.BIN/SCRATCH.BIN/GROW.BIN (other fixtures load/mutate those).
    cp "${WORKSPACE_DIR}/target/owner_blob.bin" "$KERNEL8_DIR/K2OWN.BIN"
    cp "${WORKSPACE_DIR}/target/imp_blob.bin" "$KERNEL8_DIR/K2IMP.BIN"

    # U9: plant a DEDICATED writable scratch file (NEVER HELLO.BIN — other fixtures load that as EL0 code).
    # 1 KiB (> 512 so fat::probe_once never cats it) of a known 0xEE filler; the u9 File-write demo opens it
    # RW, seeks in, overwrites a 16-byte sentinel IN PLACE, reads it back, and the launcher re-reads the raw
    # sector to prove it changed while the file size did not. Re-created every kernel8 build (KERNEL8_DIR is
    # wiped above + the .img is rebuilt), so each kernel8-test run gets a pristine scratch file.
    head -c 1024 /dev/zero | tr '\000' '\356' > "$KERNEL8_DIR/SCRATCH.BIN"

    # U10: plant a DEDICATED file to GROW (NEVER HELLO.BIN/SCRATCH.BIN). Exactly 512 bytes = one 512-byte
    # cluster of 0xC1 filler (octal \301); the u10 file-growth demo opens it RW, seeks to its EOF (the cluster
    # boundary) and writes past it — forcing fat::write_grow to allocate + zero + chain a SECOND cluster and bump
    # the on-disk directory size — then the launcher re-mounts and proves the size grew, the appended data is on
    # disk, the original cluster is intact, and both FAT copies agree. Re-created every kernel8 build, so each
    # kernel8-test run gets a pristine 1-cluster file to grow.
    head -c 512 /dev/zero | tr '\000' '\301' > "$KERNEL8_DIR/GROW.BIN"

    # BeFS-K3: stage a real 4 MB unafs volume with deterministic fixture files, built by the host
    # `unafs` CLI (the same frozen on-disk format the kernel mounts — KAT-pinned in unaos/libs/fs/unafs).
    # make-pi-img.sh carries it as MBR partition 2 (type 0x7f); the kernel's `locate_unafs` finds it
    # by superblock magic in QEMU (if=sd) and on the flashed card identically. Fixture contents are
    # byte-verified by the K3-mount witness: K3HELLO.TXT (known text) + K3PAT.BIN (12 KiB pattern,
    # byte i = (i*7+3)&0xFF — spans 3 unafs blocks so extent walking is exercised).
    echo -e "${COLOR_YELLOW}⚡ Staging unafs K3 volume (host unafs CLI)...${COLOR_RESET}"
    local UNAFS_K3_IMG="${WORKSPACE_DIR}/target/unafs-k3.img"
    local UNAFS_CLI_MANIFEST="${WORKSPACE_DIR}/../tools/unafs/Cargo.toml"
    rm -f "$UNAFS_K3_IMG"
    printf 'Hello from native UnaFS on the Pi 4!\n' > "${WORKSPACE_DIR}/target/K3HELLO.TXT"
    python3 -c "import sys; sys.stdout.buffer.write(bytes(((i*7+3) & 0xFF) for i in range(12288)))" \
        > "${WORKSPACE_DIR}/target/K3PAT.BIN"
    cargo run -q --manifest-path "$UNAFS_CLI_MANIFEST" -- init -p "$UNAFS_K3_IMG" -s 4
    cargo run -q --manifest-path "$UNAFS_CLI_MANIFEST" -- put "${WORKSPACE_DIR}/target/K3HELLO.TXT" / -i "$UNAFS_K3_IMG"
    cargo run -q --manifest-path "$UNAFS_CLI_MANIFEST" -- put "${WORKSPACE_DIR}/target/K3PAT.BIN" / -i "$UNAFS_K3_IMG"

    bash "${WORKSPACE_DIR}/scripts/make-pi-img.sh" "$KERNEL8_DIR" "${WORKSPACE_DIR}/target/UnaOS-pi4-baremetal.img" 64 "$UNAFS_K3_IMG"
    echo -e "${COLOR_GREEN}✅ Flashable image: target/UnaOS-pi4-baremetal.img — Imager → Use custom → microSD → SD slot.${COLOR_RESET}"
}

# Boot the bare-metal kernel8.img on QEMU's `raspi4b` (emulated BCM2711) — the same flat binary the
# real Pi GPU ROM loads from the microSD slot. raspi4b loads `-kernel` to 0x80000 and enters at EL2,
# and faithfully models the VideoCore mailbox + framebuffer (the buffer is scanned out to the
# display), so this exercises the Phase-2 mailbox framebuffer end to end. Our PL011 (UART0) is the
# FIRST `-serial`; the mini-UART is second. (No EDID in QEMU → the firmware's default 640×480.)
run_kernel8() {
    kernel8 # always rebuild from current source (incremental; ~seconds) so we never run a stale image
    echo -e "${COLOR_GREEN}⚡ Launching QEMU raspi4b (bare-metal kernel8.img)...${COLOR_RESET}"
    echo -e "  • PL011 serial (UART0) on stdio; mailbox framebuffer on the display"
    # M6g: attach the freshly-built flashable image as the SD card (the same bytes that get flashed, so
    # QEMU's card IS the boot image, HELLO.BIN in its FAT32 root). UNAOS_SDIMG=0 omits it (regression
    # control); any other value overrides the path. The `if=sd` card lands on QEMU's LEGACY SDHCI.
    local SDIMG="${UNAOS_SDIMG:-${WORKSPACE_DIR}/target/UnaOS-pi4-baremetal.img}"
    local SD_DRIVE=""
    [ "$SDIMG" != "0" ] && SD_DRIVE="-drive if=sd,format=raw,file=${SDIMG}"
    qemu-system-aarch64 \
        -machine raspi4b \
        -kernel "$KERNEL8_DIR/kernel8.img" \
        -serial mon:stdio -serial null \
        ${SD_DRIVE} \
        ${UNAOS_QEMU_EXTRA:-}
}

# Headless raspi4b test: boot kernel8.img, capture PL011 -> target/serial-pi.log and a QMP
# screendump of the mailbox framebuffer -> target/pi-screen.png, then self-terminate.
test_kernel8() {
    local secs="${1:-8}"
    kernel8 # always rebuild from current source (incremental; ~seconds) so we never test a stale image
    local logf="${WORKSPACE_DIR}/target/serial-pi.log"
    local png="${WORKSPACE_DIR}/target/pi-screen.png"
    rm -f "$logf"
    echo -e "${COLOR_CYAN}⚡ Headless raspi4b test (${secs}s). Serial -> ${logf}, screen -> ${png}${COLOR_RESET}"
    # M6g: attach the flashable image as the SD card (UNAOS_SDIMG=0 omits it for the no-SD control; any
    # other value overrides the path). Same bytes as the flash image, so HELLO.BIN is in its FAT32 root.
    local SDIMG="${UNAOS_SDIMG:-${WORKSPACE_DIR}/target/UnaOS-pi4-baremetal.img}"
    local SD_DRIVE=""
    [ "$SDIMG" != "0" ] && SD_DRIVE="-drive if=sd,format=raw,file=${SDIMG}"
    # QMP port: default 4463, overridable (UNAOS_QMP_PORT) and auto-bumped past ports already in
    # use — parallel worktree sessions (hybrid mode) each run their own QEMU and MUST NOT collide.
    local qmp_port="${UNAOS_QMP_PORT:-4463}"
    while lsof -iTCP:"$qmp_port" -sTCP:LISTEN >/dev/null 2>&1; do qmp_port=$((qmp_port + 1)); done
    qemu-system-aarch64 \
        -machine raspi4b \
        -kernel "$KERNEL8_DIR/kernel8.img" \
        -serial "file:${logf}" -serial null -display none \
        ${SD_DRIVE} \
        -qmp tcp:127.0.0.1:${qmp_port},server,nowait \
        ${UNAOS_QEMU_EXTRA:-} &
    local qpid=$!
    python3 "${WORKSPACE_DIR}/scripts/qmp_shoot.py" --port "$qmp_port" --wait "$((secs - 1))" --out "$png" 2>/dev/null || sleep "$secs"
    kill "$qpid" 2>/dev/null || true
    wait "$qpid" 2>/dev/null || true
    echo -e "${COLOR_GREEN}✅ Serial:${COLOR_RESET} ${logf}    ${COLOR_GREEN}Screen:${COLOR_RESET} ${png}"
}

