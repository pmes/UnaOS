    "") ;;
    1|part) STICK_IMG="${WORKSPACE_DIR}/builder/fat.img";;
    gpt) STICK_IMG="${WORKSPACE_DIR}/builder/fat-gpt.img";;
    p16) STICK_IMG="${WORKSPACE_DIR}/builder/fat16.img";;
    sf) STICK_IMG="${WORKSPACE_DIR}/builder/fat-sf.img";;
    *) STICK_IMG="${UNAOS_FATIMG}";;
esac

# SDHC-1 (x86 `test`/`x86`, DEFAULT-ON): builder/src/main.rs attaches QEMU's generic PCI SD host
# controller (`sdhci-pci` — the SAME class 0x08/subclass 0x05 triple as the 2012 rMBP's built-in
# card reader) with a blank 16 MiB card (target/sdcard.img) in its slot, so the kernel's read-only
