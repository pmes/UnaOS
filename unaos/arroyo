    cp "$FW_CACHE/start4.elf" "$FW_CACHE/fixup4.dat" "$FW_CACHE/bcm2711-rpi-4-b.dtb" "$KERNEL8_DIR/"
    cp "$FW_CACHE/overlays/miniuart-bt.dtbo" "$KERNEL8_DIR/overlays/"
    echo -e "${COLOR_GREEN}✅ Boot files: ${KERNEL8_DIR} (firmware raspberrypi/firmware ${FW_TAG})${COLOR_RESET}"

    # M6g: carry the EL0 user blob onto the boot media as HELLO.BIN, next to kernel8.img in the FAT32
    # root (make-pi-img.sh ditto's the whole staging dir). On metal the kernel's M6g loader reads this
    # very file back off the microSD it booted from; in QEMU it rides the same image attached via if=sd.
    # Mirror of the x86 carry (make-fat-img.sh's HELLO_BIN block).
    cp "${WORKSPACE_DIR}/target/user_blob.bin" "$KERNEL8_DIR/HELLO.BIN"

    # K2: carry the two additional EL0 programs onto the boot media (make-pi-img.sh ditto's the whole
    # staging dir). K2OWN.BIN = the private-create owner; K2IMP.BIN = the non-owner impostor. Re-created
    # every kernel8 build (KERNEL8_DIR is wiped above), present in every kernel8-test image AND on metal.
    # NEVER collide with HELLO.BIN/SCRATCH.BIN/GROW.BIN (other fixtures load/mutate those).
    cp "${WORKSPACE_DIR}/target/owner_blob.bin" "$KERNEL8_DIR/K2OWN.BIN"
    cp "${WORKSPACE_DIR}/target/imp_blob.bin" "$KERNEL8_DIR/K2IMP.BIN"

    # BANDY-1 M4: carry midden (program #3) onto the boot media as MIDDEN.BIN — the bandy_rt
    # launcher spawns it for the round-trip + equivalence witnesses. Distinct 8.3 name => its own
    # IMAGE_SHA256 principal via the sole mint path.
    cp "${WORKSPACE_DIR}/target/midden_blob.bin" "$KERNEL8_DIR/MIDDEN.BIN"

    # ELF-1: carry the minimal static ELF64 program onto the boot media as ELFHELLO.ELF (make-pi-img.sh
    # ditto's the whole staging dir). The kernel's ELF1 witness reads it back off the SD, validates + maps
    # its two PT_LOAD segments, and runs it at EL0. Distinct 8.3 name => its own IMAGE_SHA256 principal via
    # the sole mint path. NEVER collides with the flat fixtures (HELLO/K2*/MIDDEN/SCRATCH/GROW .BIN).
    cp "${WORKSPACE_DIR}/target/ELFHELLO.ELF" "$KERNEL8_DIR/ELFHELLO.ELF"

    # UVUG-1: carry the mini-vug static ELF64 onto the boot media as VUG.ELF (make-pi-img.sh ditto's the
    # whole staging dir). The kernel's UVUG witness reads it back off the SD through the VFS and runs it via
    # the EXEC-1 `run_user_image` path (2 PT_LOAD segments, per-segment W^X); the panel `run /fat/VUG.ELF`
    # runs the same bytes live. Distinct 8.3 name => its own IMAGE_SHA256 principal; never collides with the
    # flat fixtures or ELFHELLO.ELF.
    #
    # VUGSTAGE (PARITY §6.6b): the two PINNED siblings ride along — VUGC.ELF (pinlo, the classic wireframe
    # baseline) and VUGX.ELF (pinhi, the full per-pixel shard). x86 media has carried all three since
    # VUGSCENE; this closes the last of that gap on the Pi. They are launched exactly like VUG.ELF —
    # `bg /fat/VUGX.ELF` at the shell, or a double-click in Quarry's list, both of which take any `.ELF` on
    # the volume — so no kernel change is needed for them to be reachable, only these bytes on the FAT.
    # Cost against the 64 MiB image is the three sizes printed by build_user_vug_aarch64 above (~10 KiB
    # each): under 0.05% of the volume, and the UVUG witness still reads VUG.ELF, unchanged.
    cp "${WORKSPACE_DIR}/target/VUG.ELF" "$KERNEL8_DIR/VUG.ELF"
    cp "${WORKSPACE_DIR}/target/VUGC.ELF" "$KERNEL8_DIR/VUGC.ELF"
    cp "${WORKSPACE_DIR}/target/VUGX.ELF" "$KERNEL8_DIR/VUGX.ELF"
    echo -e "${COLOR_GREEN}✅ vug images staged: VUG.ELF ($(wc -c < "$KERNEL8_DIR/VUG.ELF" | tr -d ' ') B, adaptive) + VUGC.ELF ($(wc -c < "$KERNEL8_DIR/VUGC.ELF" | tr -d ' ') B, pinlo) + VUGX.ELF ($(wc -c < "$KERNEL8_DIR/VUGX.ELF" | tr -d ' ') B, pinhi)${COLOR_RESET}"

    # KVUG: the kernel-vug image beside it — `run /fat/VUGK.ELF` / `bg /fat/VUGK.ELF` on the panel. Its own
    # 8.3 name, so its own IMAGE_SHA256 principal; never collides with VUG.ELF or the flat fixtures.
    cp "${WORKSPACE_DIR}/target/VUGK.ELF" "$KERNEL8_DIR/VUGK.ELF"

    # BGRUN-2: carry the persistence static ELF64 onto the boot media as STAT.ELF (make-pi-img.sh ditto's
    # the whole staging dir). The BGRUN-ST persistence leg reads it back off the SD through the VFS and
    # spawns it detached; the operator drives the same bytes with `bg /fat/STAT.ELF`. Distinct 8.3 name =>
    # its own IMAGE_SHA256 principal; never collides with the flat fixtures, ELFHELLO.ELF or VUG.ELF.
    cp "${WORKSPACE_DIR}/target/STAT.ELF" "$KERNEL8_DIR/STAT.ELF"

    # PULSE-1: carry the cpu-pulse static ELF64 onto the boot media as PULSE.ELF, same reasoning as STAT
    # above — a distinct 8.3 name, its own IMAGE_SHA256 principal, driven by `bg /fat/PULSE.ELF`.
    cp "${WORKSPACE_DIR}/target/PULSE.ELF" "$KERNEL8_DIR/PULSE.ELF"

    # U9: plant a DEDICATED writable scratch file (NEVER HELLO.BIN — other fixtures load that as EL0 code).
    # 1 KiB (> 512 so fat::probe_once never cats it) of a known 0xEE filler; the u9 File-write demo opens it
    # RW, seeks in, overwrites a 16-byte sentinel IN PLACE, reads it back, and the launcher re-reads the raw
    # sector to prove it changed while the file size did not. Re-created every kernel8 build (KERNEL8_DIR is
    # wiped above + the .img is rebuilt), so each kernel8-test run gets a pristine scratch file.
    head -c 1024 /dev/zero | tr '\000' '\356' > "$KERNEL8_DIR/SCRATCH.BIN"

    # U10: plant a DEDICATED file to GROW (NEVER HELLO.BIN/SCRATCH.BIN). Exactly 512 bytes = one 512-byte
    # cluster of 0xC1 filler (octal \301); the u10 file-growth demo opens it RW, seeks to its EOF (the cluster
    # boundary) and writes past it — forcing fat::write_grow to allocate + zero + chain a SECOND cluster and bump
    # the on-disk directory size — then the launcher re-mounts and proves the size grew, the appended data is on
    # disk, the original cluster is intact, and both FAT copies agree. Re-created every kernel8 build, so each
    # kernel8-test run gets a pristine 1-cluster file to grow.
    head -c 512 /dev/zero | tr '\000' '\301' > "$KERNEL8_DIR/GROW.BIN"

    # BeFS-K3: stage a real 4 MB unafs volume with deterministic fixture files, built by the host
    # `unafs` CLI (the same frozen on-disk format the kernel mounts — KAT-pinned in unaos/libs/fs/unafs).
    # make-pi-img.sh carries it as MBR partition 2 (type 0x7f); the kernel's `locate_unafs` finds it
    # by superblock magic in QEMU (if=sd) and on the flashed card identically. Fixture contents are
    # byte-verified by the K3-mount witness: K3HELLO.TXT (known text) + K3PAT.BIN (12 KiB pattern,
    # byte i = (i*7+3)&0xFF — spans 3 unafs blocks so extent walking is exercised).
    echo -e "${COLOR_YELLOW}⚡ Staging unafs K3 volume (host unafs CLI)...${COLOR_RESET}"
    local UNAFS_K3_IMG="${WORKSPACE_DIR}/target/unafs-k3.img"
    local UNAFS_CLI_MANIFEST="${WORKSPACE_DIR}/../tools/unafs/Cargo.toml"
    rm -f "$UNAFS_K3_IMG"
    printf 'Hello from native UnaFS on the Pi 4!\n' > "${WORKSPACE_DIR}/target/K3HELLO.TXT"
    python3 -c "import sys; sys.stdout.buffer.write(bytes(((i*7+3) & 0xFF) for i in range(12288)))" \
        > "${WORKSPACE_DIR}/target/K3PAT.BIN"
    cargo run -q --manifest-path "$UNAFS_CLI_MANIFEST" -- init -p "$UNAFS_K3_IMG" -s 4
    cargo run -q --manifest-path "$UNAFS_CLI_MANIFEST" -- put "${WORKSPACE_DIR}/target/K3HELLO.TXT" / -i "$UNAFS_K3_IMG"
    cargo run -q --manifest-path "$UNAFS_CLI_MANIFEST" -- put "${WORKSPACE_DIR}/target/K3PAT.BIN" / -i "$UNAFS_K3_IMG"

    bash "${WORKSPACE_DIR}/scripts/make-pi-img.sh" "$KERNEL8_DIR" "${WORKSPACE_DIR}/target/UnaOS-pi4-baremetal.img" 64 "$UNAFS_K3_IMG"
    echo -e "${COLOR_GREEN}✅ Flashable image: target/UnaOS-pi4-baremetal.img — Imager → Use custom → microSD → SD slot.${COLOR_RESET}"
    # BUILD-2: release the coarse build lock now that the image is complete — any QEMU phase that
    # follows (kernel8-test / -run / install) uses per-run ports/logs and may overlap other runs.
    k8_lock_release
}

# Boot the bare-metal kernel8.img on QEMU's `raspi4b` (emulated BCM2711) — the same flat binary the
# real Pi GPU ROM loads from the microSD slot. raspi4b loads `-kernel` to 0x80000 and enters at EL2,
# and faithfully models the VideoCore mailbox + framebuffer (the buffer is scanned out to the
# display), so this exercises the Phase-2 mailbox framebuffer end to end. Our PL011 (UART0) is the
# FIRST `-serial`; the mini-UART is second. (No EDID in QEMU → the firmware's default 640×480.)
run_kernel8() {
    kernel8 # always rebuild from current source (incremental; ~seconds) so we never run a stale image
    echo -e "${COLOR_GREEN}⚡ Launching QEMU raspi4b (bare-metal kernel8.img)...${COLOR_RESET}"
    echo -e "  • PL011 serial (UART0) on stdio; mailbox framebuffer on the display"
    # M6g: attach the freshly-built flashable image as the SD card (the same bytes that get flashed, so
    # QEMU's card IS the boot image, HELLO.BIN in its FAT32 root). UNAOS_SDIMG=0 omits it (regression
    # control); any other value overrides the path. The `if=sd` card lands on QEMU's LEGACY SDHCI.
    local SDIMG="${UNAOS_SDIMG:-${WORKSPACE_DIR}/target/UnaOS-pi4-baremetal.img}"
    local SD_DRIVE=""
    [ "$SDIMG" != "0" ] && SD_DRIVE="-drive if=sd,format=raw,file=${SDIMG}"
    qemu-system-aarch64 \
        -machine raspi4b \
        -kernel "$KERNEL8_DIR/kernel8.img" \
        -serial mon:stdio -serial null \
        ${SD_DRIVE} \
        ${UNAOS_QEMU_EXTRA:-}
}

# Headless raspi4b test: boot kernel8.img, capture PL011 -> target/serial-pi.log and a QMP
# screendump of the mailbox framebuffer -> target/pi-screen.png, then self-terminate.
# MBENCH-HONEST: the DEFAULT WINDOW is 60 s, not the old 8 s. 8 s does not finish a pi4 boot on this
# class of host — it kills QEMU part-way through the fixture cascade, so the twelve-plus witnesses that
# print LAST never get a chance to. That shortfall reads as a regression in arcs that touched nothing,
# and it cost four separate executors an investigation each in one round (one of them confirmed it by
# gating a CLEAN base and getting the identical shortfall). The measured floor is 60 s; the spec header
# in scripts/specs/pi4-regression.spec carries the per-window measurements. `kernel8-test` is pi4-only —
# no x86/arm caller reaches this function — so raising the default changes nothing for them.
#
# FLAKE-1 (2026-07-28): two flake modes were artifacted on the bench, and both produced a DISHONEST
# verdict from a harness whose whole point is honesty. Named here so the tool reports them instead.
#   (1) SILENT NO-CAPTURE. A `kernel8-test 150` finished looking green while QEMU had produced NO
#       serial-pi.log at all; mbench then errored `[Errno 2] No such file or directory` and a
#       downstream `&&`/pipe masked the failure. Root cause is a CHECK-THEN-BIND RACE on the QMP
#       port: the `lsof` pre-scan below observes the port free, and QEMU binds it some seconds LATER
#       (after the image build), so a concurrently-launching QEMU from another worktree gate — this
#       host runs several at once — can win the bind and kill ours instantly, before `-serial file:`
#       has created the log. That check-then-bind window CANNOT be closed atomically from shell: we
#       do not hold the socket, QEMU does. The pre-scan stays (it narrows the window and is nearly
#       always sufficient); the RETRY LOOP below is the actual mechanism. A launch that is not alive
#       AND writing within UNAOS_K8T_LIVE_SECS (default 5) is treated as a flake, killed, and
#       relaunched on the next port, bounded at 2 retries.
#   (2) LOAD-SENSITIVE TRUNCATION. Under concurrent build/QEMU load a 150 s window truncated (exit 3,
#       honestly) where 210 s passed clean. Not a bug — but the TRUNCATED explanation now says so.
# EXIT CONTRACT (extends MBENCH-HONEST, does not alter it): 0 PASS / 1 FAIL / 3 TRUNCATED are exactly
# as before; the NEW code 4 means HARNESS FLAKE — the run produced no usable capture, so it is neither
# a pass, a regression, nor a truncation. Never fall through to mbench with a missing log.
# `install_pi()` and `test_aarch64()` share this launch shape and have the same latent race; they are
# deliberately NOT touched by this arc (lane discipline) and can inherit the retry helper later.
test_kernel8() {
    local secs="${1:-60}"
    kernel8 # always rebuild from current source (incremental; ~seconds) so we never test a stale image
    local logf="${WORKSPACE_DIR}/target/serial-pi.log"
    local png="${WORKSPACE_DIR}/target/pi-screen.png"
    rm -f "$logf"
    echo -e "${COLOR_CYAN}⚡ Headless raspi4b test (${secs}s). Serial -> ${logf}, screen -> ${png}${COLOR_RESET}"
    # M6g: attach the flashable image as the SD card (UNAOS_SDIMG=0 omits it for the no-SD control; any
    # other value overrides the path). Same bytes as the flash image, so HELLO.BIN is in its FAT32 root.
    local SDIMG="${UNAOS_SDIMG:-${WORKSPACE_DIR}/target/UnaOS-pi4-baremetal.img}"
    local SD_DRIVE=""
    [ "$SDIMG" != "0" ] && SD_DRIVE="-drive if=sd,format=raw,file=${SDIMG}"
    # QMP port: default 4463, overridable (UNAOS_QMP_PORT) and auto-bumped past ports already in
    # use — parallel worktree sessions (hybrid mode) each run their own QEMU and MUST NOT collide.
    # FLAKE-1: the pre-scan is a NARROWING measure, not a guarantee — see the header. It cannot be
    # atomic (we never hold the socket; QEMU binds it later), so the liveness+retry loop below is the
    # mechanism that actually turns a lost race into a named, bounded retry instead of a false green.
    local qmp_port="${UNAOS_QMP_PORT:-4463}"
    while lsof -iTCP:"$qmp_port" -sTCP:LISTEN >/dev/null 2>&1; do qmp_port=$((qmp_port + 1)); done
    # ── SUITETYPE: the OPTIONAL TYPED-INPUT MODE (default OFF) ────────────────────────────────
    # The hole this closes: the first UART above is attached `-serial file:` — WRITE-ONLY. The
    # guest can talk; nothing can talk back. So every interactive path on the Pi (bare-name
    # launch, the unknown-command refusal, `jobs`) has been un-gateable, and `exec-barename`
    # could only prove its arc by hand-driving a bidirectional chardev outside the suite
    # (PARITY.md §6.6a-closed, "the Pi's regression suite still cannot type").
    #
    # `UNAOS_K8_SCRIPT=<file>` arms it. The file is an inject script in `mbench.py`'s EXISTING
    # grammar (SLEEP / WAIT <secs> <regex> / a bare line to type) so ONE script drives both QEMU
    # here and the metal bridge via `mbench --inject`; `scripts/k8_type.py` is the typist.
    #
    # WHY THE CAPTURE PATH IS UNCHANGED: a socket chardev takes QEMU's own `logfile=`, so the
    # guest's bytes still land in exactly `$logf` and mbench still replays exactly that file.
    # Nothing downstream of the chardev knows the difference. Knob OFF, the qemu argv below is
    # BYTE-FOR-BYTE the argv it has always been — the array is built once and expanded once.
    #
    # SECOND SPEC, not extra REQUIREs in the first one: the three typed witnesses cannot exist in
    # a run that types nothing, so putting them in `pi4-regression.spec` would red the classic
    # gate for behaving correctly. That is the same argument the `[dragperf]`/`[dragwedge]`
    # knob-gated families make in that spec, and it reaches the same conclusion — the base spec's
    # REQUIRED COUNT MUST NOT MOVE. Where those families had to settle for a FORBID (one spec,
    # one battery), typed mode gets real REQUIREs by asserting a SECOND spec, additionally, only
    # when the knob is armed. See scripts/specs/pi4-barename.spec.
    local k8_script="${UNAOS_K8_SCRIPT:-}"
    local k8_spec="${UNAOS_K8_SPEC:-${WORKSPACE_DIR}/scripts/specs/pi4-barename.spec}"
    local type_port="" tpid=""
    local -a SERIAL_ARGS
    if [ -n "$k8_script" ]; then
        if [ ! -f "$k8_script" ]; then
            echo -e "${COLOR_RED}✖ kernel8-test: UNAOS_K8_SCRIPT=${k8_script} does not exist.${COLOR_RESET}"
            return 2
        fi
        # Same check-then-bind caveat as the QMP port above, same narrowing measure; the liveness
        # gate below is what actually turns a lost race into a bounded retry.
        type_port="${UNAOS_K8_PORT:-4801}"
        while lsof -iTCP:"$type_port" -sTCP:LISTEN >/dev/null 2>&1; do type_port=$((type_port + 1)); done
        SERIAL_ARGS=(-chardev "socket,id=k8u0,host=127.0.0.1,port=${type_port},server=on,wait=off,logfile=${logf}" \
                     -serial chardev:k8u0 -serial null -display none)
        echo -e "${COLOR_CYAN}⚡ TYPED MODE armed — UART0 is a bidirectional socket on 127.0.0.1:${type_port}"
        echo -e "  script: ${k8_script}    extra spec: ${k8_spec}${COLOR_RESET}"
    else
        SERIAL_ARGS=(-serial "file:${logf}" -serial null -display none)
    fi
    # FLAKE-1 liveness gate: within UNAOS_K8T_LIVE_SECS (default 5) of launch, the QEMU pid must be
    # ALIVE and $logf must exist and be GROWING PAST 0 BYTES. A QEMU that lost the QMP bind (or died
    # on a bad arg) fails both within milliseconds. 2 retries, each on the next port up.
    local live_secs="${UNAOS_K8T_LIVE_SECS:-5}"
    local max_tries=3           # 1 launch + 2 retries
    local qpid="" attempt=1 launched=0
    while [ "$attempt" -le "$max_tries" ]; do
        rm -f "$logf"
        qemu-system-aarch64 \
            -machine raspi4b \
            -kernel "$KERNEL8_DIR/kernel8.img" \
            "${SERIAL_ARGS[@]}" \
            ${SD_DRIVE} \
            -qmp tcp:127.0.0.1:${qmp_port},server,nowait \
            ${UNAOS_QEMU_EXTRA:-} &
        qpid=$!
        # SUITETYPE: attach the typist IMMEDIATELY, before the liveness poll. A socket chardev
        # whose peer never reads backs up, and the guest's console writes then block or drop —
        # which would corrupt the very capture we are about to assert. k8_type retries the
        # connect, so starting it ahead of QEMU's bind is fine and starting it late is not.
        if [ -n "$k8_script" ]; then
            python3 "${WORKSPACE_DIR}/scripts/k8_type.py" --port "$type_port" \
                --script "$k8_script" --budget "$secs" &
            tpid=$!
        fi
        # Poll at 10 Hz so a healthy launch costs a fraction of a second, not the whole window.
        local ticks=$((live_secs * 10)) t=0
        while [ "$t" -lt "$ticks" ]; do
            if ! kill -0 "$qpid" 2>/dev/null; then break; fi   # died => flake, no point waiting out the window
            if [ -s "$logf" ]; then launched=1; break; fi
            sleep 0.1
            t=$((t + 1))
        done
        if [ "$launched" -eq 1 ]; then break; fi
        kill "$qpid" 2>/dev/null || true                       # reap the remnant before retrying
        wait "$qpid" 2>/dev/null || true
        if [ -n "$tpid" ]; then kill "$tpid" 2>/dev/null || true; wait "$tpid" 2>/dev/null || true; tpid=""; fi
        if [ "$attempt" -lt "$max_tries" ]; then
            # SUITETYPE: the typist's port moves with the retry for the same reason the QMP port does.
            if [ -n "$k8_script" ]; then
                type_port=$((type_port + 1))
                while lsof -iTCP:"$type_port" -sTCP:LISTEN >/dev/null 2>&1; do type_port=$((type_port + 1)); done
                SERIAL_ARGS=(-chardev "socket,id=k8u0,host=127.0.0.1,port=${type_port},server=on,wait=off,logfile=${logf}" \
                             -serial chardev:k8u0 -serial null -display none)
            fi
            echo -e "${COLOR_YELLOW}⚠ kernel8-test: QEMU launch flake (port ${qmp_port}) — retrying on $((qmp_port + 1))${COLOR_RESET}"
            qmp_port=$((qmp_port + 1))
            while lsof -iTCP:"$qmp_port" -sTCP:LISTEN >/dev/null 2>&1; do qmp_port=$((qmp_port + 1)); done
        fi
        attempt=$((attempt + 1))
    done
    if [ "$launched" -ne 1 ]; then
        echo -e "${COLOR_RED}✖ kernel8-test: HARNESS FLAKE — QEMU never came up (no serial capture at ${logf})"
        echo -e "  after ${max_tries} launch attempts, each given ${live_secs}s to write its first byte (last port ${qmp_port})."
        echo -e "  This run carries NO verdict: not a pass, not a regression, not a truncation. Exit 4."
        echo -e "  Usual cause is a lost QMP-port race against a concurrent worktree gate, or a bad"
        echo -e "  UNAOS_QEMU_EXTRA. Re-run when the host is quieter, or pin UNAOS_QMP_PORT to a free port.${COLOR_RESET}"
        if [ -n "$tpid" ]; then kill "$tpid" 2>/dev/null || true; wait "$tpid" 2>/dev/null || true; fi
        return 4
    fi
    python3 "${WORKSPACE_DIR}/scripts/qmp_shoot.py" --port "$qmp_port" --wait "$((secs - 1))" --out "$png" 2>/dev/null || sleep "$secs"
    kill "$qpid" 2>/dev/null || true
    wait "$qpid" 2>/dev/null || true
    if [ -n "$tpid" ]; then kill "$tpid" 2>/dev/null || true; wait "$tpid" 2>/dev/null || true; tpid=""; fi
    echo -e "${COLOR_GREEN}✅ Serial:${COLOR_RESET} ${logf}    ${COLOR_GREEN}Screen:${COLOR_RESET} ${png}"

    # MBENCH-HONEST: ASSERT the capture we just took, and make this command's EXIT STATUS say so.
    # Before this, `kernel8-test` printed a path and always exited 0 — the verdict lived in whatever
    # the reader chose to grep for afterwards, which is precisely how a short boot came to be read as
    # either a pass or a regression. mbench replays the checked-in witness spec and returns
    #   0 PASS (63/63 required, 0 forbidden) | 1 FAIL (a genuine regression) | 3 TRUNCATED (the boot
    #   was cut short — INCONCLUSIVE, neither a pass nor a regression; re-run with a longer window).
    # UNAOS_K8T_ASSERT=0 opts out, for the deliberate off-spec configurations (UNAOS_SDIMG=0 no-card
    # control, single-subsystem knob runs) where the full pi4 spec is not the contract being tested.
    # FLAKE-1 adds exit 4 (HARNESS FLAKE), for the case where there is no capture to assert at all.
    if [ "${UNAOS_K8T_ASSERT:-1}" != "0" ]; then
        # FLAKE-1 belt-and-braces: the liveness gate above should make this unreachable, but a QEMU
        # that dies AFTER writing its first byte can still leave a truncated-to-zero log, and mbench
        # given a missing path errors `[Errno 2] No such file or directory` — which is how the silent
        # no-capture run got read as green. Name it as a flake (4) rather than a regression (1).
        if [ ! -s "$logf" ]; then
            echo -e "${COLOR_RED}✖ kernel8-test: HARNESS FLAKE — ${logf} is missing or empty; there is nothing to assert."
            echo -e "  QEMU came up but produced no serial bytes. This run carries NO verdict — not a pass,"
            echo -e "  not a regression, not a truncation. Exit 4; re-run.${COLOR_RESET}"
            return 4
        fi
        echo -e "${COLOR_CYAN}⚡ mbench: asserting the capture against scripts/specs/pi4-regression.spec${COLOR_RESET}"
        # `|| mrc=$?` rather than a bare call + `$?`: this script runs under `set -e`, so a FAIL (1) or
        # TRUNCATED (3) exit would otherwise abort here and swallow the explanation below.
        local mrc=0
        python3 "${WORKSPACE_DIR}/scripts/mbench.py" --replay "$logf" \
            --spec "${WORKSPACE_DIR}/scripts/specs/pi4-regression.spec" --platform pi || mrc=$?
        if [ "$mrc" -eq 3 ]; then
            echo -e "${COLOR_YELLOW}⚠ kernel8-test: the boot was TRUNCATED at ${secs}s — this run proves NOTHING."
            echo -e "  Missing witnesses here are NOT a regression. Re-run with a longer window: ./arroyo kernel8-test 60${COLOR_RESET}"
            # FLAKE-1: the window that suffices is HOST-LOAD DEPENDENT, not fixed. Artifacted on this
            # bench 2026-07-28: 150 s truncated under concurrent build/QEMU load where 210 s passed clean.
            echo -e "${COLOR_YELLOW}  The needed window scales with HOST LOAD: concurrent builds/QEMU gates slow the boot, so a"
            echo -e "  window that passed on a quiet host truncates on a busy one (bench precedent 2026-07-28: 150 s"
            echo -e "  TRUNCATED under load, 210 s clean). Try './arroyo kernel8-test 210', or re-run when quieter.${COLOR_RESET}"
        fi
        # SUITETYPE: the typed battery, asserted SECOND and ONLY when the knob is armed.
        # Ordering is the honesty argument: the base spec owns the COMPLETE markers, so it is the
        # one that can say TRUNCATED. A typed run whose boot never reached steady state has no
        # business reporting "the bare name did not launch" — the typist had nothing to type at.
        # So a non-PASS base verdict short-circuits and is returned unchanged; the typed spec is
        # only ever consulted on a capture the base spec already called complete and clean.
        if [ -n "$k8_script" ] && [ "$mrc" -eq 0 ]; then
            if [ ! -f "$k8_spec" ]; then
                echo -e "${COLOR_RED}✖ kernel8-test: typed mode armed but ${k8_spec} is missing — nothing gates the typing.${COLOR_RESET}"
                return 2
            fi
            echo -e "${COLOR_CYAN}⚡ mbench: asserting the TYPED battery against ${k8_spec#${WORKSPACE_DIR}/}${COLOR_RESET}"
            python3 "${WORKSPACE_DIR}/scripts/mbench.py" --replay "$logf" \
                --spec "$k8_spec" --platform pi || mrc=$?
            if [ "$mrc" -ne 0 ]; then
                echo -e "${COLOR_RED}✖ kernel8-test: the base spec PASSED and the TYPED battery did not."
                echo -e "  The boot is fine; what failed is an interactive path — or the typing itself never"
                echo -e "  landed. Check the '→ k8_type: typing' lines above: no typing means the socket peer"
                echo -e "  never attached (a harness fault), typing with no witness means a real regression"
                echo -e "  in the path that word takes. Script: ${k8_script}${COLOR_RESET}"
            fi
        fi
        return $mrc
    fi
    echo -e "${COLOR_YELLOW}  • UNAOS_K8T_ASSERT=0 — spec assertion SKIPPED; this run carries no verdict${COLOR_RESET}"
}

# INSTALL-PI live witness: the installer engine's FIRST full end-to-end execution that needs no bench.
# Builds kernel8.img with the three install gates armed (UNAOS_PIINSTALL_CONFIRM ⇒ arm ⇒ piinstall),
# boots raspi4b with a DEDICATED BLANK SCRATCH SD image in the (single) slot — NEVER the kernel8-test
# battery fixture — so the full flow (GPT → FAT32 → payload copy → sha extent-verify) runs against a real
# emulated card and emits `:: INSTALL: pi emmc2 gpt+fat32+copy verify => PASS ::`. Then re-reads the
# scratch image ON THE HOST (GPT signature + protective-MBR + FAT32 boot-sector label bytes at known
# offsets) — the installer's claim verified from OUTSIDE the kernel. See installer_engine.md §INSTALL-PI.
install_pi() {
    local secs="${1:-30}"
    # Arm the three gates (cargo implies the lower two, but exporting all three makes the build log list
    # every gate). Deliberately do NOT arm UNAOS_WITNESS — the scratch card carries only a boot FAT
    # partition to self-clone, so the fixture battery (which reads HELLO.BIN / the unafs volume back on the
    # kernel8-test fixture) must not run.
    export UNAOS_PIINSTALL=1 UNAOS_PIINSTALL_ARM=1 UNAOS_PIINSTALL_CONFIRM=1
    local scratch="${WORKSPACE_DIR}/target/pi-install-scratch.img"
    local logf="${WORKSPACE_DIR}/target/serial-pi-install.log"
    local scratch_mib="${UNAOS_PIINSTALL_MIB:-128}"

    kernel8 # rebuild kernel8.img from current source with the install gates armed

    # INSTALL-PI-2 SELF-CLONE: the scratch card is NOT blank — it is a throwaway COPY of the running
    # system's own boot media (an MBR/FAT32 boot partition carrying the freshly-built kernel8.img +
    # config.txt + firmware, staged from KERNEL8_DIR). The booted installer mounts this partition, snapshots
    # its boot tree into memory, then repartitions the SAME card to GPT+FAT32 and clones the buffered tree
    # back — never the kernel8-test battery fixture. On metal the seated card IS the boot card; the three
    # gates + about-to-destroy announcement are exactly the guard, and a metal leg wants a dedicated card.
    echo -e "${COLOR_CYAN}⚡ Staging ${scratch_mib} MiB self-clone SOURCE card (own boot media) -> ${scratch}${COLOR_RESET}"
    rm -f "$scratch"
    bash "${WORKSPACE_DIR}/scripts/make-pi-install-src.sh" "$KERNEL8_DIR" "$scratch" "$scratch_mib"

    rm -f "$logf"
    echo -e "${COLOR_CYAN}⚡ INSTALL-PI live witness (${secs}s). Serial -> ${logf}${COLOR_RESET}"
    local qmp_port="${UNAOS_QMP_PORT:-4465}"
    while lsof -iTCP:"$qmp_port" -sTCP:LISTEN >/dev/null 2>&1; do qmp_port=$((qmp_port + 1)); done
    qemu-system-aarch64 \
        -machine raspi4b \
        -kernel "$KERNEL8_DIR/kernel8.img" \
        -serial "file:${logf}" -serial null -display none \
        -drive if=sd,format=raw,file="${scratch}" \
        -qmp tcp:127.0.0.1:${qmp_port},server,nowait \
        ${UNAOS_QEMU_EXTRA:-} &
    local qpid=$!
    sleep "$secs"
    kill "$qpid" 2>/dev/null || true
    wait "$qpid" 2>/dev/null || true

    # ── In-kernel verdict ──
    echo -e "${COLOR_YELLOW}── INSTALL-PI serial verdict ──${COLOR_RESET}"
    awk '/PIINSTALL|:: INSTALL:/' "$logf" || true
    if awk '/:: INSTALL: pi emmc2 gpt\+zero\+fat32\+clone\([0-9]+ files\) verify => PASS ::/' "$logf" | grep -q .; then
        echo -e "${COLOR_GREEN}✅ in-kernel: self-clone install PASS line present${COLOR_RESET}"
    else
        echo -e "${COLOR_RED}❌ in-kernel: self-clone install PASS line MISSING${COLOR_RESET}"
    fi

    # ── Host-side verification: read the scratch image back from OUTSIDE the kernel ──
    echo -e "${COLOR_YELLOW}── INSTALL-PI host-side verification (${scratch}) ──${COLOR_RESET}"
    python3 - "$scratch" "$KERNEL8_DIR" <<'PY'
import sys, hashlib, struct
img = sys.argv[1]
srcdir = sys.argv[2]
SEC = 512
ESP_LBA = 2048  # gpt::ESP_LBA_START
f = open(img, "rb")
def rd(lba, n=1):
    f.seek(lba * SEC); return f.read(n * SEC)
lba0 = rd(0); lba1 = rd(1); bs = rd(ESP_LBA)
ok = True
def check(name, cond):
    global ok
    ok = ok and bool(cond)
    print(("  PASS " if cond else "  FAIL ") + name)
# ── Structures (GPT + FAT32) ──
check("protective MBR 0x55AA signature", lba0[510:512] == b"\x55\xaa")
check("protective MBR 0xEE GPT partition type @450", lba0[450] == 0xEE)
check('primary GPT header "EFI PART" @LBA1', lba1[0:8] == b"EFI PART")
check("GPT header revision 1.0", lba1[8:12] == bytes([0,0,1,0]))
check('FAT32 boot sector "FAT32" fs-type @ESP+82', bs[82:87] == b"FAT32")
check('FAT32 volume label "UNAOS" @ESP+71', bs[71:76] == b"UNAOS")
check("FAT32 boot sector 0x55AA @ESP+510", bs[510:512] == b"\x55\xaa")

# ── INSTALL-PI-2 payload: read the CLONED boot files off the FAT32 ESP and byte-verify vs the source ──
# Minimal FAT32 reader: parse the BPB, follow cluster chains through the FAT, walk directories.
bps = struct.unpack_from("<H", bs, 11)[0]
spc = bs[13]
resv = struct.unpack_from("<H", bs, 14)[0]
nfat = bs[16]
fatsz = struct.unpack_from("<I", bs, 36)[0]
rootc = struct.unpack_from("<I", bs, 44)[0]
fat_lba = ESP_LBA + resv
data_lba = ESP_LBA + resv + nfat * fatsz
def clus_lba(c): return data_lba + (c - 2) * spc
FATCACHE = {}
def fat_next(c):
    sec = c // (SEC // 4)
    if sec not in FATCACHE:
        FATCACHE[sec] = rd(fat_lba + sec)
    v = struct.unpack_from("<I", FATCACHE[sec], (c % (SEC // 4)) * 4)[0] & 0x0FFFFFFF
    return v
def chain(c):
    out = []
    while 2 <= c < 0x0FFFFFF8 and len(out) < 1_000_000:
        out.append(c); c = fat_next(c)
    return out
def read_clusters(c, nbytes):
    b = bytearray()
    for cl in chain(c):
        b += rd(clus_lba(cl), spc)
        if len(b) >= nbytes: break
    return bytes(b[:nbytes])
def read_dir(first):
    ents = {}
    raw = b"".join(rd(clus_lba(cl), spc) for cl in chain(first))
    for o in range(0, len(raw), 32):
        e = raw[o:o+32]
        if not e or e[0] == 0x00: break
        if e[0] == 0xE5: continue
        attr = e[11]
        if attr & 0x0F == 0x0F or attr & 0x08: continue  # LFN / volume label
        base = e[0:8].rstrip(b" ").decode("latin1")
        ext = e[8:11].rstrip(b" ").decode("latin1")
        name = base + (("." + ext) if ext else "")
        if name in (".", ".."): continue
        fc = (struct.unpack_from("<H", e, 20)[0] << 16) | struct.unpack_from("<H", e, 26)[0]
        size = struct.unpack_from("<I", e, 28)[0]
        ents[name] = (fc, size, bool(attr & 0x10))
    return ents
def sha(b): return hashlib.sha256(b).hexdigest()
def src_sha(path):
    with open(path, "rb") as s: return sha(s.read())

root = read_dir(rootc)
# Root files cloned from KERNEL8_DIR — byte-verify each against its source.
import os
for cloned, src in [("KERNEL8.IMG","kernel8.img"), ("CONFIG.TXT","config.txt"),
                    ("START4.ELF","start4.elf"), ("FIXUP4.DAT","fixup4.dat")]:
    sp = os.path.join(srcdir, src)
    if cloned not in root:
        check("cloned root file present: " + cloned, False); continue
    fc, size, isdir = root[cloned]
    data = read_clusters(fc, size) if size else b""
    match = (not os.path.isfile(sp)) or (sha(data) == src_sha(sp) and size == os.path.getsize(sp))
    # If the source file is absent (e.g. firmware not staged), presence alone is the check.
    check("cloned + byte-verified: %s (%d B)" % (cloned, size), match if os.path.isfile(sp) else True)
# Subdirectory clone: OVERLAYS/ must exist as a directory and carry OVERLAY1.DAT.
if "OVERLAYS" in root and root["OVERLAYS"][2]:
    sub = read_dir(root["OVERLAYS"][0])
    check("cloned subdir OVERLAYS/ carries OVERLAY1.DAT", "OVERLAY1.DAT" in sub)
else:
    check("cloned subdir OVERLAYS/ present", False)

print("HOST-VERIFY: " + ("PASS" if ok else "FAIL"))
sys.exit(0 if ok else 1)
PY
    local hv=$?
    if [ "$hv" -eq 0 ]; then
        echo -e "${COLOR_GREEN}✅ host-side: GPT + FAT32 structures verified off the scratch image${COLOR_RESET}"
    else
        echo -e "${COLOR_RED}❌ host-side: verification FAILED${COLOR_RESET}"
    fi
}

