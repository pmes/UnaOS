# --- Full battery: the one-command merge-window suite (seat runs this before every merge) ---
# Runs every gate serially, prints one ✅/❌ verdict line per step, exits nonzero on any failure.
# Verdicts come from the serial logs (read with awk — control bytes break plain grep).

# The ledgered test-fat one-line console drop (unaos-hazards; 4 battery re-run cycles on
# 2026-07-11 alone): under battery load the best-effort console intermittently drops ONE
# verdict line — always with ZERO explicit FAIL lines. On exactly that signature, re-run the
# FAT chain once in isolation and let the appended re-run's verdicts stand; a log carrying any
# FAULT_PATTERNS line keeps its red (no retry). All output flows through _step's
# capture, so the pattern + FAULT_PATTERNS scans below see the COMBINED log (the PASS-line tally in
# the summary inflates on a retry day — informational only, the retry announcement line explains).
#
# FAULT-SCAN: the retry gate reads THE shared list, not its own two-pattern copy. It has to: once
# `test-fat` fails on its own fault scan, a PANIC would otherwise reach here, find no `-> FAIL` line,
# be diagnosed as the console drop, and buy a spurious 200 s re-run of a boot already known to be dead.
test_fat_drop_retry() { # $1 = the logfile _step is capturing (READ here, written via stdout)
    if "$0" test-fat sf 300; then return 0; fi
    if ! awk -v p="$FAULT_PATTERNS" 'BEGIN{f=0} $0 ~ p {f=1} END{exit f}' "$1"; then return 1; fi
    echo "battery: test-fat missed its verdict with ZERO FAIL lines — the ledgered console drop; ONE isolated re-run"
    UNAOS_FATIMG=sf "$0" test 200
}

battery() {
    local t0=$SECONDS rc=0 results=""
    local blog_dir="target/battery"; mkdir -p "$blog_dir"

    _step() { # [--build] name, expected-pattern (empty = rc only), logfile[:verdictfile], cmd...
        # kernel8-test doesn't echo its serial log to stdout, so a step may name a separate
        # verdict file (logfile:verdictfile) — patterns are checked there instead.
        #
        # FAULT-SCAN `--build`: this step's verdict file is COMPILER OUTPUT, not a serial capture, so
        # the fault scan below is skipped for it. FAULT_PATTERNS is a list of things a KERNEL says on
        # the wire; a rustc diagnostic that happens to quote one of the source lines that PRINTS them
        # (`serial_println!("EXCEPTION: PAGE FAULT")` and friends are real, greppable source text) would
        # otherwise red a perfectly good build. These steps already carry the verdict that matters —
        # their command's own exit status, which `check` and `esp-jetson` set correctly.
        local faultscan=1
        if [ "$1" = "--build" ]; then faultscan=0; shift; fi
        local name="$1" pattern="$2" logf="${3%%:*}" vf="${3#*:}"; shift 3
        echo -e "${COLOR_CYAN}⚡ battery: ${name}${COLOR_RESET}"
        if "$@" > "$logf" 2>&1; then local crc=0; else local crc=$?; fi
        local ok=1
        [ "$crc" -ne 0 ] && ok=0
        if [ -n "$pattern" ]; then
            awk -v p="$pattern" 'BEGIN{f=1} $0 ~ p {f=0} END{exit f}' "$vf" || ok=0
        fi
        # Any fault line in a serial-backed step is a failure. FAULT-SCAN: the pattern set lives in the
        # single FAULT_PATTERNS list (see above the test legs) — this scan used to carry its own copy of
        # the three FAIL spellings and knew nothing about PANIC or EXCEPTION:, which is the same blind
        # spot that let a panicked boot exit 0 from `./arroyo test`.
        if [ "$faultscan" -eq 1 ]; then
            awk -v p="$FAULT_PATTERNS" 'BEGIN{f=0} $0 ~ p {f=1} END{exit f}' "$vf" || ok=0
        fi
        if [ "$ok" -eq 1 ]; then
            results="${results}  ✅ ${name}\n"
        else
            results="${results}  ❌ ${name}  (log: ${logf})\n"; rc=1
        fi
    }

    _step --build "check (both arches)"  ""                  "$blog_dir/check.log"        "$0" check
    _step --build "check (tegra)"        ""                  "$blog_dir/check-tegra.log"  env UNAOS_TEGRA=1 "$0" check
    _step "x86 test 25 (MISSION)"      "MISSION SUCCESS"     "$blog_dir/test-x86.log"     "$0" test 25
    _step "x86 test-fat sf 300"        "U11m2.*-> PASS"      "$blog_dir/test-fat.log"     test_fat_drop_retry "$blog_dir/test-fat.log"
    _step "arm virt v2 (MISSION)"      "MISSION SUCCESS"     "$blog_dir/test-arm-v2.log"  "$0" test-arm 22
    # USB-WRITE: assert the BOT WRITE(10) RMW+readback+restore witness in the MISSION logs just run
    # (cheap re-grep of the existing serial capture — no QEMU re-run). A `-> FAIL` usbw line is
    # already caught by the generic FAIL scan; these steps require the positive `ok` witness present.
    _step "x86 usb-write witness"      "usbw. write lba=.* ok" "$blog_dir/usbw-x86.log"    cat "$blog_dir/test-x86.log"
    _step "arm usb-write witness"      "usbw. write lba=.* ok" "$blog_dir/usbw-arm.log"    cat "$blog_dir/test-arm-v2.log"
    # FATIMG-CI: the SHIPPED EL0 app-launch path — `bg /fat/STAT.ELF` / `bg /fat/VUG.ELF` read off a
    # REAL attached FAT volume, through the ELF loader, into a compositor window. Same cheap re-grep
    # shape as the usb-write witnesses above (no extra QEMU run): the FAT-attached boot already
    # happened in the `test-fat` step, these two just require its POSITIVE verdicts to be present.
    #
    # WHY THESE ARE THEIR OWN STEPS. The witnesses SKIP with one honest line when no block device is
    # attached, and `./arroyo test` attaches none — so on a plain test run their absence is silence,
    # not red. Before the Linux backend landed in scripts/make-fat-img.sh, no FAT volume could be
    # built on a Linux box at all, so `test-fat` could not run there and the whole configuration was
    # unwitnessed: a `find_in_root` result that was exactly DOUBLE the true file size sat on this path
    # undetected until an operator hit it by hand. Asserting the positive verdict — rather than
    # trusting the absence of a negative — is what makes that impossible to repeat.
    _step "x86 STAT.ELF off FAT (WINX-2)" "WINX-2: STAT.ELF end-to-end .* -> PASS" "$blog_dir/winx2-fat.log" cat "$blog_dir/test-fat.log"
    _step "x86 VUG.ELF off FAT (WINX-8)"  "WINX-8: VUG.ELF end-to-end .* -> PASS"  "$blog_dir/winx8-fat.log" cat "$blog_dir/test-fat.log"
    # PULSE-1: the third shipped EL0 app on that same path. Same cheap re-grep of the `test-fat` capture, and
    # the same reason it is its own step rather than trusting the absence of a FAIL: the witness SKIPS with one
    # honest line when no block device is attached, so on a plain `./arroyo test` its absence is silence, not
    # red. It is also the only leg that proves SYS_CPUPULSE(49) works across the privilege boundary.
    _step "x86 PULSE.ELF off FAT (PULSE-W)" "PULSE-W: PULSE.ELF end-to-end .* -> PASS" "$blog_dir/pulsew-fat.log" cat "$blog_dir/test-fat.log"
    _step "arm virt v3 (CAPSTONE 6/6)" "CAPSTONE COMPLETE"   "$blog_dir/test-arm-v3.log"  env UNAOS_GICV3=1 "$0" test-arm 40
    # MBENCH-HONEST: this step's verdict is now the MBENCH REPLAY's exit status, which `kernel8-test`
    # propagates (see test_kernel8). It used to be a single `awk` for CAPSTONE COMPLETE against the
    # serial log, and that assertion COULD NOT GO RED on a short boot: CAPSTONE prints ~line 111 of a
    # ~1700-line capture, so every truncation this gate exists to catch still satisfied it while dozens
    # of tail witnesses were missing. The pattern argument is deliberately EMPTY — the spec's 63
    # REQUIRE/COUNT directives are the assertion now, and the generic `-> FAIL`/`FAIL ::` scan still
    # runs against target/serial-pi.log (NOT against the step log, which quotes those strings as FORBID
    # PATTERN TEXT in the verdict table and would false-red on every run).
    _step "pi4 kernel8-test 60 (mbench 63/63)" ""            "$blog_dir/kernel8.log:target/serial-pi.log" "$0" kernel8-test 60
    # A TRUNCATED pi4 step is red — but it is a DIFFERENT red from a regression, and the summary says so
    # rather than leaving the reader to open the log and guess.
    if awk 'BEGIN{f=1} /MBENCH TRUNCATED/{f=0} END{exit f}' "$blog_dir/kernel8.log" 2>/dev/null; then
        results="${results}       ↳ TRUNCATED (INCONCLUSIVE): the pi boot was CUT SHORT, not regressed — re-run before bisecting (${blog_dir}/kernel8.log)\n"
    fi
    _step --build "esp-jetson (links)"   ""                  "$blog_dir/esp-jetson.log"   env UNAOS_TEGRA=1 "$0" esp-jetson

    local passes; passes=$(awk '/-> PASS|: PASS/{n++} END{print n+0}' "$blog_dir/test-fat.log" target/serial-pi.log 2>/dev/null || echo '?')
    echo -e "\n${COLOR_PURPLE}════════════ BATTERY SUMMARY ($(( SECONDS - t0 ))s) ════════════${COLOR_RESET}"
    echo -e "$results"
    echo "  PASS lines (fat+pi): $passes   step logs: $blog_dir/"
    echo -e "  ${COLOR_CYAN}⚠ this run clobbered any x86 esp media — rebuild UNAOS_USBDEBUG=1 esp-x86 LAST before flashing${COLOR_RESET}"
    if [ "$rc" -eq 0 ]; then
        echo -e "${COLOR_GREEN}✅ FULL BATTERY GREEN${COLOR_RESET}"
    else
        echo -e "${COLOR_RED}❌ BATTERY FAILED — see step logs${COLOR_RESET}"
    fi
    return $rc
}

