    echo -e "${COLOR_YELLOW}⚡ UNAOS_NOSDHCI: no sdhci-pci/sd-card in QEMU — SDHC-1 probe reports no controller${COLOR_RESET}"
fi

# --- Build Functions ---

# WXN-x86 SECTION GATE (x86_64 ONLY): no GLOBAL CODE symbol may live in `.rodata`.
#
# WHAT IT CATCHES. `global_asm!` blocks are concatenated per CODEGEN UNIT, not per file, so a block
# that opens `.section .rodata` and never restores it leaves the section changed for whatever the
# partitioner happens to append next — which may be another file's code entirely. That is exactly
# how `switch_context` (sched.rs) came to be ASSEMBLED INTO `.rodata` behind smp.rs's AP trampoline:
# `nm` typed it `R`, not `T`, and the kernel executed it out of a segment whose LOAD is `R` with no
# `E`. Nothing in the tree said a word — it compiled, it linked, it booted, and every existing
# witness stayed green.
#
# WHY A GATE AND NOT A BELT. A `.text` directive at the top of the victim block shields that one
# block. This shields the CLASS: any file, any feature set, any future `global_asm!`. It also has to
# exist before M3b can clear `X` from `.rodata` — the milestone is unsafe while code can land there.
#
# THE RULE. In the linked x86 kernel ELF, a GLOBAL symbol in `.rodata*` whose type is FUNC or NOTYPE
# (i.e. code, or an assembler label that is not typed data) is a FAULT, unless it is one of the AP
# trampoline's own labels — `ap_trampoline_*` / `ap_param_*` — which live in `.rodata` DELIBERATELY
# (they are the 0xd8 blob `start_aps` copies to 0x8000 and the parameter cells beside it, and the
# sweep's `gib_tramp=` accounting depends on where they are). GLOBAL `OBJECT` symbols are read-only
# DATA and are none of this gate's business: `core`'s WHITESPACE_MAP is one and always has been.
#
# SCOPE: x86_64 only, by construction — this function is called from the x86 build path and from
# `esp-x86`, never from the aarch64 or Pi ones. The aarch64 leaks the M3 review found
# (`main.rs:33` `.text.boot`, `exceptions.rs:116` `.text.exception_vectors`) are the same class but
# NOT the same rule: they leak into TEXT sections a linker script orders, so the assertion that
# would catch them is about which symbol comes FIRST in `.text.boot`, not about `.rodata`. Out of
# this lane; see docs and the pi track's brief.
gate_x86_rodata_no_code() {
    local elf="$1"
    [ -f "$elf" ] || { echo -e "${COLOR_RED}ERROR: .rodata gate: ${elf} missing — the x86 kernel link produced no ELF${COLOR_RESET}"; exit 1; }
    local TOOLBIN; TOOLBIN="$(rustc +nightly --print sysroot)/lib/rustlib/$(rustc +nightly -vV | awk '/host/{print $2}')/bin"
    local NM="$TOOLBIN/llvm-nm"
    [ -x "$NM" ] || NM="$(command -v llvm-nm 2>/dev/null || true)"
    # No silent downgrade: a gate that cannot read the ELF must fail the build, not wave it through.
    [ -n "$NM" ] && [ -x "$NM" ] || { echo -e "${COLOR_RED}ERROR: .rodata gate: no llvm-nm (looked in ${TOOLBIN} and on PATH) — the gate could not run${COLOR_RESET}"; exit 1; }
    # `nm --format=sysv` is the one format that prints the SECTION NAME beside the class, so the rule
    # can be about `.rodata` itself rather than about nm's `R` letter (which covers every read-only
    # section). Uppercase class = GLOBAL. Fields: Name|Value|Class|Type|Size|Line|Section.
    local offenders
    offenders="$("$NM" --defined-only --format=sysv "$elf" 2>/dev/null | awk -F'|' '
        {
            name = $1; class = $3; type = $4; sect = $7
            gsub(/[ \t]/, "", class); gsub(/[ \t]/, "", type)
            gsub(/^[ \t]+|[ \t]+$/, "", name); gsub(/^[ \t]+|[ \t]+$/, "", sect)
            if (class != "R") next                       # GLOBAL read-only data symbols only
            if (sect !~ /^\.rodata(\.|$)/) next
            if (type != "FUNC" && type != "NOTYPE") next  # OBJECT = genuine read-only data
            if (name ~ /^ap_trampoline_/ || name ~ /^ap_param_/) next
            print name "  (" type ", " sect ")"
        }' | sort -u)"
    if [ -n "$offenders" ]; then
        echo -e "${COLOR_RED}ERROR: .rodata gate: GLOBAL code symbol(s) assembled into .rodata in ${elf}:${COLOR_RESET}"
        echo "$offenders" | sed 's/^/       /'
        echo -e "${COLOR_RED}       A global_asm! block changed the section and did not change it back, so the${COLOR_RESET}"
        echo -e "${COLOR_RED}       codegen unit appended the symbol(s) above into .rodata. Wrap the offending block${COLOR_RESET}"
        echo -e "${COLOR_RED}       in .pushsection/.popsection (see arch/x86_64/smp.rs, the AP trampoline).${COLOR_RESET}"
        exit 1
    fi
    echo -e "${COLOR_GREEN}✅ .rodata gate: no GLOBAL code symbol in .rodata (only the AP trampoline's own labels)${COLOR_RESET}"
}

build_kernel_x86_64() {
    echo -e "${COLOR_YELLOW}⚡ Building x86_64 Kernel...${COLOR_RESET}"
    cd "$WORKSPACE_DIR/crates/kernel"
    cargo +nightly build --release \
      --target ../../x86_64-unaos.json \
      $NIGHTLY_FLAGS $KERNEL_FEATURES
    cd "$WORKSPACE_DIR"
    gate_x86_rodata_no_code "${WORKSPACE_DIR}/target/x86_64-unaos/release/unaos-kernel"
    echo -e "${COLOR_GREEN}✅ x86_64 Kernel Built.${COLOR_RESET}"
}

# U2: build the x86 ring-3 "hello from disk" user program as a SEPARATE flat link product (out of the
# kernel's .text) and objcopy it to target/hello.bin — the artifact the builder copies onto the ESP
# and make-fat-img.sh copies onto the FAT images as HELLO.BIN; the kernel's U2 FAT loader reads it
# off the volume and runs it in ring 3. Mirrors the aarch64 M6c user-blob objcopy step (see kernel8).
# Its own workspace + bare x86_64 target + tiny linker script; the routine is position-independent
# (RIP-relative + inline message), so it runs wherever the kernel copies it. Fast/incremental — safe
# to call at the start of every x86 build path.
build_user_hello_x86() {
    local TOOLBIN; TOOLBIN="$(rustc +nightly --print sysroot)/lib/rustlib/$(rustc +nightly -vV | awk '/host/{print $2}')/bin"
    echo -e "${COLOR_YELLOW}⚡ Building x86 ring-3 user blob (crates/user-blob-x86 → target/hello.bin)...${COLOR_RESET}"
    mkdir -p "${WORKSPACE_DIR}/target"
    cd "$WORKSPACE_DIR/crates/user-blob-x86"
    RUSTFLAGS="-C link-arg=-T${WORKSPACE_DIR}/crates/user-blob-x86/user-blob-x86.ld" \
      cargo +nightly build --release -Z json-target-spec
    cd "$WORKSPACE_DIR"
    "$TOOLBIN/llvm-objcopy" -O binary --only-section=.text \
      "${WORKSPACE_DIR}/crates/user-blob-x86/target/x86_64-unknown-none/release/user-blob-x86" \
      "${WORKSPACE_DIR}/target/hello.bin"
    # The flat blob must exist and begin EXACTLY at _start's first instruction — the kernel enters the
    # copy at offset 0, so a stray byte ahead of _start (a future toolchain reordering objcopy output)
    # would be a metal-only wrong-entry fault QEMU wouldn't reliably catch. _start = `mov rax, 1` =
    # 48 c7 c0 01 00 00 00; assert the leading 4 bytes.
    [ -f "${WORKSPACE_DIR}/target/hello.bin" ] || { echo -e "${COLOR_RED}ERROR: hello.bin missing — blob build failed${COLOR_RESET}"; exit 1; }
    local head4; head4="$(head -c 4 "${WORKSPACE_DIR}/target/hello.bin" | od -An -tx1 | tr -d ' \n')"
    if [ "$head4" != "48c7c001" ]; then
        echo -e "${COLOR_RED}ERROR: hello.bin does not start with _start (mov rax,#1); first 4 bytes = ${head4}${COLOR_RESET}"
        exit 1
    fi
    echo -e "${COLOR_GREEN}✅ x86 user blob: $(wc -c < "${WORKSPACE_DIR}/target/hello.bin" | tr -d ' ') bytes${COLOR_RESET}"
}

# WINX-5: build the x86_64 static ELF64 EL0 PERSISTENCE program (crates/user-stat → target/STAT-X86.ELF).
# The x86 twin of the aarch64 STAT.ELF build in build_user_aarch64(): same crate, same app logic, same
# linker-script SHAPE (crates/user-stat/user-stat-x86.ld — two PT_LOAD segments via a PHDRS clause);
# only the per-arch syscall stubs and the target differ. `-z max-page-size=0x1000` packs the segments on
# 4 KiB boundaries so the image fits the kernel's 16 KiB slot window.
#
# The crate's .cargo/config.toml defaults to the aarch64 target, so `--target` is passed EXPLICITLY here
# to override it; the two builds therefore land in separate target subdirectories and never clobber each
# other's artifacts. The output keeps a distinct name (STAT-X86.ELF) for the same reason — both arches'
# images live in the one shared target/ directory, and the staging steps pick the right one.
build_user_stat_x86() {
    local TOOLBIN; TOOLBIN="$(rustc +nightly --print sysroot)/lib/rustlib/$(rustc +nightly -vV | awk '/host/{print $2}')/bin"
    echo -e "${COLOR_YELLOW}⚡ Building x86 EL0 persistence static-ELF program (crates/user-stat → target/STAT-X86.ELF)...${COLOR_RESET}"
    mkdir -p "${WORKSPACE_DIR}/target"
    cd "$WORKSPACE_DIR/crates/user-stat"
    RUSTFLAGS="-C link-arg=-T${WORKSPACE_DIR}/crates/user-stat/user-stat-x86.ld -C link-arg=-z -C link-arg=max-page-size=0x1000" \
      cargo +nightly build --release -Z json-target-spec --target "${WORKSPACE_DIR}/x86_64-unknown-none.json"
    cd "$WORKSPACE_DIR"
    "$TOOLBIN/llvm-objcopy" --strip-all \
      "${WORKSPACE_DIR}/crates/user-stat/target/x86_64-unknown-none/release/user-stat" \
      "${WORKSPACE_DIR}/target/STAT-X86.ELF"
    # The same three checks the aarch64 STAT build makes, plus the e_machine one that matters here: the
    # loader rejects a wrong-arch image, and staging an aarch64 STAT.ELF on x86 media would be a
    # confusing bench failure rather than an obvious build failure.
    [ -s "${WORKSPACE_DIR}/target/STAT-X86.ELF" ] || { echo -e "${COLOR_RED}ERROR: STAT-X86.ELF missing/empty — x86 STAT build failed${COLOR_RESET}"; exit 1; }
    local smag; smag="$(head -c 4 "${WORKSPACE_DIR}/target/STAT-X86.ELF" | od -An -tx1 | tr -d ' \n')"
    [ "$smag" = "7f454c46" ] || { echo -e "${COLOR_RED}ERROR: STAT-X86.ELF does not start with the ELF magic; first 4 bytes = ${smag}${COLOR_RESET}"; exit 1; }
    local smach; smach="$(od -An -tx1 -j18 -N2 "${WORKSPACE_DIR}/target/STAT-X86.ELF" | tr -d ' \n')"
    [ "$smach" = "3e00" ] || { echo -e "${COLOR_RED}ERROR: STAT-X86.ELF e_machine is ${smach}, want 3e00 (EM_X86_64=62 LE)${COLOR_RESET}"; exit 1; }
    local ssz; ssz="$(wc -c < "${WORKSPACE_DIR}/target/STAT-X86.ELF" | tr -d ' ')"
    [ "$ssz" -le 16384 ] || { echo -e "${COLOR_RED}ERROR: STAT-X86.ELF ${ssz} bytes > the 16384-byte EL0 user window${COLOR_RESET}"; exit 1; }
    echo -e "${COLOR_GREEN}✅ x86 static-ELF EL0 persistence program: STAT-X86.ELF (${ssz} B)${COLOR_RESET}"
}

# WINX-7: build the x86_64 static ELF64 EL0 MINI-VUG program (crates/user-vug → target/VUG-X86.ELF).
# The x86 twin of the aarch64 VUG.ELF build in build_user_aarch64(), and the exact shape of
# build_user_stat_x86 above: same crate, same app logic, same linker-script SHAPE
# (crates/user-vug/user-vug-x86.ld — two PT_LOAD segments via a PHDRS clause); only the per-arch
# syscall stubs and the target differ.
#
# Unlike STAT, this program exercises the WINX-7 verbs — SYS_THREAD_SPAWN/JOIN/EXIT, SYS_FUTEX and
# SYS_INPUT_POLL — so a build of it that links is also the first end-to-end statement that those
# stubs and those numbers agree with the kernel's.
#
# The crate's .cargo/config.toml defaults to the aarch64 target, so `--target` is passed EXPLICITLY
# here to override it; the two builds land in separate target subdirectories and never clobber each
# other. The output keeps a distinct name (VUG-X86.ELF) because both arches' images share one
# target/ directory and the staging steps pick the right one.
# VUGSCENE: one image of crates/user-vug, named by $1 (the target/ basename) and built with the cargo
# features in $2. Three images come out of the same source — see the LOD_PIN note in crates/user-vug:
#
#   VUG-X86.ELF   (no features)  the ADAPTIVE detail ladder. The default; what the desktop launches.
#   VUGC-X86.ELF  (pinlo)        level 0 forever — the CLASSIC wireframe, for a slow machine and for
#                                keeping old fps baselines comparable.
#   VUGX-X86.ELF  (pinhi)        the full shard forever, for measuring the heaviest frame this draws.
#   VUGK-X86.ELF  (kvug)         KVUG — the IN-KERNEL vug (crates/kernel/src/vug.rs) carried into EL0:
#                                `m` cycles its three screens, the classic wireframe (Mode::Wire), the
#                                painter's-algorithm faceted crystal (Mode::Solid) and the BeBox tribute.
#                                For a very slow machine, and for history. It replaces the shard
#                                raytracer rather than joining it — both do not fit one 0x2000 .text.
#
# `bg`/`run` take a path and no argv on either arch (shell.rs: `match args.first()`), so a build feature is
# the only channel a pin can travel down. The three land on the media as VUG.ELF / VUGC.ELF / VUGX.ELF —
# all 8.3-clean, all in the FAT root beside STAT.ELF and PULSE.ELF.
#
# `--target-dir` keeps the three cargo builds apart: the feature set is part of the fingerprint, so a shared
# directory would rebuild (and relink) the whole crate on every call, and a stale artifact could be picked
# up by the objcopy of the NEXT image if a build ever failed after the first.
build_one_vug_x86() {
    local out="$1" feats="$2"
    local TOOLBIN; TOOLBIN="$(rustc +nightly --print sysroot)/lib/rustlib/$(rustc +nightly -vV | awk '/host/{print $2}')/bin"
    echo -e "${COLOR_YELLOW}⚡ Building x86 EL0 mini-vug static-ELF program (crates/user-vug${feats:+ [$feats]} → target/${out})...${COLOR_RESET}"
    mkdir -p "${WORKSPACE_DIR}/target"
    cd "$WORKSPACE_DIR/crates/user-vug"
    local tdir="${WORKSPACE_DIR}/crates/user-vug/target/x86${feats:+-$feats}"
    RUSTFLAGS="-C link-arg=-T${WORKSPACE_DIR}/crates/user-vug/user-vug-x86.ld -C link-arg=-z -C link-arg=max-page-size=0x1000" \
      cargo +nightly build --release -Z json-target-spec --target "${WORKSPACE_DIR}/x86_64-unknown-none.json" \
      --target-dir "$tdir" ${feats:+--features "$feats"}
    cd "$WORKSPACE_DIR"
    "$TOOLBIN/llvm-objcopy" --strip-all \
      "${tdir}/x86_64-unknown-none/release/user-vug" \
      "${WORKSPACE_DIR}/target/${out}"
    # The same four checks the x86 STAT build makes. The e_machine one is the load-bearing addition
    # over the aarch64 build: the loader rejects a wrong-arch image, and staging an aarch64 VUG.ELF on
    # x86 media would be a confusing bench failure rather than an obvious build failure.
    [ -s "${WORKSPACE_DIR}/target/${out}" ] || { echo -e "${COLOR_RED}ERROR: ${out} missing/empty — x86 VUG build failed${COLOR_RESET}"; exit 1; }
    local vmag; vmag="$(head -c 4 "${WORKSPACE_DIR}/target/${out}" | od -An -tx1 | tr -d ' \n')"
    [ "$vmag" = "7f454c46" ] || { echo -e "${COLOR_RED}ERROR: ${out} does not start with the ELF magic; first 4 bytes = ${vmag}${COLOR_RESET}"; exit 1; }
    local vmach; vmach="$(od -An -tx1 -j18 -N2 "${WORKSPACE_DIR}/target/${out}" | tr -d ' \n')"
    [ "$vmach" = "3e00" ] || { echo -e "${COLOR_RED}ERROR: ${out} e_machine is ${vmach}, want 3e00 (EM_X86_64=62 LE)${COLOR_RESET}"; exit 1; }
    local vsz; vsz="$(wc -c < "${WORKSPACE_DIR}/target/${out}" | tr -d ' ')"
    [ "$vsz" -le 16384 ] || { echo -e "${COLOR_RED}ERROR: ${out} ${vsz} bytes > the 16384-byte EL0 user window${COLOR_RESET}"; exit 1; }
    echo -e "${COLOR_GREEN}✅ x86 static-ELF EL0 mini-vug program: ${out} (${vsz} B)${COLOR_RESET}"
}

build_user_vug_x86() {
    build_one_vug_x86 VUG-X86.ELF  ""
    build_one_vug_x86 VUGC-X86.ELF "pinlo"
    build_one_vug_x86 VUGX-X86.ELF "pinhi"
    # KVUG: the fourth image — the in-kernel vug carried into EL0. See the KVUG note in the aarch64 VUG
    # build (build_user_aarch64) for the ruling, and for why it must be its own image: the `.text` page
    # cliff at 0x2000 leaves the shipped x86 build 169 bytes of headroom and the kernel renderer costs
    # 2143, so `kvug` compiles out the shard raytracer it replaces. Measured 0x1fc5 with `kvug`, against
    # an unchanged 0x1f57 without it.
    build_one_vug_x86 VUGK-X86.ELF "kvug"
}

# PULSE-1: build the x86_64 static ELF64 EL0 CPU-PULSE MONITOR (crates/user-pulse → target/PULSE-X86.ELF).
# The exact shape of build_user_stat_x86 / build_user_vug_x86 above: same linker-script SHAPE
# (crates/user-pulse/user-pulse-x86.ld — two PT_LOAD segments via a PHDRS clause), same four assertions,
# same explicit `--target` to override the crate's aarch64 default so the two arches' builds land in
# separate target subdirectories and never clobber each other.
#
# What this program exercises that its two siblings do not: SYS_CPUPULSE(49). A build of it that links, runs
# and draws is the end-to-end statement that the ring-3 stub in crates/user-pulse and the kernel handler in
# arch/x86_64/syscall.rs agree about that number AND about the 272-byte payload layout.
build_user_pulse_x86() {
    local TOOLBIN; TOOLBIN="$(rustc +nightly --print sysroot)/lib/rustlib/$(rustc +nightly -vV | awk '/host/{print $2}')/bin"
    echo -e "${COLOR_YELLOW}⚡ Building x86 EL0 cpu-pulse static-ELF program (crates/user-pulse → target/PULSE-X86.ELF)...${COLOR_RESET}"
    mkdir -p "${WORKSPACE_DIR}/target"
    cd "$WORKSPACE_DIR/crates/user-pulse"
    RUSTFLAGS="-C link-arg=-T${WORKSPACE_DIR}/crates/user-pulse/user-pulse-x86.ld -C link-arg=-z -C link-arg=max-page-size=0x1000" \
      cargo +nightly build --release -Z json-target-spec --target "${WORKSPACE_DIR}/x86_64-unknown-none.json"
    cd "$WORKSPACE_DIR"
    "$TOOLBIN/llvm-objcopy" --strip-all \
      "${WORKSPACE_DIR}/crates/user-pulse/target/x86_64-unknown-none/release/user-pulse" \
      "${WORKSPACE_DIR}/target/PULSE-X86.ELF"
    [ -s "${WORKSPACE_DIR}/target/PULSE-X86.ELF" ] || { echo -e "${COLOR_RED}ERROR: PULSE-X86.ELF missing/empty — x86 PULSE build failed${COLOR_RESET}"; exit 1; }
    local pmag; pmag="$(head -c 4 "${WORKSPACE_DIR}/target/PULSE-X86.ELF" | od -An -tx1 | tr -d ' \n')"
    [ "$pmag" = "7f454c46" ] || { echo -e "${COLOR_RED}ERROR: PULSE-X86.ELF does not start with the ELF magic; first 4 bytes = ${pmag}${COLOR_RESET}"; exit 1; }
    local pmach; pmach="$(od -An -tx1 -j18 -N2 "${WORKSPACE_DIR}/target/PULSE-X86.ELF" | tr -d ' \n')"
    [ "$pmach" = "3e00" ] || { echo -e "${COLOR_RED}ERROR: PULSE-X86.ELF e_machine is ${pmach}, want 3e00 (EM_X86_64=62 LE)${COLOR_RESET}"; exit 1; }
    local psz; psz="$(wc -c < "${WORKSPACE_DIR}/target/PULSE-X86.ELF" | tr -d ' ')"
    [ "$psz" -le 16384 ] || { echo -e "${COLOR_RED}ERROR: PULSE-X86.ELF ${psz} bytes > the 16384-byte EL0 user window${COLOR_RESET}"; exit 1; }
    echo -e "${COLOR_GREEN}✅ x86 static-ELF EL0 cpu-pulse program: PULSE-X86.ELF (${psz} B)${COLOR_RESET}"
}

build_kernel_aarch64() {
    echo -e "${COLOR_YELLOW}⚡ Building aarch64 Kernel...${COLOR_RESET}"
    cd "$WORKSPACE_DIR/crates/kernel"
    local _af; _af="$(arm_features)"
    # BLOBATOMIC (2026-08-21, peer-ruled): a RUNNABLE image whose features compile syscall.rs's
    # include_bytes! (baremetal or tegra_el0) must never bake whatever blob a prior `check` left —
    # an image whose contents cannot be derived from its stated inputs is not a verifiable image.
    # Build the blob FRESH here, unconditionally, for exactly those feature sets (kernel8 and the
    # armed esp-jetson already do their own unconditional build; this closes esp-arm/arm/test-arm).
    case ",${_af#--features }," in
        *,baremetal,*|*,tegra_el0,*)
            local TOOLBIN; TOOLBIN="$(rustc +nightly --print sysroot)/lib/rustlib/$(rustc +nightly -vV | awk '/host/{print $2}')/bin"
            ( cd "$WORKSPACE_DIR" && build_user_blob )
            cd "$WORKSPACE_DIR/crates/kernel"
            ;;
    esac
    # Surface the effective aarch64 feature set when it differs from the (x86) banner — makes the
    # SMOLNET-DEFAULT strip visible so an operator doesn't read `smolnet` off the banner for aarch64.
    [ "$_af" != "$KERNEL_FEATURES" ] && echo -e "${COLOR_YELLOW}⚡ aarch64 effective features: ${_af#--features }${COLOR_RESET}"
    cargo +nightly build --release \
      --target ../../aarch64-unaos.json \
      $NIGHTLY_FLAGS $_af
    cd "$WORKSPACE_DIR"
    echo -e "${COLOR_GREEN}✅ aarch64 Kernel Built.${COLOR_RESET}"
}

# --- Launch Functions ---

launch_x86_64() {
    build_user_hello_x86   # U2: target/hello.bin — the builder copies it onto the ESP
    build_user_stat_x86    # WINX-5: target/STAT-X86.ELF — staged as STAT.ELF for `run`/`bg`
    build_user_vug_x86     # WINX-7: target/VUG-X86.ELF — staged as VUG.ELF for `run`/`bg`
    build_user_pulse_x86   # PULSE-1: target/PULSE-X86.ELF — staged as PULSE.ELF for `run`/`bg`
    build_kernel_x86_64

    echo -e "${COLOR_CYAN}⚡ Launching x86_64 via Builder (kernel + bootloader + QEMU)...${COLOR_RESET}"
    cd "$WORKSPACE_DIR/builder"
    cargo +nightly run --release
    cd "$WORKSPACE_DIR"
}

ESP_DIR_ARM="${WORKSPACE_DIR}/target/aarch64_esp"
AAVMF_PATH=""

# Build the aarch64 kernel + bootloader, pack the ESP, and resolve AAVMF firmware
# (sets the global AAVMF_PATH). Shared by launch_aarch64 and test_aarch64.
prepare_aarch64() {
    build_kernel_aarch64

    local KERNEL_BIN="${WORKSPACE_DIR}/target/aarch64-unaos/release/unaos-kernel"
    local BOOTLOADER_BIN="${WORKSPACE_DIR}/target/aarch64-unknown-uefi/release/bootloader.efi"

    echo -e "${COLOR_YELLOW}⚡ Building aarch64 UEFI Bootloader...${COLOR_RESET}"
    cd "$WORKSPACE_DIR/crates/bootloader"
    cargo +nightly build --release --target aarch64-unknown-uefi \
      $BOOTLOADER_FEATURES \
      -Z build-std=core,compiler_builtins,alloc \
      -Z build-std-features=compiler-builtins-mem
    cd "$WORKSPACE_DIR"

    echo -e "${COLOR_CYAN}⚡ Packaging ESP (EFI System Partition)...${COLOR_RESET}"
    rm -rf "$ESP_DIR_ARM"
    mkdir -p "$ESP_DIR_ARM/EFI/BOOT"
    cp "$BOOTLOADER_BIN" "$ESP_DIR_ARM/EFI/BOOT/BOOTAA64.EFI"
    cp "$KERNEL_BIN" "$ESP_DIR_ARM/kernel.elf"

    # Locate AAVMF firmware (macOS/Homebrew + Linux locations)
    local AAVMF_PATHS=(
        "/usr/local/share/qemu/edk2-aarch64-code.fd"
        "/opt/homebrew/share/qemu/edk2-aarch64-code.fd"
        "/usr/share/AAVMF/AAVMF_CODE.fd"
        "/usr/share/edk2/aarch64/QEMU_EFI.fd"
        "/usr/share/qemu-efi-aarch64/QEMU_EFI.fd"
    )
    AAVMF_PATH=""
    for path in "${AAVMF_PATHS[@]}"; do
        if [ -f "$path" ]; then AAVMF_PATH="$path"; break; fi
    done
    if [ -z "$AAVMF_PATH" ]; then
        echo -e "${COLOR_RED}CRITICAL: AAVMF Firmware not found.${COLOR_RESET}"
        exit 1
    fi

    # Ensure the USB mass-storage backing image exists (64 MiB, signed) — mirrors the x86
    # builder (builder/src/main.rs) so `usb-storage` has something to enumerate on aarch64 too.
    local USB_IMG="${WORKSPACE_DIR}/builder/usb.img"
    if [ ! -f "$USB_IMG" ]; then
        echo -e "${COLOR_YELLOW}⚡ Creating usb.img (64 MiB, signed)...${COLOR_RESET}"
        # bs in bytes: GNU dd (Linux) rejects the BSD `1m` suffix
        dd if=/dev/zero of="$USB_IMG" bs=1048576 count=0 seek=64 2>/dev/null
        printf 'UNA-OS-DISK-001-ALPHA' | dd of="$USB_IMG" conv=notrunc 2>/dev/null
    fi
}

launch_aarch64() {
    prepare_aarch64

    echo -e "${COLOR_GREEN}⚡ Launching QEMU (aarch64)...${COLOR_RESET}"
    echo -e "${COLOR_PURPLE}--- EXPECTED BEHAVIOR ---${COLOR_RESET}"
    echo -e "  • Serial: PCI scan ('XHCI CONTROLLER NOT FOUND' is normal — no USB on virt)"
    echo -e "  • Framebuffer shows UnaOS boot screen / shell"
    echo -e "${COLOR_PURPLE}-------------------------${COLOR_RESET}"

    qemu-system-aarch64 \
        -machine virt,virtualization=on,gic-version=2 ${GICV3_ARG} \
        -cpu cortex-a72 \
        -smp 4 \
        -m 1G \
        -drive if=pflash,format=raw,readonly=on,file="$AAVMF_PATH" \
        -drive format=raw,file=fat:rw:"$ESP_DIR_ARM" \
        -serial stdio \
        -device ramfb \
        -device qemu-xhci,id=xhci \
        -drive if=none,id=stick,format=raw,file="${STICK_IMG}" \
        -device usb-storage,bus=xhci.0,drive=stick \
        -device usb-kbd,bus=xhci.0 \
        -device usb-tablet,bus=xhci.0 \
        ${VNET_ARG} \
        -no-reboot \
        -no-shutdown \
        -d guest_errors \
        ${UNAOS_QEMU_EXTRA:-}
}

# ── FAULT-SCAN: the harness's ONE fault-pattern list ────────────────────────────────────────────
# THE list. Every serial-log verdict in this script reads it — the `test` / `test-fat` / `test-arm`
# legs below and battery's `_step` — so a pattern added here arms every gate at once and there is no
# second, drifting copy to keep in sync. mbench.py carries the same idea as DEFAULT_FORBIDS (`-> FAIL`,
# `FAIL ::`, `PANIC`) for the spec-replay path; this is its shell twin for the legs that run no spec.
#
# WHY IT EXISTS. `./arroyo test` used to print the serial log and exit 0 UNCONDITIONALLY. Artifacted on
# a W^X falsification run: an injected defect PANICKED the boot, the log said `=== KERNEL PANIC ===`,
# and the harness still exited 0 — the fault was only found because a human read the log. An exit
# status that cannot go red is not a gate. The spec-runner side got this treatment at ad8b52aa
# ("the abort is not a pass"); these legs did not, because they never scanned anything at all.
#
# The patterns, and why each one:
#   -> FAIL          the project's PASS/FAIL verdict idiom (`:: NAME: … -> FAIL ::`).
#   FAIL ::          the other spelling of the same verdict.
#   FAIL —           FATIMG-CI: the WINX end-to-end verdicts spell failure `:: WINX-2: … FAIL — <why> ::`,
#                    which matched NEITHER of the two above. The em-dash keeps it narrow enough not to
#                    fire on prose that merely contains the word FAIL. This ALSO reconciles the
#                    x86-fat.spec S5 note ("the S5 FAIL text evades arroyo's detector", seat fold
#                    2026-07-11): the STOR-1 `— witness OK ::` family (S4-mf2 / S4-race / S5 / S6-witness
#                    / S7-openany / S8-write / S9-grow) spells its failure `:: S6-witness FAIL — … ::`,
#                    so it is caught HERE now. The spec's per-witness FORBIDs stay as they are — they
#                    name the individual witness in the verdict table, which this scan does not.
#   PANIC            `main.rs`'s `#[panic_handler]` prints `=== KERNEL PANIC ===` as its first line, on
#                    both arches, through the raw lock-free serial path (so it reaches the wire even
#                    when the dying core held the UART mutex). Bare, uppercase, matching mbench's
#                    default set. No kernel print literal contains the word otherwise — verified.
#   panicked at      the Rust `PanicInfo` Display line that FOLLOWS the banner and carries the source
#                    location. Listed separately on purpose: it is what still names the fault if the
#                    banner is ever lost to a truncated write, and it is the line the scan quotes.
#   EXCEPTION:       any CPL-0 / EL1 fault diagnostic — x86 `EXCEPTION: PAGE FAULT` / `GENERAL PROTECTION
#                    FAULT` / `DOUBLE FAULT` / `MACHINE CHECK`, and aarch64 `=== AARCH64 EXCEPTION: … ===`
#                    (the substring covers both). Already the standing FORBID in rmbp-boot.spec,
#                    round6-rmbp.spec and x86-fat.spec, so this only extends it to the specless legs.
#                    Ring-3 / EL0 intentional faults do NOT print it — they print `:: RING-3 FAULT: …
#                    KILLED — …` and `:: EL0 FAULT: … KILLED — …`, which this list deliberately does not
#                    match: U1b's fault-isolation demo kills three tasks on every clean x86 boot.
FAULT_PATTERNS='-> FAIL|FAIL ::|FAIL — |PANIC|panicked at |EXCEPTION:'

# Scan a serial capture against FAULT_PATTERNS. Prints every offending line with its line number and
# returns 1 if any matched, 0 on a clean log. awk, not grep: control bytes in the serial logs break grep.
scan_serial_faults() { # $1 = log file, $2 = label used in the quoted lines
    local logf="$1" lbl="${2:-serial}"
    [ -f "$logf" ] || return 0
    awk -v p="$FAULT_PATTERNS" -v lbl="$lbl" '
        $0 ~ p { n++; if (n <= 20) printf("  ✖ %s:%d: %s\n", lbl, FNR, $0) }
        END { if (n > 20) printf("  ✖ … and %d more matching line(s)\n", n - 20); exit (n ? 1 : 0) }
    ' "$logf"
}

# Headless aarch64 run: serial -> target/serial-arm.log, self-terminates after N secs.
test_aarch64() {
    local secs="${1:-20}"
    prepare_aarch64

    local logf="${WORKSPACE_DIR}/target/serial-arm.log"
    rm -f "$logf"
    echo -e "${COLOR_CYAN}⚡ Headless aarch64 test (${secs}s). Serial -> ${logf}${COLOR_RESET}"
    qemu-system-aarch64 \
        -machine virt,virtualization=on,gic-version=2 ${GICV3_ARG} -cpu cortex-a72 -smp 4 -m 1G \
        -drive if=pflash,format=raw,readonly=on,file="$AAVMF_PATH" \
        -drive format=raw,file=fat:rw:"$ESP_DIR_ARM" \
        -serial "file:${logf}" -device ramfb -display none \
        -device qemu-xhci,id=xhci \
        -drive if=none,id=stick,format=raw,file="${STICK_IMG}" \
        -device usb-storage,bus=xhci.0,drive=stick \
        -device usb-kbd,bus=xhci.0 -device usb-tablet,bus=xhci.0 \
        ${VNET_ARG} \
        -no-reboot -no-shutdown \
        ${UNAOS_QEMU_EXTRA:-} &
    local qpid=$!
    sleep "$secs"
    kill "$qpid" 2>/dev/null || true
    wait "$qpid" 2>/dev/null || true

    echo ""
    echo -e "${COLOR_PURPLE}════════════ SERIAL LOG (${logf}) ════════════${COLOR_RESET}"
    cat "$logf" 2>/dev/null || echo -e "${COLOR_RED}(no serial log produced)${COLOR_RESET}"
    echo -e "${COLOR_PURPLE}═══════════════════════════════════════════════════${COLOR_RESET}"

    # FAULT-SCAN: this leg's EXIT STATUS now says what the log says (see FAULT_PATTERNS above).
    if [ ! -s "$logf" ]; then
        echo -e "${COLOR_RED}✖ test-arm: no serial bytes captured at ${logf} — QEMU produced nothing."
        echo -e "  This run carries NO verdict: not a pass, not a regression. Exit 4.${COLOR_RESET}"
        return 4
    fi
    if ! scan_serial_faults "$logf" "serial-arm.log"; then
        echo -e "${COLOR_RED}❌ aarch64 test FAILED — the serial log carries fault text (lines above). Log at ${logf}${COLOR_RESET}"
        return 1
    fi
    echo -e "${COLOR_GREEN}✅ aarch64 test complete. Log at ${logf}${COLOR_RESET}"
}

# --- Headless Test (capture serial to a file) ---
# Boots x86_64 in QEMU with no display, redirects the serial console to
# target/serial.log, and auto-terminates after N seconds (default 20). Use this for
# fast iteration / sharing boot logs — the log lands at a fixed path every time.
#   ./arroyo test          # 20s headless run, then prints the serial log
#   ./arroyo test 30       # 30s run
SERIAL_LOG="${WORKSPACE_DIR}/target/serial.log"

test_x86_64() {
    local secs="${1:-20}"
    build_user_hello_x86   # U2: target/hello.bin — the builder copies it onto the ESP
    build_user_stat_x86    # WINX-5: target/STAT-X86.ELF — staged as STAT.ELF for `run`/`bg`
    build_user_vug_x86     # WINX-7: target/VUG-X86.ELF — staged as VUG.ELF for `run`/`bg`
    build_user_pulse_x86   # PULSE-1: target/PULSE-X86.ELF — staged as PULSE.ELF for `run`/`bg`
    build_kernel_x86_64

    # VPERF: UNAOS_QMP_SHOT=<png path> arms a QMP framebuffer screendump of the headless x86 run
    # (the same qmp_shoot.py technique kernel8-test uses). The port default (4464) auto-bumps past
    # busy listeners so parallel worktree sessions never collide (UNAOS_QMP_PORT overrides the
    # start). The shooter runs in the background: it retries the QMP connect while the builder
    # compiles, waits UNAOS_QMP_WAIT (default secs-3) after QEMU appears, then dumps — inside the
    # builder's kill window. `|| true` guards keep this additive under `set -e`.
    local qmp_pid=""
    if [ -n "${UNAOS_QMP_SHOT:-}" ]; then
        local qmp_port="${UNAOS_QMP_PORT:-4464}"
        while lsof -iTCP:"$qmp_port" -sTCP:LISTEN >/dev/null 2>&1; do qmp_port=$((qmp_port + 1)); done
        export UNAOS_QEMU_EXTRA="${UNAOS_QEMU_EXTRA:-} -qmp tcp:127.0.0.1:${qmp_port},server,nowait"
        python3 "${WORKSPACE_DIR}/scripts/qmp_shoot.py" --port "$qmp_port" --connect-timeout 600 \
            --wait "${UNAOS_QMP_WAIT:-$((secs - 3))}" --out "${UNAOS_QMP_SHOT}" 2>/dev/null &
        qmp_pid=$!
        echo -e "${COLOR_YELLOW}⚡ QMP screendump armed: port ${qmp_port} -> ${UNAOS_QMP_SHOT}${COLOR_RESET}"
    fi

    echo -e "${COLOR_CYAN}⚡ Headless x86_64 test (${secs}s). Serial -> ${SERIAL_LOG}${COLOR_RESET}"
    rm -f "$SERIAL_LOG"
    cd "$WORKSPACE_DIR/builder"
    UNAOS_SERIAL_LOG="$SERIAL_LOG" UNAOS_TEST_SECS="$secs" cargo +nightly run --release
    cd "$WORKSPACE_DIR"
    if [ -n "$qmp_pid" ]; then wait "$qmp_pid" 2>/dev/null || true; fi

    echo ""
    echo -e "${COLOR_PURPLE}════════════ SERIAL LOG (${SERIAL_LOG}) ════════════${COLOR_RESET}"
    cat "$SERIAL_LOG" 2>/dev/null || echo -e "${COLOR_RED}(no serial log produced)${COLOR_RESET}"
    echo -e "${COLOR_PURPLE}═══════════════════════════════════════════════════${COLOR_RESET}"

    # FAULT-SCAN: this leg's EXIT STATUS now says what the log says (see FAULT_PATTERNS above).
    # `test-fat` ends by calling this function, so it inherits the same verdict.
    if [ ! -s "$SERIAL_LOG" ]; then
        echo -e "${COLOR_RED}✖ test: no serial bytes captured at ${SERIAL_LOG} — QEMU produced nothing."
        echo -e "  This run carries NO verdict: not a pass, not a regression. Exit 4.${COLOR_RESET}"
        return 4
    fi
    if ! scan_serial_faults "$SERIAL_LOG" "serial.log"; then
        echo -e "${COLOR_RED}❌ x86_64 test FAILED — the serial log carries fault text (lines above). Log at ${SERIAL_LOG}${COLOR_RESET}"
        return 1
    fi
    echo -e "${COLOR_GREEN}✅ Test run complete. Full log saved at ${SERIAL_LOG}${COLOR_RESET}"
}

# --- Utility Functions ---

# GATE-USER: the RING-3 crates under crates/user-* are each their OWN cargo workspace (every one of
# them carries an empty `[workspace]` table, so the parent unaos workspace never drags a no_std/no_main
# EL0 program into a host build). That isolation is correct for `cargo build`, but it silently made
# `./arroyo check` a KERNEL-ONLY gate: nothing outside crates/kernel was ever compiled, so a session
# could "gate" a userspace change on a green check that could not have gone red. The user crates were
# only ever type-checked as a side effect of a MEDIA build (`kernel8` / `esp-x86` / the builder), which
# is minutes of link+objcopy+staging away and is not what anyone runs before committing.
#
# This matrix closes that hole. One row per (crate, arch) pair the project GENUINELY ships — the arch
# column is the load-bearing part, because these crates are not uniformly portable:
#
#   user-blob      aarch64 only. The flat EL0 hello/K2/midden blobs (4 [[bin]]s, all checked by the one
#                  cargo invocation). Hand-written aarch64 asm; its x86 twin is a SEPARATE crate.
#   user-blob-x86  x86_64 only. That twin — a naked x86 asm stream. Neither crate can build for the
#                  other's arch and neither is meant to; forcing it would be an invented target.
#   user-elf       aarch64 only. ELF-1 ships as ELFHELLO.ELF on the Pi media and has no x86 sibling —
#                  there is no user-elf-x86.ld and no x86 build recipe anywhere in this script. Adding
#                  one here would be inventing a product, not gating an existing one.
#   user-pulse     BOTH. Arch-neutral above two syscall stubs; built as PULSE.ELF (aarch64) and
#   user-stat      PULSE-X86.ELF (x86) — see build_user_pulse_x86 / build_user_aarch64. Same for the
#   user-vug       STAT/VUG pair. These three USED to be exactly where a syscall-number or stub drift
#                  between the two arches showed up, so both legs are checked. ABIFREEZE closed the
#                  NUMBER half of that hiding place: every crate below now imports crates/una-abi
#                  instead of re-declaring the table, so a number cannot differ between a caller and
#                  the dispatcher it calls. The STUB half — register constraints, clobber lists, and
#                  the per-arch `cfg` blocks around them — is still hand-written per crate and is
#                  still exactly what these legs exist to catch.
#
# Fields (whitespace-separated; the 4th field runs to end-of-line):
#   1 crate dir under crates/
#   2 arch label (display only — the real arch comes from the target, field 3)
#   3 cargo --target override, or `-` to take the crate's own .cargo/config.toml default. The aarch64
#     legs use `-` because every crate's config.toml already defaults to ../../aarch64-base.json (as
#     does user-blob-x86's, which defaults to x86_64-unknown-none.json); the x86 legs of the three
#     dual-arch crates must override it explicitly, exactly as build_user_stat_x86 & friends do.
#   4 RUSTFLAGS. Mirrored VERBATIM from each crate's media build recipe rather than left empty. `check`
#     never invokes the linker, so the -T/-z flags are inert here — but RUSTFLAGS is part of cargo's
#     fingerprint, so a check that passed DIFFERENT flags would invalidate the crate's target/ dir and
#     force a full build-std recompile every time an operator alternated `check` and `kernel8`.
#     (user-vug is the exception on BOTH arches: its media builds are feature-variant and each lands in
#     its own `--target-dir` — target/{x86,x86-pinlo,…,arm,arm-pinlo,arm-pinhi} — so these two rows own
#     the crate's default target/ dir outright. The flags stay mirrored anyway: they are what the
#     unfeatured image is built with, and a row that drifted from its recipe would be checking a
