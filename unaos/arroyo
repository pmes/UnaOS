#!/bin/bash
# ARROYO: The Stream that Feeds the River
# "Ad Astra Per Aspera"
#
# Usage:
#   ./arroyo              Interactive menu
#   ./arroyo x86           Build & boot x86_64 (GUI window + serial on stdio)
#   ./arroyo arm           Build & boot aarch64
#   ./arroyo test [secs]   Headless x86_64 run; serial captured to target/serial.log
#   ./arroyo test-arm [s]  Headless aarch64 run; serial -> target/serial-arm.log
#   ./arroyo check         Syntax check: kernel (both targets, default + cfg-gated feature legs,
#                          including the x86 pairwise-mix legs — see GATE-CFG-MIX below)
#                          + the ring-3 user-* crates
#                          UNAOS_CFG_SWEEP=1 adds the per-feature x86 sweep (+2N legs, 150 today)
#   ./arroyo build         Build both targets (no QEMU)
#   ./arroyo clean         Purge all build artifacts

set -e

# --- Configuration ---
COLOR_RESET="\033[0m"
COLOR_PURPLE="\033[0;35m"
COLOR_CYAN="\033[0;36m"
COLOR_GREEN="\033[0;32m"
COLOR_YELLOW="\033[0;33m"
COLOR_RED="\033[0;31m"

WORKSPACE_DIR="$(cd "$(dirname "$0")" && pwd)"

# DEFAULT-QUIET (witness): the regression BATTERIES re-prove the full fixture set, so arm the kernel's
# `witness` cargo feature for exactly the battery commands — `test`/`test-fat` (x86, via the builder),
# `test-arm` (aarch64 virt), `kernel8-test` (Pi bare-metal). The boot/media commands (`x86`/`arm`/
# `esp-x86`/`esp-arm`/`esp-jetson`/`kernel8`/`vm-image`) leave it OFF so a default boot reaches the shell
# with the boot-honesty lines only. EXPORTED so the `builder` subprocess (which rebuilds the x86 kernel
# from its OWN env-driven feature list) also pushes it. `battery` is deliberately NOT armed here: each of
# its sub-invocations (`"$0" test`, `"$0" test-arm`, `"$0" kernel8-test`) re-enters this case and self-arms,
# while its `"$0" esp-jetson` sub-invocation does NOT — keeping the jetson media witness-free (byte-identity).
# SOURCE-ALONG (UNAOS_NOSRC): `esp-x86`/`esp-arm`/`esp-jetson` pack the source tree that built the
# media onto the media itself (SRC.TGZ + SRC.SHA at the volume root) — self-hosting rung 1 and GPLv3
# source availability by construction. UNAOS_NOSRC=1 skips the step (tight media / CI speed). The
# size-budgeted images (`fat-img`/`test-fat`, `vm-image`, `kernel8`) deliberately do NOT carry it.
# See docs/dev/OS/10_INSTALL/source_along.md.
case "${1:-}" in
    test|test-x86|test_x86|test-fat|test_fat|test-arm|test-aarch64|kernel8-test|test-pi)
        export UNAOS_WITNESS="${UNAOS_WITNESS:-1}" ;;
esac

# BUILD-SHA-1: Export git SHA as UNAOS_GIT_SHA for compile-time embedding (option_env!("UNAOS_GIT_SHA")).
# This makes the build ID available to all cargo invocations (check/test/kernel8/esp targets).
export UNAOS_GIT_SHA="$(git rev-parse --short=8 HEAD 2>/dev/null || echo unknown)"

# Build flags shared by both targets
NIGHTLY_FLAGS="-Z build-std=core,compiler_builtins,alloc -Z build-std-features=compiler-builtins-mem -Z json-target-spec"

# Optional kernel cargo features (composable). UNAOS_SKIP_XHCI=1 disables xHCI/USB bring-up
# (video-only boot for real HW where firmware may still own the controller and stall its reset);
# UNAOS_BOOTLOG=1 holds the boot log on screen instead of handing off to the GUI;
# UNAOS_PI=1 (Raspberry Pi 4) and UNAOS_TEGRA=1 (Jetson Orin Nano / Tegra234) select the aarch64
# UART — `pi` touches no UART (fbcon only), `tegra` points serial at the Tegra 16550. Empty by default.
# UNAOS_USBSERIAL=1 is a BUILDER/QEMU knob (not a kernel feature): the builder attaches an FTDI FT232
# usb-serial device (VID 0403 PID 6001) whose chardev is target/ftdi.log, so the x86 kernel's U2.5
# FTDI console driver enumerates it and replays the boot log out the (emulated) cable. `is_ok()`
# semantics — an EMPTY value counts as SET.
#
# WC-D: UNAOS_FBW / UNAOS_FBH are a PANEL-GEOMETRY OVERRIDE, not a cargo feature — they are read with
# `option_env!` by arch/aarch64/mailbox.rs and replace the firmware-queried display mode (default unset =>
# query the firmware, unchanged). They exist because QEMU raspi4b reports 640x480 while the bench Pi drives
# 1920x1200, and the window compositor derives each window's integer upscale FROM the panel: the same
# 128x128 window is scale 1 on the gate and scale 4 on the bench, so the gate cannot reach the bench's blit
# path at all. `UNAOS_FBW=1920 UNAOS_FBH=1200 ./arroyo kernel8-test` reproduces bench geometry, and is the
# configuration the WC-D `[wc-d] verify` verdict was cleared in. NOTE these change compiled-in behaviour:
# a build made with them is NOT the flashable default image.
#
# PI-V3D-81: UNAOS_V3D81_SETTLE_MS is the same kind of knob — read with `option_env!` by
# arch/aarch64/v3d.rs, not a cargo feature. It sets how long a reply-less NOTIFY post settles before
# the effect is read (default 250 ms, capped at 10 s, ignored unless a UNAOS_V3D81_* leg is armed).
# The value rides on the `[v3d81]` wire lines, so a capture states its own settle rather than
# requiring the reader to remember the build.
#
# PI-V3D-85: UNAOS_V3D_FIRSTKICK is BOTH — its presence arms the `v3d_firstkick` cargo feature (see
# the kernel8 knob block below) and its VALUE is read with `option_env!` by arch/aarch64/v3d.rs to
# pick which list the boot's one CT0 kick carries (`empty` | `rcl` | `m4` | `rclp<n>` | `rclhead` |
# `emptyunarm`; `1` or an empty value select `empty`). PI-V3D-86's `rclp<n>` is the prefix bisection:
# the rcl list truncated after main-list packet n. PI-V3D-87's `rclhead` and `emptyunarm` are the two
# discriminators that cut the last two candidates apart (v3d.md §49.10). The raw value rides the
# `[v3d85]` header line, so a capture states its own variant.
#
# PI-V3D-95: UNAOS_V3D_UNARMCLOSE=1 is a plain arming knob (no value) for the `v3d_unarmclose`
# feature — the `[v3d95]` unarmed-close-writes rung, which takes one `emptyunarm`-shaped CT0 kick
# before probe_job and reads CT0QMA/CT0QMS/CT0QTS and the PTB fault address across the close without
# programming any of them. See the kernel8 knob block below and v3d.md §49.12.1.
#
# PI-V3D-97: UNAOS_V3D_BASEDAIM=1 is a plain arming knob (no value) for the `v3d_basedaim` feature —
# the `[v3d97]` basedaim rung, v3d.md §49.20.6's R1 with R3 in front. It rides the `[v3d95]` rung as
# two EXTRA legs and therefore implies `v3d_unarmclose` (declared in Cargo.toml and armed here), so
# `UNAOS_V3D_BASEDAIM=1` alone is sufficient. See the kernel8 knob block below and v3d.md §49.21.
#
# PI-V3D-98: UNAOS_V3D_TSAIM=1 is a plain arming knob (no value) for the `v3d_tsaim` feature — the
# `[v3d98]` tsaim leg, v3d.md §49.22.5's R-next-1. It rides the `[v3d97]` rung as ONE more leg (D) and
# therefore implies `v3d_basedaim` (declared in Cargo.toml and armed here), so `UNAOS_V3D_TSAIM=1`
# alone is sufficient. See the kernel8 knob block below and v3d.md §49.22.
#
# PI-V3D-99: UNAOS_V3D_ARMEDCLOSE=1 is a plain arming knob (no value) for the `v3d_armedclose` feature
# — the `[v3d99]` armedclose leg, v3d.md §49.23's R-next-3. It rides the `[v3d97]` rung as ONE more leg
# (E) and therefore implies `v3d_tsaim` (declared in Cargo.toml and armed here), so
# `UNAOS_V3D_ARMEDCLOSE=1` alone is sufficient. Leg E is the ONE leg of the five that is NOT unarmed.
# See the kernel8 knob block below and v3d.md §49.23.
#
# PI-V3D-100: UNAOS_V3D_BINCONTENT=1 is a plain arming knob (no value) for the `v3d_bincontent` feature
# — the `[v3d100]` content ladder, v3d.md §49.24's R-next-4. It rides the `[v3d97]` rung as THREE more
# legs (F, G, H) and therefore implies `v3d_armedclose` (declared in Cargo.toml and armed here), so
# `UNAOS_V3D_BINCONTENT=1` alone is sufficient. F/G/H are the first legs of the rung whose lists carry
# CONTENT and the first whose lists reference DRAM at all.
# See the kernel8 knob block below and v3d.md §49.24.
#
# PI-V3D-101: UNAOS_V3D_DISPATCHDISC=1 is a plain arming knob (no value) for the `v3d_dispatchdisc`
# feature — the `[v3d101]` dispatch-discriminator rung, v3d.md §49.25.4. It adds NO leg and NO kick: it
# INSTRUMENTS the `[v3d100]` ladder's own legs E/F/G/H with a V3D performance-counter bank and a
# bit-by-bit INT_STS decode, and therefore implies `v3d_bincontent` (declared in Cargo.toml and armed
# here), so `UNAOS_V3D_DISPATCHDISC=1` alone is sufficient. The only registers it writes are the PCTR
# counter-file config registers mainline's v3d_perfmon.c writes on every perfmon start.
# See the kernel8 knob block below and v3d.md §49.25.4.
#
# PI-V3D-102: UNAOS_V3D_HFIRST=1 is a plain arming knob (no value) for the `v3d_hfirst` feature — the
# `[v3d102]` hfirst order arm, v3d.md §49.25.5. It adds NO leg, NO kick and NO instrument: it REORDERS
# the `[v3d100]` ladder's content legs to E -> H -> F -> G so that leg H — the m4-class minimum over the
# REAL coordinate shader, which DOES write VPM — runs FIRST, instead of standing down behind leg G's
# never-closing frame as it has on every boot to date. It therefore implies `v3d_dispatchdisc` (declared
# in Cargo.toml and armed here), so `UNAOS_V3D_HFIRST=1` alone is sufficient. It writes no register the
# implied chain does not already write, and the CT0-hygiene gate is mirrored, not weakened.
# See the kernel8 knob block below and v3d.md §49.25.5.
#
# PI-V3D-103: UNAOS_V3D_VPMPROBE=1 is a plain arming knob (no value) for the `v3d_vpmprobe` feature —
# the `[v3d103]` VPMPROBE discriminator rung, v3d.md §49.25.7, the successor to boot 13's `OUTCOME H4`.
# It adds NO leg, NO kick, NO shader word, NO register WRITE and NO page-table edit. It RE-SOURCES three
# PCTR slots (4/5/6 become QPU_CYCLES_STALLED_VERTEX_COORD_USER, PTB_PRIM_CLIP and
# PTB_PRIM_VIEWPOINT_DISCARD; the five slots boot 13 read H4 off are untouched and must reproduce) and
# adds FOUR READ-ONLY registers to the readback set (V3D_ERR_STAT/FDBGO/FDBGB/FDBGS, which mainline's
# own v3d_debugfs.c scopes to V3D_GEN_33..V3D_GEN_71 — bracketing this part's 4.2). It implies
# `v3d_hfirst` (declared in Cargo.toml and armed here), so `UNAOS_V3D_VPMPROBE=1` alone is sufficient.
# See the kernel8 knob block below and v3d.md §49.25.7.
KERNEL_FEATURES=""
_feats=""
# DEFAULT-QUIET: UNAOS_WITNESS=1 arms the `witness` fixture-battery feature (auto-set above for the battery
# commands; default OFF for boot/media builds). On x86 the builder re-derives features from env, so this
# also flows through UNAOS_WITNESS there. NOTE (UVUG7-W): `witness` is NOT inert on aarch64 — an earlier
# comment here claimed all its call sites were x86- or baremetal-scoped, and that was false. UVUG-7 added
# two arch-wide aarch64 sites (`arch/aarch64/timer.rs::init` and `video/screen.rs::present_surface`), so
# `test-arm` really does emit `[uvug7] ms clock` and `kernel8-test` emits both `[uvug7]` lines. The flip
# side is what bit P53: `./arroyo kernel8` leaves the feature OFF, so a default flashable image contains
# ZERO `uvug7` strings and the witness cannot fire. Every boot now states its own witness build state on
# the `:: AARCH64 build: witness=... ::` line, so absence is never mistaken for failure again.
[ -n "${UNAOS_WITNESS:-}" ] && _feats="${_feats}witness,"
# WXN-x86 M3b: UNAOS_WXNRO=1 arms the `wxnro` feature — the W-clear on the kernel's executable pages
# (x86_64 only). OFF is not "the stage absent": `memory::wxn_ro_stage` runs either way and prints its
# read-only census (`:: WXN-M3B-PRE: ... -> CENSUS ::`) plus a `would=`/`-> DRYRUN` result line; ON
# turns that `would=` into `cleared=` and the kernel's `.text` read-only under the CR0.WP M3a armed.
# Default OFF, so every existing build path (`test`, `x86`, `esp-x86`, the media builds) keeps today's
# writable-.text map and gains two measuring lines. MUST be wired in builder/src/main.rs too — the x86
# ESP carries the BUILDER's kernel, not this one. Pair it with nothing; it needs no other knob.
[ -n "${UNAOS_WXNRO:-}" ] && _feats="${_feats}wxnro,"
# SELFHOST-2: UNAOS_SELFHOST=1 arms the `selfhost` feature — the on-shard source verify + tar walk
# (`crate::selfhost`: mount the program-source volume, sha256 SRC.TGZ against SRC.SHA, gunzip and
# enumerate the tar). Rung 2 of the self-hosting line begun by SOURCE-ALONG. Read-only; it never
# writes to media. Arch-neutral module, x86_64-only call site this arc. Default OFF => module and call
# site vanish, image byte-identical. MUST be wired in builder/src/main.rs too — the x86 lanes boot the
# BUILDER's kernel, not this one. Driven end to end by `./arroyo test-selfhost`.
[ -n "${UNAOS_SELFHOST:-}" ] && _feats="${_feats}selfhost,"
# WC-G/M3 (PAYGO): UNAOS_WCG_PAYGO=1 arms the `wcg-paygo` feature — the pay-as-you-go reshape of the
# `[wc-g]` glass battery (x86_64 only). Pass 1 becomes lattice-sampled and says so on the wire
# (`coverage=lattice16`); passes 2..4 keep FULL coverage but wait for 15 s of uptime, so the ~11.5 s
# the battery used to take out of the boot is paid on a live desktop instead. Only the read-back is
# reshaped: the four checksum legs run in full on every sampled pass and every FORBID stays armed for
# the whole boot. Needs UNAOS_WITNESS to reach anything — `video/wcg.rs` is `witness`-gated — and
# means nothing on aarch64. DEFAULT OFF => every `[wc-g]` line is byte-identical to the pre-M3 wire.
# Kept in sync with builder/src/main.rs, which re-derives the x86 feature list from env and maps this
# same variable (`UNAOS_WCG_PAYGO` -> `wcg-paygo`) — so the knob reaches the ESP a metal boot runs and
# not only `check`. A knob wired into arroyo alone never reaches the boot media.
[ -n "${UNAOS_WCG_PAYGO:-}" ] && _feats="${_feats}wcg-paygo,"
# WCD-VALVE (boot-9 discriminator): UNAOS_WCDVALVE=1 arms the `wcdvalve` feature — suppress WC-D
# scan-out read-back ADMISSION while composite utilisation is high (close >= 60%, reopen < 35%,
# read from the [comp2] counters), one `[wc-d] valve CLOSED/OPEN` line per episode. A suppressed
# admission postpones the verdict (no WCD state moved), so the battery is paid normally once the
# valve reopens. Needs UNAOS_WITNESS to reach anything (the WC-D machinery is witness-gated);
# x86_64 only. Default OFF => compiled out, media byte-identical. Kept in sync with
# builder/src/main.rs, which maps this same variable — a knob wired into arroyo alone never
# reaches the boot media.
[ -n "${UNAOS_WCDVALVE:-}" ] && _feats="${_feats}wcdvalve,"
[ -n "${UNAOS_SKIP_XHCI:-}" ] && _feats="${_feats}skip_xhci,"
[ -n "${UNAOS_BOOTLOG:-}" ] && _feats="${_feats}bootlog,"
# CLOCK-2: UNAOS_LOGTS=1 arms the `logts` feature — a compact timestamp prefix on each serial LINE
# (monotonic ms → UTC after a civil anchor). CLOCK-2b: the prefix covers the UART and both capture
# transports (FTDI capture ring, UNAOS.LOG); default OFF => serial byte-identical (witness/mbench
# specs parse serial lines). Kept in sync with builder/src/main.rs.
[ -n "${UNAOS_LOGTS:-}" ] && _feats="${_feats}logts,"
# WEDGE-2: UNAOS_WEDGE2=1 arms the `wedge2` feature — raw-UART `<F1>`..`<F9>` breadcrumbs along the
# TAB->focus-raise chain, written BEFORE each phase so a core that dies IRQ-masked mid-phase still
# names it on the torn wire. Instrumentation only; default OFF => call sites vanish. See the kernel8
# knob block below and docs/dev/OS/08_VIDEO/engine.md §WEDGE-2.
[ -n "${UNAOS_WEDGE2:-}" ] && _feats="${_feats}wedge2,"
[ -n "${UNAOS_PI:-}" ] && _feats="${_feats}pi,"
[ -n "${UNAOS_USBDEBUG:-}" ] && _feats="${_feats}usbdebug,"
# MT-INVESTIGATION (IVY): arm the Wellspring raw-multitouch mode probe on the EHCI trackpad path
# (attended 2012 rMBP bench only — QEMU cannot produce Wellspring frames). Knob-off is
# byte-identical: the whole probe is `#[cfg(feature = "mtraw")]`-compiled out.
[ -n "${UNAOS_MTRAW:-}" ] && _feats="${_feats}mtraw,"
# MT-INVESTIGATION (IVY) debug SUB-KNOB: also drive the pointer from the decoded first finger.
# Implies `mtraw`. Default OFF — the live pointer path stays the 8-byte Report-ID-0x02 stream until
# metal proves raw mode is stable.
[ -n "${UNAOS_MTRAW_INJECT:-}" ] && _feats="${_feats}mtraw_inject,"
[ -n "${UNAOS_SCHED_DEMO:-}" ] && _feats="${_feats}sched_demo,"
# SIMMER self-test (R23s1): UNAOS_SIMMER=1 arms the boot-time simmer smoke test on the aarch64 virt
# GICv3 path (arch/aarch64/sched.rs::simmer_selftest) — stages the per-core load animator, samples the
# vug meter twice ~1 s apart (asserts multiple animated cores show busy deltas), then stops (asserts
# quiescence). Run: `UNAOS_GICV3=1 UNAOS_SIMMER=1 ./arroyo test-arm`. Off => no boot-time staging; the
# runtime `simmer` shell verb is always available regardless of this knob.
[ -n "${UNAOS_SIMMER:-}" ] && _feats="${_feats}simmer_test,"
# STOR-1: route x86 storage syscalls through the interrupt-driven storage service task (opt-in;
# metal-pending). x86_64 only — a no-op on the aarch64 media below.
[ -n "${UNAOS_IRQSTORAGE:-}" ] && _feats="${_feats}irqstorage,"
# BOT-RECOVER / PH-2: inject TWO synthetic BOT failures so the headless suite exercises both error
# families. (1) A transport fault on the first WRITE(10), at the CSW stage -> Reset Recovery + the
# bounded retry. (2) A `Failed` CSW on the first >=512 B READ(10) -> the runtime CHECK CONDITION
# path: REQUEST SENSE (sense rewritten to UNIT ATTENTION) + the single sense-driven retry.
# Both fire exactly once. Test-only; never on boot media.
[ -n "${UNAOS_BOTFAULT:-}" ] && _feats="${_feats}botfaultinject,"
# PFWIRE: force a fatal CPL-0 #PF from arch::init to prove the fault handlers drain diagnostics to the
# wire (review §5/C2). BRICKS THE BOOT by design — test-only, never on media. Wired in builder/src/main.rs
# too: this witness is exercised by the QEMU `test` path, whose kernel the builder re-derives from env.
[ -n "${UNAOS_PFWIRE_SELFTEST:-}" ] && _feats="${_feats}pfwire_selftest,"
# ONSET-2 (M3): UNAOS_BOTRING64=1 grows the storage slot's two BULK transfer rings 16 -> 64 TRBs
# (wrap frequency and wrap positions change; nothing else does). Default-off so a normal boot is
# byte-identical. It is a DIAGNOSTIC, not a fix — the metal evidence never convicted ring length —
# and it stays a knob for exactly that reason. Metal only: QEMU's usb-storage never stalls, wedges
# or short-changes, so it cannot be exercised there. Kept in sync with builder/src/main.rs; the boot
# log's `:: BOT: knobs … result=KNOBS ::` line reports the value that actually compiled in.
# UNAOS_BOTCBWIOC IS GONE (2026-07-30). Awaiting the CBW as its own stage is unconditional now — a
# proven fix, not an experiment (usb_xhci.md §17). Setting the variable does nothing; the KNOBS line
# reads `cbw=always-awaited` in every build.
[ -n "${UNAOS_BOTRING64:-}" ] && _feats="${_feats}botring64,"
# BOT-PARK: UNAOS_BOTWEDGE=1 injects a SYNTHETIC transport wedge on the storage slot once its first
# 24 transactions have completed — every later BOT attempt fails `Timeout` with nothing put on the
# wire. It exists because QEMU's usb-storage cannot wedge (it always answers), so the retry ladder's
# global floor — escalating back-off, the bounded per-device retry budget, the park — is otherwise
# walkable only on metal. Under it a QEMU boot reaches `:: BOT: PARKED … ::` and STOPS retrying,
# which is the arc's whole claim. TEST ONLY, never on media: it makes storage permanently unusable
# by design, so every fixture downstream of a mounted disk fails on such a run. Default OFF => fully
# cfg-compiled out and the artifact is byte-identical.
[ -n "${UNAOS_BOTWEDGE:-}" ] && _feats="${_feats}botwedge,"
# VPERF: x86 video-path bench instrumentation (scroll/VRAM-read counters, fbmem memory-type
# readout, display-BAR probe, scripted scroll scenario). x86_64-only module — aarch64 media are
# byte-identical with this on or off.
[ -n "${UNAOS_VIDEOBENCH:-}" ] && _feats="${_feats}videobench,"
# RAST-1/RAST-TEGRA: software-rasterizer spinning-cube demo through the panel path (UNAOS_RAST=1).
# Cross-arch knob now: x86/virt + aarch64/virt (QEMU ramfb witness) + aarch64/tegra (the Orin panel).
# Knob-off is byte-identical on BOTH arches (module + `rast` dep unlinked).
[ -n "${UNAOS_RAST:-}" ] && _feats="${_feats}rast,"
# PORTSW-1: DEFAULT-ON Panther Point EHCI->xHCI port switchover (route the shared USB2 ports + enable
# SuperSpeed) so the 2012 rMBP internal keyboard/trackpad re-enumerate on the xHCI+HID stack. Applied
# BEFORE enumeration with mask-read-before-write discipline (writes only advertised bits). Metal-gated
# policy (2026-07-16): the no-routing boot dropped ALL external USB on the 2012 rMBP, so routing runs
# by default. UNAOS_NOPORTSW=1 OPTS OUT (never-run no-routing experiment) => zero config-space writes
# => byte-identical no-routing media. Inert on QEMU (non-Intel xHCI). x86_64 only; aarch64 identical.
[ -n "${UNAOS_NOPORTSW:-}" ] && _feats="${_feats}noportsw,"
# EHCI-1 scout: read-only EHCI reconnaissance probe (x86_64). UNAOS_EHCISCOUT=1 fires the read-only
# census probe (call site gated `ehciscout_run`); the scout MODULE itself is compiled by default now
# (the EHCI-3 driver, default-ON below, is built from it). Kept in sync with builder/src/main.rs.
[ -n "${UNAOS_EHCISCOUT:-}" ] && _feats="${_feats}ehciscout_run,"
# EHCI-2 configure-and-relook: knob-gated minimal EHCI wake + two PORTSC censuses (x86_64). The
# evidence PROBE call site is gated `ehciconfig_run` (implies ehciconfig for the wake it shares with
# the driver). Pair with UNAOS_NOEHCIHID=1 for pure evidence (no driver). Kept in sync with builder.
[ -n "${UNAOS_EHCICONFIG:-}" ] && _feats="${_feats}ehciconfig_run,"
# EHCI-4 M1: the EHCI-3 minimal HID driver is now DEFAULT-ON on x86 (metal-gated 2026-07-17: the
# internal keyboard TYPES on the 2012 rMBP). The driver + its shared wake + ACPI-root retention are
# compiled by default via `ehcihid` (implies ehciconfig->ehciscout). UNAOS_NOEHCIHID=1 OPTS OUT =>
# feature not pushed => module + all call sites unlinked => byte-identical to the pre-fold no-EHCI
# default. Mirrors the PORTSW-1 default-ON/negative-knob policy. x86_64 only; aarch64 identical.
[ -z "${UNAOS_NOEHCIHID:-}" ] && _feats="${_feats}ehcihid,"
# KBDWIT: the one-shot per-endpoint EHCI interrupt-silence witness (drivers/ehci/mod.rs §KBDWIT) —
# for the s58 metal defect where the rMBP USB keyboard completed NOTHING all boot while the trackpad
# on the same TT streamed. DEFAULT-ON for this round (a new witness family rides the default boot
# only while it is earning its verdict): pushed whenever the driver it instruments is pushed, and
# suppressed by UNAOS_NOKBDWIT=1 => probe + IntEp fields + call site unlinked => the EHCI service
# path is byte-identical to the pre-arc default. Gated on the SAME condition as `ehcihid` on purpose:
# `kbdwit` deliberately does NOT imply `ehcihid` (implying it would resurrect the driver for an
# operator who opted out), so pushing it alone would be a feature with no module to compile into.
# Read-only: no register written, no transfer retried. Kept in sync with builder/src/main.rs.
