        ;;
    test-fat|test_fat)
        test_fat "${2:-part}" "${3:-30}"
        ;;
    test-selfhost|test_selfhost|selfhost)
        test_selfhost "${2:-sf}" "${3:-180}"
        ;;
    kernel8|baremetal)
        kernel8
        ;;
    kernel8-run|run-pi)
        run_kernel8
        ;;
    kernel8-test|test-pi)
        test_kernel8 "${2:-60}"   # MBENCH-HONEST: 8 s never finished a pi4 boot — see test_kernel8
        ;;
    kernel8-install|install-pi)
        install_pi "${2:-12}"
        ;;
    battery)
        battery
        ;;
    mbench)
        # Metal-bench harness passthrough: assert a serial capture (bridge log or
        # QEMU target/serial*.log) against a witness spec in scripts/specs/.
        # See scripts/mbench.py --help (replay / follow / self-test / inject).
        shift
        exec python3 "${WORKSPACE_DIR}/scripts/mbench.py" "$@"
        ;;
    clean)
        clean_all
        ;;
    "")
        while true; do
            show_menu
        done
        ;;
    *)
        echo -e "${COLOR_RED}Unknown command: $1${COLOR_RESET}"
        echo "Usage: ./arroyo [x86|arm|test [secs]|test-arm [secs]|check|build|esp-x86|esp-arm|esp-jetson|vm-image|fat-img|test-fat [part|gpt|p16|sf] [secs]|test-selfhost [part|gpt|p16|sf] [secs]|kernel8|kernel8-run|kernel8-test [secs]|kernel8-install [secs]|battery|clean]"
        exit 1
        ;;
esac
