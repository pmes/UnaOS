[ -n "${UNAOS_ORINDEFER:-}" ] && _feats="${_feats}orindefer,"
# JB11-ESCAPE: UNAOS_NOJB11=1 suppresses the Falcon firmware-header census
# (arch/aarch64/xusb_tegra.rs::jb11_fw_header_census) so a bench sitting can take an UN-INSTRUMENTED
# CONTROL boot. Default UNSET => the census runs on every tegra boot, unchanged — the census is the
# point; this is only its escape. Negative-knob spelling per UNAOS_NOTEGRASMP / UNAOS_NOSDHCBLK /
# UNAOS_NOKBDWIT above.
#
# NOT A CARGO FEATURE, deliberately — this is the one knob in this file whose value lies in NOT
# changing the image. It is read with `option_env!` into a `#[used]` static that the census branches
# on with `read_volatile`, so armed and suppressed builds are the same link: same functions, same
# strings, same codegen units, same panic `Location`s. MEASURED: the loadable images differ in
# EXACTLY ONE BYTE (the flag; `llvm-objcopy -O binary` + `cmp -l`), every symbol address identical —
# the two .elf FILES differ by a further 32 non-loaded bytes of .strtab (LLVM `.llvm.<hash>`
# internal-symbol suffixes), so compare the binary image and not the .elf sha256. JB11's WATCH
# ITEM is that arming the census re-partitioned codegen units and grew the image ~118 KB, and the
# JETSON-XCARVE wall is IMAGE-LAYOUT-CORRELATED — so a `#[cfg]`-style gate would remove the census
# AND relink, confounding "JB11's BAR2 traffic moved the wall" with "the relink moved the wall".
# This knob removes only the traffic, which is the control the WATCH ITEM asks for. Cargo's
# dep-info env tracking rebuilds the kernel when the knob flips, so no feature arm is needed.
#
# Suppression is NEVER SILENT: the kernel prints one line —
#   `:: tegra: JB11 [<tag>] — census SUPPRESSED (UNAOS_NOJB11=1) — control boot: ... ::`
# and returns before its first touch, so the wire always states which of the two boots this was.
# tegra-only (the whole module is `#[cfg(feature = "tegra")]`); no builder mirror — the jetson media
# is built by this script, not by the x86 `builder` crate.
if [ -n "${UNAOS_NOJB11:-}" ]; then
    export UNAOS_NOJB11
    echo -e "${COLOR_YELLOW}⚡ UNAOS_NOJB11: JB11 Falcon fw-header census SUPPRESSED (control boot — same link, ONE byte apart)${COLOR_RESET}"
fi
