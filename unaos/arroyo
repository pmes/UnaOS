# Type-check every USER_CHECK_MATRIX row whose arch label matches $1, and print one summary line in the
# same shape as the kernel legs (`✅ userspace <arch> OK`).
#
# It does NOT stop at the first failure. A broken shared syscall stub typically breaks the same crate on
# both arches and often two crates at once; aborting on the first would hand back one error per run and
# cost a full round-trip per crate. Every failure is collected and NAMED, and the function returns 1 —
# `set -e` at the top of this script then carries that straight out of check_both as a non-zero exit.
check_user_arch() {
    local _want="$1"
    local _rc=0 _n=0 _failed=""
    local _row _crate _arch _tgt _rustflags _targ_arg
    echo -e "${COLOR_YELLOW}⚡ Syntax Check: userspace (${_want})...${COLOR_RESET}"
    for _row in "${USER_CHECK_MATRIX[@]}"; do
        read -r _crate _arch _tgt _rustflags <<< "$_row"
        [ "$_arch" = "$_want" ] || continue
        _n=$((_n + 1))
        # `-` = take the crate's .cargo/config.toml default target; anything else is an explicit override.
        _targ_arg=""
        [ "$_tgt" = "-" ] || _targ_arg="--target $_tgt"
        cd "$WORKSPACE_DIR/crates/$_crate"
        # `|| _rc=...` keeps set -e from aborting the loop; the failure is recorded and reported below.
        if RUSTFLAGS="$_rustflags" cargo +nightly check --release -Z json-target-spec $_targ_arg; then
            echo -e "${COLOR_GREEN}  ✅ ${_crate} (${_arch})${COLOR_RESET}"
        else
            echo -e "${COLOR_RED}  ❌ ${_crate} (${_arch}) FAILED to compile${COLOR_RESET}"
            _failed="${_failed} ${_crate}"
            _rc=1
        fi
    done
    cd "$WORKSPACE_DIR"
    if [ "$_rc" -ne 0 ]; then
        echo -e "${COLOR_RED}❌ userspace ${_want} FAILED:${_failed}${COLOR_RESET}"
        return 1
    fi
    echo -e "${COLOR_GREEN}✅ userspace ${_want} OK (${_n} crates)${COLOR_RESET}"
}

# GATE-CFG: the DEFAULT feature set is a tiny fraction of this kernel. `[features]` in
# crates/kernel/Cargo.toml carries 77 knobs plus `default = []`, so the two legs below compile only
# what survives with every knob off — and `$KERNEL_FEATURES` (the UNAOS_* → cargo-feature mapping at
# the top of this script) adds knobs only when the OPERATOR sets them, which nobody does before a
# commit. Everything behind a `#[cfg(feature = ...)]` was therefore NEVER type-checked by the gate.
# That is not a theoretical hole. `video/wcg.rs` is declared `#[cfg(feature = "witness")] pub mod wcg;`
# in video/mod.rs, and the project's DONE gate is "`./arroyo check` green for both arches" — so a
# session could gate a change to wcg.rs on a check that could not have gone red. Measured directly: a
# deliberate `let _x: u32 = "nope";` appended to wcg.rs left `./arroyo check` at EXIT 0, while the same
# tree with `witness` armed failed at EXIT 101 and named the line. Same class as the GATE-USER hole
# above, and wider — that one missed 5 small crates, this one missed most of the kernel.
#
# THE ARCH SPLIT IS NOT COSMETIC — it is forced, and both halves were measured, not assumed:
#   * aarch64 board features on an x86 compile: HARD FAIL. `--target x86_64-unaos.json` with
#     pi/baremetal/v3d/piusb/genet/nsspan/piinstall* armed produced ~20 errors (`unresolved import
#     crate::drivers::emmc2`, `cannot find 'boot'/'aarch64' in 'arch'`, missing `arch::sched`/
#     `arch::syscall` items). Those features name aarch64-only modules; arming them on x86 is an
#     INVENTED configuration, not coverage.
#   * `pi` + `tegra` together: HARD FAIL, and deliberately so — the kernel itself refuses with
#     `error: kernel features 'pi' and 'tegra' are mutually exclusive — pick one board UART` (plus a
#     duplicate `GICD_BASE`). They select different board UARTs/GIC bases. So there is NO single
#     "everything on" aarch64 leg; two board legs are the minimum that covers both families.
#   * x86-family features on an aarch64 compile: compiles GREEN but VACUOUS — `wc`/`instgui`/kepler/
#     `smc`/`videobench`/`irqstorage`/`ehcihid`/`mtraw`/BENCH-RIDE etc. sit behind
#     `target_arch = "x86_64"` module gates, so aarch64 emits nothing for them. Carrying them on the
#     arm legs would buy zero coverage and cost a compile, so they are excluded ON EVIDENCE.
#
# COVERAGE ARGUMENT (why 3 legs + the 2 default legs are enough). The union of the three feature lists
# below is EXACTLY the `[features]` table minus `default` — 77 of 77, no more and no less, so a knob
# added to Cargo.toml without a leg here is a one-line diff to spot. And the DEFAULT legs already
# compile the all-off state for both arches — so for every feature BOTH polarities of its `#[cfg]` are
# type-checked, which is what makes the 61
# `not(feature = "pi")` / 21 `not(feature = "tegra")` / 14 `not(feature = "baremetal")` sites in the
# tree real coverage rather than an accident. The three default-ON features (`ehcihid`, `kbdwit`,
# `smolnet`) and the negative knob `noportsw` are the one asymmetry worth stating: their opt-OUT state
# has no `#[cfg(not(...))]` site anywhere in src/ (verified), so nothing is left unchecked.
#
# Fields (whitespace-separated, 3 of them; features must contain no spaces):
#   1 leg label — printed on the ✅/❌ line and in the failure summary, so a red gate names the LEG
#     and not just "the kernel".
#   2 --target json, relative to crates/kernel (same form the default legs use).
#   3 comma-separated cargo feature list.
#
# COST: these share the ordinary target/ dir on purpose. Cargo hashes the enabled-feature set into
# each unit's `-Cmetadata`, so a differing feature set gets its OWN fingerprint + rlib and coexists
# with the default legs' artifacts instead of evicting them — alternating `check` and a media build
# does NOT thrash. Warm, all three legs are cache hits; cold-for-these-feature-sets they cost about
# 3-6 s each on top of a warm dependency graph.
KERNEL_CFG_MATRIX=(
  # x86_64, every feature that emits x86 code. Covers (among others) wcg (witness) and its PAYGO
  # reshape (wcg-paygo — an x86-only `#[cfg]` inside a witness-only module, so this is the ONLY leg
  # that type-checks it at all), wcx + the fbcon
  # CONSOLE-WINDOW route (wc), instgui, the Kepler trio, IVB/GMUX, VPERF (videobench/videocap), the
  # EHCI family + KBDWIT, MTRAW + its inject sub-knob, STOR-1 (irqstorage), the BOT fault/ring
  # experiments, BENCH-RIDE (therm/pcilink/vrom), SMC, the rasterizer and the installer engine.
  "x86-all     ../../x86_64-unaos.json  nvidia-kepler,nvidia-kepler-takeover,nvidia-kepler-fifo,wc,instgui,intel-ivb,unaos_ivb,gmux_igd,witness,wcg-paygo,skip_xhci,bootlog,logts,wedge2,sched_demo,usbdebug,mtraw,mtraw_inject,irqstorage,botfaultinject,botring64,videobench,videocap,noportsw,ehciscout,ehciscout_run,ehciconfig,ehciconfig_run,ehcihid,kbdwit,smolnet,thermprobe,pcilink,vromprobe,smc,smcwalk,rast,installdemo"
  # aarch64 board leg 1 — Raspberry Pi 4 bare metal. `baremetal` ⇒ `pi`, which is what unlocks wcf
  # (aarch64 + witness + baremetal), VUG-PAR, the SMP-7/8 + CORE3 probes, the whole V3D battery
  # including its deep/qpu/dispdone/firstkick sub-knobs, PI-USB, GENET + NET-13, NS-SPAN and the
  # three-rung INSTALL-PI ladder. Cannot carry the tegra family — see the mutual-exclusion note above.
  "arm-pi      ../../aarch64-unaos.json witness,logts,wedge2,sched_demo,rast,installdemo,skip_xhci,bootlog,pi,baremetal,vugpar,smp7,smp7_retry,k2_leave,smp8,core3probe,v3d,v3d_deep,v3d_qpu,v3d_dispdone,v3d69_reenable,v3d79_minimal,v3d81,v3d81_qpu,v3d81_display,v3d_firstkick,piusb,genet,nettest,nsspan,piinstall,piinstall_arm,piinstall_confirm"
  # aarch64 board leg 2 — Jetson Orin Nano (Tegra234), plus the board-neutral aarch64 features that
  # would otherwise ride nothing: ORIN-SMP (tegrasmp/smpprobe), the four XCARVE levers, ORIN-NET-1..4
  # (pcieprobe/pcie2/pcie3/net4), the SDMMC → armed-write → install_target ladder, and AARCH64-VNET
  # (the QEMU-virt virtio-net driver, which carries no board gate of its own and so type-checks here).
  "arm-tegra   ../../aarch64-unaos.json witness,logts,wedge2,sched_demo,rast,installdemo,tegra,tegrasmp,smpprobe,xcarve,xcarve_scrub,xcarve_crcrq,xcarve_relink,pcieprobe,pcie2,pcie3,net4,sdmmc,sdmmc_arm,install_target,vnet"
)

# Type-check every KERNEL_CFG_MATRIX leg and print one summary line per leg, in the same shape as the
# kernel and userspace legs above.
#
# Like check_user_arch it does NOT stop at the first failure: a broken shared helper typically breaks
# more than one leg, and aborting on the first would hand back one leg per run — a full round-trip
# each. Every failing leg is collected and NAMED (leg label + the crate that failed to compile), and
# the function returns 1, which check_both turns into a non-zero exit for the whole gate.
#
# NOTE this deliberately does NOT consult $KERNEL_FEATURES. These legs are a FIXED coverage matrix:
# if an operator's UNAOS_* environment could add to them, the gate would mean something different for
# every operator, and "check green" would stop being a shared fact. The operator's own knob set is
# already what the two default legs compile.
check_kernel_cfg() {
    local _rc=0 _n=0 _failed=""
    local _row _leg _tgt _feats
    echo -e "${COLOR_YELLOW}⚡ Syntax Check: kernel cfg-gated coverage (${#KERNEL_CFG_MATRIX[@]} legs)...${COLOR_RESET}"
    cd "$WORKSPACE_DIR/crates/kernel"
    for _row in "${KERNEL_CFG_MATRIX[@]}"; do
        read -r _leg _tgt _feats <<< "$_row"
        _n=$((_n + 1))
        echo -e "${COLOR_CYAN}  → ${_leg}${COLOR_RESET}"
        # `if ... else` (not a bare command) so `set -e` cannot abort the loop before every leg has run.
        if cargo +nightly check --release --target "$_tgt" $NIGHTLY_FLAGS --features "$_feats"; then
            echo -e "${COLOR_GREEN}  ✅ ${_leg}${COLOR_RESET}"
        else
            echo -e "${COLOR_RED}  ❌ ${_leg} — unaos-kernel FAILED to compile${COLOR_RESET}"
            _failed="${_failed} ${_leg}"
            _rc=1
        fi
    done
    cd "$WORKSPACE_DIR"
    if [ "$_rc" -ne 0 ]; then
        echo -e "${COLOR_RED}❌ kernel cfg coverage FAILED (crate unaos-kernel), legs:${_failed}${COLOR_RESET}"
        return 1
    fi
    echo -e "${COLOR_GREEN}✅ kernel cfg coverage OK (${_n} legs)${COLOR_RESET}"
}

check_both() {
    echo -e "${COLOR_YELLOW}⚡ Syntax Check: x86_64...${COLOR_RESET}"
    cd "$WORKSPACE_DIR/crates/kernel"
    cargo +nightly check --release \
      --target ../../x86_64-unaos.json \
      $NIGHTLY_FLAGS $KERNEL_FEATURES
    echo -e "${COLOR_GREEN}✅ x86_64 OK${COLOR_RESET}"

    echo -e "${COLOR_YELLOW}⚡ Syntax Check: aarch64...${COLOR_RESET}"
    cargo +nightly check --release \
      --target ../../aarch64-unaos.json \
      $NIGHTLY_FLAGS $(arm_features)
    cd "$WORKSPACE_DIR"
    echo -e "${COLOR_GREEN}✅ aarch64 OK${COLOR_RESET}"

    # GATE-CFG: the cfg-gated coverage legs, immediately behind the two DEFAULT kernel legs so all the
    # kernel verdicts sit together in the scrollback. The default legs stay first and unchanged: they
    # are what the operator's own UNAOS_* knobs compile, and they are the fastest way to a diagnostic
    # for the edit that was just made. `_krc` carries a red leg past the userspace legs below, so a
    # green userspace can never mask a broken feature-gated kernel.
    local _krc=0
    check_kernel_cfg || _krc=1

    # GATE-USER: the ring-3 crates, per arch, AFTER the kernel legs. Ordering is deliberate — the kernel
    # is what most edits touch, so its diagnostics stay at the top of the scrollback; and a userspace stub
    # that disagrees with the kernel is easier to read once the kernel's own verdict is already in.
    #
    # Both legs run even if the first fails, for the same reason check_user_arch does not stop at its own
    # first failure: one run should name every broken crate. `_urc` carries the verdict past the second
    # leg so a green aarch64 can never mask a red x86_64.
    local _urc=0
    check_user_arch x86_64  || _urc=1
    check_user_arch aarch64 || _urc=1
    if [ "$_urc" -ne 0 ]; then
        echo -e "${COLOR_RED}❌ check FAILED — userspace crates did not compile (see above)${COLOR_RESET}"
        return 1
    fi
    if [ "$_krc" -ne 0 ]; then
        echo -e "${COLOR_RED}❌ check FAILED — cfg-gated kernel code did not compile (see above)${COLOR_RESET}"
        return 1
    fi
}

build_both() {
    build_kernel_x86_64
    build_kernel_aarch64
}

# --- Real-hardware boot media (build + package an ESP, no QEMU) ---

# sha256 of a file on stdout — shasum (macOS) then sha256sum (Linux); empty if neither exists.
sha256_of() {
    if command -v shasum >/dev/null 2>&1; then shasum -a 256 "$1" | awk '{print $1}'
    elif command -v sha256sum >/dev/null 2>&1; then sha256sum "$1" | awk '{print $1}'
    else echo ""; fi
}

# SOURCE-ALONG: every piece of UnaOS boot media carries the source tree that built it.
#   (a) self-hosting rung 1 — the code travels with the machine that runs it;
#   (b) GPL-3.0-or-later source availability BY CONSTRUCTION — the corresponding source ships
#       on the same medium as the binary, so there is never a separate written-offer step.
# Packs `git archive HEAD | gzip` (TRACKED files only — no target/, no untracked junk) to
# <media>/SRC.TGZ plus <media>/SRC.SHA carrying the tarball's sha256 and the exact provenance
# (commit / branch / `git describe --always --dirty`). A dirty working tree is STAMPED -dirty but
# the archive is HEAD — committed state, never the dirt. ~6 MiB compressed today.
# Skippable with UNAOS_NOSRC=1 (tight media, CI speed); default ON for the esp-* media commands.
# See docs/dev/OS/10_INSTALL/source_along.md.
pack_source_along() {
    local dest="$1"
    if [ -n "${UNAOS_NOSRC:-}" ]; then
        rm -f "$dest/SRC.TGZ" "$dest/SRC.SHA" 2>/dev/null || true
        echo -e "${COLOR_YELLOW}⚡ SOURCE-ALONG skipped (UNAOS_NOSRC=1) — no SRC.TGZ on this media${COLOR_RESET}"
        return 0
    fi
    local root; root="$(git -C "$WORKSPACE_DIR" rev-parse --show-toplevel 2>/dev/null || echo "")"
    if [ -z "$root" ]; then
        echo -e "${COLOR_YELLOW}⚠ SOURCE-ALONG: not a git checkout — no SRC.TGZ packed${COLOR_RESET}"
        return 0
    fi
    [ -d "$dest" ] || { echo -e "${COLOR_RED}ERROR: SOURCE-ALONG destination ${dest} does not exist${COLOR_RESET}"; exit 1; }
    echo -e "${COLOR_CYAN}⚡ SOURCE-ALONG: packing the source tree onto the media (SRC.TGZ)...${COLOR_RESET}"
    if ! git -C "$root" archive --format=tar HEAD | gzip -9 > "$dest/SRC.TGZ"; then
        echo -e "${COLOR_RED}ERROR: git archive HEAD failed — SRC.TGZ not written${COLOR_RESET}"; exit 1
    fi
    [ -s "$dest/SRC.TGZ" ] || { echo -e "${COLOR_RED}ERROR: SRC.TGZ is empty${COLOR_RESET}"; exit 1; }
    local sha; sha="$(sha256_of "$dest/SRC.TGZ")"
    [ -n "$sha" ] || { echo -e "${COLOR_RED}ERROR: no shasum/sha256sum on PATH — cannot stamp SRC.SHA${COLOR_RESET}"; exit 1; }
    {
        echo "${sha}  SRC.TGZ"
        echo "commit   $(git -C "$root" rev-parse HEAD)"
        echo "branch   $(git -C "$root" rev-parse --abbrev-ref HEAD)"
        echo "describe $(git -C "$root" describe --always --dirty)"
    } > "$dest/SRC.SHA"
    echo -e "${COLOR_GREEN}✅ SRC.TGZ: $(wc -c < "$dest/SRC.TGZ" | tr -d ' ') bytes${COLOR_RESET}"
    echo -e "   sha256: ${sha}   (SRC.SHA beside it: sha + commit/branch/describe)"
}

# x86_64 boot media for the MacBook (UEFI). Emits TWO trees, because on x86 there are two volumes:
#
#   target/x86_64_esp/   the volume UEFI BOOTS  — EFI/BOOT/BOOTX64.EFI + kernel.elf (+ companions).
#                        Read once, by the bootloader, through firmware boot services. After
#                        ExitBootServices the kernel can never read it again.
#   target/x86_64_data/  the volume the KERNEL READS — HELLO.BIN / STAT.ELF / VUG.ELF / hello.txt.
#                        This is what `fs::fat::mount()` binds, which on x86 is ALWAYS the USB
#                        mass-storage device the xHCI driver enumerated, and nothing else (there is
#                        no SD/AHCI/NVMe driver on this arch, and BootInfo carries no boot-device
#                        handle, so the kernel cannot reach the ESP even in principle).
#
# WINX-7 PKG — WHY THIS SPLIT NOW. An attended rMBP boot reported
#   `:: WINX-2: STAT.ELF absent from the boot volume — end-to-end witness skipped ::`
# with STAT.ELF verifiably on the booted card: the firmware booted the SD-card ESP while xHCI
# enumerated a USB stick, so the shell's `bg /fat/STAT.ELF` searched the stick for a file the build
# had put on the card. The old one-line instruction ("copy the contents to a FAT32 USB root") was
# correct for a ONE-STICK boot and silently wrong for a two-device one; naming the two volumes is
# the fix. On a single stick, write BOTH trees to that one root and everything behaves as before.
esp_x86() {
    echo -e "${COLOR_CYAN}⚡ Building x86_64 kernel + bootloader and packaging the ESP (no QEMU)...${COLOR_RESET}"
    build_user_hello_x86   # U2: target/hello.bin — the builder copies it onto the ESP as HELLO.BIN
    build_user_stat_x86    # WINX-5: target/STAT-X86.ELF — staged as STAT.ELF for `run`/`bg`
    build_user_vug_x86     # WINX-7: target/VUG-X86.ELF — staged as VUG.ELF for `run`/`bg`
    build_user_pulse_x86   # PULSE-1: target/PULSE-X86.ELF — staged as PULSE.ELF for `run`/`bg`
    cd "$WORKSPACE_DIR/builder"
    UNAOS_PACKAGE_ONLY=1 cargo +nightly run --release
    cd "$WORKSPACE_DIR"
    pack_source_along "${WORKSPACE_DIR}/target/x86_64_esp"
    echo -e "${COLOR_GREEN}✅ x86 ESP: ${WORKSPACE_DIR}/target/x86_64_esp/ (incl. HELLO.BIN for the U2 loader)${COLOR_RESET}"
    local _kelf="${WORKSPACE_DIR}/target/x86_64_esp/kernel.elf"
    [ -f "$_kelf" ] && echo -e "   kernel.elf sha256: $(sha256_of "$_kelf")"
    [ -f "${WORKSPACE_DIR}/target/x86_64_esp/SRC.TGZ" ] && \
      echo -e "   SRC.TGZ    sha256: $(sha256_of "${WORKSPACE_DIR}/target/x86_64_esp/SRC.TGZ")"
    echo -e "${COLOR_GREEN}✅ x86 DATA volume: ${WORKSPACE_DIR}/target/x86_64_data/ (HELLO.BIN / STAT.ELF / VUG.ELF)${COLOR_RESET}"
    echo -e ""
    echo -e "   ${COLOR_CYAN}Two volumes, because the kernel cannot read the one it booted from:${COLOR_RESET}"
    echo -e "     BOOT volume  <- target/x86_64_esp/    (UEFI reads this; boot ⌥ Option → 'EFI Boot')"
    echo -e "     DATA volume  <- target/x86_64_data/   (the kernel's FAT mount = the USB stick on storage_slot)"
    echo -e "   ONE stick:  write BOTH trees to that stick's FAT32 root — they do not collide."
    echo -e "   TWO devices (e.g. SD-card ESP + USB stick): esp tree -> the bootable device,"
    echo -e "               data tree -> the USB stick, or \`bg /fat/VUG.ELF\` reports -ENOENT."
    echo -e "   Probe after boot: \`cat hello.txt\` must say 'DATA volume' — if it says anything else,"
    echo -e "               the kernel is reading a stick you did not stage."
}

# VMIMAGE-1: emit ONE self-contained, distributable bootable disk image — a GPT disk with a FAT32
# ESP carrying the SAME boot tree esp-x86 proves (EFI/BOOT/BOOTX64.EFI + kernel.elf + companions) +
# a README-VM.txt. Boots in stock QEMU+OVMF / UTM / VirtualBox/VMware with EFI on, with zero UnaOS
# tooling on the consumer's machine. The builder packages it in pure Rust (fatfs + hand-written GPT,
# builder/src/vm_image.rs); no host mkfs/hdiutil. Writes ONLY to target/vm/ (never disturbs the
# target/ state the test harness uses) and prints the image path + sha256.
vm_image() {
    # SOURCE-ALONG: the VM image's ESP is a FIXED 64 MiB FAT (vm_image.rs ESP_BYTES) built by
    # copying whatever sits in target/x86_64_esp — so a SRC.TGZ left there by an earlier esp-x86
    # would silently ride along and eat the budget. Media packaging for the VM image is out of this
    # arc's scope, so strip it and keep the image byte-comparable to the pre-SOURCE-ALONG one.
    rm -f "${WORKSPACE_DIR}/target/x86_64_esp/SRC.TGZ" "${WORKSPACE_DIR}/target/x86_64_esp/SRC.SHA" 2>/dev/null || true
    local git7; git7="$(cd "$WORKSPACE_DIR" && git rev-parse --short=7 HEAD 2>/dev/null || echo 0000000)"
    echo -e "${COLOR_CYAN}⚡ Building x86 boot products + packaging VM image (unaos-x86-${git7}.img)...${COLOR_RESET}"
    build_user_hello_x86   # U2: target/hello.bin — the builder copies it into the ESP as HELLO.BIN
    build_user_stat_x86    # WINX-5: target/STAT-X86.ELF — staged as STAT.ELF for `run`/`bg`
    build_user_vug_x86     # WINX-7: target/VUG-X86.ELF — staged as VUG.ELF for `run`/`bg`
    build_user_pulse_x86   # PULSE-1: target/PULSE-X86.ELF — staged as PULSE.ELF for `run`/`bg`
    cd "$WORKSPACE_DIR/builder"
    UNAOS_VM_IMAGE=1 UNAOS_VM_GIT7="$git7" cargo +nightly run --release
    cd "$WORKSPACE_DIR"
    local img="${WORKSPACE_DIR}/target/vm/unaos-x86-${git7}.img"
    if [ ! -f "$img" ]; then
        echo -e "${COLOR_RED}ERROR: expected image ${img} was not produced${COLOR_RESET}"; exit 1
    fi
    # sha256: prefer shasum (macOS) then sha256sum (Linux); fail honestly if neither exists.
    local sha=""
    if command -v shasum >/dev/null 2>&1; then
        sha="$(shasum -a 256 "$img" | awk '{print $1}')"
    elif command -v sha256sum >/dev/null 2>&1; then
        sha="$(sha256sum "$img" | awk '{print $1}')"
    else
        echo -e "${COLOR_YELLOW}⚠ neither shasum nor sha256sum found — skipping checksum${COLOR_RESET}"
    fi
    echo -e "${COLOR_GREEN}✅ VM image: ${img}${COLOR_RESET}"
    echo -e "   size: $(wc -c < "$img" | tr -d ' ') bytes"
    [ -n "$sha" ] && echo -e "   sha256: ${sha}"
    echo -e "   Boot it (stock QEMU+OVMF, no arroyo harness; disk attached over USB so the boot"
    echo -e "   log is saved back to UNAOS.LOG on the image — the kernel drives USB storage, not SATA):"
    echo -e "     qemu-system-x86_64 -machine q35 -m 1G \\"
    echo -e "       -drive if=pflash,format=raw,readonly=on,file=<OVMF_CODE.fd> \\"
    echo -e "       -drive if=none,id=unastick,format=raw,file=${img} \\"
    echo -e "       -device qemu-xhci -device usb-storage,drive=unastick,bootindex=0 -serial stdio"
    echo -e "   After shutdown, attach the .img and copy UNAOS.LOG off it (that is the boot log to"
    echo -e "   send back). README-VM.txt inside the image has the UTM / VirtualBox / VMware paths."
}

# Build the FAT32 test image(s) the kernel's read-only FAT reader parses (ls/cat). Ensures the x86
# ESP is packaged first (so EFI/ + kernel.elf populate the volume), then builds a partitioned image
# (MBR@LBA0 -> BPB) and a superfloppy (BPB@LBA0). Test with `UNAOS_FATIMG=1 ./arroyo test`.
fat_img() {
    # SOURCE-ALONG stays OFF for the FAT test fixtures: these are size-budgeted images (96 MiB FAT32,
    # 32 MiB FAT16) whose contents the kernel's read-only FAT tests enumerate — a multi-MiB SRC.TGZ
    # is neither wanted nor budgeted there. Also strip one left by a previous esp-x86 run.
    export UNAOS_NOSRC=1
    rm -f "${WORKSPACE_DIR}/target/x86_64_esp/SRC.TGZ" "${WORKSPACE_DIR}/target/x86_64_esp/SRC.SHA" 2>/dev/null || true
    build_user_hello_x86   # U2: ensure target/hello.bin is fresh even if the ESP is reused below
    build_user_stat_x86    # WINX-5: target/STAT-X86.ELF — staged as STAT.ELF for `run`/`bg`
    build_user_vug_x86     # WINX-7: target/VUG-X86.ELF — staged as VUG.ELF for `run`/`bg`
    build_user_pulse_x86   # PULSE-1: target/PULSE-X86.ELF — staged as PULSE.ELF for `run`/`bg`
    if [ ! -d "${WORKSPACE_DIR}/target/x86_64_esp" ]; then
        echo -e "${COLOR_YELLOW}⚡ Packaging the x86 ESP first (payload for the FAT image)...${COLOR_RESET}"
        esp_x86
    fi
    echo -e "${COLOR_CYAN}⚡ Building FAT test images (MBR/GPT FAT32 + FAT16 + superfloppy)...${COLOR_RESET}"
    bash "${WORKSPACE_DIR}/scripts/make-fat-img.sh" part
    bash "${WORKSPACE_DIR}/scripts/make-fat-img.sh" gpt
    bash "${WORKSPACE_DIR}/scripts/make-fat-img.sh" p16
    bash "${WORKSPACE_DIR}/scripts/make-fat-img.sh" sf
    echo -e "${COLOR_GREEN}✅ FAT images: fat.img (MBR32), fat-gpt.img (GPT32), fat16.img (MBR16), fat-sf.img (superfloppy)${COLOR_RESET}"
    echo -e "   Test:  ./arroyo test-fat [part|gpt|p16|sf] 30"
}

# Headless FAT test the right way: package a FRESH ESP, rebuild the FAT image from it (so the
# usb-storage backing -- which OVMF may boot, since it carries EFI/BOOT/BOOTX64.EFI -- runs the
# SAME kernel under test, not a stale one), then boot with that FAT image as the block device.
# `./arroyo test-fat [part|sf] [secs]`. Mirrors a single-stick metal boot (boot + block are one FAT).
test_fat() {
    local layout="${1:-part}"
    local secs="${2:-30}"
    case "$layout" in part|gpt|p16|sf) ;; *) echo "usage: ./arroyo test-fat [part|gpt|p16|sf] [secs]"; exit 1;; esac
    export UNAOS_NOSRC=1   # SOURCE-ALONG off for the FAT test fixtures (see fat_img)
    esp_x86
    bash "${WORKSPACE_DIR}/scripts/make-fat-img.sh" "$layout"
    export UNAOS_FATIMG="$layout"
    test_x86_64 "$secs"
}

