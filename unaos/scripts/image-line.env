# image-line.env — THE IMAGE BUILD LINE (FOLDBUILD, rmbp-ledger B517). Every `UNAOS_*` knob the bench's rMBP image
# build (`./arroyo esp-x86` with UNAOS_UNAFS=1 -> the card image) arms, ONE `export` per line, in arroyo's knob-map
# order, each with the STATE (docs/dev/OS/rmbp-queue.md) or FLIGHT header that added it. From FOLDBUILD on a STATE
# paragraph cites this file as `image-line.env @<sha>` and never restates the line; a knob joins or leaves the image
# by a commit to THIS file. Derivation, knob by knob: docs/dev/evidence/foldbuild/IMAGE-LINE.md.
#
# Shape (`./arroyo gates` row image-line = scripts/knob-parity.sh --line reds anything else):
#   export UNAOS_<KNOB>=1  # <who added it>                      a kernel knob: arroyo's map AND the builder's
#   export UNAOS_<KNOB>="${UNAOS_<KNOB>:?set on the bench}"  # [media] <who>   a bench-local value arroyo stages onto
#                                                                the medium; the builder and the kernel never read it
# Users: `./arroyo foldleg` (the kernel + loader built under this line, a fold leg); the bench:
#   set -a; . unaos/scripts/image-line.env; set +a; ./arroyo esp-x86
# NOT on the line: UNAOS_LOGINST (NEVER on media), UNAOS_CENSUS and the recon knobs (QUIETBOOT, R80), UNAOS_USBDEBUG
# and UNAOS_KEPLER_FIFO (dropped at image 20), UNAOS_WIFI5, UNAOS_INSTGUI (its window opens at every
# desktop activation, R86 — INSTALL4 B619). INSTALL4 put the installer on the line (UNAOS_INSTALLDEMO, UNAOS_AHCI_WRITE,
# UNAOS_AHCIROOT): `install ssd --dry-run` needs no rebuild; every write still needs a grant AND the operator's typed
# token (docs/dev/OS/10_INSTALL/FLIGHT35-INSTALL.md), and the unattended boot fixture is compiled to write nothing
# without tests-at-boot (never on this line).
export UNAOS_WITNESS=1  # flight 10's flown line (image 2b, PLAYBOOK-flown.md) — on f28's wire: `witness-fixture`
export UNAOS_SELFHOST=1  # image 12 = image 11's proven line + SELFHOST LINUXABI BUSREG (queue STATE BOOT 19 READ, FLIGHT19.md)
export UNAOS_WCG_PAYGO=1  # flight 10's flown line — on f28's wire: `[wc-d] paygo win=` (witness+wcg-paygo)
export UNAOS_WCDVALVE=1  # flight 10's flown line — on f28's wire: `[wc-d] valve CLOSED` (witness+wcdvalve)
export UNAOS_LOGTS=1  # flight 10's flown line; FLIGHT22/23.md: line stamps are the kernel's clock (UNAOS_LOGTS=1)
export UNAOS_SMC=1  # flight 10's flown line (LIDSLEEP, image 20, implies it too)
export UNAOS_BT=1  # flight 10's flown line — on f28's wire: `probe=bt-campaign`
export UNAOS_BTC=1  # flight 10's flown line; re-named by STATE BOOT 21 READ (image 15) "ADD UNAOS_BTC=1"
export UNAOS_LOGIN=1  # queue STATE (flight-11 era) "knob line plus UNAOS_LOGIN=1 (NEVER UNAOS_LOGINST=1 on media)"
export UNAOS_INSTALLDEMO=1  # INSTALL4 (rmbp-ledger B619, flight 35): the `install` verb family on the image — `install ssd --dry-run` with no rebuild
export UNAOS_WIFI=1  # flight 10's flown line; restated by STATE MERGE17 FOLDED (image 19)
export UNAOS_WIFI2=1  # flight 10's flown line; restated by STATE MERGE17 FOLDED (image 19)
export UNAOS_WIFI3=1  # queue "flight line = gate7 line + UNAOS_WIFI3=1 UNAOS_WIFI4=1" (Peter's go 2026-09-17); restated image 19
export UNAOS_WIFI4=1  # same STATE as WIFI3; restated by STATE MERGE17 FOLDED (image 19)
export UNAOS_WIFI9=1  # WIFI9 (rmbp-ledger B625, R110): `tests wifi` runs the receive-only S5i/S5c/S6 rungs (HT-PHY re-init, ch-11 tune, the RX ring, 5 s beacons)
export UNAOS_WIFI10=1  # WIFI10 (rmbp-ledger B646, R110; Peter 2026-10-14 "proceed with … wifi"): `tests wifi` runs S7's probe-request half after wifi9 — THE FIRST TRANSMIT
export UNAOS_KEPLER=1  # flight 10's flown line; FLIGHT19.md / queue: image 12's line restored it (the pasted line lacked it)
export UNAOS_KEPLER_TAKEOVER=1  # flight 10's flown line; restored at image 12 as KEPLER — on f28's wire: `:: GPUBLIT: … blitter=gpu`
export UNAOS_NOASPM=1  # flight 10's flown line — on f28's wire: `[pcih] aspm cleared rp`
export UNAOS_KEPLER_CE=1  # bench, 2026-10-12: on image 21 ("KEPLER_CE is on. Only the FIFO knob was dropped at image 20"); f28: KEPLERGR3 B503 ran the CE leg
export UNAOS_WC=1  # flight 10's flown line (REQUIRED by video/mod.rs; every line since)
export UNAOS_KEPLER_VBLANK=1  # STATE BOOT 19 READ: "UNAOS_KEPLER_VBLANK=1 stays as flown on boot 19" — on f28's wire: `:: kepler: vblank-intr`
export UNAOS_DEADMAN=1  # flight 10's flown line; never named dropped (census-gated since QUIETBOOT, so silent) — BENCH CONFIRM
export UNAOS_LINUXABI=1  # image 12 (STATE BOOT 19 READ, FLIGHT19.md)
export UNAOS_BUSREG=1  # image 12 (STATE BOOT 19 READ, FLIGHT19.md)
export UNAOS_LUMEN=1  # image 13 = image 12 + VEIN LUMEN NETRING3 (STATE BOOT 19 READ, FLIGHT20.md) — on f28's wire: `:: LUMEN:`
export UNAOS_STRIA=1  # STRIAMETAL (LEDGER SR139, wave32: Peter 2026-10-14 "throw getting it up to speed natively into the mix") — `tests stria`, APPS/STRIA.ELF first for its media types
export UNAOS_NETRING3=1  # image 13 (STATE BOOT 19 READ, FLIGHT20.md)
export UNAOS_SELFDIAG=1  # image 15 = image 14 − the nine recon knobs + SELFDIAG (STATE BOOT 21 READ, FLIGHT22.md)
export UNAOS_LIDSLEEP=1  # image 20 (STATE MERGE18/MERGE19 FOLDED "PLUS UNAOS_IVB3D_BLIT=1 UNAOS_LIDSLEEP=1 UNAOS_VIDEO=1", FLIGHT27.md) — f28: `[smc] lid=open`
export UNAOS_VIDEO=1  # image 20 (same STATE, FLIGHT27.md)
export UNAOS_IVB=1  # flight 10's flown line; restored at image 12 (FLIGHT19.md: the pasted line lacked IVB)
export UNAOS_IVB3D=1  # flight 10's line; dropped at image 15 (recon); re-added image 19 (STATE MERGE17 FOLDED, FLIGHT26.md)
export UNAOS_IVB3D_R8=1  # flight 10's line; dropped at image 15 (recon); re-added image 19 (STATE MERGE17 FOLDED, FLIGHT26.md) — f28: `:: gen7: r8 begin`
export UNAOS_IVB3D_BLIT=1  # image 20 (STATE MERGE18/MERGE19 FOLDED, FLIGHT27.md) — on f28's wire: `:: GEN7BLIT2: impl=bcs`
export UNAOS_IVB3D_R9=1  # GEN7R9B (rmbp-ledger B626, wave32): R9 executes on the RCS under `tests gen7` after R1-R7, before the ladder line and R8 (R80: nothing at boot) — `[gen7] r9 ring=rcs`
export UNAOS_GMUX_IGD=1  # flight 10's flown line; restored at image 12 (FLIGHT19.md) — on f28's wire: `[GMUX] switched … to IGD`
export UNAOS_BEAM=1  # flight 10's flown line ("UNAOS_BEAM=1 confirmed on the line since flight 8") — f28: `:: BEAMX86: head=`
export UNAOS_QUARRY=1  # flight 10's flown line ("UNAOS_QUARRY=1 is the addition since flight 9"); image 3 names it again
export UNAOS_FACET=1  # image 9 = image 8's + UNAOS_FACET=1 (queue, the image-9 staging record)
export UNAOS_FTDIRX=1  # flight 10's flown line — on f28's wire: `:: FTDIRX: first byte rx=`
export UNAOS_USBNET=1  # image 10 = image 9's + UNAOS_USBNET=1 (queue, the image-10 staging record; FLIGHT17.md)
export UNAOS_AHCI=1  # flight 10's flown line — on f28's wire: `AHCI: selfcheck port=0`
export UNAOS_AHCI_WRITE=1  # INSTALL4 (B619): opens the installer's SATA READ (the census); a write still needs a minted grant + the typed token
export UNAOS_UNAFS=1  # image 14 = image 13 − VEIN + UNAFS (STATE BOOT 20 READ / R82, FLIGHT21.md) — f28: `:: UNAFSX86: root=`
export UNAOS_AHCIROOT=1  # INSTALL4 (B619): the SSD install's UnaFS leg + the SSD root after it (B332); `--write --beside <token>`
export UNAOS_HDA=1  # queue "the flight line takes UNAOS_HDA=1 UNAOS_HDATONE=1 now" (HDAAMP era) — on f28's wire: `[hda] census`
export UNAOS_HDATONE=1  # same STATE as HDA — on f28's wire: `:: HDA-TONE:`
export UNAOS_UVC=1  # image 4 (flight 12; the bench's gate10.sh) — on every flown line since; the derivation missed it (bench, 2026-10-12)
export UNAOS_IOAPIC=1  # NO STATE names it (IOAPIC B147, the flight-13 ISRARM era) — on f28's wire: `[ioapic] census ioapics=1` (cfg(feature="ioapic")) — BENCH CONFIRM
export UNAOS_WIFI_FW_PATH="${UNAOS_WIFI_FW_PATH:?set on the bench}"  # [media] image 19 (STATE MERGE17 FOLDED, FLIGHT26.md): the b43 set staged onto the card's UnaFS /FIRMWARE/
# OLDEST (rmbp-ledger B682, BP-bar-1, BP-boot-15): this line is for rmbp12:2012 — the 2012 MacBook Pro Retina is the oldest machine it serves, first-class for as long as it powers on. The const is `boot::OLDEST` (one per board, armed by UNAOS_LOGIN above); the boot that reaches this line's desktop prints `:: OLDEST: board=rmbp12 year=2012 image=<build sha> net=<absent|present> -> BOOTS ::` at its first `[desktop] built` (twoboot boot 1 REQUIREs it).
