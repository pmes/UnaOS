# image-line-orin.env — THE ORIN IMAGE BUILD LINE (ARMLINE, LEDGER SR102, wave24arm). Every `UNAOS_*` knob the
# bench's Jetson Orin card build (`./arroyo esp-jetson`, which also cuts target/UnaOS-orin-card.img) arms, ONE
# `export` per line, in arroyo's knob-map order (the top-level `_feats` map `esp_jetson()` builds from), each with
# the record that put it there. The twin of unaos/scripts/image-line.env (FOLDBUILD, rmbp-ledger B517) for the
# Orin: a knob joins or leaves the Orin image by a commit to THIS file, and a STATE paragraph cites it as
# `image-line-orin.env @<sha>` instead of restating the line.
#
# The board's line of record is the seven-knob `# KNOBS:` line every staged Orin MANIFEST carries (UNAOS_TEGRA
# UNAOS_TEGRA_EL0 UNAOS_WITNESS UNAOS_ORINDESK UNAOS_ORINCLICK UNAOS_ORINCONWIN UNAOS_ORINRENDER); image 24 adds
# the ten knobs below it (Peter, 2026-10-13: "elevate orin and pi to this level [image 24]. we'll need to test
# sonde with the orin"). esp_jetson() FORCES tegra, tegrasmp, apsrun, bsptick, bsprun and sdmmc on its own
# (the opt-outs are UNAOS_NO*), so none of those is on the line. Check leg: `arm-tegra-image`.
#
# Shape: image-line.env's (`export UNAOS_<KNOB>=1  # <who added it>`). NOTE: `scripts/knob-parity.sh --line`
# also holds every knob to the x86 builder's env→feature map, which maps none of the Orin-only knobs, so that
# gate is the rMBP line's, not this file's (reported with SR102).
# Users — the bench:
#   set -a; . unaos/scripts/image-line-orin.env; set +a; ./arroyo esp-jetson
export UNAOS_WITNESS=1  # the Orin MANIFEST `# KNOBS:` line of record
export UNAOS_HOLOCRON=1  # image 24 (ARMLINE SR102; the Orin carried it on arm-tegra-render) — the record store
export UNAOS_LOGIN=1  # image 24 (ARMLINE SR102; SO43 LOGINBOOT, the rMBP line's "UNAOS_LOGIN=1")
export UNAOS_LUMEN=1  # image 24 (ARMLINE SR102; image 13's LUMEN, HOLOCRONARM's staging keys on it)
export UNAOS_MIDDEN=1  # image 24 (ARMLINE SR102; MIDDENTWIN SR75 — aarch64 MIDDEN.ELF is ARMAPPS's)
export UNAOS_UNA=1  # image 24 (ARMLINE SR102; UNAMETAL SR90 — aarch64 UNA.ELF is ARMAPPS's)
export UNAOS_SONDE=1  # image 24 (ARMLINE SR102; REALSENSE SR92, "test sonde with the orin" — the aarch64 gate lift is ARMSONDE SR101)
export UNAOS_AETHER=1  # image 24 (ARMLINE SR102; AETHERMETAL SR66 — aarch64 AETHER.ELF is ARMAPPS's)
export UNAOS_STRIA=1  # STRIAMETAL (LEDGER SR139, wave32) — aarch64 STRIA.ELF plays on the kernel clock (the sound is refused by name: no Orin sink driver)
export UNAOS_SELFDIAG=1  # image 24 (ARMLINE SR102; image 15's SELFDIAG on the rMBP line)
export UNAOS_TEGRA=1  # the Orin MANIFEST `# KNOBS:` line of record
export UNAOS_ORINDESK=1  # the Orin MANIFEST `# KNOBS:` line of record
export UNAOS_ORINCLICK=1  # the Orin MANIFEST `# KNOBS:` line of record
export UNAOS_TEGRA_EL0=1  # the Orin MANIFEST `# KNOBS:` line of record
export UNAOS_ORINCONWIN=1  # the Orin MANIFEST `# KNOBS:` line of record
export UNAOS_ORINRENDER=1  # the Orin MANIFEST `# KNOBS:` line of record
export UNAOS_USBNET=1  # image 24 (ARMLINE SR102; image 10's USBNET on the rMBP line; the shared xHCI reaches the Orin's XUSB)
export UNAOS_UVC=1  # image 24 (ARMLINE SR102; image 4's UVC on the rMBP line; sonde implies it — the aarch64 gate lift is ARMSONDE SR101)
