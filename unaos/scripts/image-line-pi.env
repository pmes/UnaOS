# image-line-pi.env — THE PI 4 IMAGE BUILD LINE (ARMLINE, LEDGER SR102, wave24arm). Every `UNAOS_*` knob the
# bench's Pi 4 card build (`./arroyo kernel8`) arms, ONE `export` per line, in the order `kernel8()`'s CURATED
# K8_FEATS arms read them (kernel8 never reads the top-level `_feats` map), each with the record that put it
# there. The twin of unaos/scripts/image-line.env (FOLDBUILD, rmbp-ledger B517) for the Pi: a knob joins or
# leaves the Pi image by a commit to THIS file, and a STATE paragraph cites it as `image-line-pi.env @<sha>`.
#
# The board's line of record is LAWS §9's desktop line (2026-08-18: UNAOS_WITNESS UNAOS_PIUSB UNAOS_GENET
# UNAOS_SMP7 UNAOS_NETTEST UNAOS_V3D UNAOS_VUGPAR UNAOS_WEDGE2 UNAOS_PIDESK UNAOS_PIRAST UNAOS_QUARRY) plus
# UNAOS_LOGIN=1 (pi-queue "BOOT 13"); image 24 adds the rest (Peter, 2026-10-13: "elevate orin and pi to this
# level [image 24]"). Check leg: `arm-pi-image`.
#
# NOT on the line: the panel geometry UNAOS_FBW=1920 UNAOS_FBH=1200 (an option_env! VALUE the bench sets beside
# this file for its 1920x1200 panel; QEMU raspi4b is 640x480), UNAOS_LOGINST (NEVER on media).
# Shape: image-line.env's (`export UNAOS_<KNOB>=1  # <who added it>`). NOTE: `scripts/knob-parity.sh --line`
# reads the top-level map and the x86 builder's, neither of which maps the Pi-only knobs, so that gate is the
# rMBP line's, not this file's (reported with SR102).
# Users — the bench:
#   set -a; . unaos/scripts/image-line-pi.env; set +a; ./arroyo kernel8
export UNAOS_UNAFS=1  # PIUNAFS (LEDGER SR178): a native UnaFS root gets the native home, /jobs, the catalog search and the root witness — the rMBP line's rule (K8_FEATS arm arroyo:11623)
export UNAOS_WITNESS=1  # LAWS §9 Pi desktop line of record
export UNAOS_USBNET=1  # image 24 (ARMLINE SR102; USBNET SO56, image 10's on the rMBP line)
export UNAOS_SMP7=1  # LAWS §9 Pi desktop line of record
export UNAOS_V3D=1  # LAWS §9 Pi desktop line of record
export UNAOS_VUGPAR=1  # LAWS §9 Pi desktop line of record
export UNAOS_WEDGE2=1  # LAWS §9 Pi desktop line of record
export UNAOS_PIUSB=1  # LAWS §9 Pi desktop line of record
export UNAOS_GENET=1  # LAWS §9 Pi desktop line of record
export UNAOS_NETTEST=1  # LAWS §9 Pi desktop line of record
export UNAOS_PIRAST=1  # LAWS §9 Pi desktop line of record
export UNAOS_PIDESK=1  # LAWS §9 Pi desktop line of record
export UNAOS_QUARRY=1  # LAWS §9 Pi desktop line of record
export UNAOS_LOGIN=1  # pi-queue "BOOT 13": LAWS §9's line + UNAOS_LOGIN=1
export UNAOS_LUMEN=1  # image 24 (ARMLINE SR102; LUMENBIN + HOLOCRONARM: APPS/HOLOCRON.ELF)
export UNAOS_SELFDIAG=1  # image 24 (ARMLINE SR102; image 15's SELFDIAG on the rMBP line)
export UNAOS_HOLOCRON=1  # image 24 (ARMLINE SR102; the K8_FEATS arm is new with this file)
export UNAOS_MIDDEN=1  # image 24 (ARMLINE SR102; MIDDENTWIN SR75 — aarch64 MIDDEN.ELF is ARMAPPS's)
export UNAOS_UNA=1  # image 24 (ARMLINE SR102; UNAMETAL SR90 — aarch64 UNA.ELF is ARMAPPS's)
export UNAOS_SONDE=1  # image 24 (ARMLINE SR102; REALSENSE SR92 — the aarch64 gate lift is ARMSONDE SR101)
export UNAOS_AETHER=1  # image 24 (ARMLINE SR102; AETHERMETAL SR66 — aarch64 AETHER.ELF is ARMAPPS's)
export UNAOS_STRIA=1  # STRIAMETAL (LEDGER SR139, wave32) — aarch64 STRIA.ELF plays on the kernel clock (the sound is refused by name: no Pi sink driver)
export UNAOS_UVC=1  # image 24 (ARMLINE SR102; image 4's UVC on the rMBP line; sonde implies it)
# OLDEST (rmbp-ledger B682, BP-bar-1, BP-boot-15): this line is for pi4:2019 — the Raspberry Pi 4 is the oldest machine it serves. The const is `boot::OLDEST` (aarch64 without tegra, armed by UNAOS_LOGIN above); its first `[desktop] built` prints `:: OLDEST: board=pi4 year=2019 image=<build sha> net=<absent|present> -> BOOTS ::`.
