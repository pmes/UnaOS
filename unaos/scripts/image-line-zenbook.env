# image-line-zenbook.env — THE ZENBOOK IMAGE BUILD LINE (ZENBOOKIMAGELINE, zenbook-ledger Z6, wave 36). Every `UNAOS_*`
# knob the bench's ASUS Zenbook UM5606W card build (`./arroyo esp-zenbook` = `esp-x86` under THIS file) arms, ONE
# `export` per line, in arroyo's knob-map order, each with the reason it is on the Zenbook. The twin of
# unaos/scripts/image-line.env (FOLDBUILD, rmbp-ledger B517) for the Zenbook: a knob joins or leaves the Zenbook image by a
# commit to THIS file, and a STATE paragraph cites it as `image-line-zenbook.env @<sha>`.
#
# The line is the rMBP line WITHOUT its Mac-only knobs (docs/dev/OS/01_BOOT_HAL/um5606w.md §5) and without the SATA set,
# plus the Zenbook's own storage (NVMe) and the MT7925 firmware. NOTHING here has booted (ZENBOOK-FIRSTBOOT, the bench's).
# Shape: image-line.env's (`export UNAOS_<KNOB>=1  # <reason>`, `[media]` form for a bench-local value); every knob is an
# x86 knob, so `scripts/knob-parity.sh --line <this file>` (x86 mode) reads it as it reads the rMBP line.
#
# NOT on the line (and UNSET by `esp-zenbook` if the caller's shell exported them — the builder arms a knob that merely
# EXISTS, builder/src/main.rs `std::env::var(..).is_ok()`, so an inherited rMBP line would otherwise ride along):
#   SMC LIDSLEEP — the Apple SMC (ports 0x300/0x304); battery and lid are the EC's on the Zenbook (ZENBOOK-EC)
#   KEPLER KEPLER_TAKEOVER KEPLER_CE KEPLER_VBLANK NOASPM BEAM — the GK107 (10DE:0FD5) only; the Zenbook draws the GOP framebuffer
#   IVB IVB3D IVB3D_R8 IVB3D_BLIT IVB3D_R9 GMUX_IGD — the Ivy Bridge IGD (8086:0166) and the gmux; IVB also builds the
#       loader's entry traces (bootloader main.rs `read_igpu_trace`/`read_gmux_trace`, cfg unaos_ivb) — ZENBOOK-LOADERTRACE
#   HDA HDATONE — the CS4206 codec policy; the Zenbook's ALC294 + ACP is ZENBOOK-ACP
#   WIFI WIFI2 WIFI3 WIFI4 WIFI9 WIFI10 UNAOS_WIFI_FW_PATH — the Broadcom b43 radio; the Zenbook's radio is the MT7925
#   BT BTC A2DP — the Broadcom Bluetooth controller (USB ids not on the Zenbook)
#   AHCI AHCI_WRITE AHCIROOT — SATA; Strix Point has none (um5606w.md §1); the root is the card's UnaFS (the Pi/Orin shape)
#   UNAOS_GOP — the loader's output override (ZENBOOKGOP Z4); its rule picks; `esp-zenbook` passes a bench-set value through
#   UNAOS_FBW UNAOS_FBH UNAOS_PPI — QEMU panel geometry, never media; UNAOS_LOGINST — NEVER on media
# Passed through `esp-zenbook` untouched: UNAOS_MT7925_FW_PATH, UNAOS_GOP, UNAOS_NOSRC, UNAOS_X86_UNAFS_MB.
# Users — the bench:
#   UNAOS_MT7925_FW_PATH=<bunker dir> ./arroyo esp-zenbook
export UNAOS_WITNESS=1  # the rMBP line's (flight 10): the boot-honesty witnesses; generic x86
export UNAOS_SELFHOST=1  # the rMBP line's (image 12): ring-3 self-hosting; generic
export UNAOS_WCG_PAYGO=1  # the rMBP line's (flight 10): the compositor's pay-as-you-go repaint; generic wm code
export UNAOS_WCDVALVE=1  # the rMBP line's (flight 10): the WC-D valve; generic wm code, opens at services (BP-boot-3)
export UNAOS_LOGTS=1  # the rMBP line's (flight 10): line stamps on the kernel's clock — the first boot's wire needs them
export UNAOS_TICKLESS=1  # the rMBP line's (TICKLESSENV B773): idle cores halt to the next deadline on the LAPIC one-shot; no Apple part
export UNAOS_LOGIN=1  # every image line's: users, the login screen, `boot::OLDEST` (below) — NEVER UNAOS_LOGINST on media
export UNAOS_INSTALLDEMO=1  # the rMBP line's (INSTALL4 B619): the `install` verb family; `install ssd --dry-run` finds no SATA here
export UNAOS_WC=1  # the desktop: the window compositor on the GOP framebuffer — the x86-wc lane's Kepler-less path (Z4 measured)
export UNAOS_DEADMAN=1  # the rMBP line's (flight 10): the dead-man instrument; generic
export UNAOS_LINUXABI=1  # the rMBP line's (image 12): the Linux ABI shim for ring 3; generic
export UNAOS_BUSREG=1  # the rMBP line's (image 12): the bus registry; generic
export UNAOS_LUMEN=1  # the rMBP line's (image 13): APPS/LUMEN.ELF; generic ring 3
export UNAOS_STRIA=1  # the rMBP line's (STRIAMETAL SR139): APPS/STRIA.ELF; no sink driver yet on the Zenbook (ZENBOOK-ACP)
export UNAOS_NETRING3=1  # the rMBP line's (image 13): APPS/NET.ELF, the ring-3 network stack; reached through USBNET here
export UNAOS_SELFDIAG=1  # the rMBP line's (image 15): APPS/DIAG.ELF; generic
export UNAOS_VIDEO=1  # the rMBP line's (image 20): the video cores and the Player; generic
export UNAOS_QUARRY=1  # the rMBP line's (flight 10): the file browser; generic
export UNAOS_FACET=1  # the rMBP line's (image 9): the image viewer; generic
export UNAOS_FTDIRX=1  # the serial door: the FTDI FT232 over xHCI, TX + receive (um5606w.md §7) — the bench's only serial on the Zenbook
export UNAOS_USBNET=1  # the rMBP line's (image 10): a USB Ethernet dongle — the Zenbook's only wired network (no e1000, the MT7925 is S1)
export UNAOS_NVME=1  # ZENBOOKNVME (Z2): the M.2 NVMe SSD, the Zenbook's only internal disk (class 0108) — `[nvme] ctrl … -> ready`
export UNAOS_UNAFS=1  # the rMBP line's (image 14): the card's UnaFS root (esp-x86 lays the card image only under it)
export UNAOS_UVC=1  # the rMBP line's (image 4): the USB Video Class driver; generic USB (whether the Zenbook's camera is UVC is the first boot's to read)
export UNAOS_IOAPIC=1  # Z3's IRQ1 route for the i8042 keyboard; the census writes nothing and the AMD FCH's two I/O APICs fit MAX_IOAPICS=4 (ZENBOOKIMAGELINE measured)
export UNAOS_MT7925_FW_PATH="${UNAOS_MT7925_FW_PATH:?set on the bench}"  # [media] ZENBOOKMT7925 (Z5): the linux-firmware mediatek/mt7925 pair staged onto the ESP at FW/MT7925/, pinned by firmware/mt7925.pins (`fw_stage_pinned MT7925-FW`)
# OLDEST (rmbp-ledger B682, BP-bar-1, BP-boot-15): this line is for zenbook:2024 — the ASUS Zenbook UM5606W (2024) is the oldest machine it serves. ZENBOOKOLDEST (zenbook-ledger Z12): `boot::oldest()` (unaos/crates/kernel/src/boot.rs tail) overrides the x86 cfg default (rmbp12 2012) by `hw::platform()`, so an image built from this line prints `:: OLDEST: board=zenbook year=2024 image=<build sha> net=<absent|present> -> BOOTS ::` on the Zenbook and runs its `@zenbook` BOOTLIST lines (an `@rmbp12` line is skipped).
