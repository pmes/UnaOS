 const FLOOR_CELLS: usize = 20;
 
+/// PULSEOCCLUDE — **the rows this window will take from the bottom of the work area once it opens**,
+/// in panel pixels: its outer box plus the gap [`open`] insets it by, or `0` when [`content_extent`]
+/// declines the panel (no window, nothing reserved).
+///
+/// For `fbcon::panel_console_window_open`, which sizes the console against the work area and centres
+/// it there, and until this existed did both as if this window did not exist. On the Orin's 1920x1200
+/// panel the two collided: the console's box sat at y 158..938 and this window's at y 874..1086 —
+/// 64 rows of overlap, z above, over the console's last four text rows, the prompt among them
+/// (`[wc-h] win=3 … span=64 band=yes`, `[wcn] win=3 … drg=N`; RENDER2-AUDIT N1). Same shape on the Pi
+/// at four cores, 16 rows deep, unnoticed because the Pi's console is frozen by the handoff before
+/// this window opens. The number is computed HERE, from the same `content_extent` + `spawn_geometry`
+/// pair `open` sizes the box with, so the reservation and the thing reserving it cannot drift apart.
+///
+/// Pure geometry: takes `WRITER` briefly inside `spawn_geometry` and nothing else, so it is safe from
+/// any caller that holds neither `WRITER` nor the window table.
+pub fn reserve_h(pw: usize, ph: usize) -> usize {
+    match content_extent(pw, ph).and_then(|(cw, ch)| wm::spawn_geometry(cw, ch)) {
+        Some((_scale, _ow, oh)) => oh.saturating_add(2 * wm::BORDER),
+        None => 0,
+    }
+}
