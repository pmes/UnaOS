+    fn exec_done(&mut self, verb: &str, r: Result<i64, i64>) {
+        self.cmds += 1;
+        self.last_kind = 3;
+        self.last_verb = ring3::verb_code(verb);
+        let mut l = Line::new(b":: MIDDEN: plan=Exec verb=");
