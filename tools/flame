"""flame — resolve a UnaOS `prof dump` against the build's symbol table (PROFILE, rmbp-ledger B331).

The kernel embeds no symbol table. `prof dump` prints, to serial,

    [prof] summary armed=no hz=1000 samples=N dropped=0 span_ms=... cap=4096 anchor=0x...
    [prof] cpu=<c> task=<tid> ring=<0|3> rip=0x...
    ...
    [prof] dump end samples=N

and arroyo writes `target/kernel.syms` (`llvm-nm -n -C --defined-only` on the linked ELF) beside the
kernel. The kernel is PIE, so a runtime RIP is link address + slide: `anchor=` is the runtime address
of `unaos_prof_anchor`, and that symbol's line in the syms file is its link address.

    tools/flame <serial.log> [--syms target/kernel.syms] [--top N] [--svg out.svg] [--all]
    tools/flame --self-test [--keep]

Prints the top-N symbols with sample % and writes a depth-1 flame graph SVG (a histogram-shaped flame:
one bar per symbol over an `all` root; real stacks are owed). Ring-3 samples are counted as `[ring3]`.
"""
import bisect
import hashlib
import os
import re
import sys
import tempfile
import xml.etree.ElementTree as ET
from xml.sax.saxutils import escape

SAMPLE_RE = re.compile(r"\[prof\] cpu=(\d+) task=(\d+) ring=(\d+) rip=(0x[0-9a-fA-F]+)")
SUMMARY_RE = re.compile(r"\[prof\] summary .*anchor=(0x[0-9a-fA-F]+)")
END_RE = re.compile(r"\[prof\] dump end")
HASH_RE = re.compile(r"::h[0-9a-f]{16}$")
ANCHOR = "unaos_prof_anchor"
TEXT_TYPES = set("tTwWiI")


def demangle_legacy(name):
    """Minimal Rust legacy (`_ZN...E`) demangler, for a syms file written without `-C`."""
    if not name.startswith("_ZN") or not name.endswith("E"):
        return name
    s, i, parts = name[3:-1], 0, []
    while i < len(s) and s[i].isdigit():
        j = i
        while j < len(s) and s[j].isdigit():
            j += 1
        n = int(s[i:j])
        parts.append(s[j:j + n])
        i = j + n
    if not parts:
        return name
    out = "::".join(parts)
    for a, b in (("$LT$", "<"), ("$GT$", ">"), ("$RF$", "&"), ("$BP$", "*"), ("$C$", ","),
                 ("$u20$", " "), ("$u27$", "'"), ("$u5b$", "["), ("$u5d$", "]"), ("$u7b$", "{"),
                 ("$u7d$", "}"), ("$u7e$", "~"), ("$SP$", "@"), ("..", "::")):
        out = out.replace(a, b)
    return out


def clean(name):
    return HASH_RE.sub("", demangle_legacy(name))


def load_syms(path):
    """[(addr, name)] address-sorted text symbols, and the anchor's link address (or None)."""
    syms, anchor = [], None
    with open(path, errors="replace") as f:
        for line in f:
            parts = line.rstrip("\n").split(" ", 2)
            if len(parts) < 3:
                continue
            try:
                addr = int(parts[0], 16)
            except ValueError:
                continue
            typ, name = parts[1], parts[2]
            if name == ANCHOR or clean(name) == ANCHOR:
                anchor = addr
            if typ in TEXT_TYPES:
                syms.append((addr, clean(name)))
    syms.sort()
    return syms, anchor


def load_dump(path, take_all=False):
    """(samples [(cpu, task, ring, rip)], runtime anchor) of the LAST complete dump (or every one)."""
    dumps, cur, anchor = [], None, None
    with open(path, errors="replace") as f:
        for line in f:
            m = SUMMARY_RE.search(line)
            if m:
                anchor = int(m.group(1), 16)
                cur = {"anchor": anchor, "samples": []}
                continue
            m = SAMPLE_RE.search(line)
            if m:
                if cur is None:
                    cur = {"anchor": anchor, "samples": []}
                cur["samples"].append((int(m.group(1)), int(m.group(2)), int(m.group(3)), int(m.group(4), 16)))
                continue
            if END_RE.search(line) and cur is not None:
                dumps.append(cur)
                cur = None
    if cur is not None and cur["samples"]:
        dumps.append(cur)
    if not dumps:
        return [], None
    if take_all:
        return [s for d in dumps for s in d["samples"]], dumps[-1]["anchor"]
    return dumps[-1]["samples"], dumps[-1]["anchor"]


def resolve(samples, syms, link_anchor, run_anchor):
    addrs = [a for a, _ in syms]
    slide = (run_anchor - link_anchor) if (run_anchor is not None and link_anchor is not None) else 0
    counts = {}
    for _cpu, _task, ring, rip in samples:
        if ring == 3:
            name = "[ring3]"
        else:
            i = bisect.bisect_right(addrs, rip - slide) - 1
            name = syms[i][1] if i >= 0 else "[unknown]"
        counts[name] = counts.get(name, 0) + 1
    return counts, slide


def color(name):
    h = int(hashlib.md5(name.encode()).hexdigest()[:6], 16)
    return "rgb(%d,%d,%d)" % (205 + h % 50, 80 + (h >> 8) % 120, 30 + (h >> 16) % 40)


def write_svg(path, counts, title):
    total = sum(counts.values()) or 1
    width, row, pad = 1200, 18, 10
    height = pad * 2 + 24 + row * 2
    y_root = height - pad - row
    y_leaf = y_root - row
    out = ['<?xml version="1.0" standalone="no"?>',
           '<svg xmlns="http://www.w3.org/2000/svg" width="%d" height="%d" font-family="monospace" font-size="11">' % (width, height),
           '<rect x="0" y="0" width="%d" height="%d" fill="#f8f8f0"/>' % (width, height),
           '<text x="%d" y="%d" text-anchor="middle" font-size="14">%s</text>' % (width // 2, pad + 14, escape(title)),
           '<g><title>all (%d samples, 100%%)</title><rect x="%d" y="%d" width="%d" height="%d" fill="rgb(230,150,60)" rx="2"/>'
           '<text x="%d" y="%d">all</text></g>' % (total, pad, y_root, width - 2 * pad, row - 1, pad + 3, y_root + 12)]
    x, span = float(pad), float(width - 2 * pad)
    for name, n in sorted(counts.items()):
        w = span * n / total
        label = "%s (%d samples, %.1f%%)" % (name, n, 100.0 * n / total)
        text = ""
        if w > 30:
            chars = int((w - 6) / 6.6)
            t = name if len(name) <= chars else name[:max(chars - 2, 1)] + ".."
            text = '<text x="%.1f" y="%d">%s</text>' % (x + 3, y_leaf + 12, escape(t))
        out.append('<g><title>%s</title><rect x="%.1f" y="%d" width="%.1f" height="%d" fill="%s" rx="2"/>%s</g>'
                   % (escape(label), x, y_leaf, max(w - 0.5, 0.1), row - 1, color(name), text))
        x += w
    out.append("</svg>")
    with open(path, "w") as f:
        f.write("\n".join(out) + "\n")


def report(log, syms_path, top, svg, take_all=False, quiet=False):
    samples, run_anchor = load_dump(log, take_all)
    if not samples:
        print("flame: no `[prof] cpu=` lines in %s (run `prof stop` then `prof dump`)" % log, file=sys.stderr)
        return None
    syms, link_anchor = load_syms(syms_path)
    if not syms:
        print("flame: no text symbols in %s" % syms_path, file=sys.stderr)
        return None
    if link_anchor is None or run_anchor is None:
        print("flame: WARNING no anchor (%s in syms: %s, anchor= in log: %s) — slide assumed 0"
              % (ANCHOR, link_anchor is not None, run_anchor is not None), file=sys.stderr)
    counts, slide = resolve(samples, syms, link_anchor, run_anchor)
    total = len(samples)
    ranked = sorted(counts.items(), key=lambda kv: (-kv[1], kv[0]))
    if not quiet:
        print("flame: samples=%d symbols=%d slide=%#x" % (total, len(counts), slide & ((1 << 64) - 1)))
        for i, (name, n) in enumerate(ranked[:top]):
            print("%3d  %6d  %5.1f%%  %s" % (i + 1, n, 100.0 * n / total, name))
    if svg:
        write_svg(svg, counts, "UnaOS prof — %d samples, %d symbols (depth 1)" % (total, len(counts)))
        if not quiet:
            print("flame: wrote %s" % svg)
    return ranked


def self_test(keep=False):
    d = tempfile.mkdtemp(prefix="flame-")
    syms = os.path.join(d, "kernel.syms")
    log = os.path.join(d, "serial.log")
    svg = os.path.join(d, "flame.svg")
    link = {"_start": 0x200000, "kernel::prof::synthetic_load": 0x201000, ANCHOR: 0x202000,
            "_ZN4core3fmt5write17h0123456789abcdefE": 0x203000, "kernel::arch::sched::idle": 0x204000,
            "__etext": 0x205000}
    with open(syms, "w") as f:
        f.write("                 U undefined_thing\n")
        f.write("0000000000100000 r .rodata.const\n")
        for name, a in sorted(link.items(), key=lambda kv: kv[1]):
            f.write("%016x T %s\n" % (a, name))
    slide = 0xffffffff80000000 - 0x200000
    run = lambda name, off=0x40: (link[name] + slide + off)
    plan = [("kernel::prof::synthetic_load", 600), ("kernel::arch::sched::idle", 300),
            ("_ZN4core3fmt5write17h0123456789abcdefE", 60)]
    with open(log, "w") as f:
        f.write("boot noise [prof] not a sample\n")
        f.write("[prof] summary armed=no hz=1000 samples=1 dropped=0 span_ms=1 cap=4096 anchor=%#x\n" % run(ANCHOR, 0))
        f.write("[prof] cpu=0 task=1 ring=0 rip=%#x\n" % run("_start"))
        f.write("[prof] dump end samples=1\n")
        f.write("[prof] summary armed=no hz=1000 samples=1000 dropped=0 span_ms=1000 cap=4096 anchor=%#x\n" % run(ANCHOR, 0))
        k = 0
        for name, n in plan:
            for i in range(n):
                f.write("12:00:00 [prof] cpu=%d task=%d ring=0 rip=%#x\n" % (k % 4, 7, run(name, 0x10 + (i % 0x100))))
                k += 1
        for i in range(40):
            f.write("[prof] cpu=1 task=9 ring=3 rip=%#x\n" % (0x400000 + i))
        f.write("[prof] dump end samples=1000\n")
    ranked = report(log, syms, 5, svg, quiet=True)
    ok = True
    want = [("kernel::prof::synthetic_load", 600), ("kernel::arch::sched::idle", 300),
            ("core::fmt::write", 60), ("[ring3]", 40)]
    if ranked != want:
        print("flame: self-test FAIL ranked=%r want=%r" % (ranked, want))
        ok = False
    try:
        root = ET.parse(svg).getroot()
        rects = [e for e in root.iter() if e.tag.endswith("rect")]
        if len(rects) != 1 + 1 + len(want):
            print("flame: self-test FAIL svg rects=%d want=%d" % (len(rects), 2 + len(want)))
            ok = False
    except ET.ParseError as e:
        print("flame: self-test FAIL svg does not parse: %s" % e)
        ok = False
    all_ranked = report(log, syms, 5, None, take_all=True, quiet=True)
    if not all_ranked or sum(n for _, n in all_ranked) != 1001:
        print("flame: self-test FAIL --all total=%r" % (all_ranked and sum(n for _, n in all_ranked)))
        ok = False
    print("flame: self-test %s (top=%s %d/1000 samples%s)" % ("PASS" if ok else "FAIL", want[0][0], want[0][1],
                                                         ", kept " + d if keep else ""))
    if not keep:
        for p in (syms, log, svg):
            if os.path.exists(p):
                os.remove(p)
        os.rmdir(d)
    return 0 if ok else 1


def main(argv):
    if "--self-test" in argv:
        return self_test("--keep" in argv)
    args, opts, i = [], {"--syms": None, "--top": "20", "--svg": None}, 0
    take_all = False
    while i < len(argv):
        a = argv[i]
        if a in opts:
            opts[a] = argv[i + 1]
            i += 2
            continue
        if a == "--all":
            take_all = True
        elif a in ("-h", "--help"):
            print(__doc__)
            return 0
        else:
            args.append(a)
        i += 1
    if len(args) != 1:
        print(__doc__, file=sys.stderr)
        return 2
    syms = opts["--syms"]
    if syms is None:
        here = os.path.dirname(os.path.abspath(__file__))
        syms = os.path.join(here, "..", "unaos", "target", "kernel.syms")
    return 0 if report(args[0], syms, int(opts["--top"]), opts["--svg"], take_all) is not None else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
