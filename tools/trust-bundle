#!/usr/bin/env bash
# tools/trust-bundle — fetch the Mozilla CA bundle and stage it as system/trust/roots.pem (TLSCORE, SR28), plus
# the CT log lists (CTCORE, SR60).
#
#   tools/trust-bundle            fetch https://curl.se/ca/cacert.pem (curl's extraction of Mozilla's certdata.txt)
#   tools/trust-bundle --from F   use a local file or URL instead (e.g. an air-gapped copy)
#
# Writes, relative to the repo root:
#   system/trust/roots.pem          the bundle, verbatim
#   system/trust/roots.pem.sha256   "<sha256>  roots.pem"
#   system/trust/SOURCE             where it came from, when, its sha256, and the bundle's own date line
#   system/trust/ctlogs.jsn         CTCORE (SR60): Google's CT log list (v3 schema, log_list.json) — 8.3 name, the
#                                   metal opens it as SYSTEM/TRUST/CTLOGS.JSN
#   system/trust/ctapple.jsn        Apple's CT log list (current_log_list.json, same schema), when reachable
#   system/trust/*.jsn.sha256       their pins (the builder refuses a mismatch); SOURCE records the provenance
#
# The CT list: https://www.gstatic.com/ct/log_list/v3/log_list.json with its detached signature log_list.sig,
# verified against Google's key log_list_pubkey.pem (RSASSA-PKCS1-v1_5/SHA-256; `openssl dgst -verify`, the same
# check tls_core::ct::verify_list_signature makes). If gstatic is unreachable the list Chromium itself compiles in
# is taken from the Chromium source tree (components/certificate_transparency/data/log_list.json via
# raw.githubusercontent.com at the current main commit, recorded) — authenticated only by the git commit id, and
# SOURCE says "signature: UNVERIFIED" so nobody mistakes it for the signed list.
#
# If curl.se is unreachable it tries the same Mozilla bundle as packaged by certifi on PyPI (recorded in SOURCE as
# such) — never a distro store, which may carry local additions.
#
# The builder stages it (VEINTLS, SR36: unaos/builder/src/main.rs `stage_trust`) onto the ESP and the x86 DATA
# volume as system/trust/roots.pem, after checking its sha256 against roots.pem.sha256 with crypto_core's
# SHA-256 (a mismatch stops the build; an absent bundle is reported and nothing is staged). Ring 3 loads it with
# vein_ring3::trust::load (SYS_OPEN /system/trust/roots.pem) -> tls_core::x509::TrustStore::from_pem.
# Run before `./arroyo esp-x86`:   tools/trust-bundle   (re-run when the Mozilla bundle moves; commit the new pin)
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
OUT="$ROOT/system/trust"
SRC_URL="https://curl.se/ca/cacert.pem"
FROM=""
if [[ "${1:-}" == "--from" ]]; then FROM="${2:?--from needs a file or URL}"; fi
mkdir -p "$OUT"
TMP="$(mktemp)"
trap 'rm -f "$TMP"' EXIT

fetch() { curl -sSfL --max-time 60 -o "$TMP" "$1"; }
SOURCE=""
if [[ -n "$FROM" ]]; then
  if [[ -f "$FROM" ]]; then cp "$FROM" "$TMP"; else fetch "$FROM"; fi
  SOURCE="$FROM"
elif fetch "$SRC_URL"; then
  SOURCE="$SRC_URL"
else
  echo "trust-bundle: $SRC_URL unreachable; trying certifi (Mozilla bundle repackaged) from PyPI" >&2
  META="$(curl -sSf --max-time 30 https://pypi.org/pypi/certifi/json)"
  WHEEL="$(printf '%s' "$META" | python3 -c 'import json,sys; d=json.load(sys.stdin); print([u["url"] for u in d["urls"] if u["filename"].endswith(".whl")][0])')"
  VER="$(printf '%s' "$META" | python3 -c 'import json,sys; print(json.load(sys.stdin)["info"]["version"])')"
  W="$(mktemp)"
  curl -sSf --max-time 60 -o "$W" "$WHEEL"
  python3 - "$W" "$TMP" <<'PY'
import sys, zipfile
z = zipfile.ZipFile(sys.argv[1])
open(sys.argv[2], "wb").write(z.read("certifi/cacert.pem"))
PY
  rm -f "$W"
  SOURCE="certifi $VER ($WHEEL) — Mozilla bundle; curl.se was unreachable"
fi

N="$(grep -c 'BEGIN CERTIFICATE' "$TMP" || true)"
if [[ "$N" -lt 100 ]]; then echo "trust-bundle: only $N certificates — refusing" >&2; exit 1; fi
cp "$TMP" "$OUT/roots.pem" && chmod 644 "$OUT/roots.pem"
SUM="$(sha256sum "$OUT/roots.pem" | cut -d' ' -f1)"
echo "$SUM  roots.pem" > "$OUT/roots.pem.sha256"
{
  echo "source:  $SOURCE"
  echo "fetched: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
  echo "sha256:  $SUM"
  echo "certs:   $N"
  grep -m1 -i 'Certificate data from Mozilla as of' "$OUT/roots.pem" | sed 's/^## */bundle:  /' || true
} > "$OUT/SOURCE"

# ---------------------------------------------------------------- CTCORE: CT log lists
GS="https://www.gstatic.com/ct/log_list/v3"
CT="$(mktemp -d)"
trap 'rm -f "$TMP"; rm -rf "$CT"' EXIT
ct_src=""
if curl -sSfL --max-time 60 -o "$CT/log_list.json" "$GS/log_list.json" 2>/dev/null \
   && curl -sSfL --max-time 60 -o "$CT/log_list.sig" "$GS/log_list.sig" \
   && curl -sSfL --max-time 60 -o "$CT/pub.pem" "$GS/log_list_pubkey.pem"; then
  if openssl dgst -sha256 -verify "$CT/pub.pem" -signature "$CT/log_list.sig" "$CT/log_list.json" >/dev/null; then
    ct_src="$GS/log_list.json — signature VERIFIED (log_list.sig, log_list_pubkey.pem sha256 $(sha256sum "$CT/pub.pem" | cut -c1-64))"
  else
    echo "trust-bundle: log_list.sig does NOT verify — refusing the CT list" >&2; exit 1
  fi
else
  echo "trust-bundle: $GS unreachable; taking the list Chromium compiles in from the Chromium source tree" >&2
  REV="$(git ls-remote https://github.com/chromium/chromium refs/heads/main 2>/dev/null | cut -f1)"
  if [[ -n "$REV" ]] && curl -sSfL --max-time 60 -o "$CT/log_list.json" \
       "https://raw.githubusercontent.com/chromium/chromium/$REV/components/certificate_transparency/data/log_list.json"; then
    ct_src="chromium/chromium@$REV components/certificate_transparency/data/log_list.json — signature: UNVERIFIED (gstatic unreachable; authenticated by the git commit only)"
  fi
fi
if [[ -n "$ct_src" ]] && python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); assert d["operators"] and d["log_list_timestamp"]' "$CT/log_list.json"; then
  cp "$CT/log_list.json" "$OUT/ctlogs.jsn" && chmod 644 "$OUT/ctlogs.jsn"
  CSUM="$(sha256sum "$OUT/ctlogs.jsn" | cut -d' ' -f1)"
  echo "$CSUM  ctlogs.jsn" > "$OUT/ctlogs.jsn.sha256"
  {
    echo "ct:      $ct_src"
    echo "ct.sha:  $CSUM"
    echo "ct.list: $(python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); print("version", d.get("version"), "timestamp", d["log_list_timestamp"], "logs", sum(len(o.get("logs",[]))+len(o.get("tiled_logs",[])) for o in d["operators"]))' "$OUT/ctlogs.jsn")"
  } >> "$OUT/SOURCE"
else
  echo "ct:      NOT STAGED — no CT log list reachable (tls_core reports ct=off)" >> "$OUT/SOURCE"
fi
if curl -sSfL --max-time 60 -o "$CT/apple.json" "https://valid.apple.com/ct/log_list/current_log_list.json" 2>/dev/null; then
  cp "$CT/apple.json" "$OUT/ctapple.jsn" && chmod 644 "$OUT/ctapple.jsn"
  ASUM="$(sha256sum "$OUT/ctapple.jsn" | cut -d' ' -f1)"
  echo "$ASUM  ctapple.jsn" > "$OUT/ctapple.jsn.sha256"
  echo "ct.apple: https://valid.apple.com/ct/log_list/current_log_list.json sha256 $ASUM (unsigned: Apple publishes no detached signature)" >> "$OUT/SOURCE"
else
  rm -f "$OUT/ctapple.jsn" "$OUT/ctapple.jsn.sha256"
  echo "ct.apple: NOT STAGED — valid.apple.com unreachable" >> "$OUT/SOURCE"
fi
cat "$OUT/SOURCE"
