#!/usr/bin/env bash
# tools/trust-bundle — fetch the Mozilla CA bundle and stage it as system/trust/roots.pem (TLSCORE, SR28), plus
# the CT log lists (CTCORE, SR60).
#
#   tools/trust-bundle            fetch https://curl.se/ca/cacert.pem (curl's extraction of Mozilla's certdata.txt)
#   tools/trust-bundle --from F   use a local file or URL instead (e.g. an air-gapped copy)
#
# Writes, relative to the repo root:
#   system/trust/roots.pem          the bundle, verbatim
#   system/trust/roots.pem.sha256   "<sha256>  roots.pem"
#   system/trust/SOURCE             where it came from, when, its sha256, and the bundle's own date line
#   system/trust/ctlogs.jsn         CTCORE (SR60): Google's CT log list (v3 schema, log_list.json) — 8.3 name, the
#                                   metal opens it as SYSTEM/TRUST/CTLOGS.JSN
#   system/trust/ctapple.jsn        Apple's CT log list (current_log_list.json, same schema), when reachable
#   system/trust/*.jsn.sha256       their pins (the builder refuses a mismatch); SOURCE records the provenance
#   system/trust/inters.pem         Mozilla's CCADB intermediate set (PublicAllIntermediateCertsWithPEMCSV): an
#                                   UNTRUSTED pool for servers that omit an intermediate (TrustStore.intermediates;
#                                   8.3 name for the metal); pinned by inters.pem.sha256
#   tools/trust-bundle --intermediates-from F   take the CCADB CSV (or a PEM bundle) from a local file instead
#
# The CT list: https://www.gstatic.com/ct/log_list/v3/log_list.json with its detached signature log_list.sig,
# verified against Google's key log_list_pubkey.pem (RSASSA-PKCS1-v1_5/SHA-256; `openssl dgst -verify`, the same
# check tls_core::ct::verify_list_signature makes). If gstatic is unreachable the list Chromium itself compiles in
# is taken from the Chromium source tree (components/certificate_transparency/data/log_list.json via
# raw.githubusercontent.com at the current main commit, recorded) — authenticated only by the git commit id, and
# SOURCE says "signature: UNVERIFIED" so nobody mistakes it for the signed list.
#
# If curl.se is unreachable it tries the same Mozilla bundle as packaged by certifi on PyPI (recorded in SOURCE as
# such) — never a distro store, which may carry local additions.
#
# The builder stages it (VEINTLS, SR36: unaos/builder/src/main.rs `stage_trust`) onto the ESP and the x86 DATA
# volume as system/trust/roots.pem, after checking its sha256 against roots.pem.sha256 with crypto_core's
# SHA-256 (a mismatch stops the build; an absent bundle is reported and nothing is staged). Ring 3 loads it with
# vein_ring3::trust::load (SYS_OPEN /system/trust/roots.pem) -> tls_core::x509::TrustStore::from_pem.
# Run before `./arroyo esp-x86`:   tools/trust-bundle
#
# SMALLFIX (B380): THE PIN IS A COMMIT, NEVER A BUILD STEP. Flight 23's bench fetched curl.se's bundle and REWROTE the committed
# certifi pin before the builder asserted it, so the assert proved the fetch, not the pin. Now, when a pin is committed
# (git HEAD's system/trust/<file>.sha256), the fetched file is VERIFIED against it: the source the committed SOURCE records is
# tried first (the exact certifi wheel / the exact chromium commit), then the usual ones; the first whose sha256 equals the pin
# is staged, and neither the pin nor SOURCE is touched. None matching = refused:
#   trust-bundle: pin mismatch committed=<sha> fetched=<sha> — bundle NOT replaced      (exit 1; roots.pem)
#   trust-bundle: pin mismatch committed=<sha> fetched=<sha> — ctlogs.jsn NOT replaced  (ct is report-mode: the run goes on)
#   tools/trust-bundle --repin    the deliberate pin change: fetch, rewrite the pins + SOURCE — then COMMIT them.
# A file with no committed pin (ctapple.jsn, inters.pem today) is written with its pin as before, said `pin=uncommitted`.
set -euo pipefail
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
OUT="$ROOT/system/trust"
SRC_URL="https://curl.se/ca/cacert.pem"
FROM=""
INTER_FROM=""
REPIN=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --repin) REPIN=1; shift ;;
    --from) FROM="${2:?--from needs a file or URL}"; shift 2 ;;
    --intermediates-from) INTER_FROM="${2:?--intermediates-from needs a file}"; shift 2 ;;
    *) echo "trust-bundle: unknown argument $1" >&2; exit 2 ;;
  esac
done
mkdir -p "$OUT"
TMP="$(mktemp)"
trap 'rm -f "$TMP"' EXIT

# The COMMITTED pin of system/trust/<name> (git HEAD; the file itself outside a checkout), or "" when none is committed.
committed_pin() {
  local f="system/trust/$1.sha256" v=""
  if git -C "$ROOT" rev-parse --git-dir >/dev/null 2>&1; then
    v="$(git -C "$ROOT" show "HEAD:$f" 2>/dev/null | cut -d' ' -f1 || true)"
  elif [[ -f "$ROOT/$f" ]]; then
    v="$(cut -d' ' -f1 "$ROOT/$f")"
  fi
  printf '%s' "$v"
}
# The committed SOURCE's record (git HEAD), for the verify mode's first candidate.
committed_source() { git -C "$ROOT" show HEAD:system/trust/SOURCE 2>/dev/null || cat "$OUT/SOURCE" 2>/dev/null || true; }
PIN_ROOTS=""; PIN_CT=""
if [[ "$REPIN" = 0 ]]; then PIN_ROOTS="$(committed_pin roots.pem)"; PIN_CT="$(committed_pin ctlogs.jsn)"; fi
# VERIFY mode never rewrites the committed SOURCE: the run's provenance goes to a scratch file and is printed.
if [[ -n "$PIN_ROOTS" || -n "$PIN_CT" ]]; then SRCF="$(mktemp)"; else SRCF="$OUT/SOURCE"; fi
: > "$SRCF"
trap 'rm -f "$TMP"; [[ "$SRCF" = "$OUT/SOURCE" ]] || rm -f "$SRCF"' EXIT

fetch() { curl -sSfL --max-time 60 -o "$TMP" "$1"; }
certifi_wheel() { # url — the bundle out of a certifi wheel into $TMP
  local W; W="$(mktemp)"
  curl -sSf --max-time 60 -o "$W" "$1" && python3 - "$W" "$TMP" <<'PY'
import sys, zipfile
z = zipfile.ZipFile(sys.argv[1])
open(sys.argv[2], "wb").write(z.read("certifi/cacert.pem"))
PY
  local rc=$?; rm -f "$W"; return $rc
}
sha_of() { sha256sum "$1" | cut -d' ' -f1; }
SOURCE=""
FIRST_SUM=""
# One candidate into $TMP; under a committed pin it is taken only when its sha256 IS the pin.
take() { # source-description
  local s; s="$(sha_of "$TMP")"
  [[ -z "$FIRST_SUM" ]] && FIRST_SUM="$s"
  if [[ -z "$PIN_ROOTS" || "$s" = "$PIN_ROOTS" ]]; then SOURCE="$1"; return 0; fi
  echo "trust-bundle: $1 -> sha256 $s (not the committed pin)" >&2
  return 1
}
if [[ -n "$FROM" ]]; then
  if [[ -f "$FROM" ]]; then cp "$FROM" "$TMP"; else fetch "$FROM"; fi
  take "$FROM" || true
else
  # Verify mode: the committed SOURCE's own certifi wheel first (the bytes the pin was cut from).
  REC_WHEEL="$(committed_source | sed -n 's/^source:  certifi [^ ]* (\(https:[^)]*\.whl\)).*/\1/p' | head -1)"
  if [[ -n "$PIN_ROOTS" && -n "$REC_WHEEL" ]] && certifi_wheel "$REC_WHEEL"; then
    take "$(committed_source | sed -n 's/^source:  //p' | head -1)" || true
  fi
  if [[ -z "$SOURCE" ]] && fetch "$SRC_URL"; then
    take "$SRC_URL" || true
  fi
  if [[ -z "$SOURCE" ]]; then
    echo "trust-bundle: trying certifi (Mozilla bundle repackaged) from PyPI" >&2
    META="$(curl -sSf --max-time 30 https://pypi.org/pypi/certifi/json || true)"
    if [[ -n "$META" ]]; then
      WHEEL="$(printf '%s' "$META" | python3 -c 'import json,sys; d=json.load(sys.stdin); print([u["url"] for u in d["urls"] if u["filename"].endswith(".whl")][0])')"
      VER="$(printf '%s' "$META" | python3 -c 'import json,sys; print(json.load(sys.stdin)["info"]["version"])')"
      certifi_wheel "$WHEEL" && take "certifi $VER ($WHEEL) — Mozilla bundle; curl.se was unreachable" || true
    fi
  fi
fi
if [[ -z "$SOURCE" ]]; then
  if [[ -n "$PIN_ROOTS" && -n "$FIRST_SUM" ]]; then
    echo "trust-bundle: pin mismatch committed=$PIN_ROOTS fetched=$FIRST_SUM — bundle NOT replaced" >&2
    echo "trust-bundle: a pin change is a commit, never a build step: tools/trust-bundle --repin, then commit system/trust/" >&2
  else
    echo "trust-bundle: no Mozilla bundle reachable — bundle NOT replaced" >&2
  fi
  exit 1
fi

N="$(grep -c 'BEGIN CERTIFICATE' "$TMP" || true)"
if [[ "$N" -lt 100 ]]; then echo "trust-bundle: only $N certificates — refusing" >&2; exit 1; fi
cp "$TMP" "$OUT/roots.pem" && chmod 644 "$OUT/roots.pem"
SUM="$(sha256sum "$OUT/roots.pem" | cut -d' ' -f1)"
if [[ -n "$PIN_ROOTS" ]]; then
  echo "trust-bundle: roots.pem sha256 $SUM == committed pin — staged, pin untouched"
else
  echo "$SUM  roots.pem" > "$OUT/roots.pem.sha256"
fi
{
  echo "source:  $SOURCE"
  echo "fetched: $(date -u +%Y-%m-%dT%H:%M:%SZ)"
  echo "sha256:  $SUM"
  echo "certs:   $N"
  grep -m1 -i 'Certificate data from Mozilla as of' "$OUT/roots.pem" | sed 's/^## */bundle:  /' || true
} >> "$SRCF"

# ---------------------------------------------------------------- CTCORE: CT log lists
GS="https://www.gstatic.com/ct/log_list/v3"
CT="$(mktemp -d)"
trap 'rm -f "$TMP"; rm -rf "$CT"; [[ "$SRCF" = "$OUT/SOURCE" ]] || rm -f "$SRCF"' EXIT
ct_src=""
# Verify mode: the committed SOURCE's chromium commit first (the list the pin was cut from).
REC_REV="$(committed_source | sed -n 's/^ct:      chromium\/chromium@\([0-9a-f]\{40\}\) .*/\1/p' | head -1)"
if [[ -n "$PIN_CT" && -n "$REC_REV" ]] && curl -sSfL --max-time 60 -o "$CT/log_list.json" \
     "https://raw.githubusercontent.com/chromium/chromium/$REC_REV/components/certificate_transparency/data/log_list.json" 2>/dev/null \
   && [[ "$(sha_of "$CT/log_list.json")" = "$PIN_CT" ]]; then
  ct_src="chromium/chromium@$REC_REV components/certificate_transparency/data/log_list.json — the committed pin's own commit"
elif curl -sSfL --max-time 60 -o "$CT/log_list.json" "$GS/log_list.json" 2>/dev/null \
   && curl -sSfL --max-time 60 -o "$CT/log_list.sig" "$GS/log_list.sig" \
   && curl -sSfL --max-time 60 -o "$CT/pub.pem" "$GS/log_list_pubkey.pem"; then
  if openssl dgst -sha256 -verify "$CT/pub.pem" -signature "$CT/log_list.sig" "$CT/log_list.json" >/dev/null; then
    ct_src="$GS/log_list.json — signature VERIFIED (log_list.sig, log_list_pubkey.pem sha256 $(sha256sum "$CT/pub.pem" | cut -c1-64))"
  else
    echo "trust-bundle: log_list.sig does NOT verify — refusing the CT list" >&2; exit 1
  fi
else
  echo "trust-bundle: $GS unreachable; taking the list Chromium compiles in from the Chromium source tree" >&2
  REV="$(git ls-remote https://github.com/chromium/chromium refs/heads/main 2>/dev/null | cut -f1)"
  if [[ -n "$REV" ]] && curl -sSfL --max-time 60 -o "$CT/log_list.json" \
       "https://raw.githubusercontent.com/chromium/chromium/$REV/components/certificate_transparency/data/log_list.json"; then
    ct_src="chromium/chromium@$REV components/certificate_transparency/data/log_list.json — signature: UNVERIFIED (gstatic unreachable; authenticated by the git commit only)"
  fi
fi
if [[ -n "$ct_src" && -n "$PIN_CT" ]] && [[ "$(sha_of "$CT/log_list.json")" != "$PIN_CT" ]]; then
  echo "trust-bundle: pin mismatch committed=$PIN_CT fetched=$(sha_of "$CT/log_list.json") — ctlogs.jsn NOT replaced" >&2
  [[ -f "$OUT/ctlogs.jsn" && "$(sha_of "$OUT/ctlogs.jsn")" = "$PIN_CT" ]] || rm -f "$OUT/ctlogs.jsn"   # a stale unpinned copy would fail the builder's assert
  echo "ct:      NOT REPLACED — the fetched list is not the committed pin (tools/trust-bundle --repin, then commit)" >> "$SRCF"
elif [[ -n "$ct_src" ]] && python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); assert d["operators"] and d["log_list_timestamp"]' "$CT/log_list.json"; then
  cp "$CT/log_list.json" "$OUT/ctlogs.jsn" && chmod 644 "$OUT/ctlogs.jsn"
  CSUM="$(sha256sum "$OUT/ctlogs.jsn" | cut -d' ' -f1)"
  [[ -n "$PIN_CT" ]] || echo "$CSUM  ctlogs.jsn" > "$OUT/ctlogs.jsn.sha256"
  {
    echo "ct:      $ct_src"
    echo "ct.sha:  $CSUM"
    echo "ct.list: $(python3 -c 'import json,sys; d=json.load(open(sys.argv[1])); print("version", d.get("version"), "timestamp", d["log_list_timestamp"], "logs", sum(len(o.get("logs",[]))+len(o.get("tiled_logs",[])) for o in d["operators"]))' "$OUT/ctlogs.jsn")"
  } >> "$SRCF"
else
  echo "ct:      NOT STAGED — no CT log list reachable (tls_core reports ct=off)" >> "$SRCF"
fi
if curl -sSfL --max-time 60 -o "$CT/apple.json" "https://valid.apple.com/ct/log_list/current_log_list.json" 2>/dev/null; then
  cp "$CT/apple.json" "$OUT/ctapple.jsn" && chmod 644 "$OUT/ctapple.jsn"
  ASUM="$(sha256sum "$OUT/ctapple.jsn" | cut -d' ' -f1)"
  echo "$ASUM  ctapple.jsn" > "$OUT/ctapple.jsn.sha256"
  echo "ct.apple: https://valid.apple.com/ct/log_list/current_log_list.json sha256 $ASUM (unsigned: Apple publishes no detached signature) pin=uncommitted" >> "$SRCF"
else
  rm -f "$OUT/ctapple.jsn" "$OUT/ctapple.jsn.sha256"
  echo "ct.apple: NOT STAGED — valid.apple.com unreachable" >> "$SRCF"
fi
# ---------------------------------------------------------------- CTCORE: CCADB intermediates
CCADB="https://ccadb.my.salesforce-sites.com/mozilla/PublicAllIntermediateCertsWithPEMCSV"
inter_src=""
if [[ -n "$INTER_FROM" ]]; then
  cp "$INTER_FROM" "$CT/inters.raw" && inter_src="$INTER_FROM"
elif curl -sSfL --max-time 120 -o "$CT/inters.raw" "$CCADB" 2>/dev/null; then
  inter_src="$CCADB"
fi
if [[ -n "$inter_src" ]]; then
  # The CSV's "PEM Info" column holds each certificate (quoted, PEM); a PEM bundle passes through.
  python3 - "$CT/inters.raw" "$CT/inters.pem" <<'PY'
import csv, re, sys
raw = open(sys.argv[1], encoding="utf-8", errors="replace").read()
pems = re.findall(r"-----BEGIN CERTIFICATE-----[A-Za-z0-9+/=\s]+?-----END CERTIFICATE-----", raw)
seen, out = set(), []
for p in pems:
    body = "".join(p.split("-----")[2].split())
    if body not in seen:
        seen.add(body)
        out.append("-----BEGIN CERTIFICATE-----\n" + "\n".join(body[i:i+64] for i in range(0, len(body), 64)) + "\n-----END CERTIFICATE-----\n")
open(sys.argv[2], "w").write("".join(out))
print(len(out))
PY
  NI="$(grep -c 'BEGIN CERTIFICATE' "$CT/inters.pem" || true)"
  if [[ "$NI" -gt 0 ]]; then
    cp "$CT/inters.pem" "$OUT/inters.pem" && chmod 644 "$OUT/inters.pem"
    ISUM="$(sha256sum "$OUT/inters.pem" | cut -d' ' -f1)"
    echo "$ISUM  inters.pem" > "$OUT/inters.pem.sha256"
    echo "inters:  $inter_src — $NI certificates (the CA ones join the untrusted pool), sha256 $ISUM pin=uncommitted" >> "$SRCF"
  fi
else
  rm -f "$OUT/inters.pem" "$OUT/inters.pem.sha256"
  echo "inters:  NOT STAGED — CCADB ($CCADB) unreachable; no intermediate pool (pass --intermediates-from FILE)" >> "$SRCF"
fi
cat "$SRCF"
